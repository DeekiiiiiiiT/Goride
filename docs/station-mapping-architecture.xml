        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;NEW LEARNT LOCATION&lt;/b&gt;&lt;br&gt;Nothing nearby → a learnt pin is created → Learnt locations queue (can be promoted to a station)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=11;" vertex="1" parent="1">
