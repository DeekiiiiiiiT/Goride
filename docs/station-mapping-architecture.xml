        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;VERIFIED&lt;/b&gt;&lt;br&gt;Fill linked to the station. High trust score → auto-locked + signed. Price feeds the public map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1620" y="960" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;REVIEW REQUIRED&lt;/b&gt;&lt;br&gt;2+ stations too close to tell apart (ambiguous) → Resolution tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
