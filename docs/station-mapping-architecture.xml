        </mxCell>
        <mxCell id="m2y" value="&lt;b&gt;VERIFIED&lt;/b&gt; (manual override)&lt;br&gt;linked + signed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1">
