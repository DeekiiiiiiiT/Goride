        </mxCell>
        <mxCell id="m0" value="&lt;b&gt;Driver logs a fuel fill&lt;/b&gt; (driver app)&lt;br&gt;GPS point + accuracy + time of fix,&lt;br&gt;optional &quot;I was at station X&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
