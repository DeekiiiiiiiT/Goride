        <mxCell id="m4" value="&lt;b&gt;Search&lt;/b&gt;: stations within 600 m + GPS accuracy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1900" y="610" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="&lt;b&gt;Accept&lt;/b&gt; a station only if&lt;br&gt;distance ≤ its geofence (150 m default) + GPS accuracy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1900" y="690" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="What matched?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=12;fontStyle=1;" vertex="1" parent="1">
