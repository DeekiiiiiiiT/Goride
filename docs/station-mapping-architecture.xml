        <mxCell id="m3" value="&lt;b&gt;Build the GPS pool&lt;/b&gt;&lt;br&gt;verified stations (pin confirmed) + learnt pins.&lt;br&gt;Unverified CSV rows are left out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1">
