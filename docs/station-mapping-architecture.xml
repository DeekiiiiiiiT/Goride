        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;NO GPS&lt;/b&gt;&lt;br&gt;No location on the fill → unresolved stop in the Resolution tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
