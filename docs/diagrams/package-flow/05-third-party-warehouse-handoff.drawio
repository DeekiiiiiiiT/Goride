<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="third-party" name="Third-party warehouse handoff">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Scenario 5 — Third-party warehouse → Courier&lt;/b&gt;&lt;br&gt;Warehouse company receives for linked courier BSHIP. Dual ownership: owner=BSHIP, operating warehouse=Warehouse Co.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Amber = Warehouse product · Blue = Courier product · Purple = partnership link&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="start" value="START&#xa;BSHIP Connect warehouses → invite Warehouse Co&#xa;Warehouse Co Accepts (active link)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;COURIER&lt;/b&gt; BSHIP&#xa;Packages → Expected pre-alert&#xa;Tracking MY-SMOKE-001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE&lt;/b&gt; Co&#xa;/warehouse Receive Station&#xa;Select courier = BSHIP&#xa;Scan MY-SMOKE-001&#xa;owner_org=BSHIP · ops_wh=Warehouse Co" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="280" y="420" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;COURIER&lt;/b&gt; BSHIP&#xa;Invoice verify → Manifests Seal&#xa;Customs → Hub → Fulfillment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;" vertex="1" parent="1">
          <mxGeometry x="300" y="600" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="end" value="DONE&#xa;Warehouse never sees manifests&#xa;Courier never needs Warehouse Co login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="760" width="300" height="100" as="geometry" />
