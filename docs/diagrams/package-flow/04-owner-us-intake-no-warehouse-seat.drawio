<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="owner-intake" name="Owner — Courier US Intake only">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 4 — No Warehouse seat (Courier owner does US intake)&lt;/b&gt;&lt;br&gt;All steps in Courier. Receive via US Intake (same Receive Station UI as /warehouse).&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Amber = Courier (/app) · dashed blue = Warehouse login not used&lt;br&gt;Paperwork then follows Scenario 1, 2, or 3 from Invoice stage onward.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="85" as="geometry" />
        </mxCell>

        <mxCell id="legend_c" value="COURIER APP&#xa;/app — all steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="skip" value="WAREHOUSE APP&#xa;NOT USED&#xa;(no /warehouse login)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="30" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Owner / courier ops at US facility&#xa;Tracking: MY-SMOKE-001" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;US Intake (/app/receive)&lt;br&gt;Tab: Receive station&lt;br&gt;&lt;br&gt;1. Warehouse + suite&lt;br&gt;2. Scan MY-SMOKE-001 (large scan field)&lt;br&gt;3. Open &lt;b&gt;Details&lt;/b&gt; for weight / declared USD / bin&lt;br&gt;4. Upload packing slip if it came with the box&lt;br&gt;5. Soft hold ON if chasing customer invoice&lt;br&gt;6. Confirm receipt&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Optional: “Open Warehouse app” only if that seat is allowed — not required for this smoke.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="260" width="420" height="230" as="geometry" />
        </mxCell>

        <mxCell id="c1b" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;US Intake → Inbound tab&lt;br&gt;&lt;br&gt;Confirm package on floor / soft-hold flag if set" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="530" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="branch" value="Paperwork&#xa;path?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="660" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="path_slip" value="Slip + customer will invoice&#xa;→ Scenario 1 rules&#xa;(verify customer invoice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="path_chase" value="No slip / soft hold&#xa;→ Scenario 2 (verify)&#xa;or 3 (unobtainable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="800" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Packages → open package / Needs invoice&lt;br&gt;&lt;br&gt;Invoice stage: upload + &lt;b&gt;Verify&lt;/b&gt; customer invoice&#xa;OR &lt;b&gt;Mark could not obtain&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="930" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Optional: Duty / Billing / HS Tariffs" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1090" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Manifests → Seal → AWBOLDS → JCA stub&#xa;Shipped → Arrived Jamaica" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1200" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Customs → Clear&#xa;Hub → Scan station (or floor Mark ready)&#xa;Fulfillment → Desk or Scan station → Mark collected" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1340" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;All in Courier — no Warehouse seat handoff" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1510" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Smoke checklist&#xa;• /app/receive tabs: Inbound | Receive station&#xa;• Same scan-first receive as Warehouse&#xa;• No /warehouse login required&#xa;• Seal / Hub / Fulfillment all in Courier" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="260" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="c1b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1b" target="branch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Slip path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="branch" target="path_slip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Chase path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="branch" target="path_chase"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="path_slip" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="path_chase" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c5" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
