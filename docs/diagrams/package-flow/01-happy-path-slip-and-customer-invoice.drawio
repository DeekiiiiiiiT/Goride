<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="happy-path" name="Happy path — slip + customer invoice">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 1 — Happy path&lt;/b&gt;&lt;br&gt;Warehouse gets a packing slip with the box + customer sends invoice + Courier verifies → full Jamaica path&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blue = Warehouse app (/warehouse) · Amber = Courier app (/app)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend_w" value="WAREHOUSE APP&#xa;/warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend_c" value="COURIER APP&#xa;/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Package arrives at US warehouse&#xa;Tracking: MY-SMOKE-001" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound → Receive Station&lt;br&gt;&lt;br&gt;1. Choose warehouse facility&lt;br&gt;2. Choose suite (e.g. JA-SMOKE01)&lt;br&gt;3. Enter tracking MY-SMOKE-001&lt;br&gt;4. Enter weight (e.g. 3.2 lb)&lt;br&gt;5. Enter bin (e.g. B2-07)&lt;br&gt;6. Enter declared value USD (e.g. 45)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="230" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="w2" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Receive Station — paperwork with the box&lt;br&gt;&lt;br&gt;• Upload &lt;b&gt;warehouse packing slip&lt;/b&gt; (came with the box)&lt;br&gt;• Leave “Invoice required from customer” &lt;b&gt;unchecked&lt;/b&gt; (you already have a slip)&lt;br&gt;• Submit / scan inbound" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="440" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="w3" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound list&lt;br&gt;&lt;br&gt;Confirm MY-SMOKE-001 shows as received&lt;br&gt;(weight / bin look correct)&lt;br&gt;&lt;br&gt;&lt;i&gt;Warehouse work for this box is done.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="610" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="handoff" value="HANDOFF → switch to Courier login&#xa;(same org, same package)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="770" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Packages&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001 and confirm it appears&lt;br&gt;(status: received at warehouse)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="910" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Invoice Audit&lt;br&gt;&lt;br&gt;1. Open MY-SMOKE-001&lt;br&gt;2. See warehouse packing slip (for comparison)&lt;br&gt;3. Upload &lt;b&gt;customer invoice&lt;/b&gt; (PDF/image)&lt;br&gt;4. &lt;b&gt;Verify&lt;/b&gt; customer invoice&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Customer invoice is the seal gate (value check). Warehouse slip alone is not enough.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1050" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt; (optional light checks)&lt;br&gt;Mailbox → HS Tariffs — page loads&lt;br&gt;Mailbox → Package Duty — compute if asked&lt;br&gt;Mailbox → Consolidated Billing — optional INV-…" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1260" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Manifests / Manifest Builder&lt;br&gt;&lt;br&gt;1. Add MY-SMOKE-001 to a manifest&lt;br&gt;2. Clear blockers (TRN, verified customer invoice, weight, declared USD)&lt;br&gt;3. Seal&lt;br&gt;4. Download AWBOLDS (XML)&lt;br&gt;5. Submit to JCA (stub OK for smoke)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1400" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Same manifest&lt;br&gt;&lt;br&gt;1. Mark Shipped&lt;br&gt;2. Mark Arrived Jamaica" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1600" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c6" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Clearance Board (or Customs)&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001 → Clear (green)&lt;br&gt;Not Hold / Inspect on happy path" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1740" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c7" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Hub Station&lt;br&gt;&lt;br&gt;1. Select Kingston Hub&lt;br&gt;2. Scan MY-SMOKE-001&lt;br&gt;3. Sort zone (e.g. KIN-A)&lt;br&gt;4. Fulfillment = Branch pickup&lt;br&gt;5. Mark ready" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1880" width="340" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c8" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Last Mile → Fulfillment&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001 in Pickup queue&lt;br&gt;→ Mark collected" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="2060" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;Received → Customer invoice verified&#xa;→ Sealed → Cleared → Collected" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="2200" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note" value="This scenario assumes slip came with the box AND customer still provided a commercial invoice for seal.&#xa;Other scenarios (no slip, unobtainable invoice, owner US Intake) are separate .drawio files." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF7ED;strokeColor=#FB923C;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="700" y="1050" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="w1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w1" target="w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w2" target="w3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w3" target="handoff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="handoff" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c8" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
