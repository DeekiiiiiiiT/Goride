<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="happy-path" name="Happy path — slip + customer invoice">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 1 — Happy path&lt;/b&gt;&lt;br&gt;Packing slip with the box (optional reference) + customer commercial invoice verified → full Jamaica path&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blue = Warehouse app (/warehouse) · Amber = Courier app (/app)&lt;br&gt;Seal gate = verified &lt;b&gt;customer invoice&lt;/b&gt; only. Packing slip never blocks seal.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="740" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend_w" value="WAREHOUSE APP&#xa;/warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend_c" value="COURIER APP&#xa;/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Package arrives at US warehouse&#xa;Tracking: MY-SMOKE-001&#xa;Packing slip in the box" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;/warehouse → Receive Station&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(same UI as Courier US Intake → Receive station)&lt;/font&gt;&lt;br&gt;&lt;br&gt;1. Choose warehouse + suite (or scan suite QR)&lt;br&gt;2. Scan / type tracking MY-SMOKE-001 (large scan field)&lt;br&gt;3. Open &lt;b&gt;Details&lt;/b&gt; → weight, declared USD, bin&lt;br&gt;4. In Details → upload &lt;b&gt;warehouse packing slip&lt;/b&gt;&lt;br&gt;5. Leave “Customer invoice required (soft hold)” &lt;b&gt;unchecked&lt;/b&gt;&lt;br&gt;6. Confirm receipt" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="250" width="380" height="210" as="geometry" />
        </mxCell>

        <mxCell id="w2" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound&lt;br&gt;&lt;br&gt;Confirm MY-SMOKE-001 on floor&lt;br&gt;(weight / bin look correct)&lt;br&gt;&lt;br&gt;&lt;i&gt;Warehouse work for this box is done.&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Soft hold was left off — not chasing. Slip is optional reference only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="500" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="handoff" value="HANDOFF → Courier login&#xa;(same org, same package)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="680" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Packages (/app/packages)&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001&lt;br&gt;Status: received at warehouse&lt;br&gt;Open package → mission ribbon (Receive done → Invoice current)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="820" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Package Duty — Invoice stage&lt;br&gt;(/app/packages/… or Needs invoice tab)&lt;br&gt;&lt;br&gt;1. See warehouse packing slip (compare only)&lt;br&gt;2. Upload &lt;b&gt;customer commercial invoice&lt;/b&gt;&lt;br&gt;3. &lt;b&gt;Verify&lt;/b&gt; customer invoice&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Seal gate = verified customer invoice. Packing slip never seals the manifest.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="980" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt; (optional)&lt;br&gt;Package Duty → Duty (compute if asked)&lt;br&gt;Billing / HS Tariffs as needed" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1200" width="380" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Manifests (/app/manifests)&lt;br&gt;&lt;br&gt;1. Add MY-SMOKE-001 to a manifest&lt;br&gt;2. Clear blockers (TRN, verified customer invoice, weight, declared USD)&lt;br&gt;3. Seal&lt;br&gt;4. Download AWBOLDS (XML)&lt;br&gt;5. Submit to JCA (stub OK for smoke)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1330" width="380" height="170" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Same manifest&lt;br&gt;&lt;br&gt;1. Mark Shipped&lt;br&gt;2. Mark Arrived Jamaica" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1540" width="380" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c6" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Customs (/app/customs) → Lanes&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001 → Clear (green)&lt;br&gt;Not Hold / Inspect on happy path" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1680" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c7" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Hub (/app/hub) — Scan station&lt;br&gt;&lt;br&gt;1. Hub facility remembered (chrome select)&lt;br&gt;2. Scan MY-SMOKE-001 (large scan field)&lt;br&gt;3. Details → sort zone (e.g. KIN-A) + fulfillment = Branch pickup&lt;br&gt;4. Mark ready&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Or Hub floor → Mark ready if already scanned in.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="1830" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c8" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Fulfillment (/app/fulfillment)&lt;br&gt;&lt;br&gt;Desk → Pickup queue → Mark collected&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Or Scan station → scan tracking → Mark collected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="2030" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;Received → Customer invoice verified&#xa;→ Sealed → Cleared → Collected" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="2190" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Smoke checklist&#xa;• Packing slip uploaded under Details&#xa;• Customer invoice verified on package&#xa;• Manifest seals without packing-slip check&#xa;• Hub facility persists across Floor / Scan&#xa;• Fulfillment collect works from Desk or Scan" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF7ED;strokeColor=#FB923C;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="700" y="980" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w2" target="handoff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="handoff" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c8" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
