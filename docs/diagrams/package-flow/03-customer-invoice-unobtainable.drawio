<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="unobtainable" name="Customer invoice unobtainable">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 3 — Customer invoice never arrives (unobtainable)&lt;/b&gt;&lt;br&gt;Soft hold chase fails → Mark could not obtain → seal unblocked without a verified invoice file&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blue = Warehouse (/warehouse) · Amber = Courier (/app)&lt;br&gt;Unobtainable clears soft hold and satisfies seal gate (same as verify).&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="85" as="geometry" />
        </mxCell>

        <mxCell id="legend_w" value="WAREHOUSE APP&#xa;/warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend_c" value="COURIER APP&#xa;/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Same as Scenario 2 receive:&#xa;no packing slip + soft hold on&#xa;Tracking: MY-SMOKE-001" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Receive Station&lt;br&gt;&lt;br&gt;Scan + Details (weight / bin / declared USD)&lt;br&gt;✓ Soft hold: Customer invoice required&lt;br&gt;✗ No packing slip&lt;br&gt;Confirm receipt → Inbound shows soft hold" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="270" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="handoff" value="HANDOFF → Courier" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Packages → Needs invoice&lt;br&gt;&lt;br&gt;1. Open MY-SMOKE-001 Invoice stage&lt;br&gt;2. Chase customer (email / WhatsApp / phone)&lt;br&gt;3. Customer never provides a commercial invoice" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="580" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Invoice&#xa;obtainable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="760" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="branch_yes" value="Yes → Scenario 2&#xa;Upload + Verify&#xa;Do NOT mark unobtainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="900" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Package Duty — Invoice stage&lt;br&gt;&lt;br&gt;1. Enter note (e.g. customer unreachable)&lt;br&gt;2. &lt;b&gt;Mark could not obtain&lt;/b&gt;&lt;br&gt;&lt;br&gt;Effects: soft hold cleared · seal gate opened · no verified file on record" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="900" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Manifests → add MY-SMOKE-001 → Seal&#xa;(must still clear TRN / weight / declared USD)&lt;br&gt;AWBOLDS → JCA stub → Shipped → Arrived JA" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1100" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Customs → Clear&#xa;Hub Scan station → ready&#xa;Fulfillment → Mark collected" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1260" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;Unobtainable path → Sealed → Cleared → Collected&#xa;(no verified customer invoice file)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1420" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Smoke checklist&#xa;• Soft hold on at receive&#xa;• Chase then Mark could not obtain&#xa;• Soft hold gone after unobtainable&#xa;• Manifest seals without verified upload&#xa;• Packing slip still never required" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="580" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w1" target="handoff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="handoff" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="decision" target="branch_yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="decision" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
