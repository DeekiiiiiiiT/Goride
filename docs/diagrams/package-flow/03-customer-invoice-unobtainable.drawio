<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="unobtainable" name="Customer invoice unobtainable">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 3 — Customer invoice never arrives (unobtainable)&lt;/b&gt;&lt;br&gt;Warehouse flagged invoice required → Courier chased customer → no invoice → mark unobtainable → seal can continue&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blue = Warehouse app (/warehouse) · Amber = Courier app (/app)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend_w" value="WAREHOUSE APP&#xa;/warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend_c" value="COURIER APP&#xa;/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Same as “no slip” path:&#xa;no paperwork with box&#xa;Tracking: MY-SMOKE-001" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Receive Station&lt;br&gt;&lt;br&gt;Receive MY-SMOKE-001 as usual&lt;br&gt;(suite, weight, bin, declared USD)&lt;br&gt;&lt;br&gt;✓ Check &lt;b&gt;Invoice required from customer&lt;/b&gt;&lt;br&gt;✗ No warehouse packing slip uploaded&lt;br&gt;Submit inbound" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="360" height="160" as="geometry" />
        </mxCell>

        <mxCell id="w2" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound&lt;br&gt;&lt;br&gt;Confirm package listed + Invoice required = Yes&lt;br&gt;&lt;i&gt;Warehouse done.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="handoff" value="HANDOFF → Courier login" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="570" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Invoice Audit&lt;br&gt;&lt;br&gt;1. Find MY-SMOKE-001 under Required / Missing&lt;br&gt;2. Contact customer (email / WhatsApp / phone)&lt;br&gt;3. Wait a reasonable time — customer does not respond&lt;br&gt;   or cannot provide an invoice" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="360" height="140" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Can we get a&#xa;customer invoice?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="870" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="branch_yes" value="Yes → use Scenario 2&lt;br&gt;(upload + verify customer invoice)&lt;br&gt;Do NOT mark unobtainable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="880" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Invoice Audit or Package Duty&lt;br&gt;&lt;br&gt;1. Open MY-SMOKE-001&lt;br&gt;2. Mark &lt;b&gt;Could not get a customer invoice&lt;/b&gt; (unobtainable)&lt;br&gt;3. Enter a short note (e.g. “customer unreachable after 3 tries”)&lt;br&gt;4. Confirm / save&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;This is the intentional exception path so the box is not stuck forever.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1020" width="400" height="170" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Confirm queue status&lt;br&gt;&lt;br&gt;Invoice Audit → “Could not obtain” / ready-for-seal tab&lt;br&gt;Package should no longer block seal for missing verify" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1230" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Manifests / Manifest Builder&lt;br&gt;&lt;br&gt;1. Add MY-SMOKE-001&lt;br&gt;2. Clear remaining blockers (TRN, weight, declared USD)&lt;br&gt;3. Seal (allowed because unobtainable is recorded)&lt;br&gt;4. AWBOLDS → JCA stub → Shipped → Arrived JA" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1380" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Clearance → Hub Station → Fulfillment collected&lt;br&gt;(same Jamaica path as other scenarios)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1570" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;Unobtainable noted → sealed → collected&#xa;(no verified customer invoice on file)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="1700" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="warn" value="WARN — use sparingly&#xa;Unobtainable is for ops exception,&#xa;not a shortcut when customer&#xa;could still send the invoice." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEE2E2;strokeColor=#DC2626;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="1020" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="w1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w1" target="w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w2" target="handoff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="handoff" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="decision" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="decision" target="branch_yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c5" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
