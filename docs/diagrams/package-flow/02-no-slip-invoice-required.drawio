<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="no-slip" name="No slip with box — invoice required">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 2 — No slip / invoice came with the box&lt;/b&gt;&lt;br&gt;Warehouse flags “invoice required” → Courier chases customer → verify → seal → Jamaica path&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blue = Warehouse app (/warehouse) · Amber = Courier app (/app)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="780" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend_w" value="WAREHOUSE APP&#xa;/warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend_c" value="COURIER APP&#xa;/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Package arrives — NO packing slip&#xa;and NO invoice with the box&#xa;Tracking: MY-SMOKE-001" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound → Receive Station&lt;br&gt;&lt;br&gt;1. Choose warehouse facility&lt;br&gt;2. Choose suite (e.g. JA-SMOKE01)&lt;br&gt;3. Enter tracking MY-SMOKE-001&lt;br&gt;4. Enter weight (e.g. 3.2 lb)&lt;br&gt;5. Enter bin (e.g. B2-07)&lt;br&gt;6. Enter declared value USD (e.g. 45)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;Do NOT upload a warehouse packing slip&lt;/font&gt; — none came with the box" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="w2" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Receive Station — flag the gap&lt;br&gt;&lt;br&gt;✓ Check &lt;b&gt;Invoice required from customer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;This tells Courier ops: chase the real commercial invoice.&lt;/font&gt;&lt;br&gt;&lt;br&gt;Submit / scan inbound" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="480" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="w3" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound list&lt;br&gt;&lt;br&gt;Confirm MY-SMOKE-001 is listed&lt;br&gt;Confirm &lt;b&gt;Invoice required = Yes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Warehouse work for this box is done.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="660" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="handoff" value="HANDOFF → switch to Courier login&#xa;(same org, same package)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="820" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Packages&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001 — package is received at warehouse&#xa;even though paperwork was missing" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="960" width="380" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Invoice Audit&lt;br&gt;&lt;br&gt;1. Open tab for packages needing invoice&lt;br&gt;   (Required / Awaiting / Missing)&lt;br&gt;2. Find MY-SMOKE-001 flagged as invoice required&lt;br&gt;3. Contact customer outside the app if needed&lt;br&gt;4. When customer sends invoice → Upload &lt;b&gt;customer invoice&lt;/b&gt;&lt;br&gt;5. &lt;b&gt;Verify&lt;/b&gt; customer invoice" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1100" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Did the customer&#xa;send an invoice?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="1320" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_yes" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;YES — invoice verified&lt;br&gt;Continue happy path from seal onward" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1500" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c_no" value="&lt;b&gt;STOP — different scenario&lt;/b&gt;&lt;br&gt;If customer never sends invoice,&lt;br&gt;use the &lt;b&gt;unobtainable&lt;/b&gt; flow diagram&lt;br&gt;(do not leave package stuck forever)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1500" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt; (optional)&lt;br&gt;HS Tariffs / Package Duty / Billing — same as happy path" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1620" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Mailbox → Manifests / Manifest Builder&lt;br&gt;&lt;br&gt;Seal only after customer invoice is verified.&lt;br&gt;Then: AWBOLDS → JCA (stub OK) → Shipped → Arrived JA" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1730" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Clearance Board → Clear&lt;br&gt;Hub Station → sort / ready&lt;br&gt;Last Mile → Fulfillment → Mark collected" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1890" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;No slip at receive → flagged →&#xa;customer invoice verified → collected" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="2030" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Key difference from happy path:&#xa;• Warehouse does NOT upload a packing slip&#xa;• Warehouse MUST check “Invoice required”&#xa;• Courier owns chasing + verifying the customer invoice&#xa;• Seal still needs verified customer invoice (or separate unobtainable path)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF7ED;strokeColor=#FB923C;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="1100" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="w1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w1" target="w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w2" target="w3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w3" target="handoff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="handoff" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="decision" target="c_yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="decision" target="c_no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c_yes" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c5" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
