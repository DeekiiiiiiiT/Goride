<mxfile host="app.diagrams.net" agent="Roam" version="22.1.0" type="device">
  <diagram id="no-slip" name="No slip — invoice required chase">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="3100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scenario 2 — No packing slip → soft hold → Courier chases customer&lt;/b&gt;&lt;br&gt;Warehouse flags customer invoice required → customer sends invoice → verify → seal → Jamaica&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blue = Warehouse (/warehouse) · Amber = Courier (/app)&lt;br&gt;Soft hold = chase flag only (does not block receive or seal by itself). Seal still needs &lt;b&gt;verified customer invoice&lt;/b&gt;.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="85" as="geometry" />
        </mxCell>

        <mxCell id="legend_w" value="WAREHOUSE APP&#xa;/warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="30" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend_c" value="COURIER APP&#xa;/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START&#xa;Package arrives — NO packing slip&#xa;Tracking: MY-SMOKE-001" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;/warehouse → Receive Station&lt;br&gt;&lt;br&gt;1. Facility + suite&lt;br&gt;2. Scan MY-SMOKE-001&lt;br&gt;3. Open &lt;b&gt;Details&lt;/b&gt; → weight, declared USD, bin&lt;br&gt;4. &lt;font color=&quot;#B45309&quot;&gt;Do NOT upload packing slip&lt;/font&gt; (none with box)&lt;br&gt;5. ✓ Check &lt;b&gt;Customer invoice required (soft hold)&lt;/b&gt;&lt;br&gt;6. Confirm receipt" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="w2" value="&lt;b&gt;WAREHOUSE APP&lt;/b&gt;&lt;br&gt;Inbound&lt;br&gt;&lt;br&gt;Confirm MY-SMOKE-001 listed with soft hold / invoice required&lt;br&gt;&lt;i&gt;Warehouse done.&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Soft hold can be cleared anytime from Inbound or Package Duty — clearing alone does not verify seal.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="500" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="handoff" value="HANDOFF → Courier login" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="680" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Packages → Needs invoice&lt;br&gt;(/app/packages?tab=needs-invoice)&lt;br&gt;&lt;br&gt;Find MY-SMOKE-001 flagged for chase" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="810" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Open package → Invoice stage&lt;br&gt;&lt;br&gt;1. Contact customer outside the app&lt;br&gt;2. Customer sends commercial invoice&lt;br&gt;3. Upload &lt;b&gt;customer invoice&lt;/b&gt;&lt;br&gt;4. &lt;b&gt;Verify&lt;/b&gt; (clears soft hold + opens seal gate)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="960" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Did customer&#xa;send invoice?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="1150" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="yes" value="Yes → continue this scenario&#xa;(verified customer invoice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="1300" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="no" value="No → switch to Scenario 3&#xa;(Mark could not obtain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="1300" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Manifests → add package → Seal&#xa;(blockers: TRN, verified customer invoice, weight, declared USD)&#xa;AWBOLDS → JCA stub → Shipped → Arrived JA" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1420" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;COURIER APP&lt;/b&gt;&lt;br&gt;Customs → Clear&#xa;Hub Scan station → sort / ready&#xa;Fulfillment Desk or Scan → Mark collected" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="1580" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="end" value="DONE&#xa;Soft hold chase → verified invoice&#xa;→ Sealed → Cleared → Collected" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1740" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Smoke checklist&#xa;• Soft hold checked at receive&#xa;• Needs invoice queue shows package&#xa;• Verify clears soft hold&#xa;• Manifest seals only after verify&#xa;• Packing slip never required" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;align=left;spacingLeft=8;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="960" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="w2" target="handoff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="handoff" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="decision" target="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="decision" target="no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="yes" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
