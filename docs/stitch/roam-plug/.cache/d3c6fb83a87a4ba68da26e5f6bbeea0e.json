{"filename":"22-facility.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"surface-variant\": \"#e8e1db\", \"surface\": \"#fff8f2\", \"on-primary-container\": \"#fffbff\", \"on-primary-fixed\": \"#370e00\", \"background\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"primary\": \"#a33900\", \"on-secondary\": \"#ffffff\", \"secondary-container\": \"#fd761a\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-container\": \"#fffbff\", \"surface-container-lowest\": \"#ffffff\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"outline-variant\": \"#e2bfb2\", \"error\": \"#ba1a1a\", \"on-error-container\": \"#93000a\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"secondary-fixed-dim\": \"#ffb690\", \"secondary\": \"#9d4300\", \"error-container\": \"#ffdad6\", \"on-tertiary\": \"#ffffff\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"on-error\": \"#ffffff\", \"surface-container-low\": \"#faf2eb\", \"tertiary\": \"#755800\", \"on-secondary-fixed\": \"#341100\", \"surface-bright\": \"#fff8f2\", \"surface-container\": \"#f4ede6\", \"on-primary\": \"#ffffff\", \"primary-container\": \"#cc4900\", \"tertiary-container\": \"#936f00\", \"on-secondary-container\": \"#5c2400\", \"inverse-primary\": \"#ffb599\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-surface-variant\": \"#5a4138\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-secondary-fixed-variant\": \"#783200\", \"inverse-surface\": \"#33302c\", \"surface-container-highest\": \"#e8e1db\", \"primary-fixed-dim\": \"#ffb599\", \"surface-dim\": \"#e0d9d2\", \"surface-tint\": \"#a73a00\", \"on-background\": \"#1e1b17\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"gutter\": \"1rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"headline-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"body-md\": [\"Inter\"], \"label-lg\": [\"Inter\"] }, \"fontSize\": { \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Back\" class=\"w-12 h-12 flex items-center justify-center text-on-surface hover:text-primary rounded-full active:bg-surface-container transition-colors\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight line-clamp-1\">Gas Station Details</h1></div><div class=\"flex items-center\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full pt-16 bg-surface flex-1\"><div class=\"flex flex-col w-full pb-safe\">\n<!-- Interactive Feedback Banner Notification (Hidden by default) -->\n<div class=\"fixed top-20 left-4 right-4 z-50 transform -translate-y-24 opacity-0 transition-all duration-300 pointer-events-none bg-inverse-surface text-inverse-on-surface rounded-xl p-space-md shadow-xl flex items-center gap-space-sm\" id=\"toastNotification\">\n<span class=\"material-symbols-outlined text-secondary-fixed text-[24px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n<p class=\"font-body-md text-body-md font-semibold flex-1\" id=\"toastMessage\">Big up! Your confirmation keeps drivers moving.</p>\n</div>\n<!-- Hero & Verification Banner Block -->\n<div class=\"px-margin pt-space-md flex flex-col gap-space-md\">\n<!-- Verified Operator Banner (Moments of Delight & Trust) -->\n<div class=\"bg-surface-container-high rounded-xl p-space-md flex items-center justify-between shadow-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-primary text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Driver Verified</span>\n<p class=\"font-body-sm text-body-sm text-on-surface font-semibold\">Confirmed working 2 days ago by route operator Marcus T.</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[20px]\">local_taxi</span>\n</div>\n<!-- Facility Title Header Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"w-14 h-14 rounded-xl bg-secondary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-secondary-fixed text-[32px]\" style=\"font-variation-settings: 'FILL' 1;\">wc</span>\n</div>\n<div class=\"flex flex-col flex-1 min-w-0\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"bg-primary/10 text-primary font-label-sm text-label-sm px-2 py-0.5 rounded-full font-bold\">St. Andrew Parish</span>\n<span class=\"bg-surface-container text-on-surface-variant font-label-sm text-label-sm px-2 py-0.5 rounded-full\">Turnstile Entry</span>\n</div>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-1 leading-snug\">Restroom — Total Half-Way-Tree</h2>\n</div>\n</div>\n<div class=\"flex flex-col gap-1 mt-1\">\n<div class=\"flex items-center gap-space-xs text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[18px] shrink-0 text-primary\">pin_drop</span>\n<p class=\"font-body-md text-body-md font-medium text-on-surface\">Clock Tower Roundabout, Half-Way-Tree</p>\n</div>\n<!-- Plus Code with Copy Interaction -->\n<div class=\"flex items-center gap-space-sm mt-1\">\n<button class=\"flex items-center gap-1.5 bg-surface-container hover:bg-surface-container-high active:scale-95 transition-all px-3 py-1.5 rounded-lg w-fit\" id=\"copyPlusCodeBtn\" onclick=\"copyPlusCode()\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">tag</span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\" id=\"plusCodeText\">7GQM+2X Kingston</span>\n<span class=\"material-symbols-outlined text-[14px] text-outline ml-1\" id=\"copyIcon\">content_copy</span>\n</button>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Standalone Motorist Facility</span>\n</div>\n</div>\n</div>\n<!-- Direction Hero CTA Button (Large Glanceable Hit Target) -->\n<a class=\"h-14 w-full bg-primary active:bg-on-primary-fixed-variant text-on-primary rounded-xl font-headline-sm text-headline-sm font-bold flex items-center justify-center gap-space-sm shadow-md active:scale-[0.99] transition-all\" href=\"https://maps.google.com/?q=TotalEnergies+Half+Way+Tree+Clock+Tower\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-[24px]\">directions</span>\n<span>Get Directions Now</span>\n<span class=\"material-symbols-outlined text-[20px] opacity-80\">arrow_forward</span>\n</a>\n<!-- Fee Structure Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md uppercase tracking-wider text-on-surface-variant\">Required Entry Fee</span>\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">payments</span>\n</div>\n<div class=\"flex items-baseline gap-2\">\n<span class=\"font-display-lg-mobile text-display-lg-mobile font-extrabold text-primary\">J$100</span>\n<span class=\"font-body-md text-body-md text-on-surface-variant font-medium\">(pay attendant)</span>\n</div>\n<div class=\"mt-2 bg-surface-container-low rounded-lg p-space-sm flex items-start gap-space-sm\">\n<span class=\"material-symbols-outlined text-secondary text-[20px] shrink-0 mt-0.5\">account_circle</span>\n<p class=\"font-body-sm text-body-sm text-on-surface font-medium leading-relaxed\">\n          Attendant stationed at entry turnstile. Exact cash preferred, small coin change available.\n        </p>\n</div>\n</div>\n<!-- Facility Overview Bento Grid -->\n<div class=\"grid grid-cols-2 gap-space-md\">\n<!-- Hours Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between\">\n<div class=\"flex items-center justify-between\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\">schedule</span>\n<span class=\"bg-surface-container-high text-primary font-label-sm text-label-sm px-2 py-0.5 rounded-full font-bold\">Open Now</span>\n</div>\n<div class=\"mt-4\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Hours</span>\n<p class=\"font-body-md text-body-md font-bold text-on-surface mt-0.5\">Open Daily</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">6:00 AM – 10:00 PM</p>\n</div>\n</div>\n<!-- Accessibility Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between\">\n<div class=\"flex items-center justify-between\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">accessible</span>\n<span class=\"bg-surface-container-high text-primary font-label-sm text-label-sm px-2 py-0.5 rounded-full font-bold\">Step-Free</span>\n</div>\n<div class=\"mt-4\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Accessibility</span>\n<p class=\"font-body-md text-body-md font-bold text-on-surface mt-0.5\">Ramp &amp; Wide Door</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Ground-level access</p>\n</div>\n</div>\n</div>\n<!-- Verified Amenity Checklist Detail -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Cleanliness &amp; Provisioning</h3>\n<span class=\"font-label-sm text-label-sm text-primary font-bold\">5 of 5 Stocked</span>\n</div>\n<div class=\"grid grid-cols-1 gap-2.5 mt-1\">\n<div class=\"flex items-center justify-between py-1 bg-surface-container-low px-3 rounded-lg\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">water_drop</span>\n<span class=\"font-body-md text-body-md font-medium text-on-surface\">Pressurized Running Water</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n<div class=\"flex items-center justify-between py-1 bg-surface-container-low px-3 rounded-lg\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">soap</span>\n<span class=\"font-body-md text-body-md font-medium text-on-surface\">Refilled Soap Dispensers</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n<div class=\"flex items-center justify-between py-1 bg-surface-container-low px-3 rounded-lg\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">dry</span>\n<span class=\"font-body-md text-body-md font-medium text-on-surface\">Hand Paper Towels</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n<div class=\"flex items-center justify-between py-1 bg-surface-container-low px-3 rounded-lg\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">crop_portrait</span>\n<span class=\"font-body-md text-body-md font-medium text-on-surface\">Full-Length Wall Mirror</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n<div class=\"flex items-center justify-between py-1 bg-surface-container-low px-3 rounded-lg\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">door_sliding</span>\n<span class=\"font-body-md text-body-md font-medium text-on-surface\">Separate Male &amp; Female Stalls</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n</div>\n<!-- Visual Station Reference Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Roundabout Approach View</h3>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Station Perimeter</span>\n</div>\n<div class=\"relative w-full h-44 rounded-lg overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A sunny midday snapshot of the Half-Way-Tree clocktower roundabout in Kingston Jamaica with yellow taxicabs, public transit buses, palm trees, and the TotalEnergies service station clean turnstile facility entrance bathed in warm Caribbean sunlight.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDb0rvINPmB9vpWgI6hTK0O3aEiWpV_pP59RLOI67gdynjg5QtO-umBcHn0YAhKB9Ry-wj2YJq6MZDQPQJCQCcWWLbCSZ4HgE_Nr1cHOXDUv81gRMbIgG8l1roDoxxkyQ4zTIhUx7GyrqGp11cjvc1oUqaFKCkFeJd8N28JmEbhwNQcoY84Mtdz108_Jcnc2Fy_XSz47QifMzTAtgilcuIcuWQR8wpncOlVg-yC4d90qOZGTwdE_8NB\"/>\n<div class=\"absolute bottom-2 left-2 bg-surface/90 backdrop-blur-md px-2.5 py-1 rounded-md flex items-center gap-1.5 shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">visibility</span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\">Located behind convenience mart</span>\n</div>\n</div>\n</div>\n<!-- Community Crowdsourcing Verification Widget -->\n<div class=\"bg-surface-container-high rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\" id=\"crowdsourceWidget\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-9 h-9 rounded-full bg-secondary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-secondary-fixed text-[20px]\">live_help</span>\n</div>\n<div>\n<h4 class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-tight\">Still active today?</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Is this amenity open and working right now?</p>\n</div>\n</div>\n<!-- Action Response Buttons -->\n<div class=\"grid grid-cols-2 gap-space-sm mt-1\" id=\"verificationButtons\">\n<button class=\"h-12 bg-primary hover:bg-on-primary-fixed-variant active:scale-95 transition-all text-on-primary rounded-xl font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-sm\" onclick=\"handleVerification(true)\">\n<span class=\"material-symbols-outlined text-[20px]\">thumb_up</span>\n<span>Yes, it's here</span>\n</button>\n<button class=\"h-12 bg-surface-container-lowest hover:bg-surface-container active:scale-95 transition-all text-on-surface rounded-xl font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2\" onclick=\"handleVerification(false)\">\n<span class=\"material-symbols-outlined text-[20px] text-outline\">thumb_down</span>\n<span>No longer here</span>\n</button>\n</div>\n<div class=\"flex items-center gap-1.5 pt-1 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px] text-primary shrink-0\">volunteer_activism</span>\n<p class=\"font-body-sm text-body-sm leading-tight\">Driver verifications help keep Jamaican road pins reliable for everyone.</p>\n</div>\n</div>\n<!-- Secondary Utility Actions & Provenance -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm mb-4\">\n<div class=\"flex flex-col gap-2\">\n<button class=\"flex items-center justify-between py-2 text-left active:opacity-70 transition-opacity\" onclick=\"showQuickToast('Opening edit submission form...')\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-outline text-[20px]\">edit_note</span>\n<span class=\"font-body-md text-body-md font-semibold text-on-surface\">Suggest an edit to hours or setup</span>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[18px]\">chevron_right</span>\n</button>\n<button class=\"flex items-center justify-between py-2 text-left active:opacity-70 transition-opacity\" onclick=\"showQuickToast('Fee update window opened.')\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-outline text-[20px]\">price_change</span>\n<span class=\"font-body-md text-body-md font-semibold text-on-surface\">Report issue or rate adjustment</span>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[18px]\">chevron_right</span>\n</button>\n</div>\n<div class=\"bg-surface-container rounded-lg p-space-sm flex items-center gap-space-sm mt-1\">\n<span class=\"material-symbols-outlined text-primary text-[20px] shrink-0\">person_pin</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n          Facility pin added by Roam community member <span class=\"font-semibold text-on-surface\">Kemar W.</span>\n</p>\n</div>\n</div>\n</div>\n</div>\n<script>\n  function showQuickToast(msg) {\n    const toast = document.getElementById('toastNotification');\n    const label = document.getElementById('toastMessage');\n    if (!toast || !label) return;\n    label.textContent = msg;\n    toast.classList.remove('-translate-y-24', 'opacity-0');\n    toast.classList.add('translate-y-0', 'opacity-100');\n    setTimeout(() => {\n      toast.classList.add('-translate-y-24', 'opacity-0');\n      toast.classList.remove('translate-y-0', 'opacity-100');\n    }, 2800);\n  }\n\n  function copyPlusCode() {\n    const code = \"7GQM+2X Kingston\";\n    navigator.clipboard?.writeText(code).then(() => {\n      const copyIcon = document.getElementById('copyIcon');\n      if (copyIcon) copyIcon.textContent = \"check\";\n      showQuickToast('Plus Code copied! Ready for maps navigation.');\n      setTimeout(() => {\n        if (copyIcon) copyIcon.textContent = \"content_copy\";\n      }, 2000);\n    }).catch(() => {\n      showQuickToast('7GQM+2X Kingston ready.');\n    });\n  }\n\n  function handleVerification(isConfirmed) {\n    const widget = document.getElementById('crowdsourceWidget');\n    if (!widget) return;\n    if (isConfirmed) {\n      showQuickToast('Respect! Pin updated as active for road users today.');\n      widget.innerHTML = `\n        <div class=\"flex items-center gap-space-sm py-2\">\n          <span class=\"material-symbols-outlined text-primary text-[28px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n          <div>\n            <h4 class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Thank You!</h4>\n            <p class=\"font-body-sm text-body-sm text-on-surface-variant\">Your checkmark helps 250+ local Kingston taxi & private drivers today.</p>\n          </div>\n        </div>\n      `;\n    } else {\n      showQuickToast('Report recorded. Dispatched to local road verifiers.');\n      widget.innerHTML = `\n        <div class=\"flex items-center gap-space-sm py-2\">\n          <span class=\"material-symbols-outlined text-secondary text-[28px]\">report</span>\n          <div>\n            <h4 class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Under Review</h4>\n            <p class=\"font-body-sm text-body-sm text-on-surface-variant\">Thanks for flagging. We are checking turnstile operational hours.</p>\n          </div>\n        </div>\n      `;\n    }\n  }\n</script></main></body></html>"}