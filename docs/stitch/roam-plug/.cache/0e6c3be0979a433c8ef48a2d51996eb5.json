{"filename":"44-place-details.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; } body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back or close\" class=\"w-11 h-11 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">close</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Screen 44: Place Details</h1><span class=\"font-label-md text-label-md text-primary font-semibold truncate\">Map It • Crowd Contribution</span></div></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Help\" class=\"w-11 h-11 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high transition-colors\"><span class=\"material-symbols-outlined text-[20px]\">help_outline</span></button></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Progress Tracker -->\n<div class=\"w-full pt-2 pb-4\">\n<div class=\"flex items-center justify-between mb-2\">\n<span class=\"font-label-md text-label-md text-primary uppercase tracking-wider font-bold\">Step 3 of 3</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium\">Place Details</span>\n</div>\n<div class=\"w-full bg-surface-container-high h-2 rounded-full overflow-hidden flex\">\n<div class=\"bg-primary h-full w-full rounded-full transition-all duration-300\"></div>\n</div>\n</div>\n<!-- Header Location Preview Card -->\n<div class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm mb-space-md\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<div class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-md text-label-md\">\n<span>⛽</span>\n<span class=\"font-bold\">Gas Station</span>\n</div>\n<button class=\"font-label-md text-label-md text-primary font-bold hover:underline flex items-center gap-0.5\" type=\"button\">\n<span>Change</span>\n<span class=\"material-symbols-outlined text-[16px]\">edit</span>\n</button>\n</div>\n<div class=\"flex items-start gap-space-sm pt-1\">\n<span class=\"material-symbols-outlined text-primary text-[20px] mt-0.5 shrink-0\" style=\"font-variation-settings: 'FILL' 1;\">location_on</span>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">Constant Spring Rd, Half-Way-Tree</p>\n<div class=\"flex items-center gap-2 mt-0.5\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">St. Andrew Parish</span>\n<span class=\"inline-flex items-center gap-1 text-[11px] font-semibold text-tertiary bg-tertiary-fixed/60 px-2 py-0.5 rounded-full\">\n<span class=\"material-symbols-outlined text-[12px]\">gps_fixed</span>\n            ±8m accuracy\n          </span>\n</div>\n</div>\n</div>\n</div>\n<form class=\"flex flex-col gap-space-lg\" id=\"place-details-form\" onsubmit=\"event.preventDefault();\">\n<!-- Place Name -->\n<div class=\"flex flex-col gap-space-xs\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold flex items-center justify-between\" for=\"place-name\">\n<span>Place Name <span class=\"text-primary\">*</span></span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant font-normal\">Official or local name</span>\n</label>\n<div class=\"relative\">\n<input class=\"w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface font-body-lg text-body-lg shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors\" id=\"place-name\" placeholder=\"e.g. TotalEnergies Half-Way-Tree\" required=\"\" type=\"text\" value=\"TotalEnergies Half-Way-Tree\"/>\n<span class=\"material-symbols-outlined absolute right-3 top-3 text-secondary text-[22px]\">verified</span>\n</div>\n</div>\n<!-- Brand / Network Selection -->\n<div class=\"flex flex-col gap-space-xs\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold\">\n        Brand / Network <span class=\"text-primary\">*</span>\n</label>\n<div class=\"grid grid-cols-2 gap-2\" id=\"brand-selector\">\n<button class=\"brand-btn h-12 px-3 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"TotalEnergies\" type=\"button\">\n<span class=\"font-bold truncate\">TotalEnergies</span>\n<span class=\"material-symbols-outlined text-[18px]\">check_circle</span>\n</button>\n<button class=\"brand-btn h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"Rubis\" type=\"button\">\n<span class=\"font-medium truncate\">Rubis</span>\n<span class=\"material-symbols-outlined text-[18px] opacity-0\">check_circle</span>\n</button>\n<button class=\"brand-btn h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"Texaco\" type=\"button\">\n<span class=\"font-medium truncate\">Texaco</span>\n<span class=\"material-symbols-outlined text-[18px] opacity-0\">check_circle</span>\n</button>\n<button class=\"brand-btn h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"Fesco\" type=\"button\">\n<span class=\"font-medium truncate\">Fesco</span>\n<span class=\"material-symbols-outlined text-[18px] opacity-0\">check_circle</span>\n</button>\n<button class=\"brand-btn h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"Petcom\" type=\"button\">\n<span class=\"font-medium truncate\">Petcom</span>\n<span class=\"material-symbols-outlined text-[18px] opacity-0\">check_circle</span>\n</button>\n<button class=\"brand-btn h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"Unipet\" type=\"button\">\n<span class=\"font-medium truncate\">Unipet</span>\n<span class=\"material-symbols-outlined text-[18px] opacity-0\">check_circle</span>\n</button>\n<button class=\"brand-btn col-span-2 h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-lg text-label-lg flex items-center justify-between shadow-sm transition-transform active:scale-95 text-left\" data-brand=\"Independent\" type=\"button\">\n<span class=\"font-medium truncate\">Independent / Other Local Dealer</span>\n<span class=\"material-symbols-outlined text-[18px] opacity-0\">check_circle</span>\n</button>\n</div>\n</div>\n<!-- Services & Amenities -->\n<div class=\"flex flex-col gap-space-sm bg-surface-container-lowest p-space-md rounded-xl shadow-sm\">\n<div class=\"flex flex-col\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">What does this station have?</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Tap all fuels and motorist amenities available</p>\n</div>\n<!-- Fuel Grades Sub-group -->\n<div class=\"flex flex-col gap-2 pt-2\">\n<span class=\"font-label-md text-label-md text-primary font-bold uppercase tracking-wider\">Fuel Grades Dispensed</span>\n<div class=\"grid grid-cols-2 gap-2\" id=\"fuels-group\">\n<!-- E-10 87 -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-2 min-w-0\">\n<span class=\"w-3 h-3 rounded-full bg-primary shrink-0\"></span>\n<span class=\"font-label-md text-label-md text-on-surface font-bold truncate\">E-10 87</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- E-10 90 -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-2 min-w-0\">\n<span class=\"w-3 h-3 rounded-full bg-error shrink-0\"></span>\n<span class=\"font-label-md text-label-md text-on-surface font-bold truncate\">E-10 90</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- ULSD -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-2 min-w-0\">\n<span class=\"w-3 h-3 rounded-full bg-on-surface shrink-0\"></span>\n<span class=\"font-label-md text-label-md text-on-surface font-bold truncate\">ULSD Diesel</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- Auto-LPG -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container-low flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-2 min-w-0\">\n<span class=\"w-3 h-3 rounded-full bg-outline shrink-0\"></span>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium truncate\">Auto-LPG</span>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[20px] check-icon\">check_box_outline_blank</span>\n</label>\n</div>\n</div>\n<!-- Amenities Sub-group -->\n<div class=\"flex flex-col gap-2 pt-3\">\n<span class=\"font-label-md text-label-md text-primary font-bold uppercase tracking-wider\">Station Amenities</span>\n<div class=\"grid grid-cols-2 gap-2\" id=\"amenities-group\">\n<!-- Air Pump -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-1.5 min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">air</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold truncate\">Air Pump</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- Clean Restroom -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-1.5 min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">wc</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold truncate\">Restroom</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- Convenience Store -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-1.5 min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">storefront</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold truncate\">24/7 Store</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- Car Wash Bay -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container-low flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-1.5 min-w-0\">\n<span class=\"material-symbols-outlined text-outline text-[18px]\">local_car_wash</span>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium truncate\">Car Wash Bay</span>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[20px] check-icon\">check_box_outline_blank</span>\n</label>\n<!-- ATM / Cash Machine -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input checked=\"\" class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-1.5 min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">atm</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold truncate\">ATM / Cash</span>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] check-icon\" style=\"font-variation-settings: 'FILL' 1;\">check_box</span>\n</label>\n<!-- Tyre Pressure Gauge -->\n<label class=\"amenity-chip cursor-pointer h-12 px-3 rounded-lg bg-surface-container-low flex items-center justify-between transition-colors active:scale-95 select-none\">\n<input class=\"hidden\" type=\"checkbox\"/>\n<div class=\"flex items-center gap-1.5 min-w-0\">\n<span class=\"material-symbols-outlined text-outline text-[18px]\">speed</span>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium truncate\">Tyre Gauge</span>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[20px] check-icon\">check_box_outline_blank</span>\n</label>\n</div>\n</div>\n</div>\n<!-- Opening Hours -->\n<div class=\"flex flex-col gap-space-xs\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold\">Operating Hours</label>\n<div class=\"grid grid-cols-2 gap-2\" id=\"hours-selector\">\n<button class=\"hours-chip h-12 px-3 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold flex items-center justify-center gap-1.5 shadow-sm\" data-hours=\"247\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">schedule</span>\n<span>Open 24/7</span>\n</button>\n<button class=\"hours-chip h-12 px-2 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center justify-center gap-1 text-center shadow-sm\" data-hours=\"standard\" type=\"button\">\n<span>Day (6 AM - 10 PM)</span>\n</button>\n<button class=\"hours-chip h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center justify-center gap-1.5 shadow-sm\" data-hours=\"custom\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">tune</span>\n<span>Custom Hours</span>\n</button>\n<button class=\"hours-chip h-12 px-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center justify-center gap-1.5 shadow-sm\" data-hours=\"unknown\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">help_outline</span>\n<span>Not Sure</span>\n</button>\n</div>\n</div>\n<!-- Phone Number (Optional) -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold\" for=\"phone-number\">Phone Number</label>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Optional</span>\n</div>\n<div class=\"relative\">\n<div class=\"absolute left-3.5 top-3 flex items-center gap-1 text-on-surface-variant font-label-lg text-label-lg pointer-events-none\">\n<span>🇯🇲</span>\n<span class=\"font-bold text-on-surface\">+1 (876)</span>\n</div>\n<input class=\"w-full h-12 pl-28 pr-4 rounded-xl bg-surface-container-lowest text-on-surface font-body-lg text-body-lg shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors\" id=\"phone-number\" placeholder=\"926 - 4820\" type=\"tel\"/>\n</div>\n</div>\n<!-- Photo Upload Section -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold\">Photo of Station</label>\n<span class=\"font-label-sm text-label-sm font-bold text-secondary uppercase bg-secondary-fixed px-2 py-0.5 rounded-full\">Encouraged</span>\n</div>\n<!-- Motivational Badge -->\n<div class=\"flex items-center gap-2 p-space-sm bg-tertiary-fixed rounded-xl text-on-tertiary-fixed shadow-sm\">\n<span class=\"text-lg\">⚡</span>\n<span class=\"font-label-md text-label-md font-bold\">Photos get approved 3x faster by community scouts!</span>\n</div>\n<!-- Upload Drop / Action Area -->\n<button class=\"w-full h-24 rounded-xl bg-surface-container-low flex flex-col items-center justify-center gap-1 text-primary hover:bg-surface-container transition-colors shadow-sm active:scale-98\" type=\"button\">\n<div class=\"w-9 h-9 rounded-full bg-primary-fixed flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[22px]\">add_a_photo</span>\n</div>\n<span class=\"font-label-md text-label-md font-bold text-on-surface\">Snap station canopy or totem price board</span>\n</button>\n<!-- Attached Thumbnail Preview -->\n<div class=\"flex items-center justify-between p-2.5 bg-surface-container-lowest rounded-xl shadow-sm mt-1\">\n<div class=\"flex items-center gap-3 min-w-0\">\n<div class=\"w-14 h-14 rounded-lg overflow-hidden shrink-0 bg-surface-container-highest\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Close up photography of vibrant digital fuel pricing totem sign in Kingston Jamaica displaying glowing red and green LED numerals against bright sunny afternoon Caribbean sky\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCeoiVO77zHxYHCMLD9vlpY4QIp8cRPrPPCff2x7oPRB70uOgcpgDhz8avDYf7sge45K3c6kTPNn5Zcpc2g4PKoPMkwioVwaYI0i3C5TKF9XS-s_iz5A5PgEn0RvNB-heXDHn0uY-j03pa9UpoW8tQsteoi6aSGsWMDAuY-1O9-RAzCDx3siyc76DDFH3IT_dJRrZLPNElMeMuGUEJsLQIqVb2Nuva55y4sLJu0nM2qWD8K98gnozbi\"/>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-md text-label-md text-on-surface font-bold truncate\">totem_prices_hwt.jpg</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">1.8 MB • Ready to upload</span>\n</div>\n</div>\n<button aria-label=\"Remove photo\" class=\"w-10 h-10 rounded-full flex items-center justify-center text-error hover:bg-error-container/40 transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">delete</span>\n</button>\n</div>\n</div>\n<!-- Notes / Motorist Tip (Optional) -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold\" for=\"motorist-notes\">Notes / Motorist Tip</label>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Optional</span>\n</div>\n<textarea class=\"w-full p-3 rounded-xl bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors resize-none\" id=\"motorist-notes\" placeholder=\"e.g. Air pump is located behind the wash bay, accepts $100 coins or swipe debit card at cashier.\" rows=\"3\"></textarea>\n</div>\n<!-- Submission Area -->\n<div class=\"flex flex-col gap-space-xs pt-2\">\n<button class=\"w-full h-14 rounded-full bg-primary hover:bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all active:scale-95\" id=\"submit-btn\" type=\"submit\">\n<span>Submit for Review</span>\n<span class=\"material-symbols-outlined text-[22px]\">arrow_forward</span>\n</button>\n<div class=\"flex items-center justify-center gap-1.5 py-1 text-center\">\n<span class=\"material-symbols-outlined text-secondary text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">stars</span>\n<p class=\"font-label-md text-label-md text-on-surface-variant\">\n          Earn <span class=\"font-bold text-primary\">+25 Scout Points</span> upon moderation approval.\n        </p>\n</div>\n</div>\n</form>\n</div>\n<script>\n  // Brand Selector Switcher\n  const brandButtons = document.querySelectorAll('.brand-btn');\n  brandButtons.forEach(btn => {\n    btn.addEventListener('click', () => {\n      brandButtons.forEach(b => {\n        b.classList.remove('bg-primary', 'text-on-primary');\n        b.classList.add('bg-surface-container-lowest', 'text-on-surface');\n        const icon = b.querySelector('.material-symbols-outlined');\n        if (icon) icon.classList.add('opacity-0');\n        const span = b.querySelector('span:first-child');\n        if (span) span.classList.replace('font-bold', 'font-medium');\n      });\n      btn.classList.remove('bg-surface-container-lowest', 'text-on-surface');\n      btn.classList.add('bg-primary', 'text-on-primary');\n      const activeIcon = btn.querySelector('.material-symbols-outlined');\n      if (activeIcon) activeIcon.classList.remove('opacity-0');\n      const activeSpan = btn.querySelector('span:first-child');\n      if (activeSpan) activeSpan.classList.replace('font-medium', 'font-bold');\n    });\n  });\n\n  // Operating Hours Switcher\n  const hoursChips = document.querySelectorAll('.hours-chip');\n  hoursChips.forEach(chip => {\n    chip.addEventListener('click', () => {\n      hoursChips.forEach(c => {\n        c.classList.remove('bg-primary', 'text-on-primary');\n        c.classList.add('bg-surface-container-lowest', 'text-on-surface');\n        c.classList.replace('font-bold', 'font-medium');\n      });\n      chip.classList.remove('bg-surface-container-lowest', 'text-on-surface');\n      chip.classList.add('bg-primary', 'text-on-primary');\n      chip.classList.replace('font-medium', 'font-bold');\n    });\n  });\n\n  // Amenity and Fuel Checkbox Toggles\n  const amenityChips = document.querySelectorAll('.amenity-chip');\n  amenityChips.forEach(card => {\n    const checkbox = card.querySelector('input[type=\"checkbox\"]');\n    const icon = card.querySelector('.check-icon');\n    \n    card.addEventListener('click', (e) => {\n      e.preventDefault();\n      checkbox.checked = !checkbox.checked;\n      \n      if (checkbox.checked) {\n        card.classList.remove('bg-surface-container-low');\n        card.classList.add('bg-surface-container');\n        icon.textContent = 'check_box';\n        icon.classList.remove('text-outline');\n        icon.classList.add('text-primary');\n        icon.style.fontVariationSettings = \"'FILL' 1\";\n      } else {\n        card.classList.remove('bg-surface-container');\n        card.classList.add('bg-surface-container-low');\n        icon.textContent = 'check_box_outline_blank';\n        icon.classList.remove('text-primary');\n        icon.classList.add('text-outline');\n        icon.style.fontVariationSettings = \"'FILL' 0\";\n      }\n    });\n  });\n\n  // Interactive Submit Feedback\n  const submitBtn = document.getElementById('submit-btn');\n  submitBtn.addEventListener('click', () => {\n    submitBtn.innerHTML = `\n      <span class=\"material-symbols-outlined animate-spin text-[22px]\">progress_activity</span>\n      <span>Submitting Report...</span>\n    `;\n    setTimeout(() => {\n      submitBtn.classList.remove('bg-primary');\n      submitBtn.classList.add('bg-tertiary');\n      submitBtn.innerHTML = `\n        <span class=\"material-symbols-outlined text-[22px]\">done_all</span>\n        <span>Submitted! +25 Points</span>\n      `;\n    }, 900);\n  });\n</script></main></body></html>"}