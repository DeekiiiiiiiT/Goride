{"filename":"23-pending-place.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"surface-variant\": \"#e8e1db\", \"surface\": \"#fff8f2\", \"on-primary-container\": \"#fffbff\", \"on-primary-fixed\": \"#370e00\", \"background\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"primary\": \"#a33900\", \"on-secondary\": \"#ffffff\", \"secondary-container\": \"#fd761a\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-container\": \"#fffbff\", \"surface-container-lowest\": \"#ffffff\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"outline-variant\": \"#e2bfb2\", \"error\": \"#ba1a1a\", \"on-error-container\": \"#93000a\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"secondary-fixed-dim\": \"#ffb690\", \"secondary\": \"#9d4300\", \"error-container\": \"#ffdad6\", \"on-tertiary\": \"#ffffff\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"on-error\": \"#ffffff\", \"surface-container-low\": \"#faf2eb\", \"tertiary\": \"#755800\", \"on-secondary-fixed\": \"#341100\", \"surface-bright\": \"#fff8f2\", \"surface-container\": \"#f4ede6\", \"on-primary\": \"#ffffff\", \"primary-container\": \"#cc4900\", \"tertiary-container\": \"#936f00\", \"on-secondary-container\": \"#5c2400\", \"inverse-primary\": \"#ffb599\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-surface-variant\": \"#5a4138\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-secondary-fixed-variant\": \"#783200\", \"inverse-surface\": \"#33302c\", \"surface-container-highest\": \"#e8e1db\", \"primary-fixed-dim\": \"#ffb599\", \"surface-dim\": \"#e0d9d2\", \"surface-tint\": \"#a73a00\", \"on-background\": \"#1e1b17\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"gutter\": \"1rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"headline-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"body-md\": [\"Inter\"], \"label-lg\": [\"Inter\"] }, \"fontSize\": { \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Back\" class=\"w-12 h-12 flex items-center justify-center text-on-surface hover:text-primary rounded-full active:bg-surface-container transition-colors\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight line-clamp-1\">Traffic Hazard Report</h1></div><div class=\"flex items-center\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full pt-16 bg-surface flex-1\"><div class=\"flex flex-col w-full pb-safe\">\n<!-- Status Review Banner -->\n<div class=\"px-margin pt-space-md\">\n<div class=\"bg-surface-container-high rounded-xl p-space-md shadow-sm relative overflow-hidden\">\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-container/20 flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-secondary text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">hourglass_top</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-space-xs flex-wrap\">\n<span class=\"font-label-md text-label-md bg-secondary text-on-secondary px-2.5 py-0.5 rounded-full uppercase tracking-wider\">Under Review</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant flex items-center gap-0.5\">\n<span class=\"material-symbols-outlined text-[13px] text-primary\">schedule</span> 24–48 hrs est.\n            </span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface mt-1.5 font-semibold leading-snug\">\n            Pinned by You • Pending Community Approval\n          </p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">\n            The Roam team reviews every pin before it goes live to maintain verified road accuracy across all 14 parishes.\n          </p>\n</div>\n</div>\n</div>\n</div>\n<!-- Main Place Header & Snapshot -->\n<div class=\"px-margin mt-space-md\">\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex flex-col min-w-0\">\n<span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container font-label-md text-label-md text-on-surface-variant w-fit mb-2\">\n<span class=\"material-symbols-outlined text-[15px] text-primary\">tire_repair</span>\n            Tyre Shop &amp; Air Compressor\n          </span>\n<h2 class=\"font-headline-md text-headline-md text-on-surface leading-tight tracking-tight\">\n            Sammy's Tyre Repair &amp; Free Air Pump\n          </h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-1\">\n<span class=\"material-symbols-outlined text-[16px] text-outline\">location_on</span>\n            Dunrobin Ave (Opposite Dunrobin Plaza), St. Andrew\n          </p>\n</div>\n</div>\n<div class=\"flex items-center justify-between pt-2 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">event_available</span>\n          Oct 24, 2024 • 3:15 PM\n        </span>\n<span class=\"font-mono bg-surface-container px-2 py-0.5 rounded text-on-surface\">\n          18.0241° N, 76.7932° W\n        </span>\n</div>\n</div>\n</div>\n<!-- Map Preview with GPS Halo -->\n<div class=\"px-margin mt-space-md\">\n<div class=\"bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm flex flex-col\">\n<div class=\"relative w-full h-52 bg-surface-container\">\n<!-- Static stylized vector map background representation of Kingston corridor -->\n<svg class=\"w-full h-full object-cover\" fill=\"none\" viewbox=\"0 0 400 220\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect fill=\"#f4ede6\" height=\"220\" width=\"400\"></rect>\n<!-- Grid blocks -->\n<rect fill=\"#eee7e0\" height=\"50\" rx=\"4\" width=\"70\" x=\"20\" y=\"20\"></rect>\n<rect fill=\"#eee7e0\" height=\"55\" rx=\"4\" width=\"130\" x=\"110\" y=\"15\"></rect>\n<rect fill=\"#eee7e0\" height=\"50\" rx=\"4\" width=\"120\" x=\"260\" y=\"20\"></rect>\n<rect fill=\"#eee7e0\" height=\"110\" rx=\"4\" width=\"80\" x=\"20\" y=\"90\"></rect>\n<rect fill=\"#eee7e0\" height=\"90\" rx=\"4\" width=\"120\" x=\"120\" y=\"110\"></rect>\n<rect fill=\"#eee7e0\" height=\"110\" rx=\"4\" width=\"120\" x=\"260\" y=\"90\"></rect>\n<!-- Major Road: Dunrobin Avenue arterial line -->\n<path d=\"M-20 80 Q 180 80, 420 80\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"22\"></path>\n<path d=\"M-20 80 Q 180 80, 420 80\" stroke=\"#fd761a\" stroke-dasharray=\"8 6\" stroke-width=\"3\"></path>\n<!-- Cross Roads: Constant Spring junction feeder -->\n<path d=\"M105 -10 L 105 230\" stroke=\"#ffffff\" stroke-width=\"16\"></path>\n<path d=\"M250 -10 L 250 230\" stroke=\"#ffffff\" stroke-width=\"14\"></path>\n<!-- Label Dunrobin Ave -->\n<text fill=\"#8e7166\" font-family=\"sans-serif\" font-size=\"10\" font-weight=\"700\" letter-spacing=\"1\" x=\"130\" y=\"74\">DUNROBIN AVENUE</text>\n<text fill=\"#8e7166\" font-family=\"sans-serif\" font-size=\"9\" font-weight=\"600\" x=\"265\" y=\"130\">DUNROBIN PLAZA</text>\n</svg>\n<!-- Pulsating GPS Accuracy Halo & Marker Pin -->\n<div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n<div class=\"relative flex items-center justify-center\">\n<!-- Pulsing ring animation -->\n<div class=\"absolute w-28 h-28 rounded-full bg-secondary-container/25 animate-ping\"></div>\n<div class=\"absolute w-20 h-20 rounded-full bg-secondary-container/30\"></div>\n<!-- Custom map pin center marker -->\n<div class=\"relative z-10 w-11 h-11 bg-primary rounded-full shadow-lg flex items-center justify-center text-on-primary ring-4 ring-surface-container-lowest\">\n<span class=\"material-symbols-outlined text-[24px]\" style=\"font-variation-settings: 'FILL' 1;\">air</span>\n</div>\n<!-- Ground point shadow -->\n<div class=\"absolute -bottom-2 w-4 h-1.5 bg-on-surface/30 rounded-full blur-[1px]\"></div>\n</div>\n</div>\n<!-- Accuracy Floating Badge -->\n<div class=\"absolute top-3 left-3 bg-surface-container-lowest/95 backdrop-blur-sm rounded-full px-3 py-1 flex items-center gap-1.5 shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-green-600 animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface font-bold tracking-wide\">High Accuracy (±15m)</span>\n</div>\n<!-- Calibration Tag -->\n<div class=\"absolute bottom-3 right-3 bg-inverse-surface/85 backdrop-blur-sm text-inverse-on-surface rounded-full px-2.5 py-1 text-[11px] font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[13px] text-tertiary-fixed\">gps_fixed</span>\n          Calibrated on-site\n        </div>\n</div>\n<div class=\"p-space-md flex items-center justify-between text-on-surface\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">explore</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Kingston 10 • St. Andrew Parish Corridor</span>\n</div>\n<button class=\"font-label-md text-label-md text-primary font-bold active:opacity-70 flex items-center gap-0.5\" type=\"button\">\n          View Map <span class=\"material-symbols-outlined text-[16px]\">open_in_new</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Contributor Photo & On-the-Ground Notes -->\n<div class=\"px-margin mt-space-md grid grid-cols-1 gap-space-sm\">\n<!-- Photo Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">photo_camera</span>\n          Attached Verification Photo\n        </h3>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2 py-0.5 rounded\">1 Photo</span>\n</div>\n<div class=\"relative rounded-lg overflow-hidden h-44 bg-surface-container\">\n<img alt=\"Sammy's Tyre Repair shop front\" class=\"w-full h-full object-cover\" data-alt=\"A brightly lit Jamaican roadside vulcanizer tyre shop along Dunrobin Avenue Kingston, showing an industrial bright orange pneumatic tire compressor, neatly stacked commercial radial tires, a digital air pressure gauge mounted on painted concrete block wall under a clear sunny Caribbean sky with vivid warm tones.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuClHpyJLhXgsOMEvYBn-E4ZxcjaSFQaCflVyxjlzt-hc2fU5QNgmb8tiRZub4sNw5j0X9hYi39fe5ZHmdlR0oNGYOTJUdqEsrXK84dXtfXF_yeRpSZirxNVTu-LBYsLc8OMVAqlrQs3RiMEa1DwIqivAtp-VMPYwPDMDMvaS1gqJA2Db0p9n8Z4qDALSihljbMw0D2pvsWBikc5CM4XpIte_XzUWHUIkEE-2MNbT7suVULzjjyinXSn\"/>\n<div class=\"absolute bottom-2 left-2 bg-on-surface/80 backdrop-blur-sm px-2.5 py-1 rounded text-surface font-label-sm text-label-sm flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary-fixed\">verified</span>\n          Original capture • Dunrobin Ave\n        </div>\n</div>\n</div>\n<!-- Notes Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-1.5\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">comment</span>\n        Driver &amp; Operator Notes\n      </h3>\n<div class=\"bg-surface-container-low rounded-lg p-space-sm mt-1\">\n<p class=\"font-body-md text-body-md text-on-surface italic leading-relaxed\">\n          “24/7 vulcanizer with digital air gauge. J$100 tip appreciated for air, quick tire plugging for taxis.”\n        </p>\n</div>\n<div class=\"flex items-center gap-3 pt-1 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[15px] text-primary\">local_atm</span> Cash Tip Optional</span>\n<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[15px] text-primary\">schedule</span> Open 24/7</span>\n</div>\n</div>\n</div>\n<!-- What Happens Next Timeline Card -->\n<div class=\"px-margin mt-space-md\">\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between mb-space-md\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">linear_scale</span>\n          Verification Progress\n        </h3>\n<span class=\"font-label-sm text-label-sm font-bold text-secondary bg-secondary-fixed px-2 py-0.5 rounded-full\">Step 2 of 3</span>\n</div>\n<div class=\"flex flex-col gap-space-md relative\">\n<!-- Progress track vertical connector -->\n<div class=\"absolute left-[15px] top-4 bottom-4 w-0.5 bg-surface-variant\"></div>\n<!-- Step 1 (Completed) -->\n<div class=\"flex items-start gap-space-sm relative z-10\">\n<div class=\"w-8 h-8 rounded-full bg-green-700 text-white flex items-center justify-center shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[18px]\">check</span>\n</div>\n<div class=\"flex flex-col min-w-0 pt-0.5\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Automated Duplicate Check</span>\n<span class=\"font-body-sm text-body-sm text-green-800 font-semibold\">Passed • No existing pin within 250m</span>\n</div>\n</div>\n<!-- Step 2 (Active) -->\n<div class=\"flex items-start gap-space-sm relative z-10\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0 shadow-sm animate-pulse\">\n<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">hourglass_bottom</span>\n</div>\n<div class=\"flex flex-col min-w-0 pt-0.5\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">St. Andrew Parish Ambassador Review</span>\n<span class=\"font-body-sm text-body-sm text-secondary font-semibold\">In progress • Community taxi captain verifying 24/7 air pump</span>\n</div>\n</div>\n<!-- Step 3 (Pending) -->\n<div class=\"flex items-start gap-space-sm relative z-10\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container-high text-outline flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">stars</span>\n</div>\n<div class=\"flex flex-col min-w-0 pt-0.5\">\n<span class=\"font-label-lg text-label-lg text-on-surface-variant font-bold\">Island-wide Publication</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Live to all Roam Plug drivers • Earn +25 Community Points</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Contributor Actions / Controls -->\n<div class=\"px-margin mt-space-lg mb-space-xl flex flex-col gap-space-sm\">\n<button class=\"w-full h-12 bg-primary active:bg-on-primary-fixed-variant text-on-primary font-label-lg text-label-lg rounded-xl flex items-center justify-center gap-2 shadow-md transition-all active:scale-[0.99]\" id=\"editSubmissionBtn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">edit</span>\n      Edit Submission Details\n    </button>\n<button class=\"w-full h-12 bg-surface-container active:bg-surface-variant text-error font-label-lg text-label-lg rounded-xl flex items-center justify-center gap-2 transition-colors\" id=\"withdrawPinBtn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">delete_outline</span>\n      Withdraw Pin Submission\n    </button>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant text-center px-space-md pt-1\">\n      Notice: Edits made while under review will refresh your place in the verification queue.\n    </p>\n</div>\n<!-- Confirmation Modal for Withdrawing Pin (Client Micro-interaction) -->\n<div class=\"hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 backdrop-blur-xs p-margin\" id=\"withdrawModal\">\n<div class=\"bg-surface-container-lowest rounded-2xl w-full max-w-sm p-space-md flex flex-col gap-space-sm shadow-xl\">\n<div class=\"w-10 h-10 rounded-full bg-error-container text-error flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[24px]\">warning</span>\n</div>\n<h4 class=\"font-headline-sm text-headline-sm text-on-surface\">Withdraw this pin?</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n        This will cancel your verification request for \"Sammy's Tyre Repair\" and forfeit the pending +25 Community Points.\n      </p>\n<div class=\"flex gap-space-sm mt-space-sm\">\n<button class=\"flex-1 h-12 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md\" id=\"cancelModalBtn\" type=\"button\">\n          Keep Pin\n        </button>\n<button class=\"flex-1 h-12 rounded-xl bg-error text-on-error font-label-md text-label-md\" id=\"confirmWithdrawBtn\" type=\"button\">\n          Yes, Withdraw\n        </button>\n</div>\n</div>\n</div>\n</div>\n<script>\n  (function initPendingPinControls() {\n    const withdrawBtn = document.getElementById('withdrawPinBtn');\n    const modal = document.getElementById('withdrawModal');\n    const cancelBtn = document.getElementById('cancelModalBtn');\n    const confirmBtn = document.getElementById('confirmWithdrawBtn');\n    const editBtn = document.getElementById('editSubmissionBtn');\n\n    if (withdrawBtn && modal && cancelBtn) {\n      withdrawBtn.addEventListener('click', () => {\n        modal.classList.remove('hidden');\n      });\n\n      cancelBtn.addEventListener('click', () => {\n        modal.classList.add('hidden');\n      });\n\n      modal.addEventListener('click', (e) => {\n        if (e.target === modal) {\n          modal.classList.add('hidden');\n        }\n      });\n\n      confirmBtn?.addEventListener('click', () => {\n        modal.classList.add('hidden');\n        if (withdrawBtn) {\n          withdrawBtn.disabled = true;\n          withdrawBtn.textContent = 'Submission Withdrawn';\n          withdrawBtn.classList.replace('text-error', 'text-on-surface-variant');\n        }\n      });\n    }\n\n    if (editBtn) {\n      editBtn.addEventListener('click', () => {\n        // Feedback pulse micro-interaction\n        editBtn.classList.add('opacity-80');\n        setTimeout(() => editBtn.classList.remove('opacity-80'), 200);\n      });\n    }\n  })();\n</script></main></body></html>"}