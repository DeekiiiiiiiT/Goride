{"filename":"24-odometer-scan.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"error\": \"#ba1a1a\", \"error-container\": \"#ffdad6\", \"surface-bright\": \"#fff8f2\", \"primary-fixed-dim\": \"#ffb599\", \"surface-container-highest\": \"#e8e1db\", \"on-secondary-fixed\": \"#341100\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-container\": \"#936f00\", \"inverse-surface\": \"#33302c\", \"on-secondary-container\": \"#5c2400\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary\": \"#755800\", \"on-error-container\": \"#93000a\", \"on-tertiary\": \"#ffffff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface-container-lowest\": \"#ffffff\", \"background\": \"#fff8f2\", \"on-surface-variant\": \"#5a4138\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-low\": \"#faf2eb\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"outline\": \"#8e7166\", \"on-primary-container\": \"#fffbff\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container\": \"#f4ede6\", \"surface-variant\": \"#e8e1db\", \"on-primary-fixed\": \"#370e00\", \"on-secondary\": \"#ffffff\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary\": \"#9d4300\", \"surface-container-high\": \"#eee7e0\", \"primary-container\": \"#cc4900\", \"on-tertiary-container\": \"#fffbff\", \"primary\": \"#a33900\", \"on-background\": \"#1e1b17\", \"secondary-fixed\": \"#ffdbca\", \"outline-variant\": \"#e2bfb2\", \"surface\": \"#fff8f2\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"margin-lg\": \"1.5rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"margin\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"gutter\": \"1rem\" }, \"fontFamily\": { \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, \"fontSize\": { \"price-display\": [\"24px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</script><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen pt-safe pb-safe\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full relative select-none\">\n<!-- Viewfinder / Camera Viewport Canvas -->\n<div class=\"relative w-full overflow-hidden rounded-xl bg-inverse-surface min-h-[640px] flex flex-col justify-between p-margin shadow-xl\">\n<!-- Background Simulated Dashboard Cluster Image with subtle optical blur -->\n<div class=\"absolute inset-0 bg-cover bg-center filter blur-[1.5px] scale-105 opacity-80\" data-alt=\"Realistic close up view of a modern Japanese car dashboard instrument cluster backlit softly at dusk. The glowing orange and white digital LCD display shows numbers 84612 km next to an analog speedometer needle, bathed in warm sunset cabin light with deep cabin shadows.\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuATm8h_OUpQc1KGYczHzJ1GawSYEjrc50amyRGj-ei87KXaG-r-rdkxZAoHyEHY753u-gLAXg2pvFvcC7wtSBVd5Fh5cZGxq8XMR3o6TA1erxrZP_sDu2353lqa-EqHnvC8-J6GTUqVt4eeFe-esBOC6HRAmrC9YKqL-o0G4iDKKZM1wZrBbxcjfzZXuxUtcYwSU51kkhGzPePAOYixLvi8mVJMm50Zd3KsNbOU83RpnlIYP_paj9IZ');\">\n</div>\n<!-- Camera Ambient Dark Vignette & Gradient Overlays for High Legibility -->\n<div class=\"absolute inset-0 bg-gradient-to-b from-inverse-surface/90 via-transparent to-inverse-surface/95 pointer-events-none\"></div>\n<div class=\"absolute inset-0 bg-radial from-transparent via-inverse-surface/20 to-inverse-surface/80 pointer-events-none\"></div>\n<!-- TOP SECTION: Controls & Vehicle Selector -->\n<div class=\"relative z-20 flex flex-col items-center w-full space-y-space-sm pt-space-xs\">\n<!-- Top Action Bar (Close left, Flashlight right, Centered Pill) -->\n<div class=\"w-full flex items-center justify-between\">\n<!-- Close 'X' Button -->\n<button aria-label=\"Cancel scan\" class=\"w-12 h-12 rounded-full bg-inverse-surface/60 backdrop-blur-md flex items-center justify-center text-inverse-on-surface active:scale-95 transition-transform duration-150\" type=\"button\">\n<span class=\"material-symbols-outlined text-headline-sm\">close</span>\n</button>\n<!-- Prominent Vehicle Selector Pill Dropdown -->\n<div class=\"flex flex-col items-center\">\n<button class=\"flex items-center space-x-1.5 px-space-md py-1.5 rounded-full bg-inverse-surface/80 backdrop-blur-md shadow-md text-inverse-on-surface active:scale-95 transition-transform duration-150\" id=\"vehicle-dropdown-btn\" type=\"button\">\n<span class=\"material-symbols-outlined text-secondary-container\" style=\"font-variation-settings: 'FILL' 1;\">directions_car</span>\n<span class=\"font-label-lg text-label-lg tracking-tight\">2019 Toyota Roomy</span>\n<span class=\"material-symbols-outlined text-label-md text-surface-variant\">expand_more</span>\n</button>\n<!-- Last Known Reading Pill -->\n<div class=\"mt-1 px-2.5 py-0.5 rounded-full bg-inverse-surface/90 backdrop-blur-sm\">\n<span class=\"font-label-sm text-label-sm text-surface-variant uppercase tracking-wider\">Last: <strong class=\"text-inverse-on-surface\">84,210 km</strong></span>\n</div>\n</div>\n<!-- Quick Flashlight Toggle -->\n<button aria-label=\"Toggle dash torch\" class=\"w-12 h-12 rounded-full bg-inverse-surface/60 backdrop-blur-md flex items-center justify-center text-inverse-on-surface active:scale-95 transition-transform duration-150\" id=\"torch-toggle\" type=\"button\">\n<span class=\"material-symbols-outlined text-headline-sm\" id=\"torch-icon\">flash_on</span>\n</button>\n</div>\n</div>\n<!-- CENTER SECTION: Viewfinder Targeting Reticle -->\n<div class=\"relative z-20 w-full flex flex-col items-center justify-center my-auto px-space-xs\">\n<!-- Guidance Instruction Banner -->\n<div class=\"mb-3 px-space-md py-1.5 rounded-full bg-inverse-surface/80 backdrop-blur-md flex items-center space-x-1.5 shadow-sm\">\n<span class=\"material-symbols-outlined text-secondary-container text-body-md\" style=\"font-variation-settings: 'FILL' 1;\">crop_free</span>\n<span class=\"font-label-md text-label-md text-inverse-on-surface\">Line up odometer digits in box</span>\n</div>\n<!-- Viewfinder Scan Bounding Box -->\n<div class=\"relative w-full max-w-[320px] h-32 rounded-xl bg-inverse-surface/20 backdrop-blur-[1px] flex items-center justify-center overflow-hidden\">\n<!-- Glowing Sunset Corner Brackets -->\n<!-- Top Left -->\n<div class=\"absolute top-0 left-0 w-6 h-6 rounded-tl-lg border-t-[3px] border-l-[3px] border-secondary-container shadow-[0_0_12px_rgba(253,118,26,0.6)]\"></div>\n<!-- Top Right -->\n<div class=\"absolute top-0 right-0 w-6 h-6 rounded-tr-lg border-t-[3px] border-r-[3px] border-secondary-container shadow-[0_0_12px_rgba(253,118,26,0.6)]\"></div>\n<!-- Bottom Left -->\n<div class=\"absolute bottom-0 left-0 w-6 h-6 rounded-bl-lg border-b-[3px] border-l-[3px] border-secondary-container shadow-[0_0_12px_rgba(253,118,26,0.6)]\"></div>\n<!-- Bottom Right -->\n<div class=\"absolute bottom-0 right-0 w-6 h-6 rounded-br-lg border-b-[3px] border-r-[3px] border-secondary-container shadow-[0_0_12px_rgba(253,118,26,0.6)]\"></div>\n<!-- Animated Laser Scanning Line -->\n<div class=\"absolute inset-x-0 h-0.5 bg-gradient-to-r from-transparent via-secondary-container to-transparent opacity-75 shadow-[0_0_8px_rgba(253,118,26,0.8)] animate-pulse\"></div>\n<!-- Subtle Target Grid Overlay -->\n<div class=\"flex items-center space-x-2 px-space-md py-1 rounded bg-inverse-surface/70 backdrop-blur-sm\">\n<span class=\"font-label-sm text-label-sm text-secondary-fixed tracking-widest uppercase\">Auto-Detect</span>\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary-container animate-ping\"></span>\n</div>\n</div>\n<!-- Real-time Status Badge under scanner -->\n<div class=\"mt-3 flex items-center space-x-1.5\">\n<span class=\"material-symbols-outlined text-label-sm text-secondary-fixed\">wb_sunny</span>\n<span class=\"font-label-sm text-label-sm text-inverse-on-surface/90 font-medium\">HDR High-Glance Engine Active</span>\n</div>\n</div>\n<!-- BOTTOM CONTROLS SECTION -->\n<div class=\"relative z-20 w-full flex flex-col items-center space-y-space-md pb-space-xs\">\n<!-- Primary Shutter Row (Flanked by Gallery and Exposure/Lighting tools) -->\n<div class=\"w-full flex items-center justify-around max-w-[280px]\">\n<!-- Gallery / Upload Option -->\n<button aria-label=\"Upload from gallery\" class=\"w-12 h-12 rounded-full bg-inverse-surface/70 backdrop-blur-md flex items-center justify-center text-inverse-on-surface active:scale-90 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-headline-sm\">photo_library</span>\n</button>\n<!-- Big Shutter Button: Sunset Orange Ring + Tactile White Core -->\n<button aria-label=\"Capture Odometer Reading\" class=\"relative w-20 h-20 rounded-full p-1 bg-gradient-to-tr from-primary to-secondary-container shadow-[0_8px_20px_-4px_rgba(234,88,12,0.4)] flex items-center justify-center active:scale-95 transition-transform duration-100\" id=\"capture-shutter-btn\" type=\"button\">\n<div class=\"w-full h-full rounded-full bg-surface-container-lowest flex items-center justify-center\">\n<div class=\"w-14 h-14 rounded-full bg-gradient-to-tr from-primary to-secondary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-on-primary text-headline-md\">speed</span>\n</div>\n</div>\n</button>\n<!-- Secondary Flash Level Toggle -->\n<button aria-label=\"Torch brightness\" class=\"w-12 h-12 rounded-full bg-inverse-surface/70 backdrop-blur-md flex items-center justify-center text-inverse-on-surface active:scale-90 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-headline-sm\">highlight</span>\n</button>\n</div>\n<!-- Manual Fallback Entry Hook -->\n<button class=\"group flex items-center space-x-1 text-secondary-container active:opacity-80 py-1 px-2\" type=\"button\">\n<span class=\"font-label-lg text-label-lg underline underline-offset-4 decoration-secondary-container\">Type it instead</span>\n<span class=\"material-symbols-outlined text-body-md group-hover:translate-x-0.5 transition-transform\">chevron_right</span>\n</button>\n<!-- Bottom Helper / Trust Pill -->\n<div class=\"w-full max-w-sm px-space-md py-2 rounded-xl bg-inverse-surface/85 backdrop-blur-md flex items-center justify-center space-x-2 text-center\">\n<span class=\"material-symbols-outlined text-secondary-container text-body-md\" style=\"font-variation-settings: 'FILL' 1;\">auto_awesome</span>\n<span class=\"font-body-sm text-body-sm text-surface-container-high\">\n          AI reads digits in sunlight or dark dash clusters\n        </span>\n</div>\n</div>\n</div>\n</div>\n<script>\n  // Simple Micro-interaction: Shutter flash feedback and torch toggle state\n  const shutterBtn = document.getElementById('capture-shutter-btn');\n  const torchBtn = document.getElementById('torch-toggle');\n  const torchIcon = document.getElementById('torch-icon');\n\n  if (shutterBtn) {\n    shutterBtn.addEventListener('click', () => {\n      // Haptic flash micro-feedback\n      shutterBtn.classList.add('scale-90');\n      setTimeout(() => shutterBtn.classList.remove('scale-90'), 120);\n    });\n  }\n\n  if (torchBtn && torchIcon) {\n    let torchActive = false;\n    torchBtn.addEventListener('click', () => {\n      torchActive = !torchActive;\n      if (torchActive) {\n        torchBtn.classList.add('bg-secondary-container', 'text-on-secondary-container');\n        torchBtn.classList.remove('bg-inverse-surface/60', 'text-inverse-on-surface');\n        torchIcon.textContent = 'flash_on';\n      } else {\n        torchBtn.classList.remove('bg-secondary-container', 'text-on-secondary-container');\n        torchBtn.classList.add('bg-inverse-surface/60', 'text-inverse-on-surface');\n        torchIcon.textContent = 'flash_off';\n      }\n    });\n  }\n</script></main></body></html>"}