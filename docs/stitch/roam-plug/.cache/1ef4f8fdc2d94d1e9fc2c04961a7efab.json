{"filename":"42-choose-type.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; } body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back or close\" class=\"w-11 h-11 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">close</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Screen 42: Choose Place Type</h1><span class=\"font-label-md text-label-md text-primary font-semibold truncate\">Map It • Crowd Contribution</span></div></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Help\" class=\"w-11 h-11 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high transition-colors\"><span class=\"material-symbols-outlined text-[20px]\">help_outline</span></button></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-36\">\n<!-- Top Community Header & Context Banner -->\n<section class=\"flex flex-col gap-space-sm pt-space-xs\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm uppercase tracking-wider\">\n<span class=\"material-symbols-outlined text-[14px]\">public</span>\n        Community Mapping\n      </span>\n<span class=\"text-on-surface-variant font-label-sm text-label-sm\">• Step 1 of 3</span>\n</div>\n<div>\n<h2 class=\"font-headline-lg text-headline-lg text-on-surface\">What are you mapping?</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-0.5\">Pick the amenity to help Jamaican motorists find authentic road services.</p>\n</div>\n<!-- GPS Verified Guardrail Notice Card (No border, using tonal contrast & elevation) -->\n<div class=\"relative overflow-hidden rounded-xl bg-surface-container-high p-space-md shadow-sm\">\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">my_location</span>\n</div>\n<div class=\"flex flex-col min-w-0 pr-2\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Physical presence required</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-relaxed\">\n            You must be at the place to pin it. Roam Plug uses on-device GPS to verify genuine locations.\n          </p>\n</div>\n</div>\n<!-- Subtle warm ambient glow -->\n<div class=\"absolute -right-4 -bottom-4 w-20 h-20 rounded-full bg-primary/10 pointer-events-none blur-xl\"></div>\n</div>\n</section>\n<!-- Interactive Place Type Selector Grid -->\n<section class=\"mt-space-lg\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Select Category</span>\n<span class=\"font-label-sm text-label-sm text-primary font-semibold\">8 Available</span>\n</div>\n<div aria-label=\"Roadside place categories\" class=\"grid grid-cols-2 gap-space-sm\" id=\"categoryGrid\" role=\"radiogroup\">\n<!-- 1. Gas Station (Pre-selected default) -->\n<button aria-checked=\"true\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container-lowest shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Gas Station\" data-type=\"gas-station\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">local_gas_station</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-primary font-bold\">Gas Station</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface line-clamp-2 mt-0.5\">Petrol, diesel, kerosene &amp; pump services</span>\n</div>\n</button>\n<!-- 2. Auto Parts Store -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Auto Parts Store\" data-type=\"auto-parts\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">settings_suggest</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">Auto Parts</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Spares, filters, Japanese import stock</span>\n</div>\n</button>\n<!-- 3. Mechanic Shop -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Mechanic Shop\" data-type=\"mechanic\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">build</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">Mechanic</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Servicing, diagnostics, bay repairs</span>\n</div>\n</button>\n<!-- 4. Air Pump -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Air Pump\" data-type=\"air-pump\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">air</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">Air Pump</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Free or paid gauge tire inflation</span>\n</div>\n</button>\n<!-- 5. Restroom -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Restroom\" data-type=\"restroom\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">wc</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">Restroom</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Public, customer-only, depot stops</span>\n</div>\n</button>\n<!-- 6. Car Wash -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Car Wash\" data-type=\"car-wash\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">local_car_wash</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">Car Wash</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Hand wash, pressure detailing bay</span>\n</div>\n</button>\n<!-- 7. EV Charging -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"EV Charging\" data-type=\"ev-charging\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">electric_bolt</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">EV Charging</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Level 2 &amp; DC fast charging plugs</span>\n</div>\n</button>\n<!-- 8. Tyre Shop -->\n<button aria-checked=\"false\" class=\"category-card group relative text-left p-space-md rounded-xl bg-surface-container shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer flex flex-col justify-between min-h-[148px]\" data-title=\"Tyre Shop\" data-type=\"tyre-shop\" role=\"radio\" type=\"button\">\n<div class=\"selection-indicator hidden absolute top-3 right-3 w-6 h-6 rounded-full bg-primary text-on-primary items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<div class=\"icon-bubble w-12 h-12 rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center shadow-sm mb-space-sm transition-colors\">\n<span class=\"material-symbols-outlined text-[26px]\">tire_repair</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"card-title font-headline-sm text-headline-sm text-on-surface font-semibold\">Tyre Shop</span>\n<span class=\"card-desc font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-0.5\">Vulcanizing, patching, used tyres</span>\n</div>\n</button>\n</div>\n</section>\n<!-- Community Scout Tip -->\n<section class=\"mt-space-lg mb-space-md\">\n<div class=\"rounded-xl bg-surface-container-low p-space-md flex items-center gap-space-sm shadow-sm\">\n<div class=\"w-8 h-8 rounded-full bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">workspace_premium</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n        Mapping gives you <strong class=\"text-on-surface font-semibold\">+25 Roam Points</strong> once confirmed by 2 community members on route.\n      </p>\n</div>\n</section>\n<!-- Sticky Fixed Bottom Drawer / Action Bar -->\n<div class=\"fixed bottom-0 left-0 right-0 z-40 px-gutter pb-safe pt-space-sm bg-surface/95 backdrop-blur-md shadow-[0_-8px_24px_rgba(30,27,23,0.08)]\">\n<div class=\"max-w-md mx-auto flex flex-col gap-space-xs pb-space-sm\">\n<!-- Dynamic Selection Indicator -->\n<div class=\"flex items-center justify-between px-1\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"w-2 h-2 rounded-full bg-primary animate-pulse\"></span>\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Selected:</span>\n<span class=\"font-label-md text-label-md text-primary font-bold\" id=\"selectedLabel\">Gas Station</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">GPS Status: Ready</span>\n</div>\n<!-- Primary CTA Button -->\n<button class=\"w-full h-12 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-space-sm shadow-[0_8px_20px_-4px_rgba(234,88,12,0.3)] transition-all duration-150 active:scale-[0.98]\" id=\"continueBtn\" type=\"button\">\n<span>Continue to Pin Location</span>\n<span class=\"material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1\">arrow_forward</span>\n</button>\n</div>\n</div>\n</div>\n<script>\n  (function initCategorySelector() {\n    const cards = document.querySelectorAll('.category-card');\n    const selectedLabel = document.getElementById('selectedLabel');\n    const continueBtn = document.getElementById('continueBtn');\n\n    cards.forEach((card) => {\n      card.addEventListener('click', () => {\n        // Reset all cards to standard container appearance\n        cards.forEach((c) => {\n          c.setAttribute('aria-checked', 'false');\n          c.classList.remove('bg-surface-container-lowest', 'shadow-md');\n          c.classList.add('bg-surface-container', 'shadow-sm');\n\n          // Check indicator badge\n          const indicator = c.querySelector('.selection-indicator');\n          if (indicator) {\n            indicator.classList.add('hidden');\n            indicator.classList.remove('flex');\n          }\n\n          // Icon container\n          const iconBubble = c.querySelector('.icon-bubble');\n          if (iconBubble) {\n            iconBubble.classList.remove('bg-primary', 'text-on-primary');\n            iconBubble.classList.add('bg-surface-container-highest', 'text-on-surface-variant');\n          }\n\n          // Text colors\n          const title = c.querySelector('.card-title');\n          if (title) {\n            title.classList.remove('text-primary', 'font-bold');\n            title.classList.add('text-on-surface', 'font-semibold');\n          }\n\n          const desc = c.querySelector('.card-desc');\n          if (desc) {\n            desc.classList.remove('text-on-surface');\n            desc.classList.add('text-on-surface-variant');\n          }\n        });\n\n        // Set clicked card to active state\n        card.setAttribute('aria-checked', 'true');\n        card.classList.remove('bg-surface-container', 'shadow-sm');\n        card.classList.add('bg-surface-container-lowest', 'shadow-md');\n\n        const activeIndicator = card.querySelector('.selection-indicator');\n        if (activeIndicator) {\n          activeIndicator.classList.remove('hidden');\n          activeIndicator.classList.add('flex');\n        }\n\n        const activeIconBubble = card.querySelector('.icon-bubble');\n        if (activeIconBubble) {\n          activeIconBubble.classList.remove('bg-surface-container-highest', 'text-on-surface-variant');\n          activeIconBubble.classList.add('bg-primary', 'text-on-primary');\n        }\n\n        const activeTitle = card.querySelector('.card-title');\n        if (activeTitle) {\n          activeTitle.classList.remove('text-on-surface', 'font-semibold');\n          activeTitle.classList.add('text-primary', 'font-bold');\n        }\n\n        const activeDesc = card.querySelector('.card-desc');\n        if (activeDesc) {\n          activeDesc.classList.remove('text-on-surface-variant');\n          activeDesc.classList.add('text-on-surface');\n        }\n\n        // Update bottom indicator label\n        const placeName = card.getAttribute('data-title') || 'Place';\n        if (selectedLabel) {\n          selectedLabel.textContent = placeName;\n        }\n      });\n    });\n\n    if (continueBtn) {\n      continueBtn.addEventListener('click', () => {\n        const activeCard = document.querySelector('.category-card[aria-checked=\"true\"]');\n        const placeName = activeCard ? activeCard.getAttribute('data-title') : 'Gas Station';\n        \n        // Haptic feedback if available\n        if (navigator.vibrate) {\n          navigator.vibrate(30);\n        }\n      });\n    }\n  })();\n</script></main></body></html>"}