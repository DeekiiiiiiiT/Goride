{"filename":"26-fuel-details.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"surface-variant\": \"#e8e1db\", \"surface\": \"#fff8f2\", \"on-primary-container\": \"#fffbff\", \"on-primary-fixed\": \"#370e00\", \"background\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"primary\": \"#a33900\", \"on-secondary\": \"#ffffff\", \"secondary-container\": \"#fd761a\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-container\": \"#fffbff\", \"surface-container-lowest\": \"#ffffff\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"outline-variant\": \"#e2bfb2\", \"error\": \"#ba1a1a\", \"on-error-container\": \"#93000a\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"secondary-fixed-dim\": \"#ffb690\", \"secondary\": \"#9d4300\", \"error-container\": \"#ffdad6\", \"on-tertiary\": \"#ffffff\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"on-error\": \"#ffffff\", \"surface-container-low\": \"#faf2eb\", \"tertiary\": \"#755800\", \"on-secondary-fixed\": \"#341100\", \"surface-bright\": \"#fff8f2\", \"surface-container\": \"#f4ede6\", \"on-primary\": \"#ffffff\", \"primary-container\": \"#cc4900\", \"tertiary-container\": \"#936f00\", \"on-secondary-container\": \"#5c2400\", \"inverse-primary\": \"#ffb599\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-surface-variant\": \"#5a4138\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-secondary-fixed-variant\": \"#783200\", \"inverse-surface\": \"#33302c\", \"surface-container-highest\": \"#e8e1db\", \"primary-fixed-dim\": \"#ffb599\", \"surface-dim\": \"#e0d9d2\", \"surface-tint\": \"#a73a00\", \"on-background\": \"#1e1b17\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"gutter\": \"1rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"headline-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"body-md\": [\"Inter\"], \"label-lg\": [\"Inter\"] }, \"fontSize\": { \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }] } } } };</script><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Back\" class=\"w-11 h-11 min-h-[44px] min-w-[44px] flex items-center justify-center text-on-surface hover:text-primary rounded-full active:bg-surface-container transition-colors\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight line-clamp-1\">Log Fuel   Step 2 Fuel Details</h1></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Cancel or Close\" class=\"w-11 h-11 min-h-[44px] min-w-[44px] rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[22px]\">close</span></button></div></div></header><main class=\"flex flex-col relative w-full pt-16 bg-surface flex-1\"><div class=\"flex flex-col w-full pb-safe\">\n<!-- Progress / Step Context Banner -->\n<div class=\"px-margin pt-space-sm pb-space-xs flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"w-6 h-6 rounded-full bg-primary text-on-primary font-label-sm text-label-sm flex items-center justify-center\">2</span>\n<span class=\"font-label-lg text-label-lg text-on-surface\">Fuel &amp; Volume Details</span>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium\">Final Step</span>\n</div>\n<div class=\"px-margin flex gap-space-xs my-space-xs\">\n<div class=\"h-1.5 flex-1 rounded-full bg-primary\"></div>\n<div class=\"h-1.5 flex-1 rounded-full bg-primary\"></div>\n<div class=\"h-1.5 flex-1 rounded-full bg-surface-container-high\"></div>\n</div>\n<div class=\"px-margin py-space-sm flex flex-col gap-space-md\">\n<!-- Station Detection Card Container with Interactive Toggle -->\n<div class=\"flex flex-col gap-space-xs\">\n<!-- State 1: Verified GPS Station Detected -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm transition-all duration-200\" id=\"verified-station-card\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-start gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-xl bg-primary-fixed flex items-center justify-center shrink-0 text-primary\">\n<span class=\"material-symbols-outlined text-[24px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n</div>\n<div class=\"min-w-0 flex flex-col\">\n<div class=\"flex items-center gap-space-xs flex-wrap\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant\">GPS Match</span>\n<span class=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-green-100 text-green-800 font-label-sm text-label-sm font-semibold\">\n<span class=\"material-symbols-outlined text-[14px]\">verified</span>\n                  Verified Station\n                </span>\n</div>\n<p class=\"font-headline-sm text-headline-sm text-on-surface truncate mt-0.5\">Texaco Barbican</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[15px] text-primary\">location_on</span>\n                St. Andrew • Barbican Sq.\n              </p>\n</div>\n</div>\n<button class=\"px-3 py-2 min-h-[44px] min-w-[44px] rounded-lg bg-surface-container hover:bg-surface-container-high text-primary font-label-lg text-label-lg font-bold shrink-0 transition-colors\" id=\"toggle-station-btn\" type=\"button\">\n            Change\n          </button>\n</div>\n</div>\n<!-- State 2: Crowdsourced / Unlisted Station Mode (Click 'Change' to cycle) -->\n<div class=\"hidden bg-surface-container-low rounded-xl p-space-md shadow-sm transition-all duration-200\" id=\"unverified-station-card\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-start gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-xl bg-surface-container-highest flex items-center justify-center shrink-0 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[24px]\">add_location_alt</span>\n</div>\n<div class=\"min-w-0 flex flex-col\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-variant text-on-surface-variant font-label-sm text-label-sm font-semibold\">\n<span class=\"material-symbols-outlined text-[13px]\">group_work</span>\n                  Community Discovery\n                </span>\n</div>\n<p class=\"font-headline-sm text-headline-sm text-on-surface mt-0.5\">New station detected</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n                We'll pin this spot for island community review across Kingston &amp; St. Andrew.\n              </p>\n</div>\n</div>\n<button class=\"px-3 py-2 min-h-[44px] min-w-[44px] rounded-lg bg-surface-container-highest text-primary font-label-lg text-label-lg font-bold shrink-0\" id=\"reset-station-btn\" type=\"button\">\n            Reset\n          </button>\n</div>\n</div>\n</div>\n<!-- Fuel Grade Selector -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg font-bold text-on-surface\">Fuel Grade</label>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Jamaican standard specs</span>\n</div>\n<div class=\"grid grid-cols-3 gap-space-xs\" id=\"grade-selector\">\n<!-- E-10 87 (Selected by default) -->\n<button class=\"grade-pill flex flex-col items-center justify-between p-space-sm rounded-xl min-h-[64px] bg-secondary text-on-secondary shadow-md transition-all active:scale-95 text-left\" data-grade=\"87\" type=\"button\">\n<div class=\"w-full flex items-center justify-between\">\n<span class=\"w-6 h-6 rounded-full bg-green-600 text-white font-label-sm text-label-sm flex items-center justify-center font-bold\">87</span>\n<span class=\"material-symbols-outlined text-[18px] grade-check\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n<div class=\"w-full mt-2\">\n<span class=\"font-label-lg text-label-lg block leading-tight font-bold\">E-10 87</span>\n<span class=\"font-label-sm text-label-sm opacity-90 block\">Regular</span>\n</div>\n</button>\n<!-- E-10 90 -->\n<button class=\"grade-pill flex flex-col items-center justify-between p-space-sm rounded-xl min-h-[64px] bg-surface-container-lowest text-on-surface shadow-sm transition-all active:scale-95 text-left\" data-grade=\"90\" type=\"button\">\n<div class=\"w-full flex items-center justify-between\">\n<span class=\"w-6 h-6 rounded-full bg-red-600 text-white font-label-sm text-label-sm flex items-center justify-center font-bold\">90</span>\n<span class=\"material-symbols-outlined text-[18px] grade-check opacity-0\">check_circle</span>\n</div>\n<div class=\"w-full mt-2\">\n<span class=\"font-label-lg text-label-lg block leading-tight font-bold\">E-10 90</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant block\">Super Premium</span>\n</div>\n</button>\n<!-- Diesel (ULSD) -->\n<button class=\"grade-pill flex flex-col items-center justify-between p-space-sm rounded-xl min-h-[64px] bg-surface-container-lowest text-on-surface shadow-sm transition-all active:scale-95 text-left\" data-grade=\"ulsd\" type=\"button\">\n<div class=\"w-full flex items-center justify-between\">\n<span class=\"w-6 h-6 rounded-full bg-stone-900 text-white font-label-sm text-label-sm flex items-center justify-center font-bold\">D</span>\n<span class=\"material-symbols-outlined text-[18px] grade-check opacity-0\">check_circle</span>\n</div>\n<div class=\"w-full mt-2\">\n<span class=\"font-label-lg text-label-lg block leading-tight font-bold\">ULSD</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant block\">Ultra Low S.</span>\n</div>\n</button>\n</div>\n</div>\n<!-- Volume & Expenditure Calculator Bento -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-md\">\n<div class=\"grid grid-cols-2 gap-space-md\">\n<!-- Amount Paid -->\n<div class=\"flex flex-col gap-1 min-w-0\">\n<label class=\"font-label-md text-label-md text-on-surface-variant font-medium flex items-center gap-1\" for=\"amount-input\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">payments</span>\n            Amount Paid\n          </label>\n<div class=\"bg-surface-container-low rounded-xl px-space-sm py-2.5 flex items-center focus-within:bg-surface-container-high transition-colors min-h-[48px]\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-primary mr-1 select-none\">J$</span>\n<input class=\"w-full bg-transparent font-price-display text-price-display text-on-surface focus:outline-none tracking-tight font-bold\" id=\"amount-input\" inputmode=\"decimal\" step=\"10\" type=\"number\" value=\"4290\"/>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant pl-1\">Pump total with GCT</span>\n</div>\n<!-- Litres Dispensed -->\n<div class=\"flex flex-col gap-1 min-w-0\">\n<label class=\"font-label-md text-label-md text-on-surface-variant font-medium flex items-center gap-1\" for=\"litres-input\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\">water_drop</span>\n            Volume\n          </label>\n<div class=\"bg-surface-container-low rounded-xl px-space-sm py-2.5 flex items-center focus-within:bg-surface-container-high transition-colors min-h-[48px]\">\n<input class=\"w-full bg-transparent font-price-display text-price-display text-on-surface focus:outline-none tracking-tight font-bold text-right pr-1\" id=\"litres-input\" inputmode=\"decimal\" step=\"0.01\" type=\"number\" value=\"20.00\"/>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface-variant select-none\">L</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant text-right pr-1\">Total dispensed</span>\n</div>\n</div>\n<!-- Live Calculation Pill -->\n<div class=\"bg-secondary-fixed/50 rounded-xl p-space-sm flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<div class=\"w-8 h-8 rounded-lg bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">calculate</span>\n</div>\n<div>\n<span class=\"font-label-sm text-label-sm text-on-secondary-container font-semibold uppercase tracking-wider block\">Computed Rate</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant block\" id=\"rate-formula\">J$4,290 ÷ 20.00 L</span>\n</div>\n</div>\n<div class=\"text-right\">\n<div class=\"font-headline-sm text-headline-sm font-bold text-secondary\" id=\"rate-display\">J$214.50 / L</div>\n<span class=\"font-label-sm text-label-sm text-green-700 font-semibold block\">• Competitive vs Barbican Avg</span>\n</div>\n</div>\n</div>\n<!-- Tank Full Toggle & Efficiency Helper -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">speed</span>\n</div>\n<div>\n<label class=\"font-headline-sm text-headline-sm text-on-surface block leading-tight cursor-pointer\" for=\"tank-toggle\">Filled the tank</label>\n<span class=\"font-label-sm text-label-sm text-secondary font-semibold uppercase tracking-wide\">High accuracy log</span>\n</div>\n</div>\n<!-- Custom Accessible Switch -->\n<label class=\"relative inline-flex items-center cursor-pointer min-h-[48px] min-w-[48px] justify-center\">\n<input checked=\"\" class=\"sr-only peer\" id=\"tank-toggle\" type=\"checkbox\"/>\n<div class=\"w-12 h-7 bg-surface-container-highest peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[12px] after:left-[4px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary\"></div>\n</label>\n</div>\n<div class=\"bg-surface-container-low rounded-lg p-space-sm flex items-start gap-space-xs mt-1\">\n<span class=\"material-symbols-outlined text-[18px] text-tertiary shrink-0 mt-0.5\">tips_and_updates</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-snug\">\n          Helps Roam Plug calculate exact <strong class=\"text-on-surface\">km/L efficiency</strong> for your Roomy across Kingston stop-and-go climbs.\n        </p>\n</div>\n</div>\n<!-- Date, Time, and Odometer Quick Meta -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs text-on-surface\">\n<span class=\"material-symbols-outlined text-[20px] text-on-surface-variant\">calendar_today</span>\n<span class=\"font-label-lg text-label-lg font-bold\">Fill Timestamp</span>\n</div>\n<button class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high min-h-[44px] transition-colors\" type=\"button\">\n<span class=\"font-label-md text-label-md font-bold text-primary\">Today, 3:45 PM</span>\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">edit</span>\n</button>\n</div>\n<!-- Receipt Attachment Action -->\n<div class=\"pt-space-xs\">\n<label class=\"font-label-md text-label-md text-on-surface-variant mb-1.5 block\">Receipt Verification (Optional)</label>\n<div class=\"bg-surface-container-low hover:bg-surface-container rounded-xl p-space-md cursor-pointer transition-colors flex items-center justify-between\" id=\"receipt-upload-box\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[22px]\">receipt_long</span>\n</div>\n<div>\n<p class=\"font-label-lg text-label-lg font-bold text-on-surface\">Snap Pump Slip</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Auto-verifies your entry on the Plug leaderboard</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[22px] text-primary\">add_a_photo</span>\n</div>\n</div>\n</div>\n<!-- Bottom Action Area -->\n<div class=\"pt-space-xs pb-space-lg flex flex-col gap-space-xs\">\n<button class=\"w-full min-h-[48px] py-3.5 px-space-lg rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm font-bold shadow-md hover:bg-primary-container active:scale-[0.99] transition-all flex items-center justify-center gap-space-xs\" id=\"save-log-btn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">save</span>\n<span>Save Fuel Log</span>\n</button>\n<p class=\"font-label-sm text-label-sm text-center text-on-surface-variant\">\n        Logged data contributes to islandwide real-time fuel tracking • Jamaica Road Safety Compliant\n      </p>\n</div>\n</div>\n</div>\n<script>\n  (function initFuelLogStep2() {\n    // Dynamic rate calculation\n    const amountInput = document.getElementById('amount-input');\n    const litresInput = document.getElementById('litres-input');\n    const rateDisplay = document.getElementById('rate-display');\n    const rateFormula = document.getElementById('rate-formula');\n\n    function calculateRate() {\n      const amount = parseFloat(amountInput.value) || 0;\n      const litres = parseFloat(litresInput.value) || 0;\n\n      if (litres > 0) {\n        const perLitre = (amount / litres).toFixed(2);\n        rateDisplay.textContent = 'J$' + perLitre + ' / L';\n        rateFormula.innerHTML = 'J$' + amount.toLocaleString() + ' &divide; ' + litres.toFixed(2) + ' L';\n      } else {\n        rateDisplay.textContent = 'J$0.00 / L';\n        rateFormula.textContent = 'Enter volume';\n      }\n    }\n\n    amountInput.addEventListener('input', calculateRate);\n    litresInput.addEventListener('input', calculateRate);\n\n    // Fuel Grade Chips Switching\n    const gradeButtons = document.querySelectorAll('.grade-pill');\n    gradeButtons.forEach((btn) => {\n      btn.addEventListener('click', () => {\n        gradeButtons.forEach((b) => {\n          b.className = 'grade-pill flex flex-col items-center justify-between p-space-sm rounded-xl min-h-[64px] bg-surface-container-lowest text-on-surface shadow-sm transition-all active:scale-95 text-left';\n          const check = b.querySelector('.grade-check');\n          if (check) check.classList.add('opacity-0');\n        });\n\n        btn.className = 'grade-pill flex flex-col items-center justify-between p-space-sm rounded-xl min-h-[64px] bg-secondary text-on-secondary shadow-md transition-all active:scale-95 text-left';\n        const activeCheck = btn.querySelector('.grade-check');\n        if (activeCheck) activeCheck.classList.remove('opacity-0');\n      });\n    });\n\n    // Station State Switch preview toggle\n    const verifiedCard = document.getElementById('verified-station-card');\n    const unverifiedCard = document.getElementById('unverified-station-card');\n    const toggleBtn = document.getElementById('toggle-station-btn');\n    const resetBtn = document.getElementById('reset-station-btn');\n\n    if (toggleBtn && resetBtn) {\n      toggleBtn.addEventListener('click', () => {\n        verifiedCard.classList.add('hidden');\n        unverifiedCard.classList.remove('hidden');\n      });\n      resetBtn.addEventListener('click', () => {\n        unverifiedCard.classList.add('hidden');\n        verifiedCard.classList.remove('hidden');\n      });\n    }\n\n    // Receipt upload simulation\n    const receiptBox = document.getElementById('receipt-upload-box');\n    if (receiptBox) {\n      receiptBox.addEventListener('click', () => {\n        receiptBox.classList.add('bg-secondary-fixed/40');\n        const textLabel = receiptBox.querySelector('p');\n        if (textLabel) textLabel.textContent = 'slip_barbican_feb24.jpg attached';\n      });\n    }\n  })();\n</script></main></body></html>"}