{"filename":"43-place-pin.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/>\n<meta content=\"mobile_blank\" name=\"shell-type\"/>\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          colors: {\n            \"error\": \"#ba1a1a\",\n            \"error-container\": \"#ffdad6\",\n            \"surface-bright\": \"#fff8f2\",\n            \"primary-fixed-dim\": \"#ffb599\",\n            \"surface-container-highest\": \"#e8e1db\",\n            \"on-secondary-fixed\": \"#341100\",\n            \"primary-fixed\": \"#ffdbce\",\n            \"inverse-on-surface\": \"#f7efe9\",\n            \"tertiary-container\": \"#936f00\",\n            \"inverse-surface\": \"#33302c\",\n            \"on-secondary-container\": \"#5c2400\",\n            \"secondary-container\": \"#fd761a\",\n            \"secondary-fixed-dim\": \"#ffb690\",\n            \"on-primary-fixed-variant\": \"#7f2b00\",\n            \"tertiary\": \"#755800\",\n            \"on-error-container\": \"#93000a\",\n            \"on-tertiary\": \"#ffffff\",\n            \"inverse-primary\": \"#ffb599\",\n            \"on-primary\": \"#ffffff\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"background\": \"#fff8f2\",\n            \"on-surface-variant\": \"#5a4138\",\n            \"surface-dim\": \"#e0d9d2\",\n            \"on-tertiary-fixed-variant\": \"#5a4300\",\n            \"surface-container-low\": \"#faf2eb\",\n            \"on-tertiary-fixed\": \"#251a00\",\n            \"on-surface\": \"#1e1b17\",\n            \"on-error\": \"#ffffff\",\n            \"outline\": \"#8e7166\",\n            \"on-primary-container\": \"#fffbff\",\n            \"surface-tint\": \"#a73a00\",\n            \"tertiary-fixed\": \"#ffdf9a\",\n            \"surface-container\": \"#f4ede6\",\n            \"surface-variant\": \"#e8e1db\",\n            \"on-primary-fixed\": \"#370e00\",\n            \"on-secondary\": \"#ffffff\",\n            \"tertiary-fixed-dim\": \"#f7be1d\",\n            \"on-secondary-fixed-variant\": \"#783200\",\n            \"secondary\": \"#9d4300\",\n            \"surface-container-high\": \"#eee7e0\",\n            \"primary-container\": \"#ea580c\",\n            \"on-tertiary-container\": \"#fffbff\",\n            \"primary\": \"#ea580c\",\n            \"on-background\": \"#1e1b17\",\n            \"secondary-fixed\": \"#ffdbca\",\n            \"outline-variant\": \"#e2bfb2\",\n            \"surface\": \"#fff8f2\"\n          },\n          fontFamily: {\n            \"body-md\": [\"Inter\", \"sans-serif\"],\n            \"headline-sm\": [\"Inter\", \"sans-serif\"],\n            \"headline-md\": [\"Inter\", \"sans-serif\"],\n            \"label-sm\": [\"Inter\", \"sans-serif\"],\n            \"label-md\": [\"Inter\", \"sans-serif\"],\n            \"label-lg\": [\"Inter\", \"sans-serif\"]\n          }\n        }\n      }\n    };\n  </script>\n<style>\n    @layer base {\n      html, body {\n        width: 100vw;\n        height: 100vh;\n        margin: 0;\n        padding: 0;\n        overflow: hidden;\n      }\n      body {\n        overscroll-behavior: none;\n      }\n      .pb-safe {\n        padding-bottom: env(safe-area-inset-bottom, 12px);\n      }\n      .pt-safe {\n        padding-top: env(safe-area-inset-top, 12px);\n      }\n    }\n  </style>\n</head>\n<body class=\"bg-surface font-body-md text-on-surface h-screen w-screen flex flex-col overflow-hidden select-none\">\n<!-- Screen 43: Map It - Place the Pin -->\n<main class=\"relative flex-1 w-full h-full flex flex-col overflow-hidden bg-surface\">\n<!-- MAP VIEWPORT CONTAINER -->\n<div class=\"relative w-full flex-1 h-full bg-[#ebe7df] overflow-hidden\">\n<!-- High-Detail Kingston Crossroads Map Geometry -->\n<svg class=\"absolute inset-0 w-full h-full\" fill=\"none\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 420 700\" xmlns=\"http://www.w3.org/2000/svg\">\n<!-- Land blocks -->\n<path d=\"M-40 -40 H200 V230 H-40 Z\" fill=\"#eae4db\"></path>\n<path d=\"M220 -40 H460 V180 H220 Z\" fill=\"#dfd8ce\"></path>\n<path d=\"M-40 270 H150 V740 H-40 Z\" fill=\"#e5dfd5\"></path>\n<path d=\"M210 320 H460 V740 H210 Z\" fill=\"#eae3db\"></path>\n<path d=\"M150 400 H210 V740 H150 Z\" fill=\"#ded7cc\"></path>\n<!-- Parish greenery & park (Mandela Park / Recreation pocket) -->\n<rect fill=\"#d0dec8\" height=\"100\" opacity=\"0.85\" rx=\"10\" width=\"85\" x=\"235\" y=\"50\"></rect>\n<circle cx=\"280\" cy=\"100\" fill=\"#c3d5b9\" opacity=\"0.9\" r=\"28\"></circle>\n<path d=\"M20 440 Q60 410 110 440 T140 540 L20 540 Z\" fill=\"#d4e2cd\" opacity=\"0.7\"></path>\n<!-- Secondary Road Networks -->\n<path d=\"M-30 110 L450 200\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"12\"></path>\n<path d=\"M50 -30 L80 730\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"10\"></path>\n<path d=\"M280 180 L450 390\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"10\"></path>\n<path d=\"M-30 460 L180 340\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"10\"></path>\n<!-- Major Jamaican Arterial Spine: Hagley Park Rd to Constant Spring Rd -->\n<!-- Hagley Park Rd (South-West diagonal to center hub) -->\n<path d=\"M-30 520 L190 270\" stroke=\"#fbd38d\" stroke-linecap=\"round\" stroke-width=\"26\"></path>\n<path d=\"M-30 520 L190 270\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"18\"></path>\n<!-- Constant Spring Rd (North-South primary artery) -->\n<path d=\"M205 -30 L185 730\" stroke=\"#fbd38d\" stroke-linecap=\"round\" stroke-width=\"26\"></path>\n<path d=\"M205 -30 L185 730\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"18\"></path>\n<!-- Eastwood Park Rd & Half-Way-Tree Rd (East-West diagonal) -->\n<path d=\"M-30 260 L450 280\" stroke=\"#fbd38d\" stroke-linecap=\"round\" stroke-width=\"24\"></path>\n<path d=\"M-30 260 L450 280\" stroke=\"#ffffff\" stroke-linecap=\"round\" stroke-width=\"16\"></path>\n<!-- Half-Way Tree Transport Centre & Clock Tower Roundabout -->\n<ellipse cx=\"190\" cy=\"270\" fill=\"#f4ede6\" rx=\"36\" ry=\"36\" stroke=\"#ffffff\" stroke-width=\"10\"></ellipse>\n<circle cx=\"190\" cy=\"270\" fill=\"#ded7cc\" r=\"16\"></circle>\n<!-- Road Names On Canvas -->\n<text fill=\"#78594d\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" letter-spacing=\"1\" transform=\"rotate(84 216 90)\" x=\"216\" y=\"90\">CONSTANT SPRING RD</text>\n<text fill=\"#78594d\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" letter-spacing=\"0.8\" x=\"32\" y=\"252\">EASTWOOD PARK RD</text>\n<text fill=\"#78594d\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" letter-spacing=\"0.8\" x=\"260\" y=\"302\">HALF-WAY-TREE RD</text>\n<text fill=\"#78594d\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" letter-spacing=\"0.8\" transform=\"rotate(-34 60 420)\" x=\"60\" y=\"420\">HAGLEY PARK RD</text>\n<text fill=\"#4d6f3e\" font-family=\"Inter\" font-size=\"8.5\" font-weight=\"600\" x=\"242\" y=\"105\">Nelson Mandela Park</text>\n<!-- Building blocks -->\n<rect fill=\"#cfc8bc\" height=\"30\" rx=\"3\" width=\"38\" x=\"110\" y=\"70\"></rect>\n<rect fill=\"#c7bfb2\" height=\"36\" rx=\"4\" width=\"46\" x=\"235\" y=\"195\"></rect>\n<rect fill=\"#cdc6ba\" height=\"42\" rx=\"4\" width=\"52\" x=\"75\" y=\"310\"></rect>\n<rect fill=\"#d3ccbf\" height=\"50\" rx=\"4\" width=\"66\" x=\"230\" y=\"350\"></rect>\n<rect fill=\"#dcd5c9\" height=\"26\" rx=\"3\" width=\"34\" x=\"118\" y=\"180\"></rect>\n</svg>\n<!-- Faint POI Markers -->\n<!-- Mario's Auto Parts -->\n<div class=\"absolute top-[175px] left-[32px] z-10 flex items-center gap-1.5 bg-surface/90 backdrop-blur-sm border border-outline-variant/60 px-2.5 py-1 rounded-full shadow-sm pointer-events-none\">\n<span class=\"material-symbols-outlined text-outline text-[14px]\">build</span>\n<div class=\"flex flex-col\">\n<span class=\"text-[11px] font-semibold text-on-surface leading-tight\">Mario's Auto Parts</span>\n<span class=\"text-[9px] text-outline leading-none\">180m away</span>\n</div>\n</div>\n<!-- Tastee HWT -->\n<div class=\"absolute top-[320px] right-[24px] z-10 flex items-center gap-1.5 bg-surface/90 backdrop-blur-sm border border-outline-variant/60 px-2.5 py-1 rounded-full shadow-sm pointer-events-none\">\n<span class=\"material-symbols-outlined text-outline text-[14px]\">fastfood</span>\n<div class=\"flex flex-col\">\n<span class=\"text-[11px] font-semibold text-on-surface leading-tight\">Tastee HWT</span>\n<span class=\"text-[9px] text-outline leading-none\">120m away</span>\n</div>\n</div>\n<!-- Existing Total Station Dot on Map (25m away reference) -->\n<div class=\"absolute top-[230px] right-[112px] z-10 flex items-center gap-1 bg-surface-container-high/95 border border-outline/20 px-2 py-0.5 rounded-full shadow-sm pointer-events-none\">\n<span class=\"w-2 h-2 rounded-full bg-amber-600\"></span>\n<span class=\"text-[10px] font-semibold text-on-surface-variant\">Total HWT (25m)</span>\n</div>\n<!-- Center Fixed Crosshairs Reticle & High-Contrast Orange Pin -->\n<div class=\"absolute inset-0 flex items-center justify-center pointer-events-none z-20 -translate-y-8\">\n<!-- Glowing Pulse Rings -->\n<div class=\"absolute w-44 h-44 rounded-full bg-[#ea580c]/10 animate-ping opacity-60\"></div>\n<div class=\"absolute w-28 h-28 rounded-full bg-[#ea580c]/15 animate-pulse\"></div>\n<div class=\"absolute w-14 h-14 rounded-full border border-[#ea580c]/40 bg-[#ea580c]/20\"></div>\n<!-- Crosshair Reticle lines -->\n<div class=\"absolute w-12 h-[1.5px] bg-[#ea580c]/70\"></div>\n<div class=\"absolute h-12 w-[1.5px] bg-[#ea580c]/70\"></div>\n<!-- Pin Assembly Container -->\n<div class=\"flex flex-col items-center -translate-y-8\">\n<!-- Floating Tooltip -->\n<div class=\"mb-2 bg-inverse-surface/95 text-inverse-on-surface px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5 whitespace-nowrap animate-bounce\">\n<span class=\"material-symbols-outlined text-secondary-fixed text-[16px]\">touch_app</span>\n<span class=\"text-[11px] font-medium tracking-tight\">Drag map to align with station entrance</span>\n</div>\n<!-- Orange Pin Head -->\n<div class=\"relative flex items-center justify-center\">\n<!-- Ground Drop Shadow -->\n<div class=\"absolute -bottom-2 w-7 h-2 bg-black/30 rounded-full blur-[2px]\"></div>\n<div class=\"w-12 h-12 rounded-full bg-[#ea580c] text-white flex items-center justify-center shadow-2xl border-2 border-white\">\n<span class=\"material-symbols-outlined text-[24px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n</div>\n</div>\n<!-- Pin Needle Tip -->\n<div class=\"w-3.5 h-3.5 bg-[#ea580c] rotate-45 -mt-2 rounded-xs border-r border-b border-white\"></div>\n<!-- Center Point Dot -->\n<div class=\"w-2.5 h-2.5 rounded-full bg-[#ea580c] ring-2 ring-white mt-1 shadow-sm\"></div>\n</div>\n</div>\n<!-- Re-Center Map Action Button -->\n<button aria-label=\"Re-center on current location\" class=\"absolute right-4 bottom-[310px] z-20 w-11 h-11 rounded-full bg-surface-container-lowest text-on-surface flex items-center justify-center shadow-lg border border-outline-variant/40 active:scale-95 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[#ea580c] text-[22px]\">my_location</span>\n</button>\n</div>\n<!-- TOP FLOATING OVERLAY -->\n<div class=\"absolute top-0 inset-x-0 z-30 pt-safe px-3 flex flex-col gap-2 pointer-events-auto\">\n<!-- Header Row Card -->\n<div class=\"w-full bg-surface-container-lowest/95 backdrop-blur-md rounded-2xl p-2.5 flex items-center justify-between shadow-md border border-outline-variant/30\">\n<!-- Close (X) Button -->\n<button aria-label=\"Close\" class=\"w-9 h-9 rounded-full bg-surface-variant/70 text-on-surface flex items-center justify-center active:bg-surface-variant transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">close</span>\n</button>\n<!-- Title -->\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-headline-sm text-[16px] font-bold text-on-surface\">Map It</span>\n<span class=\"text-outline text-[12px]\">•</span>\n<span class=\"font-headline-sm text-[16px] font-bold text-[#ea580c]\">Position Pin</span>\n</div>\n<!-- Info Button -->\n<button aria-label=\"Information\" class=\"w-9 h-9 rounded-full bg-surface-variant/70 text-on-surface flex items-center justify-center active:bg-surface-variant transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">info</span>\n</button>\n</div>\n<!-- GPS Status Pill -->\n<div class=\"w-full bg-surface-container-lowest/95 backdrop-blur-md rounded-xl px-3 py-2 flex items-center justify-between shadow-sm border border-outline-variant/30\">\n<div class=\"flex items-center gap-2\">\n<span class=\"relative flex h-2.5 w-2.5\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-green-600\"></span>\n</span>\n<span class=\"text-[12px] font-bold text-on-surface\">GPS Accuracy ±8 m</span>\n</div>\n<span class=\"text-[11px] text-on-surface-variant font-medium\">Move outside if signal degrades</span>\n</div>\n</div>\n<!-- BOTTOM FLOATING OVERLAYS (Warning Card + Drawer) -->\n<div class=\"absolute bottom-0 inset-x-0 z-30 flex flex-col gap-2.5 px-3 pb-safe pointer-events-auto\">\n<!-- DUPLICATE DETECTION WARNING CARD -->\n<div class=\"w-full bg-surface-container-lowest rounded-2xl p-4 shadow-xl border-2 border-amber-400 flex flex-col gap-3\">\n<!-- Warning Alert Header -->\n<div class=\"flex items-start gap-2.5\">\n<div class=\"w-9 h-9 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">warning</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"text-[13px] font-bold text-on-surface tracking-tight\">⚠️ Possible Match Detected</span>\n</div>\n<p class=\"text-[12px] text-on-surface-variant mt-0.5 leading-snug\">\n              Is this <strong class=\"text-on-surface font-semibold\">Total Half-Way-Tree</strong>? It's already on the map 25m away.\n            </p>\n</div>\n</div>\n<!-- Warning Card Actions -->\n<div class=\"grid grid-cols-2 gap-2 pt-0.5\">\n<button class=\"w-full min-h-[42px] px-2.5 rounded-xl border border-outline/40 bg-surface-container-low text-on-surface text-[12px] font-semibold flex items-center justify-center gap-1 active:bg-surface-variant transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">edit_location</span>\n<span class=\"truncate\">Yes, that's it (Update info)</span>\n</button>\n<button class=\"w-full min-h-[42px] px-2.5 rounded-xl bg-secondary-fixed text-on-secondary-fixed text-[12px] font-bold flex items-center justify-center gap-1 shadow-sm active:opacity-90 transition-opacity\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">add_location</span>\n<span class=\"truncate\">No, it's a different place</span>\n</button>\n</div>\n</div>\n<!-- BOTTOM SHEET / ACTION DRAWER -->\n<div class=\"w-full bg-surface-container-lowest rounded-2xl p-3.5 shadow-xl border border-outline-variant/30 flex flex-col gap-2.5\">\n<!-- Geocoded Location Readout -->\n<div class=\"flex items-center gap-2.5 bg-surface-container-low px-3 py-2 rounded-xl\">\n<span class=\"material-symbols-outlined text-[#ea580c] text-[20px] shrink-0\">pin_drop</span>\n<div class=\"flex-1 min-w-0\">\n<p class=\"text-[12px] font-semibold text-on-surface truncate\">\n              Constant Spring Rd &amp; Eastwood Park Rd, St. Andrew (Kingston 10)\n            </p>\n</div>\n<span class=\"material-symbols-outlined text-green-700 text-[18px] shrink-0\">check_circle</span>\n</div>\n<!-- Solid Orange Primary CTA Button -->\n<button class=\"w-full min-h-[48px] py-3.5 rounded-xl bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold text-[15px] tracking-wide flex items-center justify-center gap-2 shadow-md active:scale-[0.99] transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">where_to_vote</span>\n<span>Confirm Pin Location</span>\n</button>\n</div>\n</div>\n</main>\n</body></html>"}