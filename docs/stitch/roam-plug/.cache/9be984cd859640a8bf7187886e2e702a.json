{"filename":"52-notification-settings.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;background-color:#fff8f2;color:#1e1b17;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: 'class', theme: { extend: { colors: { 'tertiary-fixed': '#ffdf9a', 'outline': '#8e7166', 'error': '#ba1a1a', 'inverse-primary': '#ffb599', 'on-tertiary': '#ffffff', 'error-container': '#ffdad6', 'surface-bright': '#fff8f2', 'background': '#fff8f2', 'surface-container-high': '#eee7e0', 'surface-variant': '#e8e1db', 'on-primary': '#ffffff', 'on-background': '#1e1b17', 'primary': '#a33900', 'secondary-container': '#fd761a', 'primary-container': '#cc4900', 'on-error': '#ffffff', 'on-tertiary-fixed': '#251a00', 'on-secondary-fixed': '#341100', 'on-secondary-fixed-variant': '#783200', 'on-surface-variant': '#5a4138', 'on-primary-container': '#fffbff', 'surface-container-lowest': '#ffffff', 'secondary-fixed-dim': '#ffb690', 'surface-container': '#f4ede6', 'tertiary-fixed-dim': '#f7be1d', 'on-secondary-container': '#5c2400', 'surface-dim': '#e0d9d2', 'on-error-container': '#93000a', 'on-primary-fixed': '#370e00', 'on-primary-fixed-variant': '#7f2b00', 'primary-fixed-dim': '#ffb599', 'outline-variant': '#e2bfb2', 'surface-tint': '#a73a00', 'surface-container-highest': '#e8e1db', 'tertiary-container': '#936f00', 'surface': '#fff8f2', 'secondary': '#9d4300', 'primary-fixed': '#ffdbce', 'inverse-on-surface': '#f7efe9', 'tertiary': '#755800', 'inverse-surface': '#33302c', 'on-tertiary-fixed-variant': '#5a4300', 'on-secondary': '#ffffff', 'surface-container-low': '#faf2eb', 'on-tertiary-container': '#fffbff', 'on-surface': '#1e1b17', 'secondary-fixed': '#ffdbca' }, borderRadius: { 'DEFAULT': '0.25rem', 'lg': '0.5rem', 'xl': '0.75rem', 'full': '9999px' }, spacing: { 'margin-lg': '1.5rem', 'margin': '1rem', 'space-md': '1rem', 'gutter': '1rem', 'space-lg': '1.5rem', 'gutter-sm': '0.75rem', 'space-xl': '2rem', 'space-sm': '0.5rem', 'space-xs': '0.25rem' }, fontFamily: { 'headline-md': ['Inter'], 'headline-sm': ['Inter'], 'headline-lg': ['Inter'], 'label-sm': ['Inter'], 'body-lg': ['Inter'], 'display-lg-mobile': ['Inter'], 'body-sm': ['Inter'], 'body-md': ['Inter'], 'label-lg': ['Inter'], 'label-md': ['Inter'], 'price-display': ['Inter'], 'display-lg': ['Inter'] }, fontSize: { 'headline-md': ['22px', { lineHeight: '28px', letterSpacing: '-0.01em', fontWeight: '700' }], 'headline-sm': ['18px', { lineHeight: '24px', fontWeight: '600' }], 'headline-lg': ['28px', { lineHeight: '36px', letterSpacing: '-0.01em', fontWeight: '700' }], 'label-sm': ['10px', { lineHeight: '12px', letterSpacing: '0.04em', fontWeight: '700' }], 'body-lg': ['16px', { lineHeight: '24px', fontWeight: '400' }], 'display-lg-mobile': ['32px', { lineHeight: '40px', letterSpacing: '-0.02em', fontWeight: '800' }], 'body-sm': ['12px', { lineHeight: '16px', fontWeight: '400' }], 'body-md': ['14px', { lineHeight: '20px', fontWeight: '400' }], 'label-lg': ['14px', { lineHeight: '20px', letterSpacing: '0.01em', fontWeight: '600' }], 'label-md': ['12px', { lineHeight: '16px', letterSpacing: '0.02em', fontWeight: '600' }], 'price-display': ['24px', { lineHeight: '28px', letterSpacing: '-0.01em', fontWeight: '700' }], 'display-lg': ['40px', { lineHeight: '48px', letterSpacing: '-0.02em', fontWeight: '800' }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen selection:bg-secondary-fixed selection:text-on-secondary-fixed\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl pt-safe shadow-[0_1px_8px_rgba(28,25,23,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Go Back\" class=\"w-12 h-12 -ml-2 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container active:scale-95 transition-all\" onclick=\"history.back()\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight truncate max-w-[210px]\">Notification Settings</h1></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0 shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full px-margin pb-space-xl\">\n<!-- Intro Description / Micro-framing -->\n<div class=\"mt-space-sm mb-space-md\">\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n      Manage your maintenance alerts, parish scout updates, and island fuel radar.\n    </p>\n</div>\n<!-- Delivery Channels Quick Switchers -->\n<div class=\"bg-surface-container-low rounded-xl p-space-md shadow-sm mb-space-lg\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">cell_tower</span>\n<span class=\"font-label-lg text-label-lg text-on-surface\">Active Alert Channels</span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold bg-primary-fixed text-on-primary-fixed px-2 py-0.5 rounded-full\">Synced</span>\n</div>\n<div class=\"grid grid-cols-1 gap-space-sm\">\n<!-- In-App Push Pill -->\n<button class=\"w-full min-h-[48px] px-space-md py-space-sm rounded-lg bg-surface-container-lowest shadow-sm flex items-center justify-between transition-all active:scale-[0.98]\" id=\"channel-push-btn\" onclick=\"toggleChannel('channel-push-btn', 'channel-push-icon', 'channel-push-check')\" type=\"button\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0\" id=\"channel-push-icon\">\n<span class=\"material-symbols-outlined text-[18px]\">notifications_active</span>\n</div>\n<div class=\"flex flex-col text-left truncate\">\n<span class=\"font-label-md text-label-md text-on-surface\">In-app push notifications</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Real-time alerts on this phone</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-secondary-container text-[22px]\" id=\"channel-push-check\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</button>\n<!-- SMS Alert Pill -->\n<button class=\"w-full min-h-[48px] px-space-md py-space-sm rounded-lg bg-surface-container-lowest shadow-sm flex items-center justify-between transition-all active:scale-[0.98]\" id=\"channel-sms-btn\" onclick=\"toggleChannel('channel-sms-btn', 'channel-sms-icon', 'channel-sms-check')\" type=\"button\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0\" id=\"channel-sms-icon\">\n<span class=\"material-symbols-outlined text-[18px]\">sms</span>\n</div>\n<div class=\"flex flex-col text-left truncate\">\n<span class=\"font-label-md text-label-md text-on-surface\">SMS alerts (+1 876 555-0192)</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Low-data &amp; offline transit texts</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-secondary-container text-[22px]\" id=\"channel-sms-check\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</button>\n</div>\n</div>\n<!-- SECTION 1: Vehicle & Maintenance Alerts -->\n<div class=\"mb-space-lg\">\n<div class=\"flex items-center gap-space-xs mb-space-sm px-space-xs\">\n<div class=\"w-6 h-6 rounded-md bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[16px]\">car_repair</span>\n</div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Vehicle &amp; Maintenance Alerts</h2>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col\">\n<!-- Service Due Reminders -->\n<div class=\"p-space-md flex items-start justify-between gap-space-md\">\n<div class=\"flex-1 min-w-0 pr-space-xs\">\n<p class=\"font-label-lg text-label-lg text-on-surface mb-0.5\">Service due reminders</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Get alerted when oil changes, tyre rotations, or brake inspections are approaching based on your odometer</p>\n</div>\n<button aria-checked=\"true\" class=\"shrink-0 relative w-14 h-8 bg-secondary-container rounded-full p-1 cursor-pointer transition-colors duration-200 focus:outline-none flex items-center\" id=\"toggle-service\" onclick=\"toggleSwitch(this)\" role=\"switch\" type=\"button\">\n<span class=\"sr-only\">Toggle service due reminders</span>\n<span class=\"translate-x-6 w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform transition-transform duration-200 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary-container\">check</span>\n</span>\n</button>\n</div>\n<div class=\"h-px bg-surface-container w-full\"></div>\n<!-- Document Renewal Reminders -->\n<div class=\"p-space-md flex items-start justify-between gap-space-md\">\n<div class=\"flex-1 min-w-0 pr-space-xs\">\n<div class=\"flex items-center gap-space-xs mb-0.5\">\n<p class=\"font-label-lg text-label-lg text-on-surface\">Document renewal reminders</p>\n<span class=\"font-label-sm text-label-sm bg-tertiary-fixed text-on-tertiary-fixed font-bold px-1.5 py-0.2 rounded\">Vital</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Timely alerts 30, 14, and 1 day before Fitness, Registration, or Insurance expire</p>\n</div>\n<button aria-checked=\"true\" class=\"shrink-0 relative w-14 h-8 bg-secondary-container rounded-full p-1 cursor-pointer transition-colors duration-200 focus:outline-none flex items-center\" id=\"toggle-docs\" onclick=\"toggleSwitch(this)\" role=\"switch\" type=\"button\">\n<span class=\"sr-only\">Toggle document renewal reminders</span>\n<span class=\"translate-x-6 w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform transition-transform duration-200 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary-container\">check</span>\n</span>\n</button>\n</div>\n</div>\n</div>\n<!-- SECTION 2: Community & Scout Activity -->\n<div class=\"mb-space-lg\">\n<div class=\"flex items-center gap-space-xs mb-space-sm px-space-xs\">\n<div class=\"w-6 h-6 rounded-md bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[16px]\">travel_explore</span>\n</div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Community &amp; Scout Activity</h2>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col\">\n<!-- Pin Approval Updates -->\n<div class=\"p-space-md flex items-start justify-between gap-space-md\">\n<div class=\"flex-1 min-w-0 pr-space-xs\">\n<p class=\"font-label-lg text-label-lg text-on-surface mb-0.5\">Pin approval updates</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Notifications when your submitted garages, tyre shops, or fuel stations are verified by Road Scouts</p>\n</div>\n<button aria-checked=\"true\" class=\"shrink-0 relative w-14 h-8 bg-secondary-container rounded-full p-1 cursor-pointer transition-colors duration-200 focus:outline-none flex items-center\" id=\"toggle-pins\" onclick=\"toggleSwitch(this)\" role=\"switch\" type=\"button\">\n<span class=\"sr-only\">Toggle pin approval updates</span>\n<span class=\"translate-x-6 w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform transition-transform duration-200 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary-container\">check</span>\n</span>\n</button>\n</div>\n<div class=\"h-px bg-surface-container w-full\"></div>\n<!-- Tips & News from Roam Plug (OFF) -->\n<div class=\"p-space-md flex items-start justify-between gap-space-md\">\n<div class=\"flex-1 min-w-0 pr-space-xs\">\n<p class=\"font-label-lg text-label-lg text-on-surface mb-0.5\">Tips and news from Roam Plug</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Island motoring guides, road safety advisories, and new community features</p>\n</div>\n<button aria-checked=\"false\" class=\"shrink-0 relative w-14 h-8 bg-surface-container-highest rounded-full p-1 cursor-pointer transition-colors duration-200 focus:outline-none flex items-center\" id=\"toggle-tips\" onclick=\"toggleSwitch(this)\" role=\"switch\" type=\"button\">\n<span class=\"sr-only\">Toggle tips and news</span>\n<span class=\"translate-x-0 w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform transition-transform duration-200 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-outline opacity-0\">check</span>\n</span>\n</button>\n</div>\n</div>\n</div>\n<!-- SECTION 3: Fuel Radar & Pricing -->\n<div class=\"mb-space-lg\">\n<div class=\"flex items-center gap-space-xs mb-space-sm px-space-xs\">\n<div class=\"w-6 h-6 rounded-md bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[16px]\">local_gas_station</span>\n</div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Fuel Radar &amp; Pricing</h2>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col\">\n<!-- Weekly Fuel Price Summary -->\n<div class=\"p-space-md flex items-start justify-between gap-space-md\">\n<div class=\"flex-1 min-w-0 pr-space-xs\">\n<div class=\"flex items-center gap-space-xs mb-0.5\">\n<p class=\"font-label-lg text-label-lg text-on-surface\">Weekly fuel price summary</p>\n<span class=\"font-label-sm text-label-sm bg-secondary-fixed-dim text-on-secondary-fixed font-bold px-1.5 py-0.2 rounded\">Petrojam</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Every Thursday morning Petrojam price change breakdown across Jamaica</p>\n</div>\n<button aria-checked=\"true\" class=\"shrink-0 relative w-14 h-8 bg-secondary-container rounded-full p-1 cursor-pointer transition-colors duration-200 focus:outline-none flex items-center\" id=\"toggle-summary\" onclick=\"toggleSwitch(this)\" role=\"switch\" type=\"button\">\n<span class=\"sr-only\">Toggle weekly fuel price summary</span>\n<span class=\"translate-x-6 w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform transition-transform duration-200 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary-container\">check</span>\n</span>\n</button>\n</div>\n<div class=\"h-px bg-surface-container w-full\"></div>\n<!-- Price Drop Alerts -->\n<div class=\"p-space-md flex items-start justify-between gap-space-md\">\n<div class=\"flex-1 min-w-0 pr-space-xs\">\n<p class=\"font-label-lg text-label-lg text-on-surface mb-0.5\">Price drop alerts for favourite stations</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Instant notification when your bookmarked pumps lower their per-litre rate</p>\n</div>\n<button aria-checked=\"true\" class=\"shrink-0 relative w-14 h-8 bg-secondary-container rounded-full p-1 cursor-pointer transition-colors duration-200 focus:outline-none flex items-center\" id=\"toggle-drops\" onclick=\"toggleSwitch(this)\" role=\"switch\" type=\"button\">\n<span class=\"sr-only\">Toggle price drop alerts</span>\n<span class=\"translate-x-6 w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform transition-transform duration-200 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary-container\">check</span>\n</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Quiet Hours Interactive Card -->\n<div class=\"bg-surface-container rounded-xl p-space-md mb-space-lg shadow-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-start gap-space-sm min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high text-on-surface flex items-center justify-center shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[20px]\">bedtime</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Quiet Hours</span>\n<span class=\"font-label-md text-label-md text-primary font-semibold\">10:00 PM – 6:00 AM</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">\n            Mutes non-essential pings. Urgent parish roadblock alerts &amp; emergency hazard notices remain active.\n          </p>\n</div>\n</div>\n<button class=\"h-9 px-3 rounded-full bg-surface-container-highest text-on-surface font-label-sm text-label-sm hover:bg-surface-variant active:scale-95 transition-all shrink-0\" onclick=\"adjustQuietHours()\" type=\"button\">\n        Edit\n      </button>\n</div>\n</div>\n<!-- Island Community Partner Note -->\n<div class=\"bg-surface-container-low rounded-xl p-space-md flex items-start gap-space-sm\">\n<span class=\"material-symbols-outlined text-secondary text-[20px] shrink-0 mt-0.5\">verified_user</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n      SMS notifications are sent free of charge courtesy of Roam Plug Jamaica community partners and road safety advocates across all 14 parishes.\n    </p>\n</div>\n<!-- Micro Toast Feedback Notification (Hidden by default) -->\n<div class=\"fixed bottom-6 inset-x-margin max-w-sm mx-auto bg-inverse-surface text-inverse-on-surface px-space-md py-space-sm rounded-xl shadow-lg flex items-center justify-between opacity-0 pointer-events-none transition-all duration-300 z-50 transform translate-y-4\" id=\"toast\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-secondary-fixed text-[20px]\">check</span>\n<span class=\"font-label-md text-label-md\" id=\"toast-text\">Setting updated</span>\n</div>\n</div>\n</div>\n<script>\n  function showToast(message) {\n    const toast = document.getElementById('toast');\n    const toastText = document.getElementById('toast-text');\n    if (!toast || !toastText) return;\n    \n    toastText.innerText = message;\n    toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');\n    toast.classList.add('opacity-100', 'translate-y-0');\n\n    setTimeout(() => {\n      toast.classList.remove('opacity-100', 'translate-y-0');\n      toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');\n    }, 2200);\n  }\n\n  function toggleSwitch(button) {\n    const isChecked = button.getAttribute('aria-checked') === 'true';\n    const newState = !isChecked;\n    button.setAttribute('aria-checked', String(newState));\n\n    const thumb = button.querySelector('span:not(.sr-only)');\n    const checkIcon = thumb ? thumb.querySelector('span.material-symbols-outlined') : null;\n\n    if (newState) {\n      button.classList.remove('bg-surface-container-highest');\n      button.classList.add('bg-secondary-container');\n      if (thumb) {\n        thumb.classList.remove('translate-x-0');\n        thumb.classList.add('translate-x-6');\n      }\n      if (checkIcon) {\n        checkIcon.classList.remove('opacity-0', 'text-outline');\n        checkIcon.classList.add('opacity-100', 'text-secondary-container');\n      }\n      showToast('Alert enabled');\n    } else {\n      button.classList.remove('bg-secondary-container');\n      button.classList.add('bg-surface-container-highest');\n      if (thumb) {\n        thumb.classList.remove('translate-x-6');\n        thumb.classList.add('translate-x-0');\n      }\n      if (checkIcon) {\n        checkIcon.classList.remove('opacity-100', 'text-secondary-container');\n        checkIcon.classList.add('opacity-0', 'text-outline');\n      }\n      showToast('Alert paused');\n    }\n  }\n\n  function toggleChannel(btnId, iconId, checkId) {\n    const btn = document.getElementById(btnId);\n    const icon = document.getElementById(iconId);\n    const check = document.getElementById(checkId);\n    if (!btn || !icon || !check) return;\n\n    const isActive = check.innerText.trim() === 'check_circle';\n\n    if (isActive) {\n      check.innerText = 'radio_button_unchecked';\n      check.classList.remove('text-secondary-container');\n      check.classList.add('text-outline-variant');\n      icon.classList.remove('bg-secondary-container', 'text-on-secondary-container');\n      icon.classList.add('bg-surface-container-high', 'text-on-surface-variant');\n      showToast('Channel disabled');\n    } else {\n      check.innerText = 'check_circle';\n      check.classList.remove('text-outline-variant');\n      check.classList.add('text-secondary-container');\n      icon.classList.remove('bg-surface-container-high', 'text-on-surface-variant');\n      icon.classList.add('bg-secondary-container', 'text-on-secondary-container');\n      showToast('Channel activated');\n    }\n  }\n\n  function adjustQuietHours() {\n    showToast('Quiet hours configured: 10:00 PM – 6:00 AM');\n  }\n</script></main></body></html>"}