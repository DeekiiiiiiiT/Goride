{"filename":"36-documents.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"on-secondary-container\": \"#5c2400\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-primary-container\": \"#fffbff\", \"background\": \"#fff8f2\", \"on-secondary\": \"#ffffff\", \"primary-fixed-dim\": \"#ffb599\", \"tertiary-container\": \"#936f00\", \"inverse-primary\": \"#ffb599\", \"secondary-container\": \"#fd761a\", \"on-background\": \"#1e1b17\", \"surface-container\": \"#f4ede6\", \"primary\": \"#a33900\", \"on-surface-variant\": \"#5a4138\", \"inverse-on-surface\": \"#f7efe9\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"surface-container-high\": \"#eee7e0\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"surface-variant\": \"#e8e1db\", \"outline\": \"#8e7166\", \"on-surface\": \"#1e1b17\", \"surface-bright\": \"#fff8f2\", \"tertiary\": \"#755800\", \"inverse-surface\": \"#33302c\", \"surface-container-low\": \"#faf2eb\", \"secondary\": \"#9d4300\", \"secondary-fixed-dim\": \"#ffb690\", \"surface-tint\": \"#a73a00\", \"on-error\": \"#ffffff\", \"primary-fixed\": \"#ffdbce\", \"primary-container\": \"#cc4900\", \"on-tertiary\": \"#ffffff\", \"surface\": \"#fff8f2\", \"error\": \"#ba1a1a\", \"tertiary-fixed\": \"#ffdf9a\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-error-container\": \"#93000a\", \"on-secondary-fixed\": \"#341100\", \"on-tertiary-container\": \"#fffbff\", \"on-secondary-fixed-variant\": \"#783200\", \"on-tertiary-fixed\": \"#251a00\", \"secondary-fixed\": \"#ffdbca\", \"surface-container-highest\": \"#e8e1db\", \"surface-container-lowest\": \"#ffffff\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-xl\": \"2rem\", \"space-md\": \"1rem\", \"margin\": \"1rem\", \"gutter\": \"1rem\", \"space-sm\": \"0.5rem\", \"margin-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"body-md\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-lg\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { lineHeight: \"24px\", fontWeight: \"400\" }], \"label-sm\": [\"10px\", { lineHeight: \"12px\", letterSpacing: \"0.04em\", fontWeight: \"700\" }], \"label-md\": [\"12px\", { lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"600\" }], \"headline-lg\": [\"28px\", { lineHeight: \"36px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg-mobile\": [\"32px\", { lineHeight: \"40px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-md\": [\"14px\", { lineHeight: \"20px\", fontWeight: \"400\" }], \"price-display\": [\"24px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"headline-md\": [\"22px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg\": [\"40px\", { lineHeight: \"48px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-sm\": [\"12px\", { lineHeight: \"16px\", fontWeight: \"400\" }], \"headline-sm\": [\"18px\", { lineHeight: \"24px\", fontWeight: \"600\" }], \"label-lg\": [\"14px\", { lineHeight: \"20px\", letterSpacing: \"0.01em\", fontWeight: \"600\" }] } } } }</script><style>@layer base { html, body { min-height: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface min-h-screen flex flex-col antialiased selection:bg-primary/20 selection:text-primary\"><header class=\"fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(28,25,23,0.04)] pt-safe\"><div class=\"h-16 px-space-sm flex items-center justify-between\"><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Go Back\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface hover:text-primary hover:bg-surface-container active:scale-95 transition-all\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-md text-headline-md text-on-surface tracking-tight font-headline-md line-clamp-1\">Documents &amp; Renewals</h1></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Share Vehicle\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[22px]\">share</span></button><button aria-label=\"More Options\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[22px]\">more_vert</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-space-xs shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 w-full bg-surface pt-16 pb-safe\"><div class=\"flex flex-col w-full px-space-md pb-space-xl gap-space-lg\">\n<!-- Header Context & Vehicle Switcher Banner -->\n<div class=\"flex flex-col gap-space-xs mt-space-sm\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs text-primary\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">verified_user</span>\n<span class=\"font-label-md text-label-md uppercase tracking-wider font-bold\">Island Road Compliance</span>\n</div>\n<span class=\"font-label-sm text-label-sm bg-surface-container text-on-surface-variant px-space-sm py-1 rounded-full flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary animate-pulse\"></span>\n        TAJ Synced\n      </span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Jamaica statutory motoring compliance &amp; reminders</p>\n<!-- Vehicle Selector Pill -->\n<div class=\"flex items-center justify-between bg-surface-container-low p-space-sm rounded-xl mt-space-xs shadow-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">directions_car</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium\">Active Vehicle &amp; Operator</span>\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">2019 Toyota Roomy <span class=\"font-body-sm text-body-sm text-on-surface-variant font-normal\">(8241-HY)</span></span>\n</div>\n</div>\n<button aria-label=\"Switch Vehicle\" class=\"w-9 h-9 flex items-center justify-center rounded-full bg-surface-container text-on-surface hover:text-primary transition-all flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">swap_horiz</span>\n</button>\n</div>\n</div>\n<!-- Compliance Health Bar Summary -->\n<div class=\"bg-gradient-to-r from-surface-container via-surface-container-low to-surface-container p-space-md rounded-xl flex flex-col gap-space-sm shadow-sm\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">shield_with_heart</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Motoring Fitness Score</span>\n</div>\n<span class=\"font-label-md text-label-md font-bold px-2 py-0.5 rounded-full bg-error-container text-on-error-container\">1 Attention Needed</span>\n</div>\n<!-- Mini progress segments -->\n<div class=\"w-full grid grid-cols-4 gap-1.5 h-2 rounded-full overflow-hidden bg-surface-container-highest\">\n<div class=\"bg-emerald-600 rounded-sm\" title=\"Licence: Valid\"></div>\n<div class=\"bg-amber-500 rounded-sm\" title=\"Tax Disc: Expiring soon\"></div>\n<div class=\"bg-amber-500 rounded-sm\" title=\"Fitness: Expiring soon\"></div>\n<div class=\"bg-error rounded-sm animate-pulse\" title=\"Insurance: Overdue\"></div>\n</div>\n<div class=\"flex items-center justify-between text-on-surface-variant font-body-sm text-body-sm pt-0.5\">\n<span>3 active covers</span>\n<span class=\"text-error font-medium flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">error</span>\n        Insurance overdue by 3d\n      </span>\n</div>\n</div>\n<!-- Document Cards List -->\n<div class=\"flex flex-col gap-space-md\">\n<!-- 1. Driver's Licence (Valid) -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm relative overflow-hidden transition-transform active:scale-[0.99]\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[24px]\">badge</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Driver's Licence</h2>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Tax Administration Jamaica (TAJ)</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md bg-emerald-100 text-emerald-800 px-space-sm py-1 rounded-full font-bold flex items-center gap-1 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[14px]\">check_circle</span>\n          Valid\n        </span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-sm bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Expiry Date</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">12 Jun 2027</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Time Remaining</span>\n<span class=\"font-label-lg text-label-lg text-emerald-700 font-semibold\">962 days left</span>\n</div>\n</div>\n<!-- Reminder Chip & Quick Action -->\n<div class=\"flex items-center justify-between pt-space-xs gap-space-xs\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant bg-surface-container px-space-sm py-1.5 rounded-lg flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">notifications_active</span>\n          30d &amp; 7d before\n        </span>\n<button class=\"h-10 px-space-md rounded-lg bg-surface-container text-on-surface font-label-md text-label-md font-bold hover:bg-surface-container-high transition-colors flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[18px]\">visibility</span>\n          View Digital Copy\n        </button>\n</div>\n</div>\n<!-- 2. Motor Vehicle Registration (Tax Disc) - Expiring Soon -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm relative overflow-hidden transition-transform active:scale-[0.99]\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-lg bg-amber-50 text-amber-800 flex items-center justify-center flex-shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[24px]\">local_police</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Registration (Tax Disc)</h2>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">TAJ Motor Vehicle Licensing</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md bg-amber-100 text-amber-900 px-space-sm py-1 rounded-full font-bold flex items-center gap-1 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[14px]\">timelapse</span>\n          Expiring Soon\n        </span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-sm bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Expiry Date</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">10 Dec 2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Time Remaining</span>\n<span class=\"font-label-lg text-label-lg text-secondary font-semibold\">Expires in 45 days</span>\n</div>\n</div>\n<div class=\"flex items-center justify-between pt-space-xs gap-space-xs flex-wrap\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant bg-surface-container px-space-sm py-1.5 rounded-lg flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">notifications_active</span>\n          30d, 14d, 3d before\n        </span>\n<button class=\"h-10 px-space-md rounded-lg bg-primary-fixed text-on-primary-fixed-variant font-label-md text-label-md font-bold hover:bg-primary-fixed-dim transition-colors flex items-center gap-1\">\n<span>Renew Online via TAJ</span>\n<span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</button>\n</div>\n</div>\n<!-- 3. Certificate of Fitness (Action Required) -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm relative overflow-hidden transition-transform active:scale-[0.99]\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-lg bg-secondary-fixed text-on-secondary-fixed-variant flex items-center justify-center flex-shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[24px]\">car_repair</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Certificate of Fitness</h2>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">ITA Swallowfield Depot</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md bg-secondary-fixed text-on-secondary-fixed-variant px-space-sm py-1 rounded-full font-bold flex items-center gap-1 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[14px]\">notification_important</span>\n          Action Required\n        </span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-sm bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Expiry Date</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">15 Nov 2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Urgency</span>\n<span class=\"font-label-lg text-label-lg text-secondary font-semibold\">Expires in 21 days</span>\n</div>\n</div>\n<div class=\"flex flex-col gap-space-xs pt-space-xs\">\n<div class=\"flex items-center justify-between text-on-surface-variant\">\n<span class=\"font-body-sm text-body-sm bg-surface-container px-space-sm py-1 rounded-lg flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">notifications_active</span>\n            30d, 14d, 7d, 1d\n          </span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Kingston &amp; St. Andrew</span>\n</div>\n<button class=\"w-full min-h-[48px] rounded-lg bg-secondary text-on-secondary font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-xs shadow-md active:opacity-90 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">calendar_month</span>\n          Book Inspection at Swallowfield\n        </button>\n</div>\n</div>\n<!-- 4. Motor Vehicle Insurance (Overdue - Vivid Red Alert) -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-md flex flex-col gap-space-sm relative overflow-hidden bg-gradient-to-b from-error-container/20 to-surface-container-lowest\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-lg bg-error-container text-on-error-container flex items-center justify-center flex-shrink-0 shadow-sm animate-pulse\">\n<span class=\"material-symbols-outlined text-[24px]\">emergency</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-1\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Vehicle Insurance</h2>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Advantage General (Comprehensive)</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md bg-error text-on-error px-space-sm py-1 rounded-full font-bold flex items-center gap-1 flex-shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">warning</span>\n          Overdue\n        </span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-sm bg-error-container/30 p-space-sm rounded-lg\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium\">Policy No.</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold tracking-tight\">POL-88219-JM</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-error font-medium\">Expired 21 Oct 2024</span>\n<span class=\"font-label-lg text-label-lg text-error font-extrabold\">Expired 3 days ago!</span>\n</div>\n</div>\n<div class=\"flex items-center gap-1.5 text-error font-body-sm text-body-sm font-semibold px-1\">\n<span class=\"material-symbols-outlined text-[18px]\">announcement</span>\n<span>⚠️ Urgent Reminder Active • Vehicle not road legal</span>\n</div>\n<div class=\"flex gap-space-xs pt-space-xs\">\n<button class=\"flex-1 min-h-[48px] rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-xs shadow-md active:opacity-90 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">phone_in_talk</span>\n          Call Broker / Renew\n        </button>\n<button aria-label=\"Upload Insurance Cover Note\" class=\"w-12 h-12 rounded-lg bg-surface-container text-on-surface flex items-center justify-center hover:bg-surface-container-high transition-colors flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">upload_file</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Visual Road Readiness Card: Island Statutory Essentials -->\n<div class=\"bg-surface-container-low rounded-xl p-space-md flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Compliance Checklist</h3>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Road Traffic Act 2018</span>\n</div>\n<div class=\"grid grid-cols-3 gap-space-xs text-center\">\n<div class=\"bg-surface-container p-space-sm rounded-lg flex flex-col items-center gap-1\">\n<span class=\"material-symbols-outlined text-emerald-700 text-[22px]\">contact_emergency</span>\n<span class=\"font-label-sm text-label-sm font-bold text-on-surface\">Licence</span>\n<span class=\"font-body-sm text-body-sm text-emerald-700 font-semibold\">Ready</span>\n</div>\n<div class=\"bg-surface-container p-space-sm rounded-lg flex flex-col items-center gap-1\">\n<span class=\"material-symbols-outlined text-amber-700 text-[22px]\">fact_check</span>\n<span class=\"font-label-sm text-label-sm font-bold text-on-surface\">Fitness</span>\n<span class=\"font-body-sm text-body-sm text-amber-700 font-semibold\">21d Left</span>\n</div>\n<div class=\"bg-surface-container p-space-sm rounded-lg flex flex-col items-center gap-1\">\n<span class=\"material-symbols-outlined text-error text-[22px]\">shield_lock</span>\n<span class=\"font-label-sm text-label-sm font-bold text-on-surface\">Insurance</span>\n<span class=\"font-body-sm text-body-sm text-error font-semibold\">Lapsed</span>\n</div>\n</div>\n</div>\n<!-- Primary Add Document Action -->\n<button class=\"w-full min-h-[52px] rounded-xl bg-gradient-to-r from-primary to-secondary text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-sm shadow-md active:scale-[0.99] transition-all\" id=\"add-doc-btn\">\n<span class=\"material-symbols-outlined text-[24px]\">add_circle</span>\n    + Add Document or Reminder\n  </button>\n<!-- Interactive Document Addition Drawer / Mock Trigger State -->\n<div class=\"hidden bg-inverse-surface text-inverse-on-surface p-space-md rounded-xl flex items-center justify-between shadow-xl\" id=\"quick-action-toast\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-primary-fixed\">document_scanner</span>\n<span class=\"font-body-md text-body-md\">Camera scanner loaded. Ready for disc or cover note.</span>\n</div>\n<button class=\"text-primary-fixed font-label-md text-label-md font-bold px-2 py-1\" id=\"close-toast\">OK</button>\n</div>\n<!-- Privacy Guarantee Card -->\n<div class=\"bg-surface-container rounded-xl p-space-md flex items-start gap-space-md shadow-sm\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary flex-shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">enhanced_encryption</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<div class=\"flex items-center gap-1 text-on-surface\">\n<span class=\"font-label-lg text-label-lg font-bold\">Privacy &amp; Vault Guarantee</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n        Stored privately on your device and encrypted account. Never shared with third parties or tax authorities without your consent.\n      </p>\n</div>\n</div>\n<!-- Island Quick Links & Support -->\n<div class=\"flex items-center justify-around py-space-xs text-on-surface-variant text-body-sm font-body-sm\">\n<button class=\"flex items-center gap-1 hover:text-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">help_center</span>\n      TAJ Portal FAQs\n    </button>\n<span class=\"text-outline-variant\">•</span>\n<button class=\"flex items-center gap-1 hover:text-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">call</span>\n      ITA Depots List\n    </button>\n<span class=\"text-outline-variant\">•</span>\n<button class=\"flex items-center gap-1 hover:text-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">tune</span>\n      Notification Rules\n    </button>\n</div>\n</div>\n<script>\n  (function() {\n    const addBtn = document.getElementById('add-doc-btn');\n    const toast = document.getElementById('quick-action-toast');\n    const closeToast = document.getElementById('close-toast');\n\n    if (addBtn && toast && closeToast) {\n      addBtn.addEventListener('click', function() {\n        toast.classList.remove('hidden');\n        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n      });\n\n      closeToast.addEventListener('click', function() {\n        toast.classList.add('hidden');\n      });\n    }\n  })();\n</script></main></body></html>"}