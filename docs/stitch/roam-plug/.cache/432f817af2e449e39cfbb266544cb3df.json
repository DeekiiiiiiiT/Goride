{"filename":"54-settings.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;background-color:#fff8f2;color:#1e1b17;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: 'class', theme: { extend: { colors: { 'tertiary-fixed': '#ffdf9a', 'outline': '#8e7166', 'error': '#ba1a1a', 'inverse-primary': '#ffb599', 'on-tertiary': '#ffffff', 'error-container': '#ffdad6', 'surface-bright': '#fff8f2', 'background': '#fff8f2', 'surface-container-high': '#eee7e0', 'surface-variant': '#e8e1db', 'on-primary': '#ffffff', 'on-background': '#1e1b17', 'primary': '#a33900', 'secondary-container': '#fd761a', 'primary-container': '#cc4900', 'on-error': '#ffffff', 'on-tertiary-fixed': '#251a00', 'on-secondary-fixed': '#341100', 'on-secondary-fixed-variant': '#783200', 'on-surface-variant': '#5a4138', 'on-primary-container': '#fffbff', 'surface-container-lowest': '#ffffff', 'secondary-fixed-dim': '#ffb690', 'surface-container': '#f4ede6', 'tertiary-fixed-dim': '#f7be1d', 'on-secondary-container': '#5c2400', 'surface-dim': '#e0d9d2', 'on-error-container': '#93000a', 'on-primary-fixed': '#370e00', 'on-primary-fixed-variant': '#7f2b00', 'primary-fixed-dim': '#ffb599', 'outline-variant': '#e2bfb2', 'surface-tint': '#a73a00', 'surface-container-highest': '#e8e1db', 'tertiary-container': '#936f00', 'surface': '#fff8f2', 'secondary': '#9d4300', 'primary-fixed': '#ffdbce', 'inverse-on-surface': '#f7efe9', 'tertiary': '#755800', 'inverse-surface': '#33302c', 'on-tertiary-fixed-variant': '#5a4300', 'on-secondary': '#ffffff', 'surface-container-low': '#faf2eb', 'on-tertiary-container': '#fffbff', 'on-surface': '#1e1b17', 'secondary-fixed': '#ffdbca' }, borderRadius: { 'DEFAULT': '0.25rem', 'lg': '0.5rem', 'xl': '0.75rem', 'full': '9999px' }, spacing: { 'margin-lg': '1.5rem', 'margin': '1rem', 'space-md': '1rem', 'gutter': '1rem', 'space-lg': '1.5rem', 'gutter-sm': '0.75rem', 'space-xl': '2rem', 'space-sm': '0.5rem', 'space-xs': '0.25rem' }, fontFamily: { 'headline-md': ['Inter'], 'headline-sm': ['Inter'], 'headline-lg': ['Inter'], 'label-sm': ['Inter'], 'body-lg': ['Inter'], 'display-lg-mobile': ['Inter'], 'body-sm': ['Inter'], 'body-md': ['Inter'], 'label-lg': ['Inter'], 'label-md': ['Inter'], 'price-display': ['Inter'], 'display-lg': ['Inter'] }, fontSize: { 'headline-md': ['22px', { lineHeight: '28px', letterSpacing: '-0.01em', fontWeight: '700' }], 'headline-sm': ['18px', { lineHeight: '24px', fontWeight: '600' }], 'headline-lg': ['28px', { lineHeight: '36px', letterSpacing: '-0.01em', fontWeight: '700' }], 'label-sm': ['10px', { lineHeight: '12px', letterSpacing: '0.04em', fontWeight: '700' }], 'body-lg': ['16px', { lineHeight: '24px', fontWeight: '400' }], 'display-lg-mobile': ['32px', { lineHeight: '40px', letterSpacing: '-0.02em', fontWeight: '800' }], 'body-sm': ['12px', { lineHeight: '16px', fontWeight: '400' }], 'body-md': ['14px', { lineHeight: '20px', fontWeight: '400' }], 'label-lg': ['14px', { lineHeight: '20px', letterSpacing: '0.01em', fontWeight: '600' }], 'label-md': ['12px', { lineHeight: '16px', letterSpacing: '0.02em', fontWeight: '600' }], 'price-display': ['24px', { lineHeight: '28px', letterSpacing: '-0.01em', fontWeight: '700' }], 'display-lg': ['40px', { lineHeight: '48px', letterSpacing: '-0.02em', fontWeight: '800' }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen selection:bg-secondary-fixed selection:text-on-secondary-fixed\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl pt-safe shadow-[0_1px_8px_rgba(28,25,23,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Go Back\" class=\"w-12 h-12 -ml-2 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container active:scale-95 transition-all\" onclick=\"history.back()\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight truncate max-w-[210px]\">Settings</h1></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0 shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Subtle Header Introduction & Scout Badge Status -->\n<div class=\"px-margin pt-2 pb-4\">\n<div class=\"flex items-center justify-between gap-space-sm mb-1.5\">\n<span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-label-sm font-label-sm tracking-wider uppercase\">\n<span class=\"material-symbols-outlined text-[13px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n        Driver Preferences\n      </span>\n<span class=\"text-label-sm font-label-sm text-outline flex items-center gap-1\">\n<span class=\"inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse\"></span>\n        Sync Active\n      </span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n      Customize your app experience, navigation preferences, and fuel defaults.\n    </p>\n</div>\n<!-- Main Settings Vertical Flow -->\n<div class=\"px-margin flex flex-col gap-space-lg\">\n<!-- 1. APPEARANCE & THEME -->\n<section class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between mb-1\">\n<h2 class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">palette</span>\n          Appearance\n        </h2>\n<span class=\"text-label-sm font-label-sm text-on-surface-variant uppercase\">Display</span>\n</div>\n<div class=\"p-1.5 rounded-xl bg-surface-container flex items-center gap-1.5 shadow-sm\">\n<!-- Light (Selected) -->\n<button class=\"appearance-btn flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-lg bg-surface-container-lowest text-primary shadow-sm font-label-md text-label-md transition-all active:scale-95\" data-theme=\"light\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">light_mode</span>\n<span>Light</span>\n</button>\n<!-- Dark -->\n<button class=\"appearance-btn flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-all active:scale-95\" data-theme=\"dark\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">dark_mode</span>\n<span>Dark</span>\n</button>\n<!-- System -->\n<button class=\"appearance-btn flex-1 flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-all active:scale-95\" data-theme=\"system\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">devices</span>\n<span>System</span>\n</button>\n</div>\n</section>\n<!-- 2. NAVIGATION & MAP ROUTING -->\n<section class=\"flex flex-col gap-space-xs\">\n<div class=\"flex flex-col mb-1\">\n<h2 class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">turn_sharp_right</span>\n          Default navigation app\n        </h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n          Used when launching turn-by-turn directions to stations or mechanics\n        </p>\n</div>\n<div class=\"flex flex-col gap-2\">\n<!-- Google Maps (Selected) -->\n<label class=\"nav-choice flex items-center justify-between p-3.5 rounded-xl bg-surface-container-lowest shadow-sm cursor-pointer transition-all active:scale-[0.99] group\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-primary\">\n<span class=\"material-symbols-outlined text-[24px]\">map</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Google Maps</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Recommended for island-wide routes</span>\n</div>\n</div>\n<input checked=\"\" class=\"accent-primary w-5 h-5 cursor-pointer\" name=\"default_nav\" type=\"radio\" value=\"google\"/>\n</label>\n<!-- Waze -->\n<label class=\"nav-choice flex items-center justify-between p-3.5 rounded-xl bg-surface-container-lowest shadow-sm cursor-pointer transition-all active:scale-[0.99] group\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-secondary\">\n<span class=\"material-symbols-outlined text-[24px]\">traffic</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Waze</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Active road hazard &amp; police reports</span>\n</div>\n</div>\n<input class=\"accent-primary w-5 h-5 cursor-pointer\" name=\"default_nav\" type=\"radio\" value=\"waze\"/>\n</label>\n<!-- Apple Maps -->\n<label class=\"nav-choice flex items-center justify-between p-3.5 rounded-xl bg-surface-container-lowest shadow-sm cursor-pointer transition-all active:scale-[0.99] group\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-outline\">\n<span class=\"material-symbols-outlined text-[24px]\">explore</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Apple Maps</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Native iOS vehicle integration</span>\n</div>\n</div>\n<input class=\"accent-primary w-5 h-5 cursor-pointer\" name=\"default_nav\" type=\"radio\" value=\"apple\"/>\n</label>\n</div>\n</section>\n<!-- 3. VEHICLE & FUEL PREFERENCES -->\n<section class=\"flex flex-col gap-space-xs\">\n<div class=\"flex flex-col mb-1\">\n<h2 class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">local_gas_station</span>\n          Default fuel grade\n        </h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n          Pre-selects your pump type when viewing station prices and logging fill-ups\n        </p>\n</div>\n<div class=\"grid grid-cols-3 gap-2\">\n<!-- E-10 87 (Selected) -->\n<button class=\"fuel-btn flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container-lowest shadow-sm transition-all active:scale-95 text-center relative overflow-hidden\" data-fuel=\"e10-87\" type=\"button\">\n<span class=\"inline-block w-full h-1 bg-primary absolute top-0 inset-x-0\"></span>\n<span class=\"font-headline-sm text-headline-sm text-primary mb-0.5\">87</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">E-10 87</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant mt-1\">Regular Unleaded</span>\n<div class=\"mt-2 text-primary\">\n<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</button>\n<!-- E-10 90 -->\n<button class=\"fuel-btn flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container-lowest shadow-sm transition-all active:scale-95 text-center relative opacity-85 hover:opacity-100\" data-fuel=\"e10-90\" type=\"button\">\n<span class=\"inline-block w-full h-1 bg-transparent absolute top-0 inset-x-0\"></span>\n<span class=\"font-headline-sm text-headline-sm text-on-surface mb-0.5\">90</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">E-10 90</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant mt-1\">Super Premium</span>\n<div class=\"mt-2 text-outline-variant\">\n<span class=\"material-symbols-outlined text-[18px]\">radio_button_unchecked</span>\n</div>\n</button>\n<!-- Automotive Diesel -->\n<button class=\"fuel-btn flex flex-col items-center justify-center p-3 rounded-xl bg-surface-container-lowest shadow-sm transition-all active:scale-95 text-center relative opacity-85 hover:opacity-100\" data-fuel=\"diesel\" type=\"button\">\n<span class=\"inline-block w-full h-1 bg-transparent absolute top-0 inset-x-0\"></span>\n<span class=\"font-headline-sm text-headline-sm text-on-surface mb-0.5\">ULSD</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">Diesel</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant mt-1\">Ultra Low Sulfur</span>\n<div class=\"mt-2 text-outline-variant\">\n<span class=\"material-symbols-outlined text-[18px]\">radio_button_unchecked</span>\n</div>\n</button>\n</div>\n</section>\n<!-- 4. REGIONAL & MEASUREMENT UNITS -->\n<section class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between mb-1\">\n<h2 class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">public</span>\n          Regional &amp; Measurement Units\n        </h2>\n<span class=\"text-label-sm font-label-sm text-on-surface-variant uppercase\">Local Specs</span>\n</div>\n<div class=\"rounded-xl bg-surface-container-lowest shadow-sm overflow-hidden flex flex-col\">\n<!-- Distance units (Fixed JA Standard) -->\n<div class=\"p-4 flex items-center justify-between bg-surface-container-lowest\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">straighten</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Distance units</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Mandatory Jamaican highway standard</span>\n</div>\n</div>\n<div class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md\">\n<span>Kilometres (km)</span>\n<span class=\"material-symbols-outlined text-[16px] text-outline\" title=\"Locked by regional regulation\">lock</span>\n</div>\n</div>\n<div class=\"h-px w-full bg-surface-container\"></div>\n<!-- Currency -->\n<div class=\"p-4 flex items-center justify-between bg-surface-container-lowest\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">payments</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Currency</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Pump pricing &amp; toll fees</span>\n</div>\n</div>\n<div class=\"flex items-center gap-1 px-3 py-1.5 rounded-lg bg-secondary-fixed text-on-secondary-fixed font-label-md text-label-md\">\n<span>Jamaican Dollars (J$)</span>\n</div>\n</div>\n<div class=\"h-px w-full bg-surface-container\"></div>\n<!-- Language Selector -->\n<button class=\"w-full p-4 flex items-center justify-between bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-left active:bg-surface-container\" type=\"button\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">translate</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Language</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Locale &amp; roadside terminology</span>\n</div>\n</div>\n<div class=\"flex items-center gap-1 text-on-surface-variant font-label-md text-label-md\">\n<span class=\"text-on-surface\">English (Jamaica)</span>\n<span class=\"material-symbols-outlined text-[20px]\">chevron_right</span>\n</div>\n</button>\n</div>\n</section>\n<!-- 5. LEGAL & ABOUT -->\n<section class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between mb-1\">\n<h2 class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">info</span>\n          About &amp; Community\n        </h2>\n</div>\n<div class=\"rounded-xl bg-surface-container-lowest shadow-sm overflow-hidden flex flex-col\">\n<!-- About Roam Plug -->\n<button class=\"w-full p-4 flex items-center justify-between bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-left active:bg-surface-container\" type=\"button\">\n<div class=\"flex items-center gap-3 min-w-0\">\n<div class=\"w-9 h-9 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">electric_bolt</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">About Roam Plug</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Built for Jamaican roads, by local drivers</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[20px] text-outline shrink-0 ml-2\">chevron_right</span>\n</button>\n<div class=\"h-px w-full bg-surface-container\"></div>\n<!-- Community Scout Guidelines -->\n<button class=\"w-full p-4 flex items-center justify-between bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-left active:bg-surface-container\" type=\"button\">\n<div class=\"flex items-center gap-3 min-w-0\">\n<div class=\"w-9 h-9 rounded-lg bg-tertiary-fixed flex items-center justify-center text-tertiary shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">verified_user</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Community Scout Guidelines</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Accuracy rewards &amp; station verification</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[20px] text-outline shrink-0 ml-2\">chevron_right</span>\n</button>\n<div class=\"h-px w-full bg-surface-container\"></div>\n<!-- Terms of Service -->\n<button class=\"w-full p-4 flex items-center justify-between bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-left active:bg-surface-container\" type=\"button\">\n<div class=\"flex items-center gap-3 min-w-0\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">gavel</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Terms of Service</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">User rights, telemetry &amp; navigation rules</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[20px] text-outline shrink-0 ml-2\">chevron_right</span>\n</button>\n<div class=\"h-px w-full bg-surface-container\"></div>\n<!-- Privacy Policy -->\n<button class=\"w-full p-4 flex items-center justify-between bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-left active:bg-surface-container\" type=\"button\">\n<div class=\"flex items-center gap-3 min-w-0\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">policy</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Privacy Policy</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Strict location privacy &amp; data policies</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[20px] text-outline shrink-0 ml-2\">chevron_right</span>\n</button>\n</div>\n</section>\n<!-- Visual Card: Island Road Community Banner -->\n<div class=\"rounded-xl overflow-hidden bg-surface-container-low shadow-sm p-4 flex items-center gap-3.5\">\n<div class=\"w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-md\">\n<span class=\"material-symbols-outlined text-[26px]\">handshake</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">One Road, One People</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Over 14,200 active drivers updating gas stations &amp; road repairs across 14 parishes daily.</span>\n</div>\n</div>\n<!-- 6. APP FOOTER -->\n<footer class=\"pt-2 pb-6 flex flex-col items-center text-center gap-2\">\n<div class=\"flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[15px] text-primary\">local_taxi</span>\n<span class=\"font-label-sm text-label-sm\">Roam Plug v2.4.1 (Build 184) • Kingston, Jamaica</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-outline max-w-[290px] leading-relaxed\">\n        © 2024 Roam Plug Jamaica. Fuel prices updated with Petrojam weekly notices.\n      </p>\n</footer>\n</div>\n</div>\n<script>\n  // Appearance Selector Micro-interaction\n  const appearanceButtons = document.querySelectorAll('.appearance-btn');\n  appearanceButtons.forEach(btn => {\n    btn.addEventListener('click', () => {\n      appearanceButtons.forEach(b => {\n        b.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm');\n        b.classList.add('text-on-surface-variant');\n      });\n      btn.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm');\n      btn.classList.remove('text-on-surface-variant');\n    });\n  });\n\n  // Fuel Selector Micro-interaction\n  const fuelButtons = document.querySelectorAll('.fuel-btn');\n  fuelButtons.forEach(btn => {\n    btn.addEventListener('click', () => {\n      fuelButtons.forEach(b => {\n        b.classList.add('opacity-85');\n        const bar = b.querySelector('span:first-child');\n        if (bar) bar.className = 'inline-block w-full h-1 bg-transparent absolute top-0 inset-x-0';\n        const num = b.querySelector('.font-headline-sm');\n        if (num) num.className = 'font-headline-sm text-headline-sm text-on-surface mb-0.5';\n        const iconDiv = b.querySelector('.mt-2');\n        if (iconDiv) {\n          iconDiv.className = 'mt-2 text-outline-variant';\n          iconDiv.innerHTML = '<span class=\"material-symbols-outlined text-[18px]\">radio_button_unchecked</span>';\n        }\n      });\n\n      btn.classList.remove('opacity-85');\n      const activeBar = btn.querySelector('span:first-child');\n      if (activeBar) activeBar.className = 'inline-block w-full h-1 bg-primary absolute top-0 inset-x-0';\n      const activeNum = btn.querySelector('.font-headline-sm');\n      if (activeNum) activeNum.className = 'font-headline-sm text-headline-sm text-primary mb-0.5';\n      const activeIcon = btn.querySelector('.mt-2');\n      if (activeIcon) {\n        activeIcon.className = 'mt-2 text-primary';\n        activeIcon.innerHTML = '<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: \\'FILL\\' 1;\">check_circle</span>';\n      }\n    });\n  });\n</script></main></body></html>"}