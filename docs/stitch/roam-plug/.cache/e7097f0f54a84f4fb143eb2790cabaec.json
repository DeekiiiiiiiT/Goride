{"filename":"33-log-service.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back\" class=\"w-12 h-12 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Log Service</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Vehicle Header Ribbon Badge -->\n<div class=\"mt-2 mb-4 p-space-md rounded-xl bg-surface-container flex items-center justify-between shadow-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center flex-shrink-0\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">directions_car</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-primary uppercase tracking-wider font-bold\">Active Vehicle</span>\n<div class=\"flex items-center gap-1.5 truncate\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">2019 Toyota Roomy</span>\n<span class=\"bg-surface-container-highest px-2 py-0.5 rounded text-on-surface-variant font-label-md text-label-md font-semibold flex-shrink-0\">8241-HY</span>\n</div>\n</div>\n</div>\n<div class=\"flex flex-col items-end flex-shrink-0 pl-2\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse\"></span>\n        Up to date\n      </span>\n</div>\n</div>\n<form class=\"flex flex-col gap-space-lg\" id=\"serviceLogForm\" onsubmit=\"event.preventDefault(); triggerSuccessCelebration();\">\n<!-- 1. Service Performed (Multi-Select Chips) -->\n<div class=\"flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">build_circle</span>\n          Service Performed\n        </label>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Tap to toggle</span>\n</div>\n<div class=\"flex flex-wrap gap-2\" id=\"chipsContainer\">\n<!-- Selected 1 -->\n<button class=\"chip active-chip h-10 px-3.5 rounded-full bg-primary text-on-primary font-label-md text-label-md flex items-center gap-1.5 shadow-sm active:scale-95 transition-transform\" data-selected=\"true\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon\">check</span>\n<span>Engine Oil &amp; Filter</span>\n</button>\n<!-- Selected 2 -->\n<button class=\"chip active-chip h-10 px-3.5 rounded-full bg-primary text-on-primary font-label-md text-label-md flex items-center gap-1.5 shadow-sm active:scale-95 transition-transform\" data-selected=\"true\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon\">check</span>\n<span>Multi-point Inspection</span>\n</button>\n<!-- Unselected options -->\n<button class=\"chip h-10 px-3.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md flex items-center gap-1.5 active:scale-95 transition-transform\" data-selected=\"false\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon hidden\">check</span>\n<span>Brake Pads</span>\n</button>\n<button class=\"chip h-10 px-3.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md flex items-center gap-1.5 active:scale-95 transition-transform\" data-selected=\"false\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon hidden\">check</span>\n<span>Air Filter</span>\n</button>\n<button class=\"chip h-10 px-3.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md flex items-center gap-1.5 active:scale-95 transition-transform\" data-selected=\"false\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon hidden\">check</span>\n<span>Tyre Rotation</span>\n</button>\n<button class=\"chip h-10 px-3.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md flex items-center gap-1.5 active:scale-95 transition-transform\" data-selected=\"false\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon hidden\">check</span>\n<span>Transmission Fluid</span>\n</button>\n<button class=\"chip h-10 px-3.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md flex items-center gap-1.5 active:scale-95 transition-transform\" data-selected=\"false\" onclick=\"toggleChip(this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] leading-none check-icon hidden\">check</span>\n<span>Battery</span>\n</button>\n<!-- Custom Service Adder -->\n<button class=\"h-10 px-3.5 rounded-full bg-surface-container-highest text-primary font-label-md text-label-md flex items-center gap-1 shadow-sm active:scale-95 transition-transform\" onclick=\"promptCustomService()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">add</span>\n<span>Custom Service</span>\n</button>\n</div>\n</div>\n<!-- 2 & 3. Odometer Reading & Date Grid -->\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-space-md\">\n<!-- Odometer Field -->\n<div class=\"flex flex-col gap-space-xs\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center justify-between\" for=\"odometerInput\">\n<span class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">speed</span>\n            Odometer Reading\n          </span>\n<button class=\"text-secondary font-label-sm text-label-sm flex items-center gap-0.5 active:opacity-75\" onclick=\"syncCluster()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[14px]\">sync</span>\n            Sync cluster\n          </button>\n</label>\n<div class=\"relative flex items-center\">\n<input class=\"w-full h-12 px-4 pr-11 rounded-xl bg-surface-container-lowest font-headline-sm text-headline-sm text-on-surface focus:outline-none focus:bg-surface-container-low shadow-sm\" id=\"odometerInput\" type=\"text\" value=\"84,612 km\"/>\n<div class=\"absolute right-3 text-on-surface-variant pointer-events-none flex items-center\">\n<span class=\"material-symbols-outlined text-[20px]\">edit</span>\n</div>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Last known was 79,400 km in May</p>\n</div>\n<!-- Date of Service Field -->\n<div class=\"flex flex-col gap-space-xs\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1.5\" for=\"dateInput\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">event</span>\n          Date of Service\n        </label>\n<div class=\"relative flex items-center\">\n<input class=\"w-full h-12 px-4 pr-11 rounded-xl bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:bg-surface-container-low shadow-sm\" id=\"dateInput\" type=\"text\" value=\"Today, 24 Oct 2024\"/>\n<div class=\"absolute right-3 text-primary pointer-events-none flex items-center\">\n<span class=\"material-symbols-outlined text-[22px]\">calendar_month</span>\n</div>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Scheduled reset baseline date</p>\n</div>\n</div>\n<!-- 4. Where was it done? Segmented Toggle -->\n<div class=\"flex flex-col gap-space-sm\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">location_on</span>\n        Where was it done?\n      </label>\n<!-- Segmented Control Bar -->\n<div class=\"p-1 rounded-xl bg-surface-container-high flex items-center gap-1\">\n<button class=\"flex-1 min-h-[44px] rounded-lg bg-surface-container-lowest shadow-sm flex items-center justify-center gap-1.5 font-label-md text-label-md text-on-surface transition-all\" id=\"btnShop\" onclick=\"setServiceLocationType('shop')\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\">verified</span>\n          Mechanic Shop\n        </button>\n<button class=\"flex-1 min-h-[44px] rounded-lg text-on-surface-variant flex items-center justify-center gap-1.5 font-label-md text-label-md transition-all\" id=\"btnDiy\" onclick=\"setServiceLocationType('diy')\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">home_repair_service</span>\n          Did it myself (DIY)\n        </button>\n</div>\n<!-- Shop Selector Card -->\n<div class=\"p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex items-start justify-between gap-space-sm transition-all\" id=\"shopSelectorCard\">\n<div class=\"flex items-start gap-3 min-w-0\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary flex-shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[22px]\">garage</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Precision Auto Works</span>\n<span class=\"inline-flex items-center text-emerald-600 flex-shrink-0\" title=\"Verified Workshop\">\n<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</span>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">14 Dunrobin Ave, St. Andrew (Kingston 10)</span>\n<div class=\"mt-2 flex items-center gap-2\">\n<span class=\"px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold\">Authorized Partner</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">4.9 ★ (128 reviews)</span>\n</div>\n</div>\n</div>\n<button class=\"text-secondary font-label-md text-label-md font-semibold hover:underline flex-shrink-0 pt-0.5\" onclick=\"showChangeShopModal()\" type=\"button\">\n          Change\n        </button>\n</div>\n<!-- DIY Container (Hidden by default) -->\n<div class=\"hidden p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex items-center gap-3\" id=\"diyInfoContainer\">\n<div class=\"w-10 h-10 rounded-lg bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">handyman</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">DIY Log Mode Active</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Your garage diary will record this as self-performed maintenance.</span>\n</div>\n</div>\n</div>\n<!-- 5. Total Cost (Optional & Private) -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1.5\" for=\"costInput\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">payments</span>\n          Total Cost\n        </label>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[13px]\">lock</span>\n          Private\n        </span>\n</div>\n<div class=\"relative flex items-center\">\n<div class=\"absolute left-4 font-headline-sm text-headline-sm text-primary font-bold\">J$</div>\n<input class=\"w-full h-12 pl-12 pr-4 rounded-xl bg-surface-container-lowest font-headline-sm text-headline-sm text-on-surface focus:outline-none focus:bg-surface-container-low shadow-sm\" id=\"costInput\" placeholder=\"0.00\" type=\"text\" value=\"12,500\"/>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[15px] text-tertiary\">info</span>\n        Kept private to your personal garage records. Used for expense analytics.\n      </p>\n</div>\n<!-- 6. Notes & Parts Used (Optional) -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1.5\" for=\"serviceNotes\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">description</span>\n          Notes &amp; Parts Used\n        </label>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Optional</span>\n</div>\n<textarea class=\"w-full p-3.5 rounded-xl bg-surface-container-lowest font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-low shadow-sm resize-none\" id=\"serviceNotes\" placeholder=\"e.g. Used Castrol Edge 5W-30 (4L) + OEM Toyota filter from Mario's Auto Parts. Inspected front brake pad wear at 70%.\" rows=\"3\"></textarea>\n</div>\n<!-- 7. Attach Receipt or Photo -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">receipt_long</span>\n          Attach Receipt or Photo\n        </label>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Max 5MB</span>\n</div>\n<!-- Upload Zone Card -->\n<div class=\"p-space-md rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col gap-3\">\n<div class=\"flex items-center gap-3\">\n<!-- Thumbnail Preview (Active simulated upload) -->\n<div class=\"relative w-16 h-16 rounded-xl overflow-hidden bg-surface-container-high flex-shrink-0 group\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A close-up photograph of an official Jamaican automotive repair invoice on branded receipt paper with clear Jamaican dollar breakdowns, stamped and verified under warm indoor workshop light.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBkyNeYkXGbAbKD_-LSKE-5Eb9lceGaLGrOLt7cw1UKYTvNCaTK4wALAty3KSju5WCuzAlxIsYtPTYxwJZn7_QnR0jaxJepllVZF-drGRswLBgeAmJx6PNoQsFLIUTPlXOlUJCTgrUO3F__oSuv3D6cpI_kA4QiyAJRS5mikpMRO3EgqQ3FH2MW-SIcKc6O3CEdGfk8fYoL6GOqRyzr1m6zUi-L07m-mBRBlKFDZFJinARosZhu0Hct\"/>\n<div class=\"absolute inset-0 bg-on-surface/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity\">\n<span class=\"material-symbols-outlined text-surface-container-lowest text-[18px]\">zoom_in</span>\n</div>\n</div>\n<!-- Upload Prompt -->\n<div class=\"flex flex-col min-w-0 flex-1\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">Invoice_Dunrobin_8241.jpg</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">1.4 MB • Uploaded</span>\n<div class=\"mt-1 flex items-center gap-2\">\n<button class=\"font-label-sm text-label-sm text-secondary hover:underline flex items-center gap-0.5\" type=\"button\">\n<span class=\"material-symbols-outlined text-[13px]\">refresh</span> Replace\n              </button>\n<button class=\"font-label-sm text-label-sm text-error hover:underline flex items-center gap-0.5\" type=\"button\">\n<span class=\"material-symbols-outlined text-[13px]\">delete</span> Remove\n              </button>\n</div>\n</div>\n</div>\n<!-- Snap Button Utility Box -->\n<button class=\"w-full py-2.5 px-4 rounded-xl bg-surface-container-low active:bg-surface-container flex items-center justify-center gap-2 text-on-surface-variant hover:text-primary transition-colors\" onclick=\"simulateSnapReceipt()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px] text-primary\">add_a_photo</span>\n<span class=\"font-label-md text-label-md font-semibold\">Snap additional invoice or oil sticker</span>\n</button>\n</div>\n</div>\n<!-- Schedule Projection Callout -->\n<div class=\"p-space-md rounded-xl bg-gradient-to-r from-primary-fixed/60 via-secondary-fixed/40 to-tertiary-fixed/40 flex items-start gap-3 shadow-sm\">\n<div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary flex-shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[18px]\">update</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Upcoming Interval Calibration</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n          Saving resets the oil cycle countdown to <span class=\"font-bold text-on-surface\">5,000 km</span> or <span class=\"font-bold text-on-surface\">90 days</span>, recalculating your next service for late January 2025.\n        </p>\n</div>\n</div>\n<!-- 8. Bottom Action Area -->\n<div class=\"flex flex-col gap-space-xs mt-2\">\n<button class=\"w-full min-h-[52px] rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 shadow-lg shadow-primary/20 active:scale-[0.98] transition-all\" id=\"saveBtn\" type=\"submit\">\n<span class=\"material-symbols-outlined text-[22px]\">check_circle</span>\n<span>Save Service Log</span>\n</button>\n<div class=\"text-center px-4 py-2\">\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n          Automatically updates your maintenance schedule and resets service countdowns.\n        </p>\n</div>\n</div>\n</form>\n<!-- Interactive Modal: Quick Shop Switcher (Hidden) -->\n<div class=\"hidden fixed inset-0 z-50 bg-on-surface/50 backdrop-blur-sm flex items-end justify-center\" id=\"shopModal\">\n<div class=\"w-full max-w-lg bg-surface-container-lowest rounded-t-2xl p-space-lg flex flex-col gap-4 max-h-[707px] overflow-y-auto\">\n<div class=\"flex items-center justify-between pb-2\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\">local_gas_station</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Select Workshop</h3>\n</div>\n<button class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant\" onclick=\"closeShopModal()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">close</span>\n</button>\n</div>\n<div class=\"flex flex-col gap-2\">\n<button class=\"p-3 text-left rounded-xl bg-surface-container-low hover:bg-surface-container flex flex-col\" onclick=\"selectShop('Precision Auto Works', '14 Dunrobin Ave, St. Andrew')\" type=\"button\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Precision Auto Works</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">14 Dunrobin Ave, St. Andrew (Authorized)</span>\n</button>\n<button class=\"p-3 text-left rounded-xl bg-surface-container-low hover:bg-surface-container flex flex-col\" onclick=\"selectShop('Motor Sales &amp; Service Ltd', 'Half-Way-Tree Road, Kingston 5')\" type=\"button\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Motor Sales &amp; Service Ltd</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Half-Way-Tree Road, Kingston 5</span>\n</button>\n<button class=\"p-3 text-left rounded-xl bg-surface-container-low hover:bg-surface-container flex flex-col\" onclick=\"selectShop('Bogue Lube &amp; Tyre Centre', 'Alice Eldemire Dr, Montego Bay')\" type=\"button\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Bogue Lube &amp; Tyre Centre</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Alice Eldemire Dr, Montego Bay</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Toast Notification Feedback -->\n<div class=\"fixed bottom-6 left-4 right-4 z-50 pointer-events-none transform translate-y-24 opacity-0 transition-all duration-300 flex justify-center\" id=\"toastNotification\">\n<div class=\"bg-inverse-surface text-inverse-on-surface px-5 py-3 rounded-full shadow-2xl flex items-center gap-2 font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-emerald-400 text-[20px]\">task_alt</span>\n<span id=\"toastMsg\">Service log successfully saved!</span>\n</div>\n</div>\n</div>\n<script>\n  function toggleChip(button) {\n    const isSelected = button.getAttribute('data-selected') === 'true';\n    const checkIcon = button.querySelector('.check-icon');\n    \n    if (isSelected) {\n      button.setAttribute('data-selected', 'false');\n      button.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');\n      button.classList.add('bg-surface-container-high', 'text-on-surface-variant');\n      if (checkIcon) checkIcon.classList.add('hidden');\n    } else {\n      button.setAttribute('data-selected', 'true');\n      button.classList.remove('bg-surface-container-high', 'text-on-surface-variant');\n      button.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');\n      if (checkIcon) checkIcon.classList.remove('hidden');\n    }\n  }\n\n  function promptCustomService() {\n    const serviceName = prompt(\"Enter custom service name (e.g. Spark Plugs Replacement):\");\n    if (serviceName && serviceName.trim().length > 0) {\n      const container = document.getElementById('chipsContainer');\n      const newChip = document.createElement('button');\n      newChip.type = 'button';\n      newChip.setAttribute('data-selected', 'true');\n      newChip.className = 'chip active-chip h-10 px-3.5 rounded-full bg-primary text-on-primary font-label-md text-label-md flex items-center gap-1.5 shadow-sm active:scale-95 transition-transform';\n      newChip.onclick = function() { toggleChip(this); };\n      newChip.innerHTML = `<span class=\"material-symbols-outlined text-[16px] leading-none check-icon\">check</span><span>${serviceName.trim()}</span>`;\n      container.insertBefore(newChip, container.lastElementChild);\n      showToast(`Added \"${serviceName.trim()}\"`);\n    }\n  }\n\n  function syncCluster() {\n    const odoInput = document.getElementById('odometerInput');\n    odoInput.value = \"84,612 km\";\n    showToast(\"Synced from OBD telemetry (84,612 km)\");\n  }\n\n  function setServiceLocationType(type) {\n    const btnShop = document.getElementById('btnShop');\n    const btnDiy = document.getElementById('btnDiy');\n    const shopCard = document.getElementById('shopSelectorCard');\n    const diyCard = document.getElementById('diyInfoContainer');\n\n    if (type === 'shop') {\n      btnShop.className = 'flex-1 min-h-[44px] rounded-lg bg-surface-container-lowest shadow-sm flex items-center justify-center gap-1.5 font-label-md text-label-md text-on-surface transition-all';\n      btnDiy.className = 'flex-1 min-h-[44px] rounded-lg text-on-surface-variant flex items-center justify-center gap-1.5 font-label-md text-label-md transition-all';\n      shopCard.classList.remove('hidden');\n      diyCard.classList.add('hidden');\n    } else {\n      btnDiy.className = 'flex-1 min-h-[44px] rounded-lg bg-surface-container-lowest shadow-sm flex items-center justify-center gap-1.5 font-label-md text-label-md text-on-surface transition-all';\n      btnShop.className = 'flex-1 min-h-[44px] rounded-lg text-on-surface-variant flex items-center justify-center gap-1.5 font-label-md text-label-md transition-all';\n      shopCard.classList.add('hidden');\n      diyCard.classList.remove('hidden');\n    }\n  }\n\n  function showChangeShopModal() {\n    document.getElementById('shopModal').classList.remove('hidden');\n  }\n\n  function closeShopModal() {\n    document.getElementById('shopModal').classList.add('hidden');\n  }\n\n  function selectShop(name, address) {\n    const shopCard = document.getElementById('shopSelectorCard');\n    const h3 = shopCard.querySelector('.font-headline-sm');\n    const addr = shopCard.querySelector('.text-on-surface-variant');\n    if (h3) h3.textContent = name;\n    if (addr) addr.textContent = address;\n    closeShopModal();\n    showToast(`Selected ${name}`);\n  }\n\n  function simulateSnapReceipt() {\n    showToast(\"Camera activated. Attached document photo.\");\n  }\n\n  function showToast(message) {\n    const toast = document.getElementById('toastNotification');\n    const msgSpan = document.getElementById('toastMsg');\n    if (msgSpan) msgSpan.textContent = message;\n    toast.classList.remove('translate-y-24', 'opacity-0');\n    toast.classList.add('translate-y-0', 'opacity-100');\n    setTimeout(() => {\n      toast.classList.add('translate-y-24', 'opacity-0');\n      toast.classList.remove('translate-y-0', 'opacity-100');\n    }, 2800);\n  }\n\n  function triggerSuccessCelebration() {\n    const btn = document.getElementById('saveBtn');\n    btn.innerHTML = `<span class=\"material-symbols-outlined text-[22px] animate-spin\">refresh</span><span>Saving...</span>`;\n    setTimeout(() => {\n      btn.innerHTML = `<span class=\"material-symbols-outlined text-[22px]\">done_all</span><span>Service Logged!</span>`;\n      btn.classList.remove('bg-primary');\n      btn.classList.add('bg-emerald-600');\n      showToast(\"Service log & garage schedule updated!\");\n    }, 800);\n  }\n</script></main></body></html>"}