{"filename":"11-vehicle-not-found.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;min-height:100%;margin:0;padding:0;}body{overscroll-behavior-y:none;-webkit-tap-highlight-color:transparent;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"surface-container-lowest\": \"#ffffff\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary\": \"#9d4300\", \"on-primary-fixed\": \"#370e00\", \"surface-container-highest\": \"#e8e1db\", \"tertiary\": \"#755800\", \"on-surface\": \"#1e1b17\", \"inverse-primary\": \"#ffb599\", \"primary\": \"#a33900\", \"tertiary-container\": \"#936f00\", \"surface\": \"#fff8f2\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-tertiary\": \"#ffffff\", \"on-secondary-fixed\": \"#341100\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary-fixed\": \"#ffdbca\", \"on-primary-fixed-variant\": \"#7f2b00\", \"secondary-container\": \"#fd761a\", \"surface-container-low\": \"#faf2eb\", \"surface-variant\": \"#e8e1db\", \"on-error-container\": \"#93000a\", \"outline-variant\": \"#e2bfb2\", \"secondary-fixed-dim\": \"#ffb690\", \"inverse-on-surface\": \"#f7efe9\", \"on-surface-variant\": \"#5a4138\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"on-error\": \"#ffffff\", \"background\": \"#fff8f2\", \"primary-fixed\": \"#ffdbce\", \"on-tertiary-container\": \"#fffbff\", \"surface-container\": \"#f4ede6\", \"surface-dim\": \"#e0d9d2\", \"surface-tint\": \"#a73a00\", \"primary-container\": \"#cc4900\", \"error\": \"#ba1a1a\", \"inverse-surface\": \"#33302c\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"primary-fixed-dim\": \"#ffb599\", \"on-background\": \"#1e1b17\", \"on-primary-container\": \"#fffbff\", \"surface-container-high\": \"#eee7e0\", \"on-secondary\": \"#ffffff\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-bright\": \"#fff8f2\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-xl\": \"2rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-sm\": \"0.5rem\", \"gutter\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"margin\": \"1rem\", \"space-xs\": \"0.25rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"body-md\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"label-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { lineHeight: \"24px\", fontWeight: \"400\" }], \"label-sm\": [\"10px\", { lineHeight: \"12px\", letterSpacing: \"0.04em\", fontWeight: \"700\" }], \"label-lg\": [\"14px\", { lineHeight: \"20px\", letterSpacing: \"0.01em\", fontWeight: \"600\" }], \"headline-lg\": [\"28px\", { lineHeight: \"36px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"body-md\": [\"14px\", { lineHeight: \"20px\", fontWeight: \"400\" }], \"display-lg-mobile\": [\"32px\", { lineHeight: \"40px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"label-md\": [\"12px\", { lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"600\" }], \"headline-md\": [\"22px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg\": [\"40px\", { lineHeight: \"48px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-sm\": [\"12px\", { lineHeight: \"16px\", fontWeight: \"400\" }], \"price-display\": [\"24px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"headline-sm\": [\"18px\", { lineHeight: \"24px\", fontWeight: \"600\" }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface text-on-surface font-body-md text-body-md min-h-screen flex flex-col pt-safe pb-safe antialiased selection:bg-primary/20\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full pb-10\">\n<!-- Top Navigation Bar -->\n<div class=\"flex items-center justify-between px-space-md py-space-sm bg-surface\">\n<button aria-label=\"Go back\" class=\"w-12 h-12 flex items-center justify-center rounded-full bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors active:scale-95\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">arrow_back</span>\n</button>\n<div class=\"flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed\">\n<span class=\"material-symbols-outlined text-[14px]\" style=\"font-variation-settings: 'FILL' 1;\">directions_car</span>\n<span class=\"font-label-sm text-label-sm tracking-wider uppercase\">Garage Registry</span>\n</div>\n<button class=\"h-12 px-3 flex items-center justify-center text-on-surface-variant font-label-lg text-label-lg hover:text-primary transition-colors\" type=\"button\">\n      Cancel\n    </button>\n</div>\n<div class=\"px-space-md flex flex-col gap-5 mt-2\">\n<!-- Title & Context -->\n<div class=\"flex flex-col gap-1.5\">\n<div class=\"flex items-center gap-2\">\n<h1 class=\"font-display-lg-mobile text-display-lg-mobile text-on-surface\">Tell us about your car</h1>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n        Can't find your exact trim or Japanese domestic import spec? Send the specs and our Jamaican automotive team will index it.\n      </p>\n</div>\n<!-- Friendly Speed Guarantee Banner -->\n<div class=\"rounded-xl p-4 bg-tertiary-fixed text-on-tertiary-fixed shadow-sm flex flex-col gap-2\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider bg-on-tertiary-fixed text-tertiary-fixed px-2 py-0.5 rounded-full\">\n          Instant Access\n        </span>\n<div class=\"flex items-center gap-1 font-label-md text-label-md text-on-tertiary-fixed-variant\">\n<span class=\"material-symbols-outlined text-[16px]\">bolt</span>\n<span>Zero Waiting</span>\n</div>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-tertiary-fixed leading-relaxed\">\n        We'll add your ride to Jamaica's master catalog within 24 hours. You can track fuel &amp; tolls right now — your parish-spec service schedule unlocks upon verification!\n      </p>\n</div>\n<!-- Main Spec Form Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-4\">\n<div class=\"flex items-center justify-between pb-1\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">Vehicle Details</span>\n<span class=\"font-label-sm text-label-sm text-primary uppercase\">Quick Verification</span>\n</div>\n<!-- Make Field -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"car-make\">Make</label>\n<div class=\"relative flex items-center\">\n<input class=\"w-full h-12 px-3.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest outline-none shadow-sm\" id=\"car-make\" placeholder=\"e.g. Toyota, Honda, Subaru, BYD\" type=\"text\" value=\"Toyota\"/>\n<span class=\"material-symbols-outlined absolute right-3 text-secondary text-[20px]\">check_circle</span>\n</div>\n</div>\n<!-- Model Field -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"car-model\">Model / Chassis Trim</label>\n<input class=\"w-full h-12 px-3.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest outline-none shadow-sm\" id=\"car-model\" placeholder=\"e.g. Probox, Succeed, Passo, Axio, Fit Shuttle\" type=\"text\" value=\"Succeed Hybrid\"/>\n</div>\n<!-- Year & Engine Row -->\n<div class=\"grid grid-cols-2 gap-3\">\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"car-year\">Model Year</label>\n<div class=\"relative flex items-center\">\n<select class=\"w-full h-12 px-3 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none outline-none shadow-sm pr-8\" id=\"car-year\">\n<option value=\"2024\">2024</option>\n<option value=\"2023\">2023</option>\n<option value=\"2022\">2022</option>\n<option value=\"2021\">2021</option>\n<option value=\"2020\">2020</option>\n<option value=\"2019\">2019</option>\n<option selected=\"\" value=\"2018\">2018</option>\n<option value=\"2017\">2017</option>\n<option value=\"2016\">2016</option>\n<option value=\"2015\">2015</option>\n<option value=\"older\">Older (Classic / Route spec)</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-2.5 pointer-events-none text-on-surface-variant text-[20px]\">expand_more</span>\n</div>\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"car-engine\">Displacement</label>\n<input class=\"w-full h-12 px-3 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest outline-none shadow-sm\" id=\"car-engine\" placeholder=\"e.g. 1.5L 1NZ-FXE\" type=\"text\" value=\"1.5L\"/>\n</div>\n</div>\n<!-- Fuel Grade Selector -->\n<div class=\"flex flex-col gap-2 pt-1\">\n<label class=\"font-label-md text-label-md text-on-surface\">Recommended Fuel Grade in Jamaica</label>\n<div class=\"grid grid-cols-2 gap-2\" id=\"fuel-group\">\n<!-- E-10 87 -->\n<button class=\"fuel-chip h-12 px-3 rounded-lg bg-surface-container-low text-on-surface flex items-center justify-between active:scale-[0.98] transition-transform\" data-fuel=\"87\" type=\"button\">\n<span class=\"font-label-lg text-label-lg\">E-10 87</span>\n<span class=\"w-3.5 h-3.5 rounded-full bg-surface-variant\"></span>\n</button>\n<!-- E-10 90 (Pre-selected) -->\n<button class=\"fuel-chip h-12 px-3 rounded-lg bg-primary-container text-on-primary-container shadow-sm flex items-center justify-between active:scale-[0.98] transition-transform\" data-fuel=\"90\" type=\"button\">\n<span class=\"font-label-lg text-label-lg font-bold\">E-10 90</span>\n<span class=\"material-symbols-outlined text-[18px]\">check</span>\n</button>\n<!-- Ultra Low Sulfur Diesel -->\n<button class=\"fuel-chip h-12 px-3 rounded-lg bg-surface-container-low text-on-surface flex items-center justify-between active:scale-[0.98] transition-transform\" data-fuel=\"diesel\" type=\"button\">\n<span class=\"font-label-lg text-label-lg\">ULSD Diesel</span>\n<span class=\"w-3.5 h-3.5 rounded-full bg-surface-variant\"></span>\n</button>\n<!-- Hybrid / EV -->\n<button class=\"fuel-chip h-12 px-3 rounded-lg bg-surface-container-low text-on-surface flex items-center justify-between active:scale-[0.98] transition-transform\" data-fuel=\"hybrid\" type=\"button\">\n<span class=\"font-label-lg text-label-lg\">Hybrid / EV</span>\n<span class=\"w-3.5 h-3.5 rounded-full bg-surface-variant\"></span>\n</button>\n</div>\n</div>\n<!-- Transmission Selector Chips -->\n<div class=\"flex flex-col gap-2 pt-1\">\n<label class=\"font-label-md text-label-md text-on-surface\">Transmission</label>\n<div class=\"grid grid-cols-2 gap-2\" id=\"trans-group\">\n<button class=\"trans-chip h-12 rounded-lg bg-on-surface text-surface flex items-center justify-center gap-2 font-label-lg text-label-lg\" data-trans=\"auto\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">auto_transmission</span>\n<span>Automatic / CVT</span>\n</button>\n<button class=\"trans-chip h-12 rounded-lg bg-surface-container-low text-on-surface flex items-center justify-center gap-2 font-label-lg text-label-lg\" data-trans=\"manual\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">save_as</span>\n<span>Manual Stick</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Optional Photo Placard Upload Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-3\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[18px]\">photo_camera</span>\n</div>\n<div>\n<span class=\"font-label-lg text-label-lg text-on-surface\">Add Vehicle Photo (Optional)</span>\n<span class=\"font-label-sm text-label-sm text-secondary block\">Speeds up catalogue approval</span>\n</div>\n</div>\n<div class=\"relative w-full h-36 rounded-lg bg-surface-container overflow-hidden flex flex-col items-center justify-center cursor-pointer group shadow-inner\">\n<img class=\"absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-30 transition-opacity\" data-alt=\"Close up photograph of a Japanese import vehicle silver chassis ID placard stamped inside the engine bay with VIN, engine code, and color code, photographed under bright tropical Caribbean sunlight with clean mechanics tools in soft focus\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCUKWD6MFOlYGcS2JxQwbYouI2uEFHEL0mePS1ZD4LfLBMGhzR1o4zcrRJzUAi2LhmgwINwW-zxBjag0719XRe_VxYy5h447HtM_5oY_IO_Fuqz54wmFCHaAMd4VEsvSZxEF0Iocr3QDhZkOVvpDtkLGyBoHcC-4jgniQVqvvN8X_LPNoLuBRPcXtr9q_3wF56VKctwUMKf1_4kBbgB3kR8qbUf7QwGRwJRtdox5AWPgGCEJ1KnNjyj\"/>\n<div class=\"relative z-10 flex flex-col items-center text-center px-4\">\n<div class=\"w-12 h-12 rounded-full bg-surface-container-lowest shadow-md flex items-center justify-center text-primary mb-2\">\n<span class=\"material-symbols-outlined text-[24px]\">add_a_photo</span>\n</div>\n<p class=\"font-label-md text-label-md text-on-surface font-semibold\">Snap Door Jamb or Chassis Plate</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant max-w-[240px] mt-0.5\">\n            Gives us your Japanese chassis code (e.g. NCP160, DBA-ZVW52) for 100% correct part specs.\n          </p>\n</div>\n</div>\n</div>\n<!-- Island Mechanics Trust Callout -->\n<div class=\"rounded-xl p-3.5 bg-surface-container-low shadow-sm flex items-start gap-3\">\n<div class=\"w-9 h-9 rounded-full bg-tertiary-fixed-dim text-on-tertiary-fixed flex items-center justify-center shrink-0 shadow-xs\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">verified_user</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-md text-label-md text-on-surface font-bold\">Local Parts Guarantee</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n          Indexing your engine lets mechanics from Montego Bay to Downtown Kingston match genuine oil filters, brake pads, and spark plugs without guessing.\n        </p>\n</div>\n</div>\n<!-- Primary Action Button & Footer Prompt -->\n<div class=\"flex flex-col gap-2 pt-2\">\n<button class=\"w-full h-12 rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 shadow-md active:bg-primary-container transition-all\" id=\"submit-car-btn\" type=\"button\">\n<span>Submit &amp; Continue</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<div class=\"flex items-center justify-center gap-1.5 text-center text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[14px]\">save</span>\n<span class=\"font-body-sm text-body-sm\">Saves draft vehicle &amp; proceeds to odometer calibration</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n  (function() {\n    // Interactive Fuel Grade Chips\n    const fuelChips = document.querySelectorAll('.fuel-chip');\n    fuelChips.forEach(chip => {\n      chip.addEventListener('click', () => {\n        fuelChips.forEach(c => {\n          c.className = 'fuel-chip h-12 px-3 rounded-lg bg-surface-container-low text-on-surface flex items-center justify-between active:scale-[0.98] transition-transform';\n          c.innerHTML = '<span class=\"font-label-lg text-label-lg\">' + c.querySelector('span').innerText + '</span><span class=\"w-3.5 h-3.5 rounded-full bg-surface-variant\"></span>';\n        });\n        chip.className = 'fuel-chip h-12 px-3 rounded-lg bg-primary-container text-on-primary-container shadow-sm flex items-center justify-between active:scale-[0.98] transition-transform';\n        const label = chip.querySelector('span').innerText;\n        chip.innerHTML = '<span class=\"font-label-lg text-label-lg font-bold\">' + label + '</span><span class=\"material-symbols-outlined text-[18px]\">check</span>';\n      });\n    });\n\n    // Transmission Chips\n    const transChips = document.querySelectorAll('.trans-chip');\n    transChips.forEach(chip => {\n      chip.addEventListener('click', () => {\n        transChips.forEach(tc => {\n          tc.className = 'trans-chip h-12 rounded-lg bg-surface-container-low text-on-surface flex items-center justify-center gap-2 font-label-lg text-label-lg';\n        });\n        chip.className = 'trans-chip h-12 rounded-lg bg-on-surface text-surface flex items-center justify-center gap-2 font-label-lg text-label-lg';\n      });\n    });\n\n    // Submit micro-feedback\n    const submitBtn = document.getElementById('submit-car-btn');\n    if (submitBtn) {\n      submitBtn.addEventListener('click', () => {\n        submitBtn.innerHTML = '<span class=\"material-symbols-outlined animate-spin text-[20px]\">progress_activity</span><span>Indexing specs...</span>';\n        setTimeout(() => {\n          submitBtn.innerHTML = '<span class=\"material-symbols-outlined text-[20px]\">check_circle</span><span>Vehicle Draft Saved!</span>';\n          submitBtn.classList.replace('bg-primary', 'bg-tertiary-container');\n        }, 800);\n      });\n    }\n  })();\n</script></main></body></html>"}