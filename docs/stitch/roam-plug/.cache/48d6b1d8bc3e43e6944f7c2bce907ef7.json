t-1 shadow-sm\"></div>\n</div>\n<!-- Map Pin 2: Cool Oasis Kingsway -->\n<div class=\"absolute top-28 right-12 flex flex-col items-center cursor-pointer group active:scale-95 transition-transform\">\n<div class=\"flex items-center gap-1 bg-surface-container-lowest text-on-surface px-2 py-1 rounded-full shadow-md\">\n<span class=\"font-label-md text-label-md font-bold\">J$209.50</span>\n</div>\n<div class=\"bg-surface-container-lowest px-1.5 py-0.5 rounded shadow-sm text-on-surface-variant font-label-sm text-[9px] mt-0.5\">\n        Cool Oasis\n      </div>\n<div class=\"w-1.5 h-1.5 bg-surface-container-lowest rotate-45 -mt-1\"></div>\n</div>\n<!-- Map Pin 3: Texaco Clock Tower Roundabout -->\n<div class=\"absolute bottom-20 left-1/3 flex flex-col items-center cursor-pointer group active:scale-95 transition-transform\">\n<div class=\"flex items-center gap-1 bg-surface-container-lowest text-on-surface px-2 py-1 rounded-full shadow-md\">\n<span class=\"font-label-md text-label-md font-bold\">J$214.50</span>\n</div>\n<div class=\"bg-surface-container-lowest px-1.5 py-0.5 rounded shadow-sm text-on-surface-variant font-label-sm text-[9px] mt-0.5\">\n        Texaco\n      </div>\n<div class=\"w-1.5 h-1.5 bg-surface-container-lowest rotate-45 -mt-1\"></div>\n</div>\n<!-- Map Pin 4: Mechanic / Auto Plug -->\n<div class=\"absolute top-8 right-1/3 flex items-center justify-center w-7 h-7 rounded-full bg-secondary text-on-secondary shadow-md cursor-pointer\">\n<span class=\"material-symbols-outlined text-[16px]\">build</span>\n</div>\n<!-- Map Pin 5: Free Air Pump Indicator -->\n<div class=\"absolute bottom-24 right-20 flex items-center justify-center w-7 h-7 rounded-full bg-surface-container-highest text-on-surface shadow-md cursor-pointer\">\n<span class=\"material-symbols-outlined text-[16px]\">air</span>\n</div>\n<!-- Recenter & Layer Floating Controls -->\n<div class=\"absolute bottom-4 right-4 flex flex-col gap-2 z-20\">\n<button aria-label=\"Recenter Map\" class=\"w-10 h-10 rounded-full bg-surface-container-lowest text-on-surface shadow-md flex items-center justify-center active:bg-surface-container transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">my_location</span>\n</button>\n<button aria-label=\"Toggle Satellite / Traffic\" class=\"w-10 h-10 rounded-full bg-surface-container-lowest text-on-surface shadow-md flex items-center justify-center active:bg-surface-container transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">layers</span>\n</button>\n</div>\n</section>\n<!-- Bottom Sheet: Driver Feed & Guest Discovery Deck -->\n<section class=\"flex flex-col gap-space-md px-space-md -mt-4 relative z-30 bg-surface rounded-t-3xl pt-3 pb-8 shadow-xl\">\n<!-- Draggable Pill Indicator -->\n<div class=\"w-12 h-1.5 rounded-full bg-surface-container-highest mx-auto\"></div>\n<!-- Guest Mode Value Hook: Maintenance & Document Vault Teaser -->\n<div class=\"relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary-container via-secondary to-primary p-space-md text-on-primary shadow-md\">\n<!-- Decorative Island Sun Graphic Accent -->\n<div class=\"absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-tertiary-fixed/20 pointer-events-none blur-xl\"></div>\n<div class=\"relative z-10 flex flex-col gap-2\">\n<div class=\"flex items-center justify-between\">\n<span class=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-on-primary/20 backdrop-blur-sm font-label-sm text-label-sm uppercase tracking-wider text-on-primary font-bold\">\n<span class=\"material-symbols-outlined text-[14px]\">stars</span> Driver Co-Pilot\n          </span>\n<span class=\"font-label-sm text-label-sm text-primary-fixed\">Guest Mode</span>\n</div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-primary font-bold leading-snug\">\n          Track your car's maintenance for free\n        </h2>\n<p class=\"font-body-md text-body-md text-primary-fixed font-normal leading-relaxed\">\n          Log fuel stops, get Jamaican fitness &amp; oil change reminders, and never miss statutory road service.\n        </p>\n<div class=\"pt-2 flex items-center gap-3\">\n<button class=\"h-11 px-5 rounded-xl bg-surface-container-lowest text-primary font-label-lg text-label-lg font-bold shadow-md active:scale-95 transition-transform flex items-center gap-2\" onclick=\"showGuestModal()\" type=\"button\">\n<span>Create free account</span>\n<span class=\"material-symbols-outlined text-[18px]\">arrow_forward</span>\n</button>\n<button class=\"font-label-md text-label-md text-primary-fixed underline decoration-primary-fixed/60 font-semibold py-2\" onclick=\"showGuestModal()\" type=\"button\">\n            Sign In\n          </button>\n</div>\n</div>\n</div>\n<!-- Section Title: Best Rate Callout -->\n<div class=\"flex items-center justify-between pt-1\">\n<div class=\"flex items-center gap-2\">\n<span class=\"flex h-2.5 w-2.5 rounded-full bg-tertiary-container\"></span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Cheapest E-10 87 Near You</h3>\n</div>\n<span class=\"font-label-md text-label-md text-secondary font-bold\">St Andrew Hub</span>\n</div>\n<!-- Highlighted Hero Station Card: Fesco Beechwood -->\n<article class=\"flex flex-col bg-surface-container-lowest rounded-2xl p-space-md shadow-sm gap-space-sm relative overflow-hidden\">\n<!-- Golden Best Rate Badge -->\n<div class=\"absolute top-0 right-0 bg-tertiary-fixed text-on-tertiary-fixed px-3 py-1 rounded-bl-xl font-label-sm text-label-sm font-bold flex items-center gap-1 shadow-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">local_fire_department</span>\n<span>Cheapest E-10</span>\n</div>\n<!-- Station Header Row -->\n<div class=\"flex items-start gap-3 pr-24\">\n<div class=\"w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-on-primary-fixed font-headline-sm text-headline-sm font-bold shadow-inner flex-shrink-0\">\n          F\n        </div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold truncate\">Fesco Beechwood</h4>\n<span class=\"material-symbols-outlined text-emerald-600 text-[18px]\" title=\"Community Verified\">verified</span>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Beechwood Ave, Kingston 5 • 0.8 km</span>\n</div>\n</div>\n<!-- Price & Verification Grid -->\n<div class=\"flex items-end justify-between bg-surface-container-low p-3 rounded-xl\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold\">E-10 87 Octane</span>\n<div class=\"flex items-baseline gap-1 mt-0.5\">\n<span class=\"font-price-display text-price-display text-on-surface font-black\">J$208.20</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">/ Litre</span>\n</div>\n</div>\n<div class=\"flex items-center gap-1 text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-emerald-600\">check_circle</span>\n<span>Verified 22m ago by Andre B.</span>\n</div>\n</div>\n<!-- Action Buttons Row -->\n<div class=\"grid grid-cols-2 gap-2.5 pt-1\">\n<button class=\"h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-sm active:bg-secondary-container transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">directions</span>\n<span>Drive Now (3m)</span>\n</button>\n<button class=\"h-12 rounded-xl bg-surface-container text-on-surface-variant font-label-lg text-label-lg font-semibold flex items-center justify-center gap-1.5 active:bg-surface-container-high transition-colors\" onclick=\"showGuestModal()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">lock</span>\n<span>Sign in to log</span>\n</button>\n</div>\n</article>\n<!-- Other Gas Plugs Nearby Header -->\n<div class=\"flex items-center justify-between pt-2\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Other Gas Plugs Nearby</h3>\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Updated in real-time</span>\n</div>\n<!-- Station List Row 1: Cool Oasis Kingsway -->\n<article class=\"flex flex-col bg-surface-container-lowest rounded-2xl p-space-md shadow-sm gap-2 active:bg-surface-container-low transition-colors cursor-pointer\">\n<div class=\"flex items-start justify-between\">\n<div class=\"flex items-start gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary font-headline-sm text-headline-sm font-bold flex-shrink-0\">\n            C\n          </div>\n<div class=\"flex flex-col\">\n<h4 class=\"font-headline-sm text-label-lg text-on-surface font-bold\">Cool Oasis • Kingsway</h4>\n<div class=\"flex items-center gap-2 mt-0.5\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">1.4 km away</span>\n<span class=\"text-on-surface-variant text-[10px]\">•</span>\n<span class=\"font-label-sm text-label-sm text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded\">Free Air</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">24/7</span>\n</div>\n</div>\n</div>\n<div class=\"flex flex-col items-end\">\n<span class=\"font-headline-sm text-label-lg font-bold text-on-surface\">J$209.50</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">E-10 87</span>\n</div>\n</div>\n</article>\n<!-- Station List Row 2: Texaco Clock Tower -->\n<article class=\"flex flex-col bg-surface-container-lowest rounded-2xl p-space-md shadow-sm gap-2 active:bg-surface-container-low transition-colors cursor-pointer\">\n<div class=\"flex items-start justify-between\">\n<div class=\"flex items-start gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-error-container flex items-center justify-center text-error font-headline-sm text-headline-sm font-bold flex-shrink-0\">\n            T\n          </div>\n<div class=\"flex flex-col\">\n<h4 class=\"font-headline-sm text-label-lg text-on-surface font-bold\">Texaco • Clock Tower Roundabout</h4>\n<div class=\"flex items-center gap-2 mt-0.5\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">0.4 km away</span>\n<span class=\"text-on-surface-variant text-[10px]\">•</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2 py-0.5 rounded\">ATM</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Restrooms</span>\n</div>\n</div>\n</div>\n<div class=\"flex flex-col items-end\">\n<span class=\"font-headline-sm text-label-lg font-bold text-on-surface\">J$214.50</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">E-10 87</span>\n</div>\n</div>\n</article>\n<!-- Community Tip Banner -->\n<div class=\"flex items-center gap-3 bg-surface-container p-space-md rounded-2xl text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-primary text-[24px]\">lightbulb</span>\n<p class=\"font-body-sm text-body-sm leading-relaxed\">\n<strong class=\"text-on-surface\">Did you know?</strong> Gas rates update every Thursday from Petrojam. Community plugs keep prices accurate island-wide!\n      </p>\n</div>\n</section>\n<!-- Floating Action Button: + MAP SPOT (Guest Protected with Sign in Prompt) -->\n<aside class=\"fixed bottom-20 right-4 z-40\">\n<button aria-label=\"Sign in to Pin Spot\" class=\"flex items-center gap-2 h-12 px-4 rounded-full bg-primary text-on-primary shadow-xl active:scale-95 transition-transform\" onclick=\"showGuestModal()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">add_location_alt</span>\n<span class=\"font-label-lg text-label-lg font-bold tracking-tight\">+ MAP SPOT</span>\n<span class=\"w-5 h-5 rounded-full bg-on-primary/20 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[13px] text-on-primary\">lock</span>\n</span>\n</button>\n</aside>\n<!-- Interactive Guest Frictionless Conversion Dialog Modal (Hidden by Default) -->\n<dialog class=\"fixed inset-0 w-full h-full bg-inverse-surface/60 backdrop-blur-sm z-50 p-space-md m-0 border-0 flex items-end justify-center opacity-0 pointer-events-none transition-opacity duration-200\" id=\"guest-conversion-modal\">\n<div class=\"w-full max-w-sm bg-surface-container-lowest rounded-3xl p-space-lg flex flex-col gap-space-md shadow-2xl relative\">\n<button aria-label=\"Close dialog\" class=\"absolute top-4 right-4 w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant\" onclick=\"hideGuestModal()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">close</span>\n</button>\n<div class=\"w-12 h-12 rounded-2xl bg-primary-fixed flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[26px]\">car_repair</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<h3 class=\"font-headline-md text-headline-md text-on-surface font-extrabold\">Join Roam Plug Jamaica</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          Create an account to pin price updates, unlock Jamaican fitness reminders, and customize your vehicle garage.\n        </p>\n</div>\n<div class=\"flex flex-col gap-2.5 pt-2\">\n<button class=\"w-full h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 active:scale-95 transition-transform shadow-md\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">person_add</span>\n<span>Sign Up with Phone</span>\n</button>\n<button class=\"w-full h-12 rounded-xl bg-surface-container text-on-surface font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 active:bg-surface-container-high transition-colors\" type=\"button\">\n<span>Continue with Google</span>\n</button>\n</div>\n<p class=\"font-label-sm text-label-sm text-center text-on-surface-variant/80\">\n        By continuing you support the Jamaican motoring community.\n      </p>\n</div>\n</dialog>\n</div>\n<script>\n  function showGuestModal() {\n    const modal = document.getElementById('guest-conversion-modal');\n    if (modal) {\n      modal.classList.remove('opacity-0', 'pointer-events-none');\n      modal.classList.add('opacity-100', 'pointer-events-auto');\n    }\n  }\n\n  function hideGuestModal() {\n    const modal = document.getElementById('guest-conversion-modal');\n    if (modal) {\n      modal.classList.remove('opacity-100', 'pointer-events-auto');\n      modal.classList.add('opacity-0', 'pointer-events-none');\n    }\n  }\n\n  // Intercept the center shell LOG button to trigger guest alert if tapped in guest mode\n  document.addEventListener('DOMContentLoaded', () => {\n    const logBtn = document.querySelector('a[data-path=\"log-fuel\"]');\n    if (logBtn) {\n      logBtn.addEventListener('click', (e) => {\n        e.preventDefault();\n        showGuestModal();\n      });\n    }\n\n    const garageTab = document.querySelector('a[data-path=\"garage\"]');\n    if (garageTab) {\n      garageTab.addEventListener('click', (e) => {\n        e.preventDefault();\n        showGuestModal();\n      });\n    }\n  });\n</script></main><nav class=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_12px_rgba(28,25,23,0.06)]\" data-active-classes=\"text-primary font-bold\"><div class=\"relative flex justify-around items-center h-16 px-space-xs\"><a class=\"flex-1 flex flex-col items-center justify-center gap-0.5 min-h-[48px] min-w-[48px] text-on-surface-variant transition-colors\" data-path=\"explore\" href=\"#\"><span class=\"material-symbols-outlined text-[24px]\">explore</span><span class=\"font-label-sm text-label-sm\">Explore</span></a><a class=\"flex-1 flex flex-col 