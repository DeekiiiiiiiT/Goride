></div></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Parish Selection &amp; Alerts\" class=\"w-11 h-11 min-h-[44px] min-w-[44px] rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full pt-16 pb-28 bg-surface min-h-screen\"><div class=\"flex flex-col w-full relative\">\n<!-- Interactive Top Search & Context Bar -->\n<section class=\"px-space-md pt-space-sm pb-space-xs flex flex-col gap-space-sm z-30\">\n<div class=\"flex items-center justify-between gap-space-sm\">\n<!-- Parish / Location Quick Trigger -->\n<button aria-label=\"Change current location\" class=\"flex items-center gap-1.5 bg-surface-container px-3 py-1.5 rounded-full shadow-sm active:scale-95 transition-transform text-left\" type=\"button\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">location_on</span>\n<span class=\"font-label-md text-label-md text-on-surface truncate max-w-[190px]\">Half-Way-Tree, St Andrew</span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[16px]\">expand_more</span>\n</button>\n<!-- Live Plugs Real-time Signal & Guest Prompt -->\n<div class=\"flex items-center gap-space-xs\">\n<div class=\"flex items-center gap-1.5 bg-surface-container-low px-2.5 py-1 rounded-full shadow-sm\">\n<span class=\"relative flex h-2 w-2\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-600\"></span>\n</span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold\">Live Plugs</span>\n</div>