{"filename":"45-submitted.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/>\n<meta content=\"mobile_blank\" name=\"shell-type\"/>\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n    @layer base {\n      html, body { width: 100vw; margin: 0; padding: 0; }\n      body { overscroll-behavior: none; }\n      .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }\n      .pt-safe { padding-top: env(safe-area-inset-top, 0px); }\n    }\n    ::-webkit-scrollbar { display: none; }\n    body { min-height: max(884px, 100dvh); }\n  </style>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          colors: {\n            \"primary\": \"#a33900\",\n            \"primary-container\": \"#cc4900\",\n            \"on-primary\": \"#ffffff\",\n            \"primary-fixed\": \"#ffdbce\",\n            \"on-primary-fixed-variant\": \"#7f2b00\",\n            \"secondary\": \"#9d4300\",\n            \"secondary-container\": \"#fd761a\",\n            \"on-secondary-container\": \"#5c2400\",\n            \"tertiary\": \"#755800\",\n            \"tertiary-fixed\": \"#ffdf9a\",\n            \"tertiary-fixed-dim\": \"#f7be1d\",\n            \"on-tertiary-fixed\": \"#251a00\",\n            \"background\": \"#fff8f2\",\n            \"surface\": \"#fff8f2\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"surface-container-low\": \"#faf2eb\",\n            \"surface-container\": \"#f4ede6\",\n            \"surface-container-high\": \"#eee7e0\",\n            \"surface-container-highest\": \"#e8e1db\",\n            \"on-surface\": \"#1e1b17\",\n            \"on-surface-variant\": \"#5a4138\",\n            \"outline\": \"#8e7166\",\n            \"outline-variant\": \"#e2bfb2\",\n            \"error\": \"#ba1a1a\"\n          },\n          borderRadius: {\n            \"DEFAULT\": \"0.25rem\",\n            \"lg\": \"0.5rem\",\n            \"xl\": \"0.75rem\",\n            \"2xl\": \"1rem\",\n            \"full\": \"9999px\"\n          },\n          fontFamily: {\n            \"sans\": [\"Inter\", \"sans-serif\"]\n          }\n        }\n      }\n    };\n  </script>\n</head>\n<body class=\"bg-surface font-sans text-on-surface flex flex-col min-h-screen pt-safe pb-safe selection:bg-primary-fixed selection:text-primary\">\n<!-- Top Close/Back Action Bar -->\n<header class=\"sticky top-0 z-30 flex items-center justify-between px-4 py-3 bg-surface border-b border-surface-container-highest/60 backdrop-blur-sm bg-surface/95\">\n<button aria-label=\"Go back or close\" class=\"flex items-center justify-center w-10 h-10 rounded-full hover:bg-surface-container active:bg-surface-container-high text-on-surface transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[24px]\">close</span>\n</button>\n<div class=\"flex items-center gap-1.5 font-bold text-sm tracking-wide text-on-surface\">\n<span>Map It</span>\n<span class=\"text-secondary font-black\">•</span>\n<span class=\"text-on-surface-variant font-medium\">Status</span>\n</div>\n<div class=\"w-10 h-10 flex items-center justify-center\">\n<button aria-label=\"Help &amp; Info\" class=\"flex items-center justify-center w-9 h-9 rounded-full hover:bg-surface-container text-on-surface-variant\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">help_outline</span>\n</button>\n</div>\n</header>\n<!-- Main Scrollable Content -->\n<main class=\"flex-1 w-full max-w-md mx-auto p-4 space-y-4\">\n<!-- Hero Pending Badge Section -->\n<div class=\"flex flex-col items-center justify-center pt-2 pb-1 text-center\">\n<!-- Styled Pending Pin Badge -->\n<div class=\"relative flex items-center justify-center w-28 h-28 mb-3\">\n<!-- Glow / Backdrop -->\n<div class=\"absolute inset-0 rounded-full bg-secondary-container/20 blur-xl\"></div>\n<!-- Dashed Circular Border with Animation/Accent Ring -->\n<svg class=\"absolute inset-0 w-full h-full -rotate-45\" viewbox=\"0 0 112 112\">\n<circle class=\"opacity-80\" cx=\"56\" cy=\"56\" fill=\"none\" r=\"50\" stroke=\"#fd761a\" stroke-dasharray=\"6 5\" stroke-linecap=\"round\" stroke-width=\"2.5\"></circle>\n</svg>\n<!-- Inner Badge Container -->\n<div class=\"relative flex items-center justify-center w-20 h-20 rounded-full bg-surface-container-lowest shadow-md\">\n<div class=\"flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-tr from-primary to-secondary-container text-on-primary shadow-inner\">\n<span class=\"material-symbols-outlined text-[34px]\" style=\"font-variation-settings: 'FILL' 1;\">add_location_alt</span>\n</div>\n<!-- Clock / Hourglass Motif Corner Pill -->\n<div class=\"absolute -bottom-1 -right-1 flex items-center justify-center w-8 h-8 rounded-full bg-tertiary-fixed-dim text-on-tertiary-fixed shadow-md border-2 border-surface-container-lowest\">\n<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">schedule</span>\n</div>\n</div>\n</div>\n<!-- Pending Verification Chip -->\n<div class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-fixed/60 text-on-tertiary-fixed mb-2 shadow-xs\">\n<span class=\"material-symbols-outlined text-[15px]\" style=\"font-variation-settings: 'FILL' 1;\">hourglass_top</span>\n<span class=\"text-xs font-bold uppercase tracking-wider\">Pending Verification</span>\n</div>\n<!-- Headings -->\n<h1 class=\"text-2xl font-extrabold tracking-tight text-on-surface text-center\">\n        Thanks! Your pin is awaiting approval\n      </h1>\n<p class=\"text-sm text-on-surface-variant max-w-xs text-center mt-1.5 leading-relaxed\">\n        The Roam team checks every pin before it goes on the map. We'll notify you once verified.\n      </p>\n</div>\n<!-- Submission Summary Card -->\n<div class=\"w-full bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container-highest/60 p-4\">\n<div class=\"flex items-start justify-between gap-3 pb-3 border-b border-surface-container\">\n<div class=\"flex items-start gap-3 min-w-0\">\n<div class=\"flex items-center justify-center w-11 h-11 rounded-xl bg-surface-container text-primary shrink-0 text-xl font-bold shadow-xs\">\n            ⛽\n          </div>\n<div class=\"min-w-0\">\n<h2 class=\"text-base font-bold text-on-surface truncate\">TotalEnergies Half-Way-Tree</h2>\n<p class=\"text-xs text-on-surface-variant truncate mt-0.5\">Constant Spring Rd, Kingston 10</p>\n</div>\n</div>\n</div>\n<div class=\"flex items-center justify-between pt-3 gap-2\">\n<span class=\"text-xs font-semibold text-on-surface-variant flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">local_gas_station</span>\n          Gas Station\n        </span>\n<!-- Status Pill -->\n<span class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-low text-secondary border border-secondary-container/30 text-xs font-bold\">\n<span class=\"w-2 h-2 rounded-full bg-secondary-container animate-pulse\"></span>\n          Pending Review • ~2-4 hours est.\n        </span>\n</div>\n</div>\n<!-- Community Contribution Card (Warm Gradient Background) -->\n<div class=\"relative w-full rounded-2xl overflow-hidden p-4 bg-gradient-to-br from-primary-container via-secondary-container to-tertiary-fixed text-on-primary shadow-md\">\n<!-- Ambient Decorative Trophy Watermark -->\n<div class=\"absolute -right-5 -bottom-6 opacity-15 pointer-events-none select-none\">\n<span class=\"material-symbols-outlined text-[140px]\">emoji_events</span>\n</div>\n<div class=\"relative z-10 flex flex-col gap-2.5\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<div class=\"flex items-center justify-center w-8 h-8 rounded-full bg-white/20 backdrop-blur-sm text-white\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">emoji_events</span>\n</div>\n<span class=\"text-xs font-bold tracking-wider uppercase text-white/95\">Scout Network</span>\n</div>\n<span class=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-black/15 backdrop-blur-sm text-white\">\n            Rank: Parish Scout Level 2\n          </span>\n</div>\n<div class=\"flex items-baseline justify-between mt-1\">\n<div>\n<div class=\"text-2xl font-black tracking-tight text-white\">\n              12 Places Mapped\n            </div>\n</div>\n<div class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-container-lowest text-primary font-bold text-sm shadow-xs\">\n            +25 Pending Scout Points\n          </div>\n</div>\n<div class=\"mt-1 bg-black/10 rounded-xl p-2.5 backdrop-blur-xs\">\n<p class=\"text-xs text-white/95 flex items-start gap-1.5 leading-snug\">\n<span class=\"material-symbols-outlined text-[15px] shrink-0 mt-0.5 text-tertiary-fixed\" style=\"font-variation-settings: 'FILL' 1;\">thumb_up</span>\n<span>Your pins help over <strong>3,400 Jamaican motorists</strong> find fuel, air, and repairs.</span>\n</p>\n</div>\n</div>\n</div>\n<!-- Verification Steps Card -->\n<div class=\"w-full bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container-highest/60 p-4\">\n<h3 class=\"text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-3\">Verification Process</h3>\n<div class=\"space-y-3\">\n<!-- Step 1: GPS corridor match: Verified -->\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2.5 min-w-0\">\n<div class=\"flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 shrink-0\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n<span class=\"text-sm font-medium text-on-surface\">1. GPS corridor match</span>\n</div>\n<span class=\"text-xs font-bold text-emerald-700\">Verified</span>\n</div>\n<!-- Step 2: Community moderator check: In queue -->\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2.5 min-w-0\">\n<div class=\"flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-800 shrink-0\">\n<span class=\"material-symbols-outlined text-[15px]\" style=\"font-variation-settings: 'FILL' 1;\">schedule</span>\n</div>\n<span class=\"text-sm font-medium text-on-surface\">2. Community moderator check</span>\n</div>\n<span class=\"text-xs font-bold text-amber-700\">In queue</span>\n</div>\n<!-- Step 3: Published to Jamaican Radar (muted) -->\n<div class=\"flex items-center justify-between opacity-60\">\n<div class=\"flex items-center gap-2.5 min-w-0\">\n<div class=\"flex items-center justify-center w-6 h-6 rounded-full bg-surface-container text-on-surface-variant shrink-0\">\n<span class=\"material-symbols-outlined text-[15px]\">sensors</span>\n</div>\n<span class=\"text-sm font-medium text-on-surface\">3. Published to Jamaican Radar</span>\n</div>\n<span class=\"text-xs font-medium text-on-surface-variant\">Pending</span>\n</div>\n</div>\n</div>\n<!-- Bottom Actions -->\n<div class=\"space-y-2.5 pt-2\">\n<!-- Primary button: Map Another Place -->\n<button class=\"w-full bg-primary text-white py-3.5 rounded-xl font-bold flex items-center justify-center gap-2 shadow-sm active:opacity-90 transition-opacity text-sm\" type=\"button\">\n<span class=\"material-symbols-outlined text-[19px]\">add_location</span>\n<span>Map Another Place</span>\n</button>\n<!-- Secondary button: Back to Map -->\n<button class=\"w-full border border-outline py-3 rounded-xl font-semibold w-full text-center text-on-surface flex items-center justify-center gap-2 hover:bg-surface-container/50 active:bg-surface-container transition-colors text-sm\" type=\"button\">\n<span class=\"material-symbols-outlined text-[19px] text-primary\">map</span>\n<span>Back to Map</span>\n</button>\n<!-- Text link: View My Submitted Places -->\n<div class=\"text-center pt-1 pb-2\">\n<a class=\"text-xs font-semibold text-secondary hover:underline underline-offset-4 py-1.5 px-3\" href=\"#submitted-places\">\n          View My Submitted Places\n        </a>\n</div>\n</div>\n</main>\n</body></html>"}