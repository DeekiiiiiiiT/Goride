{"filename":"31-maintenance-schedule.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back\" class=\"w-12 h-12 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Maintenance Schedule</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-24\">\n<!-- Vehicle Header Card -->\n<section class=\"bg-surface-container rounded-xl p-space-md shadow-sm mb-space-md\">\n<div class=\"flex items-start justify-between gap-space-sm mb-space-sm\">\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">2019 Toyota Roomy</span>\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n</div>\n<div class=\"flex items-center gap-space-xs mt-space-xs\">\n<span class=\"bg-surface-container-highest text-on-surface-variant font-label-md text-label-md px-space-sm py-0.5 rounded flex items-center gap-1 shadow-sm\">\n<span>🔒</span>\n<span class=\"tracking-wider\">8241-HY</span>\n</span>\n<span class=\"font-label-md text-label-md text-on-surface-variant\">• 84,612 km</span>\n</div>\n</div>\n<div class=\"w-12 h-12 rounded-lg bg-surface-container-highest overflow-hidden flex-shrink-0 shadow-sm\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A compact metallic bronze 2019 Toyota Roomy parked gracefully under bright Caribbean midday sun with palm trees reflecting off windshield, realistic automotive photography\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAUiOcWucZnld91gH_Ck_Gj32W0rsXuYKJKZ7JgqyCfmR-rDozatjb1NptFMEoakffxHZzIqfD2Vk0pH1DOEtgJTh_gpuomGTvsmTxczMl87UIcXjdT9xdVFK60yFvKN9Qi6KhQgw0Dk3yJdkuMFjLqxkAxrDW9I-khn-tDVaX0SE62vx8D6sC9ydrtuVSJvVvRStB0PkM3mCGWeDj_EjCd8Jl1tCu7x5b_FNYSVa_diAIFaz4CZZqk\"/>\n</div>\n</div>\n<!-- General Schedule Disclaimer Pill -->\n<div class=\"bg-surface-container-lowest rounded-lg p-space-sm flex items-center gap-space-xs shadow-sm\">\n<span class=\"material-symbols-outlined text-secondary text-[18px] flex-shrink-0\">info</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-tight\">\n        General schedule — your exact car's schedule is coming\n      </p>\n</div>\n</section>\n<!-- Driving Telemetry Bar -->\n<section class=\"bg-surface-container-low rounded-xl p-space-md shadow-sm mb-space-lg\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-container/20 flex items-center justify-center flex-shrink-0\">\n<span class=\"material-symbols-outlined text-secondary text-[22px]\">commute</span>\n</div>\n<div class=\"flex flex-col min-w-0 flex-1\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-secondary\">Telemetry Sync</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary\"></span> Moderate Wear\n          </span>\n</div>\n<p class=\"font-label-lg text-label-lg text-on-surface truncate\">\n          ~48 km/day <span class=\"font-body-sm text-body-sm text-on-surface-variant\">(Kingston ↔ Spanish Town)</span>\n</p>\n</div>\n</div>\n</section>\n<!-- Urgent / Overdue Notice -->\n<section class=\"mb-space-lg\">\n<div class=\"bg-surface-container-lowest rounded-xl p-space-sm px-space-md flex items-center justify-between shadow-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-tertiary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n<span class=\"font-label-lg text-label-lg text-on-surface\">No Overdue Items</span>\n</div>\n<span class=\"bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm px-space-sm py-0.5 rounded-full\">OVERDUE (0)</span>\n</div>\n</section>\n<!-- DUE SOON SECTION -->\n<section class=\"mb-space-lg\">\n<div class=\"flex items-center justify-between mb-space-sm px-space-xs\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-secondary-container animate-pulse\"></span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">DUE SOON</h2>\n</div>\n<span class=\"bg-secondary-container text-on-secondary font-label-sm text-label-sm px-space-sm py-0.5 rounded-full\">1 ACTION</span>\n</div>\n<!-- Due Soon Card (Engine Oil) -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-md transition-all active:scale-[0.99] cursor-pointer\">\n<div class=\"flex items-start justify-between gap-space-sm mb-space-xs\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-lg bg-secondary-container/15 flex items-center justify-center flex-shrink-0 text-secondary\">\n<span class=\"material-symbols-outlined text-[24px]\">oil_barrel</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">Engine Oil &amp; Filter Service</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Every 5,000 km or 6 months</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-outline text-[22px]\">chevron_right</span>\n</div>\n<!-- Critical Countdown -->\n<div class=\"bg-surface-container-low rounded-lg p-space-sm my-space-sm\">\n<div class=\"flex items-center justify-between mb-space-xs\">\n<span class=\"font-label-md text-label-md text-secondary font-semibold\">Due at 85,000 km</span>\n<span class=\"font-label-md text-label-md text-secondary font-bold\">~388 km left (~8 days)</span>\n</div>\n<!-- Progress Bar -->\n<div class=\"w-full bg-surface-container-highest h-2.5 rounded-full overflow-hidden\">\n<div class=\"bg-secondary-container h-full rounded-full\" style=\"width: 92%;\"></div>\n</div>\n<div class=\"flex justify-between items-center mt-1 text-[11px] font-label-sm text-on-surface-variant\">\n<span>80,000 km</span>\n<span class=\"text-secondary font-semibold\">Current: 84,612 km (92%)</span>\n<span>85,000 km</span>\n</div>\n</div>\n<!-- Recommendation Spec -->\n<div class=\"flex items-center gap-space-xs pt-space-xs\">\n<span class=\"material-symbols-outlined text-tertiary text-[16px]\">tune</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n          Spec: <span class=\"font-semibold text-on-surface\">0W-20 / 5W-30 Synthetic</span> (Idemitsu / Castrol)\n        </p>\n</div>\n</div>\n</section>\n<!-- UPCOMING SECTION -->\n<section class=\"mb-space-lg\">\n<div class=\"flex items-center justify-between mb-space-sm px-space-xs\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">UPCOMING</h2>\n<span class=\"bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm px-space-sm py-0.5 rounded-full\">4 ITEMS</span>\n</div>\n<div class=\"flex flex-col gap-space-sm\">\n<!-- Item 1: Front Brake Pads -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[20px]\">disc_full</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Front Brake Pads &amp; Rotors</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Every 25,000 km</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium\">5,388 km left</span>\n</div>\n<div class=\"mt-space-sm\">\n<div class=\"w-full bg-surface-container h-1.5 rounded-full overflow-hidden\">\n<div class=\"bg-outline h-full rounded-full\" style=\"width: 65%;\"></div>\n</div>\n<div class=\"flex justify-between items-center mt-1\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Due at 90,000 km</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">~3.5 months</span>\n</div>\n</div>\n</div>\n<!-- Item 2: Air Filter & Cabin AC Filter -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[20px]\">air</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Air Filter &amp; Cabin AC Filter</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Every 15,000 km</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium\">10,388 km left</span>\n</div>\n<div class=\"mt-space-sm\">\n<div class=\"w-full bg-surface-container h-1.5 rounded-full overflow-hidden\">\n<div class=\"bg-outline h-full rounded-full\" style=\"width: 31%;\"></div>\n</div>\n<div class=\"flex justify-between items-center mt-1\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Due at 95,000 km</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">~7 months</span>\n</div>\n</div>\n</div>\n<!-- Item 3: CVT Fluid -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[20px]\">settings_input_component</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">CVT Transmission Fluid (TC/FE)</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Every 40,000 km</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium\">15,388 km left</span>\n</div>\n<div class=\"mt-space-sm\">\n<div class=\"w-full bg-surface-container h-1.5 rounded-full overflow-hidden\">\n<div class=\"bg-outline h-full rounded-full\" style=\"width: 20%;\"></div>\n</div>\n<div class=\"flex justify-between items-center mt-1\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Due at 100,000 km</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">~11 months</span>\n</div>\n</div>\n</div>\n<!-- Item 4: Spark Plugs -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center flex-shrink-0 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[20px]\">bolt</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface\">Spark Plugs (Iridium)</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Every 60,000 km</span>\n</div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium\">35,388 km left</span>\n</div>\n<div class=\"mt-space-sm\">\n<div class=\"w-full bg-surface-container h-1.5 rounded-full overflow-hidden\">\n<div class=\"bg-outline h-full rounded-full\" style=\"width: 10%;\"></div>\n</div>\n<div class=\"flex justify-between items-center mt-1\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Due at 120,000 km</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">~2 years</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- DONE RECENTLY SECTION -->\n<section class=\"mb-space-xl\">\n<div class=\"flex items-center justify-between mb-space-sm px-space-xs\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">DONE RECENTLY</h2>\n<span class=\"bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm px-space-sm py-0.5 rounded-full\">2 LOGGED</span>\n</div>\n<div class=\"flex flex-col gap-space-sm\">\n<!-- Done 1: Tyre Rotation -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"w-8 h-8 rounded-full bg-tertiary-fixed flex items-center justify-center flex-shrink-0 text-on-tertiary-fixed\">\n<span class=\"material-symbols-outlined text-[18px]\">check</span>\n</div>\n<div class=\"flex flex-col flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">Tyre Rotation &amp; Balancing</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">80,000 km</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n              14 Sep 2024 • Sammy's Tyre Repair\n            </p>\n</div>\n</div>\n</div>\n<!-- Done 2: Coolant Flush -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"w-8 h-8 rounded-full bg-tertiary-fixed flex items-center justify-center flex-shrink-0 text-on-tertiary-fixed\">\n<span class=\"material-symbols-outlined text-[18px]\">check</span>\n</div>\n<div class=\"flex flex-col flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">Coolant Flush &amp; Top-up</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">75,000 km</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n              12 May 2024 • Precision Auto Works\n            </p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Sticky / Floating Bottom Actions Bar -->\n<div class=\"fixed bottom-0 left-0 right-0 p-space-md bg-surface/90 backdrop-blur-xl shadow-lg flex flex-col gap-space-xs z-40 max-w-md mx-auto\">\n<button class=\"w-full h-12 bg-primary hover:bg-primary-container active:scale-[0.98] transition-all rounded-lg text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-space-xs shadow-md\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">add_circle</span>\n<span>Log a Service</span>\n</button>\n<button class=\"w-full py-1 text-center font-label-md text-label-md text-secondary hover:text-primary transition-colors flex items-center justify-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">picture_as_pdf</span>\n<span>View History (PDF Export)</span>\n</button>\n</div>\n</div></main></body></html>"}