{"filename":"43b-place-pin-variant.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"error\": \"#ba1a1a\", \"error-container\": \"#ffdad6\", \"surface-bright\": \"#fff8f2\", \"primary-fixed-dim\": \"#ffb599\", \"surface-container-highest\": \"#e8e1db\", \"on-secondary-fixed\": \"#341100\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-container\": \"#936f00\", \"inverse-surface\": \"#33302c\", \"on-secondary-container\": \"#5c2400\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary\": \"#755800\", \"on-error-container\": \"#93000a\", \"on-tertiary\": \"#ffffff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface-container-lowest\": \"#ffffff\", \"background\": \"#fff8f2\", \"on-surface-variant\": \"#5a4138\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-low\": \"#faf2eb\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"outline\": \"#8e7166\", \"on-primary-container\": \"#fffbff\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container\": \"#f4ede6\", \"surface-variant\": \"#e8e1db\", \"on-primary-fixed\": \"#370e00\", \"on-secondary\": \"#ffffff\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary\": \"#9d4300\", \"surface-container-high\": \"#eee7e0\", \"primary-container\": \"#cc4900\", \"on-tertiary-container\": \"#fffbff\", \"primary\": \"#a33900\", \"on-background\": \"#1e1b17\", \"secondary-fixed\": \"#ffdbca\", \"outline-variant\": \"#e2bfb2\", \"surface\": \"#fff8f2\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"margin-lg\": \"1.5rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"margin\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"gutter\": \"1rem\" }, \"fontFamily\": { \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, \"fontSize\": { \"price-display\": [\"24px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</style><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen pt-safe pb-safe\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full relative select-none overflow-hidden pb-4\">\n  <!-- Map Canvas & Interactive Surface -->\n  <div class=\"relative w-full h-[620px] bg-[#e8e4dc] overflow-hidden flex items-center justify-center\">\n    \n    <!-- Stylized Kingston Crossroads Map Geometry -->\n    <svg class=\"absolute inset-0 w-full h-full\" preserveAspectRatio=\"xMidYMid slice\" viewBox=\"0 0 420 620\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- Urban Land Parcels -->\n      <path d=\"M-20 -20 H180 V220 H-20 Z\" fill=\"#eae4db\"/>\n      <path d=\"M220 -20 H440 V160 H220 Z\" fill=\"#dfd8cd\"/>\n      <path d=\"M-20 280 H140 V640 H-20 Z\" fill=\"#e4ddd3\"/>\n      <path d=\"M210 320 H440 V640 H210 Z\" fill=\"#e9e3da\"/>\n      <path d=\"M140 380 H210 V640 H140 Z\" fill=\"#ded7cc\"/>\n      \n      <!-- Greenery & Urban Parks (e.g. Mandela Park pocket) -->\n      <rect x=\"235\" y=\"40\" width=\"75\" height=\"90\" rx=\"8\" fill=\"#d2deca\" opacity=\"0.8\"/>\n      <path d=\"M30 420 Q60 390 100 420 T130 500 L30 500 Z\" fill=\"#d6e2cf\" opacity=\"0.7\"/>\n\n      <!-- Secondary Roads / Arterials -->\n      <path d=\"M-20 120 L440 210\" stroke=\"#ffffff\" stroke-width=\"12\" stroke-linecap=\"round\"/>\n      <path d=\"M60 -20 L90 640\" stroke=\"#ffffff\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n      <path d=\"M290 190 L440 380\" stroke=\"#ffffff\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n      \n      <!-- Primary Crossroads: Constant Spring Rd & Eastwood Park Rd & Hagley Park -->\n      <!-- Constant Spring Rd (North-South main spine) -->\n      <path d=\"M205 -30 L175 650\" stroke=\"#fed7aa\" stroke-width=\"26\" stroke-linecap=\"round\"/>\n      <path d=\"M205 -30 L175 650\" stroke=\"#ffffff\" stroke-width=\"18\" stroke-linecap=\"round\"/>\n      \n      <!-- Eastwood Park Rd / Half-Way Tree Intersection (Diagonals) -->\n      <path d=\"M-30 250 L440 275\" stroke=\"#fed7aa\" stroke-width=\"24\" stroke-linecap=\"round\"/>\n      <path d=\"M-30 250 L440 275\" stroke=\"#ffffff\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n\n      <!-- Traffic Clockwise HWT Transport Centre Roundabout Hub -->\n      <ellipse cx=\"190\" cy=\"262\" rx=\"34\" ry=\"34\" fill=\"#f4ede6\" stroke=\"#ffffff\" stroke-width=\"10\"/>\n      <circle cx=\"190\" cy=\"262\" r=\"14\" fill=\"#ded7cc\"/>\n\n      <!-- Road Names On Canvas -->\n      <text x=\"216\" y=\"80\" fill=\"#8e7166\" font-size=\"9\" font-family=\"Inter\" font-weight=\"700\" letter-spacing=\"1\" transform=\"rotate(78 216 80)\">CONSTANT SPRING RD</text>\n      <text x=\"40\" y=\"242\" fill=\"#8e7166\" font-size=\"9\" font-family=\"Inter\" font-weight=\"700\" letter-spacing=\"0.8\">EASTWOOD PARK RD</text>\n      <text x=\"270\" y=\"292\" fill=\"#8e7166\" font-size=\"9\" font-family=\"Inter\" font-weight=\"700\" letter-spacing=\"0.8\">HALF-WAY-TREE RD</text>\n      <text x=\"242\" y=\"90\" fill=\"#5a7d4a\" font-size=\"8\" font-family=\"Inter\" font-weight=\"600\">Nelson Mandela Park</text>\n\n      <!-- Building Footprints -->\n      <rect x=\"110\" y=\"80\" width=\"36\" height=\"28\" rx=\"3\" fill=\"#cfc8bc\"/>\n      <rect x=\"235\" y=\"195\" width=\"45\" height=\"34\" rx=\"4\" fill=\"#c7bfb2\"/>\n      <rect x=\"75\" y=\"310\" width=\"50\" height=\"42\" rx=\"4\" fill=\"#cdc6ba\"/>\n      <rect x=\"230\" y=\"350\" width=\"64\" height=\"48\" rx=\"4\" fill=\"#d3ccbf\"/>\n    </svg>\n\n    <!-- Faint Nearby Places (Landmarks) -->\n    <!-- Mario's Auto Parts -->\n    <div class=\"absolute top-[160px] left-[42px] z-10 flex items-center gap-1.5 bg-surface/90 backdrop-blur-sm px-2.5 py-1 rounded-full shadow-sm\">\n      <span class=\"material-symbols-outlined text-outline text-[14px]\">build</span>\n      <div class=\"flex flex-col\">\n        <span class=\"font-label-sm text-on-surface truncate max-w-[90px]\">Mario's Auto</span>\n        <span class=\"font-label-sm text-outline\">180m</span>\n      </div>\n    </div>\n\n    <!-- Tastee Patties -->\n    <div class=\"absolute top-[340px] right-[40px] z-10 flex items-center gap-1.5 bg-surface/90 backdrop-blur-sm px-2.5 py-1 rounded-full shadow-sm\">\n      <span class=\"material-symbols-outlined text-outline text-[14px]\">fastfood</span>\n      <div class=\"flex flex-col\">\n        <span class=\"font-label-sm text-on-surface truncate max-w-[90px]\">Tastee Patties</span>\n        <span class=\"font-label-sm text-outline\">120m</span>\n      </div>\n    </div>\n\n    <!-- Existing TOTAL Station Pin Marker (Context for Duplicate Prompt) -->\n    <div class=\"absolute top-[230px] right-[110px] z-10 flex items-center gap-1 bg-surface-container-high/95 px-2 py-1 rounded-full shadow-sm\">\n      <span class=\"material-symbols-outlined text-error text-[15px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n      <span class=\"font-label-sm text-on-surface-variant font-semibold\">Total HWT (25m)</span>\n    </div>\n\n    <!-- Pulsing GPS Radar Ground Rings centered on crosshair -->\n    <div class=\"absolute pointer-events-none flex items-center justify-center\">\n      <div class=\"w-36 h-36 rounded-full bg-primary/10 animate-ping opacity-50\"></div>\n      <div class=\"absolute w-24 h-24 rounded-full bg-primary/15 animate-pulse\"></div>\n      <div class=\"absolute w-12 h-12 rounded-full bg-primary/20\"></div>\n    </div>\n\n    <!-- Central Interactive Pin Drop Unit -->\n    <div class=\"relative z-20 flex flex-col items-center -translate-y-9 pointer-events-none\">\n      \n      <!-- Instructional Floating Speech Bubble -->\n      <div class=\"mb-2 bg-inverse-surface/95 text-inverse-on-surface px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5 max-w-[260px] animate-bounce\">\n        <span class=\"material-symbols-outlined text-secondary-fixed text-[16px]\">touch_app</span>\n        <span class=\"font-label-sm leading-tight text-center\">Drag map to align crosshairs with station entrance</span>\n      </div>\n\n      <!-- Station Pin Icon & Outer Halo -->\n      <div class=\"relative flex items-center justify-center\">\n        <!-- Floating Shadow -->\n        <div class=\"absolute -bottom-2 w-7 h-2.5 bg-black/35 rounded-full blur-[2px]\"></div>\n\n        <!-- The Marker Head -->\n        <div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-xl\">\n          <span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n        </div>\n      </div>\n\n      <!-- Pin Base / Needle Point -->\n      <div class=\"w-3 h-3 bg-primary-container rotate-45 -mt-1.5 rounded-xs\"></div>\n      \n      <!-- Crosshair Target Dot -->\n      <div class=\"w-2.5 h-2.5 rounded-full bg-primary mt-1 shadow-sm\"></div>\n    </div>\n\n    <!-- Re-Center Map Floating Action Button -->\n    <button type=\"button\" aria-label=\"Re-center on current GPS\" class=\"absolute right-4 bottom-44 z-20 w-12 h-12 rounded-full bg-surface-container-lowest text-on-surface flex items-center justify-center shadow-lg active:scale-95 transition-transform\">\n      <span class=\"material-symbols-outlined text-primary text-[24px]\">my_location</span>\n    </button>\n  </div>\n\n  <!-- FLOATING TOP OVERLAY BAR -->\n  <div class=\"absolute top-3 inset-x-3 z-30 flex flex-col gap-2\">\n    <!-- Main Top Strip -->\n    <div class=\"w-full bg-surface-container-lowest/95 backdrop-blur-md rounded-2xl px-3.5 py-2.5 flex items-center justify-between shadow-md\">\n      <!-- Left: Step Back / Cancel -->\n      <div class=\"flex items-center gap-2\">\n        <button type=\"button\" aria-label=\"Close\" class=\"w-9 h-9 rounded-full bg-surface-variant/50 text-on-surface flex items-center justify-center active:bg-surface-variant transition-colors\">\n          <span class=\"material-symbols-outlined text-[20px]\">close</span>\n        </button>\n        <div class=\"flex flex-col\">\n          <span class=\"font-label-sm text-secondary uppercase tracking-wider\">Step 2 of 3</span>\n          <h1 class=\"font-headline-sm text-on-surface leading-none\">Position Pin</h1>\n        </div>\n      </div>\n\n      <!-- Right: Live Precision Pill -->\n      <div class=\"flex items-center gap-1.5 bg-surface-container-low px-2.5 py-1.5 rounded-full\">\n        <span class=\"w-2.5 h-2.5 rounded-full bg-green-600 animate-pulse\"></span>\n        <div class=\"flex flex-col text-right\">\n          <span class=\"font-label-sm text-on-surface font-bold\">±8 m</span>\n          <span class=\"font-label-sm text-outline text-[9px] leading-none\">High Precision</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- GPS Signal Warning Note / Alternative Switcher Banner -->\n    <div class=\"w-full bg-amber-50 rounded-xl px-3 py-2 flex items-center justify-between shadow-sm\">\n      <div class=\"flex items-center gap-2 min-w-0\">\n        <span class=\"material-symbols-outlined text-tertiary-container text-[18px]\">satellite_alt</span>\n        <span class=\"font-body-sm text-on-surface-variant truncate\">\n          <strong class=\"text-tertiary-container\">±45 m</strong> — move outside for better signal\n        </span>\n      </div>\n      <button type=\"button\" class=\"font-label-sm text-primary font-bold pl-2 shrink-0\">\n        Refresh\n      </button>\n    </div>\n  </div>\n\n  <!-- DUPLICATE WARNING CARD (Floating Contextual Alert) -->\n  <div class=\"px-4 -mt-24 z-30 w-full\">\n    <div class=\"w-full bg-surface-container-lowest rounded-2xl p-4 shadow-xl flex flex-col gap-3\">\n      <!-- Alert Header -->\n      <div class=\"flex items-start gap-3\">\n        <div class=\"w-10 h-10 rounded-full bg-amber-100 text-tertiary flex items-center justify-center shrink-0\">\n          <span class=\"material-symbols-outlined text-[22px]\">warning</span>\n        </div>\n        <div class=\"flex-1 min-w-0\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"font-label-sm bg-amber-200 text-on-tertiary-fixed px-1.5 py-0.5 rounded font-bold\">25m away</span>\n            <span class=\"font-label-md text-tertiary-container uppercase tracking-wide\">Possible Match</span>\n          </div>\n          <h2 class=\"font-headline-sm text-on-surface mt-0.5\">Is this Total Half-Way-Tree?</h2>\n          <p class=\"font-body-sm text-on-surface-variant mt-0.5\">\n            This location is already registered on Roam Plug with active fuel rates.\n          </p>\n        </div>\n      </div>\n\n      <!-- Action Choice Buttons -->\n      <div class=\"flex flex-col gap-2 pt-1\">\n        <button type=\"button\" class=\"w-full min-h-[46px] rounded-xl bg-surface-container-high text-on-surface font-label-lg flex items-center justify-center gap-2 active:bg-surface-variant transition-colors\">\n          <span class=\"material-symbols-outlined text-[18px]\">edit_location_alt</span>\n          <span>Yes, that's it (Update info)</span>\n        </button>\n        <button type=\"button\" class=\"w-full min-h-[46px] rounded-xl bg-primary text-on-primary font-label-lg flex items-center justify-center gap-2 shadow-md active:bg-primary-container transition-colors\">\n          <span class=\"material-symbols-outlined text-[18px]\">add_location</span>\n          <span>No, it's a different place</span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- BOTTOM FIXED ACTION DRAWER -->\n  <div class=\"px-4 mt-3 z-30 w-full flex flex-col gap-3\">\n    <!-- Geocoded Address Card -->\n    <div class=\"w-full bg-surface-container-low rounded-xl p-3 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center shrink-0\">\n        <span class=\"material-symbols-outlined text-[20px]\">pin_drop</span>\n      </div>\n      <div class=\"flex-1 min-w-0\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"font-label-sm bg-surface-variant text-on-surface-variant px-2 py-0.5 rounded-full font-semibold\">Kingston 10</span>\n          <span class=\"font-label-sm text-outline\">St. Andrew</span>\n        </div>\n        <p class=\"font-body-md text-on-surface font-semibold truncate mt-0.5\">\n          Constant Spring Rd &amp; Eastwood Park Rd\n        </p>\n      </div>\n      <span class=\"material-symbols-outlined text-outline text-[20px]\">check_circle</span>\n    </div>\n\n    <!-- Final Primary CTA Button -->\n    <button type=\"button\" class=\"w-full min-h-[52px] rounded-xl bg-primary text-on-primary font-label-lg tracking-wide flex items-center justify-center gap-2 shadow-lg active:scale-[0.99] transition-transform\">\n      <span class=\"material-symbols-outlined text-[22px]\">where_to_vote</span>\n      <span class=\"font-bold\">Confirm Pin Location</span>\n    </button>\n\n    <!-- Sub-Action Calibrate Link -->\n    <div class=\"flex items-center justify-center gap-1.5 py-1\">\n      <span class=\"material-symbols-outlined text-secondary text-[16px]\">tune</span>\n      <button type=\"button\" class=\"font-label-md text-secondary hover:underline\">\n        Calibrate GPS Compass\n      </button>\n    </div>\n  </div>\n</div></main></body></html></script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body></body></html>"}