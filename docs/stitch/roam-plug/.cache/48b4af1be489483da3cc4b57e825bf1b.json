{"filename":"04-signup-phone.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=block\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"surface-container-highest\": \"#e8e1db\", \"surface-container\": \"#f4ede6\", \"on-surface\": \"#1e1b17\", \"error\": \"#ba1a1a\", \"surface-bright\": \"#fff8f2\", \"on-background\": \"#1e1b17\", \"outline\": \"#8e7166\", \"secondary-fixed\": \"#ffdbca\", \"on-secondary-fixed\": \"#341100\", \"surface-dim\": \"#e0d9d2\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"primary-container\": \"#cc4900\", \"primary-fixed\": \"#ffdbce\", \"surface-variant\": \"#e8e1db\", \"on-error\": \"#ffffff\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary-container\": \"#936f00\", \"error-container\": \"#ffdad6\", \"on-tertiary\": \"#ffffff\", \"on-tertiary-container\": \"#fffbff\", \"secondary\": \"#9d4300\", \"primary\": \"#a33900\", \"inverse-surface\": \"#33302c\", \"primary-fixed-dim\": \"#ffb599\", \"on-primary-container\": \"#fffbff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface\": \"#fff8f2\", \"background\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"outline-variant\": \"#e2bfb2\", \"on-secondary\": \"#ffffff\", \"secondary-fixed-dim\": \"#ffb690\", \"surface-container-low\": \"#faf2eb\", \"on-secondary-fixed-variant\": \"#783200\", \"on-tertiary-fixed\": \"#251a00\", \"on-error-container\": \"#93000a\", \"surface-tint\": \"#a73a00\", \"on-surface-variant\": \"#5a4138\", \"secondary-container\": \"#fd761a\", \"tertiary\": \"#755800\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"surface-container-lowest\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"gutter-sm\": \"0.75rem\", \"space-xs\": \"0.25rem\", \"space-md\": \"1rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"gutter\": \"1rem\", \"space-lg\": \"1.5rem\", \"margin\": \"1rem\", \"margin-lg\": \"1.5rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-md\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100%;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface text-on-surface antialiased flex flex-col min-h-screen\"><div class=\"w-full pt-safe px-margin select-none\"><div class=\"flex justify-between items-center pt-space-xs text-on-surface\"><span class=\"font-label-md text-label-md font-semibold tracking-tight\">9:41</span><div class=\"flex items-center gap-1.5\"><span class=\"material-symbols-outlined text-[16px] leading-none\">signal_cellular_alt</span><span class=\"material-symbols-outlined text-[16px] leading-none\">wifi</span><span class=\"material-symbols-outlined text-[18px] leading-none\">battery_full</span></div></div></div><main class=\"flex-1 flex flex-col relative w-full pb-safe bg-surface px-margin\"><div class=\"flex flex-col w-full pb-space-xl\">\n<!-- Top Navigation & Brand Mini Pill -->\n<header class=\"flex items-center justify-between w-full py-space-sm mb-space-sm\">\n<button aria-label=\"Go back\" class=\"flex items-center justify-center w-12 h-12 rounded-full bg-surface-container active:bg-surface-container-highest transition-colors shadow-sm\" type=\"button\">\n<span class=\"material-symbols-outlined text-on-surface text-[22px]\">arrow_back</span>\n</button>\n<div class=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n<span class=\"font-label-md text-label-md tracking-wide text-on-surface uppercase font-extrabold\">Roam Plug</span>\n</div>\n<div class=\"w-12 h-12 opacity-0 pointer-events-none\"></div>\n</header>\n<!-- Progress Flow Tracker -->\n<div class=\"w-full bg-surface-container-low p-space-md rounded-2xl mb-space-md shadow-sm\">\n<div class=\"flex items-center justify-between mb-2\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-bold\">1</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">Phone Sign Up</span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold\">Step 1 of 3</span>\n</div>\n<!-- Visual Stepper Segments -->\n<div class=\"flex items-center gap-2 w-full\">\n<div class=\"h-2 flex-1 rounded-full bg-primary transition-all duration-300\"></div>\n<div class=\"h-2 flex-1 rounded-full bg-surface-container-highest\"></div>\n<div class=\"h-2 flex-1 rounded-full bg-surface-container-highest\"></div>\n</div>\n<div class=\"flex justify-between items-center mt-2 px-0.5\">\n<span class=\"font-label-sm text-label-sm text-primary font-bold\">1. Phone</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">2. Verify</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">3. Profile</span>\n</div>\n</div>\n<!-- Hero Content & Jamaican Motoring Pitch -->\n<section class=\"mb-space-lg\">\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-2\">\n      Create your account\n    </h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n      Join thousands of Jamaican drivers tracking fuel, car maintenance, and mapping our roads across all 14 parishes.\n    </p>\n</section>\n<!-- Interactive Form Section -->\n<div class=\"bg-surface-container-lowest rounded-2xl p-space-md shadow-sm flex flex-col gap-space-md mb-space-md\">\n<!-- Phone Input Group -->\n<div class=\"flex flex-col gap-2\">\n<div class=\"flex justify-between items-center\">\n<label class=\"font-label-lg text-label-lg text-on-surface font-bold\" for=\"phone-input\">\n          Phone Number\n        </label>\n<span class=\"font-label-sm text-label-sm text-primary font-bold bg-primary-fixed px-2 py-0.5 rounded-full text-on-primary-fixed\">\n          JA Mobile\n        </span>\n</div>\n<div class=\"flex items-center gap-2\">\n<!-- Jamaica Country Code Badge -->\n<div class=\"flex items-center gap-2 px-3 py-3 rounded-xl bg-surface-container-high h-[52px] select-none shrink-0 shadow-sm\" title=\"Jamaica (+1 876)\">\n<svg aria-hidden=\"true\" class=\"w-6 h-4 rounded-sm shadow-xs\" viewbox=\"0 0 600 300\">\n<rect fill=\"#000000\" height=\"300\" width=\"600\"></rect>\n<polygon fill=\"#007730\" points=\"0,0 300,150 0,300\"></polygon>\n<polygon fill=\"#007730\" points=\"600,0 300,150 600,300\"></polygon>\n<polygon fill=\"#fed100\" points=\"0,0 300,150 600,0\"></polygon>\n<polygon fill=\"#fed100\" points=\"0,300 300,150 600,300\"></polygon>\n<line stroke=\"#fed100\" stroke-width=\"48\" x1=\"0\" x2=\"600\" y1=\"0\" y2=\"300\"></line>\n<line stroke=\"#fed100\" stroke-width=\"48\" x1=\"600\" x2=\"0\" y1=\"0\" y2=\"300\"></line>\n</svg>\n<span class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">+1 876</span>\n</div>\n<!-- Local Phone Number Input -->\n<div class=\"relative flex-1\">\n<input class=\"w-full h-[52px] px-4 rounded-xl bg-surface-container-low text-on-surface font-headline-sm text-headline-sm tracking-wide placeholder:text-on-surface-variant/40 focus:outline-none focus:bg-surface-container-lowest focus:ring-0 transition-all\" id=\"phone-input\" maxlength=\"8\" placeholder=\"555-0199\" type=\"tel\"/>\n<button aria-label=\"Clear input\" class=\"absolute right-3 top-1/2 -translate-y-1/2 hidden text-on-surface-variant/60 hover:text-on-surface p-1\" id=\"clear-phone\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">cancel</span>\n</button>\n</div>\n</div>\n<!-- Helper Notice -->\n<div class=\"flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-surface-container-low mt-1\">\n<span class=\"material-symbols-outlined text-secondary text-[16px] shrink-0\">sms</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium\">\n          We'll send an SMS code to verify. Free standard rates apply.\n        </span>\n</div>\n</div>\n<!-- Quick Terms Checkbox -->\n<label class=\"flex items-start gap-3 cursor-pointer select-none group mt-1\">\n<div class=\"relative flex items-center justify-center w-6 h-6 rounded-lg bg-primary mt-0.5 shrink-0 transition-transform active:scale-90 shadow-xs\">\n<input checked=\"\" class=\"sr-only peer\" id=\"terms-checkbox\" type=\"checkbox\"/>\n<span class=\"material-symbols-outlined text-on-primary text-[18px] select-none pointer-events-none\">check</span>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant leading-tight\">\n        I agree to Roam Plug's <span class=\"text-primary font-semibold underline decoration-primary/40 underline-offset-2\">Terms of Service</span> and <span class=\"text-primary font-semibold underline decoration-primary/40 underline-offset-2\">Privacy Policy</span>. Offline sync and parish road guidelines apply.\n      </span>\n</label>\n<!-- Primary CTA: Continue -->\n<button class=\"w-full min-h-[52px] px-6 rounded-xl bg-primary active:bg-secondary-container text-on-primary flex items-center justify-center gap-2 font-headline-sm text-headline-sm font-bold shadow-md transition-all duration-200 transform active:scale-[0.99]\" id=\"submit-btn\" type=\"button\">\n<span>Continue</span>\n<span class=\"material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1\">arrow_forward</span>\n</button>\n</div>\n<!-- Island Transit Visual Teaser (Delight element) -->\n<div class=\"w-full rounded-2xl overflow-hidden bg-surface-container-low mb-space-md shadow-sm relative\">\n<div class=\"w-full h-24 bg-cover bg-center\" data-alt=\"Scenic sun-drenched Jamaican coastal highway with vibrant asphalt road, lush green Blue Mountains background, clear Caribbean sunlight, and a cheerful modern hatchback navigating smoothly.\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD9PxhNy3xACpZJn_cmpGX6kBPMFt6D_Z6Q1mmsJ8OtaDQP2i4uA--3AKVkqPoVLaoA_CPLivkScPkBhvrqsP-fouhkDfcEiji798bpWp-jGfvIX8IlEOJqHCwsxoSef9cDKTK5QRdAavt67UArFH11LbHM1N61qFory1dgIUNOOoS_0Yu-qQ1tmjUTZjnHb_OqIZjziLR3_JMQliHpZ2gOdrtqcdk_TInI8SzogEdFf5w8lMmRrb9j')\"></div>\n<div class=\"p-3 bg-surface-container-high/90 flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">speed</span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\">Community Road Updates</span>\n</div>\n<span class=\"font-label-sm text-label-sm font-bold bg-surface-container-lowest text-on-surface px-2 py-0.5 rounded-full shadow-xs\">Live in Kingston &amp; MoBay</span>\n</div>\n</div>\n<!-- Warm Styled \"OR\" Divider -->\n<div class=\"flex items-center gap-3 my-2 px-2\">\n<div class=\"h-0.5 flex-1 bg-surface-container-highest rounded-full\"></div>\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant font-bold px-1\">or sign in with</span>\n<div class=\"h-0.5 flex-1 bg-surface-container-highest rounded-full\"></div>\n</div>\n<!-- Social Sign-In Providers -->\n<div class=\"flex flex-col gap-2.5 mt-space-sm mb-space-md\">\n<!-- Google Auth Button -->\n<button class=\"w-full min-h-[48px] px-4 rounded-xl bg-surface-container-lowest active:bg-surface-container text-on-surface flex items-center justify-center gap-3 font-label-lg text-label-lg font-bold shadow-sm transition-colors\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"w-5 h-5 shrink-0\" viewbox=\"0 0 24 24\">\n<path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\"></path>\n<path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\"></path>\n<path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\" fill=\"#FBBC05\"></path>\n<path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\" fill=\"#EA4335\"></path>\n</svg>\n<span>Continue with Google</span>\n</button>\n<!-- Apple Auth Button -->\n<button class=\"w-full min-h-[48px] px-4 rounded-xl bg-inverse-surface active:bg-on-surface text-inverse-on-surface flex items-center justify-center gap-3 font-label-lg text-label-lg font-bold shadow-sm transition-colors\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"w-5 h-5 shrink-0 fill-current\" viewbox=\"0 0 170 170\">\n<path d=\"M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.05-7.7-7.85-12-14.42-6.01-9.17-10.85-19.78-14.5-31.84-3.66-12.06-5.5-23.75-5.5-35.08 0-14.75 3.82-27.18 11.45-37.3 7.64-10.12 17.39-15.29 29.27-15.52 4.58 0 9.8 1.25 15.66 3.75 5.86 2.5 9.74 3.79 11.64 3.87 1.63 0 5.64-1.34 12.03-4.02 6.38-2.69 11.75-3.85 16.11-3.48 12.22.95 22.09 5.56 29.6 13.84-10.89 6.6-16.22 15.73-16 27.38.28 9.5 4.02 17.48 11.22 23.95 7.2 6.47 15.76 10.1 25.68 10.9-2.29 6.84-4.89 13.75-7.8 20.73zM119.22 33.15c0-7.23 2.65-13.97 7.95-20.22 5.3-6.26 11.83-10.51 19.59-12.76.38 2.05.57 3.87.57 5.48 0 7.37-2.73 14.34-8.19 20.91-5.46 6.57-12.08 10.73-19.86 12.49-.07-2.02-.06-3.99-.06-5.9z\"></path>\n</svg>\n<span>Continue with Apple</span>\n</button>\n</div>\n<!-- Community Reassurance Trust Anchor -->\n<footer class=\"mt-auto pt-2 flex flex-col items-center gap-1.5 text-center\">\n<div class=\"flex items-center justify-center gap-2 flex-wrap\">\n<span class=\"inline-flex items-center gap-1 font-label-sm text-label-sm font-semibold text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\">check_circle</span>\n        100% Free\n      </span>\n<span class=\"text-on-surface-variant/40\">•</span>\n<span class=\"inline-flex items-center gap-1 font-label-sm text-label-sm font-semibold text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\">credit_card_off</span>\n        No card needed\n      </span>\n<span class=\"text-on-surface-variant/40\">•</span>\n<span class=\"inline-flex items-center gap-1 font-label-sm text-label-sm font-semibold text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\">group</span>\n        Driver powered\n      </span>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant/70\">\n      Built for Jamaican roads, taxis, and road trips.\n    </span>\n</footer>\n</div>\n<script>\n  (function () {\n    const phoneInput = document.getElementById('phone-input');\n    const clearBtn = document.getElementById('clear-phone');\n    const submitBtn = document.getElementById('submit-btn');\n    const termsCheckbox = document.getElementById('terms-checkbox');\n\n    if (!phoneInput) return;\n\n    // Format local Jamaican 7-digit mobile (e.g. 555-0199)\n    phoneInput.addEventListener('input', (e) => {\n      let value = e.target.value.replace(/\\D/g, '');\n      if (value.length > 7) value = value.slice(0, 7);\n      \n      if (value.length > 3) {\n        e.target.value = value.slice(0, 3) + '-' + value.slice(3);\n      } else {\n        e.target.value = value;\n      }\n\n      if (e.target.value.length > 0) {\n        clearBtn.classList.remove('hidden');\n      } else {\n        clearBtn.classList.add('hidden');\n      }\n    });\n\n    clearBtn.addEventListener('click', () => {\n      phoneInput.value = '';\n      clearBtn.classList.add('hidden');\n      phoneInput.focus();\n    });\n\n    // Checkbox custom toggle visualization\n    const checkboxWrapper = termsCheckbox.parentElement;\n    const checkIcon = checkboxWrapper.querySelector('span');\n\n    checkboxWrapper.addEventListener('click', () => {\n      termsCheckbox.checked = !termsCheckbox.checked;\n      if (termsCheckbox.checked) {\n        checkboxWrapper.classList.remove('bg-surface-container-highest');\n        checkboxWrapper.classList.add('bg-primary');\n        checkIcon.classList.remove('opacity-0');\n      } else {\n        checkboxWrapper.classList.remove('bg-primary');\n        checkboxWrapper.classList.add('bg-surface-container-highest');\n        checkIcon.classList.add('opacity-0');\n      }\n    });\n\n    // Delight micro-interaction on button tap\n    submitBtn.addEventListener('click', () => {\n      const rawNumber = phoneInput.value.replace(/\\D/g, '');\n      if (rawNumber.length < 7) {\n        phoneInput.parentElement.classList.add('animate-pulse');\n        phoneInput.focus();\n        setTimeout(() => phoneInput.parentElement.classList.remove('animate-pulse'), 800);\n        return;\n      }\n\n      // Visual confirmation state\n      const originalText = submitBtn.innerHTML;\n      submitBtn.innerHTML = `\n        <span class=\"material-symbols-outlined animate-spin text-[20px]\">progress_activity</span>\n        <span>Sending Code...</span>\n      `;\n      submitBtn.classList.add('opacity-80', 'pointer-events-none');\n\n      setTimeout(() => {\n        submitBtn.innerHTML = `\n          <span class=\"material-symbols-outlined text-[20px]\">check</span>\n          <span>SMS Dispatched!</span>\n        `;\n        submitBtn.classList.remove('bg-primary');\n        submitBtn.classList.add('bg-tertiary');\n      }, 1100);\n    });\n  })();\n</script></main></body></html>"}