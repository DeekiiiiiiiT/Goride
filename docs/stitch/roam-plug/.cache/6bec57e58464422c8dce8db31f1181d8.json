{"filename":"34-history.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back\" class=\"w-12 h-12 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Maintenance History</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-24\">\n<!-- Vehicle Summary & Digital Logbook Card -->\n<section class=\"mt- space-y-space-md\">\n<div class=\"relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-md shadow-sm\">\n<div class=\"flex items-start justify-between gap-space-sm mb-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[26px]\">build_circle</span>\n</div>\n<div>\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span> Logged Health\n            </span>\n<p class=\"font-price-display text-price-display text-primary mt-0.5\">J$ 64,300</p>\n</div>\n</div>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold\">\n          6 Services\n        </span>\n</div>\n<!-- Quick stats ribbon -->\n<div class=\"grid grid-cols-2 gap-space-sm bg-surface-container-low rounded-lg p-space-sm mb-space-md\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">CURRENT ODOMETER</span>\n<span class=\"font-headline-sm text-headline-sm text-on-surface flex items-center gap-1\">\n            84,612 <span class=\"font-label-md text-label-md text-on-surface-variant font-normal\">km</span>\n</span>\n</div>\n<div class=\"flex flex-col border-l border-outline-variant/30 pl-space-sm\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">LAST LOGGED</span>\n<span class=\"font-headline-sm text-headline-sm text-secondary flex items-center gap-1\">\n            14 Sep <span class=\"font-label-md text-label-md text-on-surface-variant font-normal\">2024</span>\n</span>\n</div>\n</div>\n<!-- Download Certified Logbook Action -->\n<button class=\"w-full h-12 rounded-lg bg-primary text-on-primary flex items-center justify-center gap-space-sm font-label-lg text-label-lg shadow-md active:bg-primary-container transition-transform active:scale-[0.99]\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">verified_user</span>\n<span>Download History (PDF)</span>\n<span class=\"material-symbols-outlined text-[18px]\">download</span>\n</button>\n<div class=\"mt-space-xs flex items-center justify-center gap-1.5 text-center\">\n<span class=\"material-symbols-outlined text-secondary text-[14px]\">format_image_left</span>\n<p class=\"font-label-sm text-label-sm text-on-surface-variant\">\n          Certified digital logbook • Ideal for ITA compliance, insurance &amp; resale\n        </p>\n</div>\n</div>\n</section>\n<!-- Filter Pill Chips Carousel -->\n<section class=\"mt-space-lg\">\n<div class=\"flex items-center justify-between mb-space-xs\">\n<span class=\"font-label-md text-label-md text-on-surface-variant font-bold uppercase tracking-wider\">Filter Records</span>\n<span class=\"font-label-sm text-label-sm text-secondary\">Showing all 6 logs</span>\n</div>\n<div class=\"flex gap-space-xs overflow-x-auto pb-1 -mx-gutter px-gutter scroll-smooth no-scrollbar\" id=\"chip-filters\">\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-primary text-on-primary font-label-md text-label-md font-semibold flex items-center gap-1.5 shadow-sm active:scale-95 transition-all\">\n<span>All</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm\">6</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center gap-1.5 shadow-sm active:scale-95 transition-all\">\n<span>Oil &amp; Fluids</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">3</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center gap-1.5 shadow-sm active:scale-95 transition-all\">\n<span>Brakes</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">1</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center gap-1.5 shadow-sm active:scale-95 transition-all\">\n<span>Tyres &amp; Suspension</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">1</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-lowest text-on-surface font-label-md text-label-md font-medium flex items-center gap-1.5 shadow-sm active:scale-95 transition-all\">\n<span>Statutory / Inspection</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">1</span>\n</button>\n</div>\n</section>\n<!-- Timeline List by Date -->\n<section class=\"mt-space-lg relative\">\n<!-- Visual vertical track connector -->\n<div class=\"absolute left-4 top-4 bottom-8 w-0.5 bg-surface-container-highest -z-0\"></div>\n<div class=\"space-y-space-md relative z-10\">\n<!-- Event 1: Tyre Rotation -->\n<article class=\"flex gap-space-sm items-start\">\n<div class=\"w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-md shrink-0 mt-2\">\n<span class=\"material-symbols-outlined text-[18px]\">tire_repair</span>\n</div>\n<div class=\"flex-1 bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between gap-space-xs\">\n<span class=\"font-label-sm text-label-sm font-bold text-secondary uppercase tracking-wider\">\n              14 Sep 2024 • 80,000 km\n            </span>\n<span class=\"inline-flex items-center gap-1 text-[11px] font-semibold text-tertiary bg-tertiary-fixed/60 px-2 py-0.5 rounded-full\">\n<span class=\"material-symbols-outlined text-[13px]\">attach_file</span> Receipt\n            </span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface mt-1\">Tyre Rotation &amp; High-Speed Balancing</h3>\n<div class=\"flex items-center gap-1.5 mt-1 text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">storefront</span>\n<span>Sammy's Tyre Repair (Dunrobin Ave)</span>\n</div>\n<div class=\"my-space-sm p-space-sm rounded-lg bg-surface-container-low text-on-surface-variant font-body-sm text-body-sm\">\n            Front tyres rotated to rear; checked pressure 32 PSI all round. Road tested smoothly on Kingston bypass.\n          </div>\n<div class=\"flex items-center justify-between pt-space-xs\">\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Total Cost</span>\n<span class=\"font-price-display text-price-display text-on-surface\">J$ 4,500</span>\n</div>\n</div>\n</article>\n<!-- Event 2: Brake Pads Replacement -->\n<article class=\"flex gap-space-sm items-start\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shadow-md shrink-0 mt-2\">\n<span class=\"material-symbols-outlined text-[18px]\">warning</span>\n</div>\n<div class=\"flex-1 bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between gap-space-xs\">\n<span class=\"font-label-sm text-label-sm font-bold text-secondary uppercase tracking-wider\">\n              14 Mar 2024 • 79,950 km\n            </span>\n<span class=\"inline-flex items-center gap-1 text-[11px] font-semibold text-primary bg-primary-fixed px-2 py-0.5 rounded-full\">\n<span class=\"material-symbols-outlined text-[13px]\">verified</span> OEM Parts\n            </span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface mt-1\">Front Brake Pads Replacement</h3>\n<div class=\"flex items-center gap-1.5 mt-1 text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\">precision_manufacturing</span>\n<span>Precision Auto Works</span>\n</div>\n<!-- Itemized parts/labour breakdown -->\n<div class=\"mt-space-sm grid grid-cols-2 gap-2 p-space-sm rounded-lg bg-surface-container-low font-label-sm text-label-sm\">\n<div>\n<span class=\"text-on-surface-variant block\">Akebono Pads</span>\n<span class=\"font-bold text-on-surface\">J$ 9,800</span>\n</div>\n<div>\n<span class=\"text-on-surface-variant block\">Skimming &amp; Labour</span>\n<span class=\"font-bold text-on-surface\">J$ 5,000</span>\n</div>\n</div>\n<p class=\"mt-space-xs text-on-surface-variant font-body-sm text-body-sm\">\n            Rotors skimmed; brake fluid level topped up with Castrol DOT 4.\n          </p>\n<div class=\"flex items-center justify-between pt-space-xs mt-space-xs\">\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Total Cost</span>\n<span class=\"font-price-display text-price-display text-on-surface\">J$ 14,800</span>\n</div>\n</div>\n</article>\n<!-- Event 3: Full Synthetic Oil & Fluid Flush -->\n<article class=\"flex gap-space-sm items-start\">\n<div class=\"w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-md shrink-0 mt-2\">\n<span class=\"material-symbols-outlined text-[18px]\">oil_barrel</span>\n</div>\n<div class=\"flex-1 bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between gap-space-xs\">\n<span class=\"font-label-sm text-label-sm font-bold text-secondary uppercase tracking-wider\">\n              12 Jan 2024 • 75,000 km\n            </span>\n<span class=\"inline-flex items-center gap-1 text-[11px] font-semibold text-tertiary bg-tertiary-fixed/60 px-2 py-0.5 rounded-full\">\n<span class=\"material-symbols-outlined text-[13px]\">tune</span> Full Service\n            </span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface mt-1\">Full Synthetic Oil &amp; Filter Service + Coolant Flush</h3>\n<div class=\"flex items-center gap-1.5 mt-1 text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\">handyman</span>\n<span>Precision Auto Works</span>\n</div>\n<div class=\"my-space-sm p-space-sm rounded-lg bg-surface-container-low text-on-surface-variant font-body-sm text-body-sm\">\n            Idemitsu 0W-20 Synthetic, OEM Toyota filter replaced, genuine pink coolant level checked &amp; topped up.\n          </div>\n<div class=\"flex items-center justify-between pt-space-xs\">\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Total Cost</span>\n<span class=\"font-price-display text-price-display text-on-surface\">J$ 16,500</span>\n</div>\n</div>\n</article>\n<!-- Event 4: DIY Oil Service -->\n<article class=\"flex gap-space-sm items-start\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container-highest text-on-surface flex items-center justify-center shadow-sm shrink-0 mt-2\">\n<span class=\"material-symbols-outlined text-[18px]\">person_apron</span>\n</div>\n<div class=\"flex-1 bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between gap-space-xs\">\n<span class=\"font-label-sm text-label-sm font-bold text-secondary uppercase tracking-wider\">\n              02 Nov 2023 • 70,120 km\n            </span>\n<span class=\"inline-flex items-center gap-1 text-[11px] font-medium text-on-surface-variant bg-surface-container px-2 py-0.5 rounded-full\">\n              DIY Self-Log\n            </span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface mt-1\">Engine Oil &amp; Filter Service</h3>\n<div class=\"flex items-center gap-1.5 mt-1 text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-outline\">home_repair_service</span>\n<span>Did it myself (DIY)</span>\n</div>\n<p class=\"mt-space-sm text-on-surface-variant font-body-sm text-body-sm\">\n            Parts bought at Mario's Auto Parts (Half Way Tree). Oil drain plug washer replaced.\n          </p>\n<div class=\"flex items-center justify-between pt-space-xs mt-space-xs\">\n<span class=\"font-label-md text-label-md text-on-surface-variant\">Parts Cost</span>\n<span class=\"font-price-display text-price-display text-on-surface\">J$ 8,500</span>\n</div>\n</div>\n</article>\n</div>\n</section>\n<!-- Visual Road Inspection Badge / Island Readiness -->\n<section class=\"mt-space-lg mb-space-sm\">\n<div class=\"rounded-xl bg-surface-container p-space-md flex items-center gap-space-md\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">assignment_turned_in</span>\n</div>\n<div class=\"min-w-0 flex-1\">\n<p class=\"font-headline-sm text-headline-sm text-on-surface\">ITA Road Fitness</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Valid until 28 Feb 2025 • Depot: Swallowfield</p>\n</div>\n<span class=\"material-symbols-outlined text-secondary\">chevron_right</span>\n</div>\n</section>\n<!-- Sticky Bottom Interactive Bar -->\n<div class=\"fixed bottom-0 left-0 right-0 z-40 bg-surface/90 backdrop-blur-md px-gutter py-space-sm pb-safe shadow-[0_-4px_16px_rgba(30,27,23,0.06)]\">\n<div class=\"max-w-md mx-auto flex items-center gap-space-sm\">\n<button class=\"flex-1 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center gap-space-xs font-label-lg text-label-lg shadow-lg active:bg-primary-container active:scale-[0.98] transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">add_circle</span>\n<span>Log Another Service</span>\n</button>\n<button aria-label=\"Share summary report\" class=\"w-12 h-12 rounded-xl bg-surface-container-high text-on-surface flex items-center justify-center hover:bg-surface-container-highest active:scale-95 transition-all shrink-0\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">ios_share</span>\n</button>\n</div>\n</div>\n</div>\n<script>\n  // Filter chips active state interaction\n  document.querySelectorAll('.filter-chip').forEach(button => {\n    button.addEventListener('click', () => {\n      document.querySelectorAll('.filter-chip').forEach(b => {\n        b.classList.remove('bg-primary', 'text-on-primary');\n        b.classList.add('bg-surface-container-lowest', 'text-on-surface');\n      });\n      button.classList.remove('bg-surface-container-lowest', 'text-on-surface');\n      button.classList.add('bg-primary', 'text-on-primary');\n    });\n  });\n</script></main></body></html>"}