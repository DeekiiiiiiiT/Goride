{"filename":"12-starting-odometer.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;min-height:100%;margin:0;padding:0;}body{overscroll-behavior-y:none;-webkit-tap-highlight-color:transparent;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"surface-container-lowest\": \"#ffffff\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary\": \"#9d4300\", \"on-primary-fixed\": \"#370e00\", \"surface-container-highest\": \"#e8e1db\", \"tertiary\": \"#755800\", \"on-surface\": \"#1e1b17\", \"inverse-primary\": \"#ffb599\", \"primary\": \"#a33900\", \"tertiary-container\": \"#936f00\", \"surface\": \"#fff8f2\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-tertiary\": \"#ffffff\", \"on-secondary-fixed\": \"#341100\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary-fixed\": \"#ffdbca\", \"on-primary-fixed-variant\": \"#7f2b00\", \"secondary-container\": \"#fd761a\", \"surface-container-low\": \"#faf2eb\", \"surface-variant\": \"#e8e1db\", \"on-error-container\": \"#93000a\", \"outline-variant\": \"#e2bfb2\", \"secondary-fixed-dim\": \"#ffb690\", \"inverse-on-surface\": \"#f7efe9\", \"on-surface-variant\": \"#5a4138\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"on-error\": \"#ffffff\", \"background\": \"#fff8f2\", \"primary-fixed\": \"#ffdbce\", \"on-tertiary-container\": \"#fffbff\", \"surface-container\": \"#f4ede6\", \"surface-dim\": \"#e0d9d2\", \"surface-tint\": \"#a73a00\", \"primary-container\": \"#cc4900\", \"error\": \"#ba1a1a\", \"inverse-surface\": \"#33302c\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"primary-fixed-dim\": \"#ffb599\", \"on-background\": \"#1e1b17\", \"on-primary-container\": \"#fffbff\", \"surface-container-high\": \"#eee7e0\", \"on-secondary\": \"#ffffff\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-bright\": \"#fff8f2\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-xl\": \"2rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-sm\": \"0.5rem\", \"gutter\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"margin\": \"1rem\", \"space-xs\": \"0.25rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"body-md\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"label-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { lineHeight: \"24px\", fontWeight: \"400\" }], \"label-sm\": [\"10px\", { lineHeight: \"12px\", letterSpacing: \"0.04em\", fontWeight: \"700\" }], \"label-lg\": [\"14px\", { lineHeight: \"20px\", letterSpacing: \"0.01em\", fontWeight: \"600\" }], \"headline-lg\": [\"28px\", { lineHeight: \"36px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"body-md\": [\"14px\", { lineHeight: \"20px\", fontWeight: \"400\" }], \"display-lg-mobile\": [\"32px\", { lineHeight: \"40px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"label-md\": [\"12px\", { lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"600\" }], \"headline-md\": [\"22px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg\": [\"40px\", { lineHeight: \"48px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-sm\": [\"12px\", { lineHeight: \"16px\", fontWeight: \"400\" }], \"price-display\": [\"24px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"headline-sm\": [\"18px\", { lineHeight: \"24px\", fontWeight: \"600\" }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface text-on-surface font-body-md text-body-md min-h-screen flex flex-col pt-safe pb-safe antialiased selection:bg-primary/20\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Top Navigation & Progress Bar -->\n<div class=\"flex flex-col gap-3 px-4 pt-3 pb-2\">\n<div class=\"flex items-center justify-between\">\n<button aria-label=\"Go back\" class=\"flex items-center justify-center w-12 h-12 rounded-full bg-surface-container-high text-on-surface transition-transform active:scale-95\" type=\"button\">\n<span class=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n</button>\n<div class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-highest\">\n<span class=\"w-2 h-2 rounded-full bg-secondary-container animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant\">Step 3 of 3</span>\n</div>\n<button class=\"flex items-center justify-center h-12 px-3 rounded-full text-on-surface-variant font-label-lg text-label-lg active:bg-surface-container transition-colors\" type=\"button\">\n        Skip\n      </button>\n</div>\n<!-- 3-Segment Stepper -->\n<div aria-label=\"Progress: Step 3 of 3\" class=\"grid grid-cols-3 gap-2 w-full pt-1\">\n<div class=\"h-1.5 rounded-full bg-primary\"></div>\n<div class=\"h-1.5 rounded-full bg-primary\"></div>\n<div class=\"h-1.5 rounded-full bg-secondary-container shadow-[0_0_8px_rgba(253,118,26,0.6)]\"></div>\n</div>\n</div>\n<!-- Header Headline Section -->\n<div class=\"flex flex-col px-4 pt-4 pb-2\">\n<div class=\"flex items-center gap-2 mb-1\">\n<span class=\"material-symbols-outlined text-secondary-container text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">speed</span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold\">Baseline Metric</span>\n</div>\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight\">What's on your odometer?</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1.5 leading-relaxed\">\n      Enter your starting mileage so Roam Plug can calculate live fuel efficiency (km/L) and trigger timely island maintenance alerts.\n    </p>\n</div>\n<div class=\"flex flex-col gap-4 px-4 mt-3\">\n<!-- Camera Scan Card (AI Optical Dash Reader) -->\n<div class=\"relative overflow-hidden rounded-xl bg-gradient-to-br from-secondary-fixed via-surface-container-low to-surface-container p-4 shadow-sm\">\n<div class=\"absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-secondary-container/10 pointer-events-none blur-xl\"></div>\n<div class=\"flex items-start gap-3.5 relative z-10\">\n<div class=\"flex items-center justify-center w-12 h-12 rounded-xl bg-primary text-on-primary shadow-md shrink-0\">\n<span class=\"material-symbols-outlined text-[26px]\">document_scanner</span>\n</div>\n<div class=\"flex flex-col min-w-0 flex-1\">\n<div class=\"flex items-center gap-2\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Scan with Camera</h2>\n<span class=\"px-2 py-0.5 rounded-full bg-secondary text-on-primary font-label-sm text-label-sm\">AI FAST</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n            Point cluster gauge right at the pump — AI reads digits automatically.\n          </p>\n</div>\n</div>\n<div class=\"mt-4 relative z-10\">\n<button class=\"flex items-center justify-center gap-2.5 w-full h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg shadow-[0_4px_12px_rgba(163,57,0,0.25)] active:bg-on-primary-fixed-variant transition-all\" id=\"cameraScanBtn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">photo_camera</span>\n<span>Open Camera Scanner</span>\n</button>\n</div>\n</div>\n<!-- Caribbean Divider -->\n<div class=\"flex items-center justify-center gap-3 my-1\">\n<div class=\"flex-1 h-px bg-surface-container-highest\"></div>\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant font-bold\">OR ENTER MANUALLY</span>\n<div class=\"flex-1 h-px bg-surface-container-highest\"></div>\n</div>\n<!-- Manual Numeric Input Card -->\n<div class=\"flex flex-col rounded-xl bg-surface-container-lowest p-5 shadow-sm\">\n<div class=\"flex items-center justify-between mb-3\">\n<label class=\"font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-bold\" for=\"odometerDisplay\">Current Reading</label>\n<span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n          Jamaica Standard (km)\n        </span>\n</div>\n<!-- Live Dashboard Counter Box -->\n<div class=\"flex items-baseline justify-between rounded-xl bg-surface-container-low px-4 py-3.5\">\n<div class=\"flex items-baseline gap-1.5 flex-1 overflow-x-auto\">\n<input aria-label=\"Odometer value in kilometers\" class=\"font-display-lg-mobile text-display-lg-mobile text-on-surface bg-transparent outline-none w-full tabular-nums font-extrabold tracking-tight selection:bg-secondary-fixed\" id=\"odometerDisplay\" inputmode=\"numeric\" type=\"text\" value=\"84,320\"/>\n</div>\n<span class=\"font-headline-md text-headline-md text-primary font-bold shrink-0 ml-2\">km</span>\n</div>\n<!-- Quick Steppers for Island Drivers -->\n<div class=\"grid grid-cols-2 gap-2.5 mt-3\">\n<button class=\"flex items-center justify-center gap-1.5 h-12 rounded-lg bg-surface-container font-label-md text-label-md text-on-surface active:bg-surface-container-high transition-colors\" id=\"minus1000\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">remove</span>\n<span>1,000 km</span>\n</button>\n<button class=\"flex items-center justify-center gap-1.5 h-12 rounded-lg bg-surface-container font-label-md text-label-md text-on-surface active:bg-surface-container-high transition-colors\" id=\"plus1000\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">add</span>\n<span>1,000 km</span>\n</button>\n</div>\n<div class=\"flex items-center justify-center gap-1.5 mt-3.5 pt-3 border-t-0 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\">calendar_today</span>\n<span>Logged today as initial tank baseline</span>\n</div>\n</div>\n<!-- Optional Vehicle Identification (Expandable Drawer) -->\n<details class=\"group rounded-xl bg-surface-container-lowest overflow-hidden shadow-sm transition-all\">\n<summary class=\"flex items-center justify-between p-4 cursor-pointer list-none select-none active:bg-surface-container-low\">\n<div class=\"flex items-center gap-3\">\n<div class=\"flex items-center justify-center w-8 h-8 rounded-lg bg-surface-container text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[20px]\">directions_car</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Plate &amp; Nickname</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Optional Jamaican vehicle tags</span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-[22px] text-on-surface-variant transition-transform duration-200 group-open:rotate-180\">expand_more</span>\n</summary>\n<div class=\"flex flex-col gap-3.5 px-4 pb-4 pt-1\">\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface font-semibold\" for=\"carNickname\">Vehicle Nickname</label>\n<div class=\"flex items-center rounded-lg bg-surface-container-low px-3.5 h-12\">\n<input class=\"bg-transparent w-full text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/60 outline-none\" id=\"carNickname\" placeholder=\"e.g. Work Roomy, Daily Fit, Red Probox\" type=\"text\"/>\n</div>\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<div class=\"flex items-center justify-between\">\n<label class=\"font-label-md text-label-md text-on-surface font-semibold\" for=\"plateNumber\">Jamaica License Plate</label>\n<span class=\"flex items-center gap-1 font-label-sm text-label-sm text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[13px] text-tertiary\">lock</span>\n              Private &amp; Encrypted\n            </span>\n</div>\n<div class=\"flex items-center rounded-lg bg-surface-container-low px-3.5 h-12\">\n<span class=\"material-symbols-outlined text-[20px] text-on-surface-variant mr-2\">badge</span>\n<input class=\"bg-transparent w-full text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/60 uppercase tracking-widest outline-none font-semibold\" id=\"plateNumber\" placeholder=\"e.g. 8492 GA\" type=\"text\"/>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n            Kept strictly on your phone. Never displayed on parish fuel crowd-checks or speed alerts.\n          </p>\n</div>\n</div>\n</details>\n<!-- Jamaican Motoring Culture Tip Card -->\n<div class=\"flex items-start gap-3 rounded-xl bg-surface-container p-4 shadow-sm\">\n<div class=\"flex items-center justify-center w-9 h-9 rounded-lg bg-tertiary-fixed text-on-tertiary-fixed shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h2 class=\"font-label-lg text-label-lg text-on-surface font-bold\">Island Fuel Plug</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-snug\">\n          Next fill-up at <strong>Fesco</strong>, <strong>Cool Oasis</strong>, or <strong>Texaco</strong>, just key in liters and current km. Roam Plug calculates your exact Jamaican Dollar cost per kilometer automatically.\n        </p>\n</div>\n</div>\n</div>\n<!-- Bottom Fixed-Height Primary Action CTA -->\n<div class=\"flex flex-col items-center gap-2 px-4 pt-5 pb-2 mt-auto\">\n<button class=\"flex items-center justify-center gap-2 w-full h-[52px] rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm font-bold shadow-[0_8px_20px_-4px_rgba(234,88,12,0.35)] active:scale-[0.98] transition-transform\" id=\"finishBtn\" type=\"button\">\n<span>Finish &amp; Go to Radar</span>\n<span class=\"material-symbols-outlined text-[22px]\">arrow_forward</span>\n</button>\n<div class=\"flex items-center gap-1.5 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary\">verified_user</span>\n<span>100% Free island motoring companion</span>\n</div>\n</div>\n</div>\n<script>\n  (function() {\n    const odoInput = document.getElementById('odometerDisplay');\n    const plusBtn = document.getElementById('plus1000');\n    const minusBtn = document.getElementById('minus1000');\n    const cameraBtn = document.getElementById('cameraScanBtn');\n    const finishBtn = document.getElementById('finishBtn');\n\n    function parseVal(str) {\n      return parseInt(str.replace(/[^0-9]/g, ''), 10) || 0;\n    }\n\n    function formatVal(num) {\n      return num.toLocaleString('en-US');\n    }\n\n    if (plusBtn && odoInput) {\n      plusBtn.addEventListener('click', function() {\n        let current = parseVal(odoInput.value);\n        current += 1000;\n        odoInput.value = formatVal(current);\n      });\n    }\n\n    if (minusBtn && odoInput) {\n      minusBtn.addEventListener('click', function() {\n        let current = parseVal(odoInput.value);\n        current = Math.max(0, current - 1000);\n        odoInput.value = formatVal(current);\n      });\n    }\n\n    if (odoInput) {\n      odoInput.addEventListener('input', function(e) {\n        let raw = e.target.value.replace(/[^0-9]/g, '');\n        if (raw) {\n          e.target.value = formatVal(parseInt(raw, 10));\n        }\n      });\n    }\n\n    if (cameraBtn) {\n      cameraBtn.addEventListener('click', function() {\n        // Quick visual feedback simulating AI optical recognition\n        cameraBtn.classList.add('opacity-80');\n        const orig = cameraBtn.innerHTML;\n        cameraBtn.innerHTML = '<span class=\"material-symbols-outlined text-[20px] animate-spin\">refresh</span><span>Scanning Cluster Gauge...</span>';\n        setTimeout(function() {\n          cameraBtn.innerHTML = '<span class=\"material-symbols-outlined text-[20px]\">check_circle</span><span>Cluster Found: 84,320 km</span>';\n          setTimeout(function() {\n            cameraBtn.innerHTML = orig;\n            cameraBtn.classList.remove('opacity-80');\n          }, 1800);\n        }, 900);\n      });\n    }\n\n    if (finishBtn) {\n      finishBtn.addEventListener('click', function() {\n        finishBtn.innerHTML = '<span>Setting Up Island Radar...</span>';\n        finishBtn.classList.add('opacity-90');\n      });\n    }\n  })();\n</script></main></body></html>"}