\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back\" class=\"w-12 h-12 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Part Detail</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-10 space-y-space-md\">\n<!-- Toast Notification for Copying -->\n<div class=\"fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-space-md py-space-sm bg-inverse-surface text-inverse-on-surface rounded-full shadow-xl opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-space-xs font-label-md text-label-md\" id=\"copy-toast\">\n<span class=\"material-symbols-outlined text-[18px] text-tertiary-fixed\">check_circle</span>\n<span id=\"toast-text\">Part number copied!</span>\n</div>\n<!-- Hero Card: Exact Factory Part -->\n<section class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden\">\n<div class=\"flex items-center justify-between gap-space-sm mb-space-sm\">\n<div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-low text-on-surface\">\n<span class=\"w-2 h-2 rounded-full bg-[#16a34a] animate-pulse\"></span>\n<span class=\"material-symbols-outlined text-[16px] text-[#16a34a]\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n<span class=\"font-label-md text-label-md text-[#16a34a] uppercase tracking-wider font-bold\">Exact Factory Part</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2 py-0.5 rounded-full uppercase\">OEM JDM</span>\n</div>\n<!-- Product Visual & Branding -->\n<div class=\"relative w-full h-44 rounded-lg overflow-hidden mb-space-md bg-surface-container-low flex items-center justify-center\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Official Toyota genuine front brake pad set in original red and white branded packaging with authentic inspection seals, positioned on a sunlit mechanic workbench with metallic calipers in background, high contrast, warm amber ambient light, crisp automotive photography\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDvi5U-YoFsXyEO6kPXcA0iwlQXfuJwZ7Wmvwe4ZIgRCvCD8HzosiZ59mfdV6rSGCLe7fH86qJ_VMEUghrgU-dQTN57KScombwL-hwHHerf0uSH8c7iJg7aMGmkRPLNmvvLGhD_KjtdBVAbbQgP81sdlYiNwlTcZntg3oyrEdxwSa7Ks2oOQjOajla__01g_8LP_WUpbmbxQAdTqxPPH1y99GqBTrzXjfaCdjW5WchRM2CA73mN93RG\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent\"></div>\n<div class=\"absolute bottom-2 left-2 flex items-center gap-1.5 px-2.5 py-1 bg-surface-container-lowest/90 backdrop-blur-md rounded-lg shadow-sm\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">verified_user</span>\n<span class=\"font-label-sm text-label-sm text-on-surface font-semibold\">Toyota Genuine Parts • Made in Japan</span>\n</div>\n</div>\n<div class=\"flex flex-col space-y-space-xs\">\n<h2 class=\"font-headline-md text-headline-md text-on-surface tracking-tight\">Front Brake Pad Set</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Disc brake system axle assembly kit (Left &amp; Right)</p>\n</div>\n<!-- Copyable Main Part Number Card -->\n<div class=\"mt-space-md p-space-md bg-surface-container rounded-lg flex items-center justify-between gap-space-sm shadow-inner\">\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">OEM Part Number</span>\n<span class=\"font-price-display text-price-display text-primary tracking-wide select-all\" id=\"main-part-no\">04465-B1170</span>\n</div>\n<button aria-label=\"Copy OEM Part Number\" class=\"h-12 px-space-md rounded-lg bg-primary text-on-primary font-label-lg text-label-lg flex items-center gap-1.5 active:scale-95 shadow-sm transition-transform\" onclick=\"copyToClipboard('04465-B1170', 'OEM Part 04465-B1170 copied!')\">\n<span class=\"material-symbols-outlined text-[20px]\">content_copy</span>\n<span>Copy</span>\n</button>\n</div>\n<!-- Fit Guarantee Badge -->\n<div class=\"mt-space-sm p-space-sm rounded-lg bg-surface-container-low flex items-center gap-space-sm\">\n<div class=\"w-8 h-8 rounded-full bg-[#16a34a]/15 text-[#16a34a] flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">task_alt</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-[#16a34a] font-bold tracking-wide uppercase\">100% Fit Guarantee</span>\n<span class=\"font-body-sm text-body-sm text-on-surface truncate\">Pre-checked for your 2019 Toyota Roomy (M900A)</span>\n</div>\n</div>\n</section>\n<!-- Verified Compatibility Card -->\n<section class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center gap-space-xs mb-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">directions_car</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Fits (Verified Compatibility)</h3>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mb-space-md\">Standard factory fitment for JDM compacts sharing the Daihatsu DNGA/M900 platform.</p>\n<div class=\"space-y-space-xs\">\n<!-- Vehicle 1: Active Match -->\n<div class=\"p-space-sm rounded-lg bg-surface-container-high flex items-center justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-2.5 h-2.5 rounded-full bg-[#16a34a] shrink-0\"></div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">2016–2023 Toyota Roomy</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Chassis: M900A / M910A (2WD/4WD)</span>\n</div>\n</div>\n<span class=\"px-2 py-0.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm shrink-0\">Your Car</span>\n</div>\n<!-- Vehicle 2 -->\n<div class=\"p-space-sm rounded-lg bg-surface-container-low flex items-center justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-2 h-2 rounded-full bg-on-surface-variant/40 shrink-0\"></div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">2016–2023 Toyota Tank</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Chassis: M900A / M910A</span>\n</div>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Direct Fit</span>\n</div>\n<!-- Vehicle 3 -->\n<div class=\"p-space-sm rounded-lg bg-surface-container-low flex items-center justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-2 h-2 rounded-full bg-on-surface-variant/40 shrink-0\"></div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">2016–2023 Daihatsu Thor</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Chassis: M900S / M910S</span>\n</div>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Direct Fit</span>\n</div>\n<!-- Vehicle 4 -->\n<div class=\"p-space-sm rounded-lg bg-surface-container-low flex items-center justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-2 h-2 rounded-full bg-on-surface-variant/40 shrink-0\"></div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface truncate\">2016–2023 Subaru Justy</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Chassis: M900F</span>\n</div>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Direct Fit</span>\n</div>\n</div>\n<!-- Engine Codes Sub-pill -->\n<div class=\"mt-space-md p-space-sm rounded-lg bg-surface-container flex items-center gap-space-sm\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">engineering</span>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Compatible Engine Codes</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">1KR-FE (1.0L Naturally Aspirated) • 1KR-VET (1.0L Turbo)</span>\n</div>\n</div>\n</section>\n<!-- Cross-Reference Numbers Card -->\n<section class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between mb-space-xs\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\">shuffle</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Also Known As</h3>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Tap to copy</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mb-space-md\">Give any of these alternate numbers to Kingston or Montego Bay auto parts desks:</p>\n<div class=\"grid grid-cols-2 gap-space-sm\">\n<!-- Ref 1 -->\n<button class=\"p-space-sm bg-surface-container rounded-lg text-left active:scale-95 transition-transform group flex flex-col justify-between h-20\" onclick=\"copyToClipboard('04465-B1170-000', 'Daihatsu code copied!')\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-semibold\">Daihatsu OEM</span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[16px] group-hover:text-primary\">content_copy</span>\n</div>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold tracking-tight\">04465-B1170-000</span>\n</button>\n<!-- Ref 2 -->\n<button class=\"p-space-sm bg-surface-container rounded-lg text-left active:scale-95 transition-transform group flex flex-col justify-between h-20\" onclick=\"copyToClipboard('AN-788WK', 'Akebono code copied!')\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-semibold\">Akebono (Japan)</span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[16px] group-hover:text-primary\">content_copy</span>\n</div>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold tracking-tight\">AN-788WK</span>\n</button>\n<!-- Ref 3 -->\n<button class=\"p-space-sm bg-surface-container rounded-lg text-left active:scale-95 transition-transform group flex flex-col justify-between h-20\" onclick=\"copyToClipboard('SN188P', 'Advics code copied!')\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-semibold\">Advics OE</span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[16px] group-hover:text-primary\">content_copy</span>\n</div>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold tracking-tight\">SN188P</span>\n</button>\n<!-- Ref 4 -->\n<button class=\"p-space-sm bg-surface-container rounded-lg text-left active:scale-95 transition-transform group flex flex-col justify-between h-20\" onclick=\"copyToClipboard('AY040-KE150', 'Pitwork code copied!')\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-semibold\">Pitwork (Nissan/JDM)</span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[16px] group-hover:text-primary\">content_copy</span>\n</div>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold tracking-tight\">AY040-KE150</span>\n</button>\n</div>\n</section>\n<!-- Technical Specs Ca