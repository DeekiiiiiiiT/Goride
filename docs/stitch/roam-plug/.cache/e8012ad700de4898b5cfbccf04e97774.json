"surface-container-low\": \"#faf2eb\", \"secondary\": \"#9d4300\", \"secondary-fixed-dim\": \"#ffb690\", \"surface-tint\": \"#a73a00\", \"on-error\": \"#ffffff\", \"primary-fixed\": \"#ffdbce\", \"primary-container\": \"#cc4900\", \"on-tertiary\": \"#ffffff\", \"surface\": \"#fff8f2\", \"error\": \"#ba1a1a\", \"tertiary-fixed\": \"#ffdf9a\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-error-container\": \"#93000a\", \"on-secondary-fixed\": \"#341100\", \"on-tertiary-container\": \"#fffbff\", \"on-secondary-fixed-variant\": \"#783200\", \"on-tertiary-fixed\": \"#251a00\", \"secondary-fixed\": \"#ffdbca\", \"surface-container-highest\": \"#e8e1db\", \"surface-container-lowest\": \"#ffffff\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-xl\": \"2rem\", \"space-md\": \"1rem\", \"margin\": \"1rem\", \"gutter\": \"1rem\", \"space-sm\": \"0.5rem\", \"margin-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"body-md\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-lg\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { lineHeight: \"24px\", fontWeight: \"400\" }], \"label-sm\": [\"10px\", { lineHeight: \"12px\", letterSpacing: \"0.04em\", fontWeight: \"700\" }], \"label-md\": [\"12px\", { lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"600\" }], \"headline-lg\": [\"28px\", { lineHeight: \"36px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg-mobile\": [\"32px\", { lineHeight: \"40px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-md\": [\"14px\", { lineHeight: \"20px\", fontWeight: \"400\" }], \"price-display\": [\"24px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"headline-md\": [\"22px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg\": [\"40px\", { lineHeight: \"48px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-sm\": [\"12px\", { lineHeight: \"16px\", fontWeight: \"400\" }], \"headline-sm\": [\"18px\", { lineHeight: \"24px\", fontWeight: \"600\" }], \"label-lg\": [\"14px\", { lineHeight: \"20px\", letterSpacing: \"0.01em\", fontWeight: \"600\" }] } } } }</script><style>@layer base { html, body { min-height: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface min-h-screen flex flex-col antialiased selection:bg-primary/20 selection:text-primary\"><header class=\"fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(28,25,23,0.04)] pt-safe\"><div class=\"h-16 px-space-sm flex items-center justify-between\"><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Go Back\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface hover:text-primary hover:bg-surface-container active:scale-95 transition-all\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-md text-headline-md text-on-surface tracking-tight font-headline-md line-clamp-1\">Fuel Spend &amp; Mileage</h1></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Share Vehicle\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[22px]\">share</span></button><button aria-label=\"More Options\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[22px]\">more_vert</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-space-xs shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 w-full bg-surface pt-16 pb-safe\"><div class=\"flex flex-col w-full\">\n<!-- Vehicle Context Strip -->\n<div class=\"px-space-md py-space-sm flex items-center justify-between\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-secondary-fixed text-[18px]\">directions_car</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Active Ride</p>\n<p class=\"font-headline-sm text-headline-sm text-on-surface truncate\">2019 Toyota Roomy <span class=\"text-primary font-label-md\">(8241-HY)</span></p>\n</div>\n</div>\n<div class=\"flex items-center gap-space-xs bg-surface-container-high px-space-sm py-1 rounded-full shrink-0\">\n<span class=\"w-2 h-2 rounded-full bg-secondary-container animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-bold\">St. Andrew</span>\n</div>\n</div>\n<!-- Time Period Selector Tabs -->\n<div class=\"px-space-md py-space-xs overflow-x-auto\">\n<div class=\"flex items-center gap-space-xs p-1 bg-surface-container rounded-full min-w-max\">\n<button class=\"period-btn px-space-md py-2 rounded-full font-label-md text-label-md text-on-surface-variant transition-all hover:text-on-surface active:scale-95\" onclick=\"setPeriod(this, 'week')\" type=\"button\">\n        This week\n      </button>\n<button class=\"period-btn px-space-md py-2 rounded-full font-label-md text-label-md bg-primary text-on-primary shadow-sm transition-all active:scale-95\" onclick=\"setPeriod(this, 'month')\" type=\"button\">\n        This month\n      </button>\n<button class=\"period-btn px-space-md py-2 rounded-full font-label-md text-label-md text-on-surface-variant transition-all hover:text-on-surface active:scale-95\" onclick=\"setPeriod(this, '3months')\" type=\"button\">\n        3 months\n      </button>\n<button class=\"period-btn px-space-md py-2 rounded-full font-label-md text-label-md text-on-surface-variant transition-all hover:text-on-surface active:scale-95\" onclick=\"setPeriod(this, 'year')\" type=\"button\">\n        Year\n      </button>\n</div>\n</div>\n<div class=\"p-space-md flex flex-col gap-space-lg\">\n<!-- Hero Analytics Card -->\n<div class=\"relative overflow-hidden rounded-xl bg-gradient-to-br from-primary-container via-secondary-container to-secondary text-on-primary-container p-space-lg shadow-md\">\n<!-- Decorative ambient sunshine rings -->\n<div class=\"absolute -right-12 -top-12 w-44 h-44 rounded-full bg-surface-container-lowest/10 pointer-events-none blur-xl\"></div>\n<div class=\"absolute right-6 bottom-[-20px] w-28 h-28 rounded-full bg-tertiary-fixed/20 pointer-events-none blur-lg\"></div>\n<div class=\"relative z-10 flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md tracking-wider uppercase opacity-90\">Total Fuel Spend</span>\n<span class=\"inline-flex items-center gap-1 bg-surface-container-lowest/20 px-2 py-0.5 rounded-full font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[13px]\">bolt</span> Oct 2024\n          </span>\n</div>\n<div class=\"flex items-baseline gap-space-xs mt-1\">\n<span class=\"font-headline-md text-headline-md opacity-85\">J$</span>\n<h2 class=\"font-display-lg-mobile text-display-lg-mobile font-extrabold tracking-tight\">18,450</h2>\n</div>\n<!-- Savings callouts -->\n<div class=\"flex flex-wrap items-center gap-space-xs pt-space-xs\">\n<div class=\"inline-flex items-center gap-1 bg-surface-container-lowest text-primary font-label-md text-label-md px-space-sm py-1 rounded-full shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">trending_down</span>\n<span>-8.4% vs Sept</span>\n</div>\n<div class=\"inline-flex items-center gap-1 bg-surface-container-lowest/25 font-label-sm text-label-sm px-space-sm py-1 rounded-full backdrop-blur-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">local_fire_department</span>\n<span>J$ 1,600 scout saved</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Key Stats 2x2 Grid -->\n<div>\n<div class=\"flex items-center justify-between mb-space-sm\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Efficiency Pulse</h3>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider\">Metrics</span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-sm\">\n<!-- Stat 1 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold\">Litres Burned</span>\n<div class=\"w-7 h-7 rounded-full bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\">local_gas_station</span>\n</div>\n</div>\n<div class=\"mt-space-sm\">\n<p class=\"font-headline-md text-headline-md text-on-surface\">86.0 <span class=\"font-label-md text-label-md text-on-surface-variant\">L</span></p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">4 fuel fill-ups</p>\n</div>\n</div>\n<!-- Stat 2 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold\">Distance</span>\n<div class=\"w-7 h-7 rounded-full bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\">add_road</span>\n</div>\n</div>\n<div class=\"mt-space-sm\">\n<p class=\"font-headline-md text-headline-md text-on-surface\">1,220 <span class=\"font-label-md text-label-md text-on-surface-variant\">km</span></p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">~39.3 km/day</p>\n</div>\n</div>\n<!-- Stat 3 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold\">Avg Price / L</span>\n<div class=\"w-7 h-7 rounded-full bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\">sell</span>\n</div>\n</div>\n<div class=\"mt-space-sm\">\n<p class=\"font-headline-sm text-headline-sm text-on-surface\">J$ 214.53</p>\n<span class=\"inline-block mt-0.5 px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface font-label-sm text-label-sm\">E-10 87 Blend</span>\n</div>\n</div>\n<!-- Stat 4 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold\">Cost per Km</span>\n<div class=\"w-7 h-7 rounded-full bg-surface-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\">savings</span>\n</div>\n</div>\n<div class=\"mt-space-sm\">\n<p class=\"font-headline-sm text-headline-sm text-on-surface\">J$ 15.12</p>\n<p class=\"font-body-sm text-body-sm text-primary font-semibold mt-0.5\">Top 15% island-wide</p>\n</div>\n</div>\n</div>\n</div>\n<!-- Chart 1: Spend by Week Bar Chart -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-md\">\n<div class=\"flex items-center justify-between\">\n<div>\n<h4 class=\"font-headline-sm text-headline-sm text-on-surface\">Spend by Week</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Weekly gas spend overview for October</p>\n</div>\n<div class=\"text-right\">\n<span class=\"font-label-sm text-label-sm px-2 py-1 rounded bg-secondary-fixed text-on-secondary-fixed font-bold\">Peak: W3</span>\n</div>\n</div>\n<!-- Bar Chart Visual -->\n<div class=\"pt-space-sm\">\n<div class=\"h-44 w-full flex items-end justify-between gap-3 px-2 pb-2\">\n<!-- W1 -->\n<div class=\"flex-1 flex flex-col items-center gap-1 group\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant group-hover:text-primary transition-colors\">J$4.8k</span>\n<div class=\"w-full bg-surface-container rounded-t-lg relative flex items-end justify-center overflow-hidden h-36\">\n<div class=\"w-full bg-secondary-container rounded-t-lg transition-all duration-500 ease-out\" style=\"height: 72%;\"></div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant mt-1\">W1</span>\n</div>\n<!-- W2 -->\n<div class=\"flex-1 flex flex-col items-center gap-1 group\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant group-hover:text-primary transition-colors\">J$4.2k</span>\n<div class=\"w-full bg-surface-container rounded-t-lg relative flex items-end justify-center overflow-hidden h-36\">\n<div class=\"w-full bg-secondary-container rounded-t-lg transition-all duration-500 ease-out\" style=\"height: 62%;\"></div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant mt-1\">W2</span>\n</div>\n<!-- W3 (Peak highlight) -->\n<div class=\"flex-1 flex flex-col items-center gap-1 group\">\n<div class=\"flex items-center gap-0.5 bg-primary text-on-primary px-1.5 py-0.5 rounded-full shadow-sm\">\n<span class=\"font-label-sm text-label-sm font-bold\">J$5.2k</span>\n</div>\n<div class=\"w-full bg-surface-container rounded-t-lg relative flex items-end justify-center overflow-hidden h-36\">\n<div class=\"w-full bg-gradient-to-t from-secondary to-primary rounded-t-lg transition-all duration-500 ease-out\" style=\"height: 94%;\">\n<div class=\"w-full h-1.5 bg-tertiary-fixed rounded-t\"></div>\n</div>\n</div>\n<span class=\"font-label-md text-label-md text-primary font-bold mt-1\">W3</span>\n</div>\n<!-- W4 -->\n<div class=\"flex-1 flex flex-col items-center gap-1 group\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant group-hover:text-primary transition-colors\">J$4.3k</span>\n<div class=\"w-full bg-surface-container rounded-t-lg relative flex items-end justify-center overflow-hidden h-36\">\n<div class=\"w-full bg-secondary-container rounded-t-lg transition-all duration-500 ease-out\" style=\"height: 64%;\"></div>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant mt-1\">W4</span>\n</div>\n</div>\n<div class=\"flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm px-2 pt-2 bg-surface-container-low rounded-lg mt-2\">\n<span>Total: 4 Transactions</span>\n<span class=\"font-semibold text-primary\">Avg: J$ 4,612.50 / week</span>\n</div>\n</div>\n</div>\n<!-- Chart 2: Fuel Efficiency Line Chart -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<div>\n<h4 class=\"font-headline-sm text-headline-sm text-on-surface\">Efficiency Trend (km/L)</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Toyota Roomy 1.0L Turbo CVT</p>\n</div>\n<div class=\"flex items-center gap-1 bg-surface-container px-2 py-1 rounded-full\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface\">Target: 13.4 km/L</span>\n</div>\n</div>\n<!-- Line Graph SVG Container -->\n<div class=\"relative w-full pt-space-xs\">\n<svg aria-label=\"Fuel efficiency line chart\" class=\"w-full h-36 overflow-visible\" viewbox=\"0 0 340 140\">\n<!-- Benchmark baseline line -->\n<line stroke=\"#936f00\" stroke-dasharray=\"4 4\" stroke-opacity=\"0.6\" stroke-width=\"1.5\" x1=\"16\" x2=\"324\" y1=\"86\" y2=\"86\"></line>\n<text class=\"font-label-sm text-[9px] font-semibold\" fill=\"#755800\" x=\"20\" y=\"80\">Parish Avg (13.4 km/L)</text>\n<!-- Gradient Area -->\n<defs>\n<lineargradient id=\"efficiencyGlow\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0%\" stop-color=\"#cc4900\" stop-opacity=\"0.32\"></stop>\n<stop offset=\"100%\" stop-color=\"#cc4900\" stop-opacity=\"0.0\"></stop>\n</lineargradient>\n</defs>\n<!-- Filled path -->\n<polygon fill=\"url(#efficiencyGlow)\" points=\"24,105 108,98 200,32 300,42 300,126 24,126\"></polygon>\n<!-- Line curve -->\n<polyline fill=\"none\" points=\"24,105 108,98 200,32 300,42\" stroke=\"#a33900\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"></polyline>\n<!-- Points -->\n<!-- P1: Oct 02 -> 14.0 -->\n<circle cx=\"24\" cy=\"105\" fill=\"#ffffff\" r=\"4.5\" stroke=\"#a33900\" stroke-width=\"2.5\"></circle>\n<text class=\"font-label-sm text-[10px]\" fill=\"#5a4138\" text-anchor=\"middle\" x=\"24\" y=\"125\">14.0</text>\n<!-- P2: Oct 10 -> 13.9 -->\n<circle cx=\"108\" cy=\"98\" fill=\"#ffffff\" r=\"4.5\" stroke=\"#a33900\" stroke-width=\"2.5\"></circle>\n<text class=\"font-label-sm text-[10px]\" fill=\"#5a4138\" text-anchor=\"middle\" x=\"108\" y=\"125\">13.9</text>\n<!-- P3: Oct 17 -> 14.4 -->\n<circle cx=\"200\" cy=\"32\" fill=\"#a33900\" r=\"5\" stroke=\"#ffdbce\" stroke-width=\"2\"></circle>\n<text class=\"font-label-md text-[11px] font-bold\" fill=\"#a33900\" text-anchor=\"middle\" x=\"200\" y=\"22\">14.4 ★</text>\n<!-- P4: Oct 24 -> 14.2 -->\n<circle cx=\"300\" cy=\"42\" fill=\"#ffffff\" r=\"4.5\" stroke=\"#a33900\" stroke-width=\"2.5\"></circle>\n<text class=\"font-label-sm text-[10px]\" fill=\"#5a4138\" text-anchor=\"middle\" x=\"300\" y=\"28\">14.2</text>\n</svg>\n<div class=\"flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm px-2 pt-1\">\n<span>02 Oct</span>\n<span>10 Oct</span>\n<span>17 Oct</span>\n<span>24 Oct</span>\n</div>\n</div>\n</div>\n<!-- Recent Fuel Logs Section -->\n<div class=\"flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">October Fuel Logs</h3>\n<span class=\"font-label-md text-label-md text-primary font-semibold\">4 entries</span>\n</div>\n<!-- Log Entries List -->\n<div class=\"flex flex-col gap-space-xs\">\n<!-- Entry 1: Texaco Barbican -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs transition-transform active:scale-[0.99]\">\n<div class=\"flex items-start justify-between\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-secondary text-[22px]\">local_gas_station</span>\n</div>\n<div>\n<div class=\"flex items-center gap-1.5\">\n<h4 class=\"font-headline-sm text-headline-sm text-on-surface\">Texaco Barbican</h4>\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary shrink-0\"></span>\n<span class=\"font-label-sm text-label-sm px-1.5 py-0.5 rounded bg-surface-container text-on-surface-variant\">E-10 87</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">24 Oct • Kingston 6</p>\n</div>\n</div>\n<div class=\"text-right\">\n<p class=\"font-price-display text-pric