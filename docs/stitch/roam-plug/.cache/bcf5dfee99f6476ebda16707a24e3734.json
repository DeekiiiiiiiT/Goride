{"filename":"45b-submitted-variant.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"error\": \"#ba1a1a\", \"error-container\": \"#ffdad6\", \"surface-bright\": \"#fff8f2\", \"primary-fixed-dim\": \"#ffb599\", \"surface-container-highest\": \"#e8e1db\", \"on-secondary-fixed\": \"#341100\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-container\": \"#936f00\", \"inverse-surface\": \"#33302c\", \"on-secondary-container\": \"#5c2400\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary\": \"#755800\", \"on-error-container\": \"#93000a\", \"on-tertiary\": \"#ffffff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface-container-lowest\": \"#ffffff\", \"background\": \"#fff8f2\", \"on-surface-variant\": \"#5a4138\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-low\": \"#faf2eb\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"outline\": \"#8e7166\", \"on-primary-container\": \"#fffbff\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container\": \"#f4ede6\", \"surface-variant\": \"#e8e1db\", \"on-primary-fixed\": \"#370e00\", \"on-secondary\": \"#ffffff\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary\": \"#9d4300\", \"surface-container-high\": \"#eee7e0\", \"primary-container\": \"#cc4900\", \"on-tertiary-container\": \"#fffbff\", \"primary\": \"#a33900\", \"on-background\": \"#1e1b17\", \"secondary-fixed\": \"#ffdbca\", \"outline-variant\": \"#e2bfb2\", \"surface\": \"#fff8f2\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"margin-lg\": \"1.5rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"margin\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"gutter\": \"1rem\" }, \"fontFamily\": { \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, \"fontSize\": { \"price-display\": [\"24px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</style><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen pt-safe pb-safe\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full px-margin pb-space-xl\">\n  <!-- Top Visual Delight: Pending Pin Illustration -->\n  <div class=\"flex flex-col items-center justify-center pt-space-lg pb-space-md text-center relative\">\n    <!-- Decorative Floating Hummingbird Motif -->\n    <div class=\"absolute right-6 top-2 opacity-85 pointer-events-none transform rotate-12 transition-transform duration-700 hover:rotate-0\">\n      <svg width=\"44\" height=\"44\" viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Stylized Doctor Bird (Jamaican Swallowtail Hummingbird) -->\n        <path d=\"M42 6C34 10 28 17 24 23L17 18C16 13 20 8 26 5L42 6Z\" fill=\"#16a34a\"/>\n        <path d=\"M24 23C21 27 18 31 16 38L13 47C13 47 16 41 19 36C22 31 27 28 27 28L24 23Z\" fill=\"#1e1b17\"/>\n        <path d=\"M19 23L9 16C5 13 4 8 7 7C10 6 15 11 19 19L19 23Z\" fill=\"#eab308\"/>\n        <circle cx=\"28\" cy=\"11\" r=\"1.5\" fill=\"#ffffff\"/>\n      </svg>\n    </div>\n\n    <!-- Main Pin Badge Illustration -->\n    <div class=\"relative flex items-center justify-center w-28 h-28 mb-space-md\">\n      <!-- Ambient Sun-Warmed Glow -->\n      <div class=\"absolute inset-0 rounded-full bg-secondary-container/20 blur-xl\"></div>\n      \n      <!-- Dashed Rotating / Pulsing SVG Ring -->\n      <svg class=\"absolute inset-0 w-full h-full transform -rotate-45\" viewBox=\"0 0 112 112\">\n        <circle cx=\"56\" cy=\"56\" r=\"50\" fill=\"none\" stroke=\"#fd761a\" stroke-width=\"2.5\" stroke-dasharray=\"7 5\" stroke-linecap=\"round\" class=\"opacity-90\"/>\n      </svg>\n\n      <!-- Inner High-Contrast Badge Container -->\n      <div class=\"relative flex items-center justify-center w-20 h-20 rounded-full bg-surface-container-lowest shadow-md\">\n        <!-- Sunset Gradient Core -->\n        <div class=\"flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-tr from-primary to-secondary-container text-on-primary shadow-sm\">\n          <span class=\"material-symbols-outlined text-[36px]\" style=\"font-variation-settings: 'FILL' 1;\">add_location_alt</span>\n        </div>\n        \n        <!-- Floating Status Sparkle / Clock Accent -->\n        <div class=\"absolute -bottom-1 -right-1 flex items-center justify-center w-8 h-8 rounded-full bg-tertiary-fixed-dim text-on-tertiary-fixed shadow-md border-2 border-surface-container-lowest\">\n          <span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">schedule</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Island Flag Ribbon Micro Accent -->\n    <div class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-low shadow-sm mb-space-sm\">\n      <div class=\"flex items-center gap-0.5 overflow-hidden rounded-full w-4 h-2.5\">\n        <span class=\"w-1.5 h-full bg-[#16a34a]\"></span>\n        <span class=\"w-1 h-full bg-[#eab308]\"></span>\n        <span class=\"w-1.5 h-full bg-[#1e1b17]\"></span>\n      </div>\n      <span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant\">Kingston &amp; St. Andrew Corridor</span>\n    </div>\n\n    <!-- Headline & Reassurance -->\n    <h1 class=\"font-headline-md text-headline-md text-on-surface text-center mb-space-xs\">\n      Thanks! Your pin is awaiting approval\n    </h1>\n    <p class=\"font-body-md text-body-md text-on-surface-variant max-w-sm text-center leading-relaxed\">\n      The Roam team and parish moderators check every pin before it goes live on the island map. We&apos;ll notify you as soon as it&apos;s verified.\n    </p>\n  </div>\n\n  <!-- Submission Summary Card -->\n  <div class=\"w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-md mb-space-md\">\n    <div class=\"flex items-start justify-between gap-space-sm pb-space-sm\">\n      <div class=\"flex items-start gap-space-sm min-w-0\">\n        <div class=\"flex items-center justify-center w-11 h-11 rounded-lg bg-surface-container text-primary shrink-0 shadow-sm\">\n          <span class=\"material-symbols-outlined text-[24px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n        </div>\n        <div class=\"min-w-0\">\n          <h2 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">TotalEnergies Half-Way-Tree</h2>\n          <p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Constant Spring Rd, Kingston 10</p>\n        </div>\n      </div>\n      <!-- Status Badge -->\n      <div class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed shrink-0 shadow-sm\">\n        <span class=\"material-symbols-outlined text-[14px]\" style=\"font-variation-settings: 'FILL' 1;\">hourglass_top</span>\n        <span class=\"font-label-md text-label-md\">Pending Review</span>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-2 gap-space-sm pt-space-sm bg-surface-container-low rounded-lg p-space-sm\">\n      <div class=\"flex flex-col\">\n        <span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Category</span>\n        <span class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1 mt-0.5\">\n          <span class=\"material-symbols-outlined text-[16px] text-primary\">local_gas_station</span>\n          Gas Station\n        </span>\n      </div>\n      <div class=\"flex flex-col\">\n        <span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Est. Review Time</span>\n        <span class=\"font-label-lg text-label-lg text-on-surface flex items-center gap-1 mt-0.5\">\n          <span class=\"material-symbols-outlined text-[16px] text-secondary\">pace</span>\n          ~2 to 4 hours\n        </span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Community Contribution Counter Card (Sunset Motoring Gradient) -->\n  <div class=\"relative w-full rounded-xl overflow-hidden p-space-md mb-space-md bg-gradient-to-br from-primary-container via-secondary-container to-tertiary-fixed shadow-md text-on-primary\">\n    <!-- Ambient Overlay Graphics -->\n    <div class=\"absolute -right-8 -bottom-8 opacity-15 pointer-events-none\">\n      <span class=\"material-symbols-outlined text-[160px]\">emoji_events</span>\n    </div>\n\n    <div class=\"relative z-10 flex flex-col gap-space-sm\">\n      <div class=\"flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"flex items-center justify-center w-8 h-8 rounded-full bg-surface-container-lowest/20 backdrop-blur-sm\">\n            <span class=\"material-symbols-outlined text-[20px] text-on-primary\" style=\"font-variation-settings: 'FILL' 1;\">military_tech</span>\n          </span>\n          <span class=\"font-label-lg text-label-lg tracking-wide uppercase text-on-primary/90\">Scout Network</span>\n        </div>\n        <span class=\"font-label-md text-label-md px-2.5 py-0.5 rounded-full bg-surface-container-lowest/25 backdrop-blur-sm text-on-primary\">\n          Rank: Parish Scout Level 2\n        </span>\n      </div>\n\n      <div class=\"flex items-baseline justify-between mt-space-xs\">\n        <div>\n          <div class=\"font-display-lg-mobile text-display-lg-mobile font-bold tracking-tight text-on-primary\">\n            12 Places\n          </div>\n          <p class=\"font-label-md text-label-md text-on-primary/90 -mt-1\">Mapped across Jamaica</p>\n        </div>\n        <div class=\"text-right\">\n          <div class=\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-surface-container-lowest text-primary font-price-display text-price-display shadow-sm\">\n            +25\n          </div>\n          <span class=\"block font-label-sm text-label-sm text-on-primary/95 mt-1 font-semibold\">Pending Points</span>\n        </div>\n      </div>\n\n      <div class=\"pt-space-sm mt-space-xs bg-surface-container-lowest/15 rounded-lg p-2.5 backdrop-blur-sm\">\n        <p class=\"font-body-sm text-body-sm text-on-primary flex items-start gap-1.5 leading-snug\">\n          <span class=\"material-symbols-outlined text-[16px] shrink-0 mt-0.5 text-tertiary-fixed\" style=\"font-variation-settings: 'FILL' 1;\">volunteer_activism</span>\n          <span>Respect! Your pins have helped over <strong>3,400 Jamaican motorists</strong> find fuel, air, and repairs this month.</span>\n        </p>\n      </div>\n    </div>\n  </div>\n\n  <!-- What Happens Next Timeline Card -->\n  <div class=\"w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-md mb-space-lg\">\n    <div class=\"flex items-center justify-between pb-space-sm mb-space-sm\">\n      <h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Verification Process</h3>\n      <span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container text-on-surface-variant uppercase font-semibold\">3-Step Check</span>\n    </div>\n\n    <div class=\"flex flex-col gap-space-md\">\n      <!-- Step 1: Automated GPS Corridor Verification (Completed) -->\n      <div class=\"flex items-start gap-space-sm\">\n        <div class=\"flex flex-col items-center\">\n          <div class=\"flex items-center justify-center w-7 h-7 rounded-full bg-[#16a34a] text-surface-container-lowest shadow-sm\">\n            <span class=\"material-symbols-outlined text-[18px]\">check</span>\n          </div>\n          <div class=\"w-0.5 h-7 bg-[#16a34a] mt-1 opacity-70\"></div>\n        </div>\n        <div class=\"flex-1 min-w-0 pt-0.5\">\n          <div class=\"flex items-center justify-between\">\n            <span class=\"font-label-lg text-label-lg text-on-surface\">Corridor GPS Check</span>\n            <span class=\"font-label-sm text-label-sm text-[#16a34a] font-bold\">Passed</span>\n          </div>\n          <p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n            Geofence verified along Constant Spring arterial corridor.\n          </p>\n        </div>\n      </div>\n\n      <!-- Step 2: Moderator checks duplicate & photo (In queue) -->\n      <div class=\"flex items-start gap-space-sm\">\n        <div class=\"flex flex-col items-center\">\n          <div class=\"flex items-center justify-center w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container shadow-sm animate-pulse\">\n            <span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">sync</span>\n          </div>\n          <div class=\"w-0.5 h-7 bg-surface-container-highest mt-1\"></div>\n        </div>\n        <div class=\"flex-1 min-w-0 pt-0.5\">\n          <div class=\"flex items-center justify-between\">\n            <span class=\"font-label-lg text-label-lg text-on-surface\">Duplicate &amp; Photo Audit</span>\n            <span class=\"font-label-sm text-label-sm text-secondary font-bold\">In Review</span>\n          </div>\n          <p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n            Local Kingston moderators verifying site photos and fuel grade availability.\n          </p>\n        </div>\n      </div>\n\n      <!-- Step 3: Pin goes live on Jamaican radar + SMS alert sent -->\n      <div class=\"flex items-start gap-space-sm\">\n        <div class=\"flex flex-col items-center\">\n          <div class=\"flex items-center justify-center w-7 h-7 rounded-full bg-surface-container text-on-surface-variant shadow-sm\">\n            <span class=\"material-symbols-outlined text-[16px]\">sensors</span>\n          </div>\n        </div>\n        <div class=\"flex-1 min-w-0 pt-0.5\">\n          <div class=\"flex items-center justify-between\">\n            <span class=\"font-label-lg text-label-lg text-on-surface-variant\">Live Radar Broadcast</span>\n            <span class=\"font-label-sm text-label-sm text-on-surface-variant\">Pending</span>\n          </div>\n          <p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n            Pin activates across the Roam live map and confirms via instant SMS.\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Primary and Secondary Actions -->\n  <div class=\"flex flex-col gap-space-sm w-full\">\n    <!-- Primary CTA: Map Another Place -->\n    <button type=\"button\" class=\"w-full min-h-[48px] px-space-lg py-3 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-2 shadow-md active:bg-on-primary-fixed-variant transition-colors\">\n      <span class=\"material-symbols-outlined text-[20px]\">add_location</span>\n      <span>Map Another Place</span>\n    </button>\n\n    <!-- Secondary CTA: Back to Map -->\n    <button type=\"button\" class=\"w-full min-h-[48px] px-space-lg py-3 rounded-lg bg-surface-container text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-2 active:bg-surface-container-high transition-colors\">\n      <span class=\"material-symbols-outlined text-[20px] text-primary\">map</span>\n      <span>Back to Map</span>\n    </button>\n\n    <!-- Subtle Tertiary Link -->\n    <div class=\"flex items-center justify-center pt-space-xs pb-space-sm\">\n      <a href=\"#submitted-places\" class=\"font-label-md text-label-md text-secondary underline decoration-secondary/50 underline-offset-4 py-2 px-4 active:text-on-secondary-fixed-variant\">\n        View My Submitted Places (12)\n      </a>\n    </div>\n  </div>\n</div></main></body></html></script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body></body></html>"}