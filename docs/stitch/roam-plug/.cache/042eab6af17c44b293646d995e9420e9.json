y-between pt-2\">\n<div class=\"flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\">speed</span>\n<span>16.8 km/L Est. Kingston Urban</span>\n</div>\n<div class=\"w-16 h-8 flex items-center justify-end text-primary opacity-80\">\n<svg class=\"w-14 h-7 stroke-current\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 72 32\">\n<path d=\"M4 22L12 22M60 22L68 22M12 22C12 18.5 15 16 18.5 16C22 16 25 18.5 25 22M47 22C47 18.5 50 16 53.5 16C57 16 60 18.5 60 22\"></path>\n<path d=\"M12 22H6M6 22L8 15L15 11L28 8H44L56 12L66 16L66 22H60\"></path>\n<path d=\"M28 8L26 15H46L44 8\"></path>\n<circle cx=\"18.5\" cy=\"22\" fill=\"currentColor\" r=\"3.5\"></circle>\n<circle cx=\"53.5\" cy=\"22\" fill=\"currentColor\" r=\"3.5\"></circle>\n</svg>\n</div>\n</div>\n</div>\n<div class=\"p-4 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col gap-3 active:bg-surface-container-low transition-colors\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Roomy X / Standard</span>\n<span class=\"px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm font-semibold\">M900A</span>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">2WD Front Wheel Drive • 2016–2020</span>\n</div>\n<div class=\"w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center text-transparent flex-shrink-0 mt-0.5\">\n<div class=\"w-2 h-2 rounded-full bg-surface-container\"></div>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center gap-2\">\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[15px] text-on-surface-variant\">eco</span>\n          1.0L 1KR-FE Non-Turbo\n        </span>\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[15px] text-on-surface-variant\">local_gas_station</span>\n          E-10 87 recommended\n        </span>\n</div>\n<div class=\"flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm pt-1\">\n<span class=\"material-symbols-outlined text-[16px]\">speed</span>\n<span>18.2 km/L Est. Island Commute</span>\n</div>\n</div>\n<div class=\"p-4 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col gap-3 active:bg-surface-container-low transition-colors\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Roomy 4WD</span>\n<span class=\"px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm font-semibold\">M910A</span>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">All-Wheel Drive • 2016–2020</span>\n</div>\n<div class=\"w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center text-transparent flex-shrink-0 mt-0.5\">\n<div class=\"w-2 h-2 rounded-full bg-surface-container\"></div>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center gap-2\">\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[15px] text-on-surface-variant\">all_inclusive</span>\n          1.0L AWD Hill Assist\n        </span>\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[15px] text-on-surface-variant\">local_gas_station</span>\n          E-10 87 / 90\n        </span>\n</div>\n<div class=\"flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm pt-1\">\n<span class=\"material-symbols-outlined text-[16px]\">speed</span>\n<span>15.4 km/L Est. Hill Route Spec</span>\n</div>\n</div>\n</div>\n<div class=\"px-space-md mb-6\">\n<button class=\"w-full p-3.5 rounded-xl bg-surface-container-low flex items-center justify-center gap-2 text-secondary active:bg-secondary-fixed/50 transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">help_center</span>\n<span class=\"font-label-lg text-label-lg font-bold\">Can't find your car? Enter custom vehicle specs</span>\n</button>\n</div>\n<div class=\"px-space-md flex flex-col gap-2\">\n<button class=\"w-full h-[50px] rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm font-bold shadow-md flex items-center justify-center gap-2 active:bg-primary-container transition-all\" type=\"button\">\n<span>Continue with Roomy (2019)</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant text-center px-4\">\n      You can edit this or add a second vehicle anytime in Garage.\n    </p>\n</div>\n</div></main></body></html>"}