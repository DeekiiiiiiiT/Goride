\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Parts For My Car   Categories</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Vehicle Identity Card & Switcher -->\n<div class=\"mb-4\">\n<button class=\"w-full bg-surface-container hover:bg-surface-container-high transition-colors rounded-xl p-space-md shadow-sm flex items-center justify-between text-left active:scale-[0.99] group\" type=\"button\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-11 h-11 rounded-lg bg-primary-fixed flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-primary-fixed text-[24px]\">directions_car</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">2019 Toyota Roomy</span>\n<span class=\"material-symbols-outlined text-primary text-[20px] transition-transform group-hover:translate-y-0.5\">expand_more</span>\n</div>\n<div class=\"flex items-center gap-2 mt-0.5 text-on-surface-variant font-label-md text-label-md flex-wrap\">\n<span class=\"bg-surface-container-highest px-1.5 py-0.5 rounded text-on-surface font-semibold\">8241-HY</span>\n<span>1KR-FE Turbo</span>\n<span class=\"text-secondary font-medium\">JDM Import (M900A)</span>\n</div>\n</div>\n</div>\n<div class=\"shrink-0 pl-2\">\n<span class=\"font-label-sm text-label-sm text-primary uppercase tracking-wider font-bold bg-primary-fixed/60 px-2 py-1 rounded-full\">Active</span>\n</div>\n</button>\n</div>\n<!-- Search Component with Instant Jamaican Autofill Hint -->\n<div class=\"mb-4\">\n<div class=\"relative flex items-center\">\n<div class=\"absolute left-3.5 flex items-center pointer-events-none text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[22px]\">search</span>\n</div>\n<input class=\"w-full h-12 pl-11 pr-10 rounded-xl bg-surface-container-lowest font-body-md text-body-md text-on-surface placeholder:text-outline shadow-sm focus:outline-none focus:bg-surface-container-lowest focus:ring-0 active:bg-surface-container-lowest transition-all\" id=\"parts-search-input\" placeholder=\"Search part (e.g. brake pads, 04465-B1170)...\" type=\"search\"/>\n<button aria-label=\"Clear search\" class=\"absolute right-3 w-8 h-8 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container-high transition-colors\" id=\"clear-search-btn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">close</span>\n</button>\n</div>\n</div>\n<!-- Island Match Guarantee Value Prop Banner -->\n<div class=\"mb-5 bg-gradient-to-r from-primary-container via-secondary-container to-tertiary-container text-on-primary p-space-md rounded-xl shadow-md relative overflow-hidden\">\n<div class=\"absolute -right-4 -bottom-4 w-28 h-28 opacity-15 pointer-events-none\">\n<span class=\"material-symbols-outlined text-[120px]\">verified_user</span>\n</div>\n<div class=\"relative z-10\">\n<div class=\"flex items-center gap-1.5 mb-1\">\n<span class=\"material-symbols-outlined text-tertiary-fixed text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">electric_bolt</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-primary\">JDM &amp; Caribbean Fitment Match</h2>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-primary/95 pr-6 leading-relaxed\">\n        We auto-cross-reference your JDM Roomy chassis with sister Daihatsu Thor &amp; Subaru Justy codes stocked right here in Jamaican auto supply warehouses.\n      </p>\n</div>\n</div>\n<!-- Common for your car (Quick Horizontal Carousel) -->\n<div class=\"mb-6\">\n<div class=\"flex items-center justify-between mb-2.5\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">auto_fix_high</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Common for Your Roomy</h2>\n</div>\n<span class=\"font-label-md text-label-md text-secondary font-semibold\">1KR-FE Specs</span>\n</div>\n<div class=\"flex gap-3 overflow-x-auto pb-2 -mx-gutter px-gutter no-scrollbar scroll-smooth\">\n<!-- Card 1: Oil Filter -->\n<div class=\"shrink-0 w-60 bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between\">\n<div>\n<div class=\"flex items-center justify-between mb-2\">\n<div class=\"w-8 h-8 rounded-lg bg-error-container text-on-error-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px]\">oil_barrel</span>\n</div>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-bold\">Due Soon</span>\n</div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Oil Filter</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">OEM: 04152-40060</p>\n<p class=\"font-label-sm text-label-sm text-secondary font-medium mt-1\">Cross-fit: Daihatsu Thor</p>\n</div>\n<div class=\"pt-3 mt-2\">\n<a class=\"inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:text-primary-container\" href=\"#\">\n            View fits <span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Card 2: Air Intake -->\n<div class=\"shrink-0 w-60 bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between\">\n<div>\n<div class=\"flex items-center justify-between mb-2\">\n<div class=\"w-8 h-8 rounded-lg bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px]\">air</span>\n</div>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface font-semibold\">Kingston Dust Spec</span>\n</div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Air Filter</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">High-flow pleated element</p>\n<p class=\"font-label-sm text-label-sm text-secondary font-medium mt-1\">OEM: 17801-B1020</p>\n</div>\n<div class=\"pt-3 mt-2\">\n<a class=\"inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:text-primary-container\" href=\"#\">\n            View fits <span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Card 3: Spark Plugs -->\n<div class=\"shrink-0 w-60 bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between\">\n<div>\n<div class=\"flex items-center justify-between mb-2\">\n<div class=\"w-8 h-8 rounded-lg bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px]\">bolt</span>\n</div>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-semibold\">Turbo Spec</span>\n</div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Spark Plugs (Set of 3)</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">NGK Iridium ILKR7D8</p>\n<p class=\"font-label-sm text-label-sm text-secondary font-medium mt-1\">Pre-gapped 0.8mm</p>\n</div>\n<div class=\"pt-3 mt-2\">\n<a class=\"inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:text-primary-container\" href=\"#\">\n            View fits <span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Card 4: Brake Pads -->\n<div class=\"shrink-0 w-60 bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between\">\n<div>\n<div class=\"flex items-center justify-between mb-2\">\n<div class=\"w-8 h-8 rounded-lg bg-primary-fixed text-on-primary-fixed flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px]\">trip_origin</span>\n</div>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface font-semibold\">Hill Grade</span>\n</div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Front Brake Pads</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">Ceramic anti-fade series</p>\n<p class=\"font-label-sm text-label-sm text-secondary font-medium mt-1\">OEM: 04465-B1170</p>\n</div>\n<div class=\"pt-3 mt-2\">\n<a class=\"inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:text-primary-container\" href=\"#\">\n            View fits <span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n<!-- Browse by Category Section -->\n<div class=\"mb-6\">\n<div class=\"flex items-center justify-between mb-3\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">category</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Browse by Category</h2>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface-variant\">10 Sectors</span>\n</div>\n<!-- Category Grid: Tactile 2-column touch cards -->\n<div class=\"grid grid-cols-2 gap-3\">\n<!-- 1. Filters -->\n<a class=\"bg-surface-container-lowest hover:bg-surface-container active:scale-[0.98] transition-all p-3.5 rounded-xl shadow-sm flex flex-col justify-between min-h-[120px] group\" href=\"#\">\n<div class=\"flex items-center justify-between\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container fle