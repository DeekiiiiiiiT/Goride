{"filename":"02-welcome.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"surface-container-highest\": \"#e8e1db\", \"surface-container\": \"#f4ede6\", \"on-surface\": \"#1e1b17\", \"error\": \"#ba1a1a\", \"surface-bright\": \"#fff8f2\", \"on-background\": \"#1e1b17\", \"outline\": \"#8e7166\", \"secondary-fixed\": \"#ffdbca\", \"on-secondary-fixed\": \"#341100\", \"surface-dim\": \"#e0d9d2\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"primary-container\": \"#cc4900\", \"primary-fixed\": \"#ffdbce\", \"surface-variant\": \"#e8e1db\", \"on-error\": \"#ffffff\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary-container\": \"#936f00\", \"error-container\": \"#ffdad6\", \"on-tertiary\": \"#ffffff\", \"on-tertiary-container\": \"#fffbff\", \"secondary\": \"#9d4300\", \"primary\": \"#a33900\", \"inverse-surface\": \"#33302c\", \"primary-fixed-dim\": \"#ffb599\", \"on-primary-container\": \"#fffbff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface\": \"#fff8f2\", \"background\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"outline-variant\": \"#e2bfb2\", \"on-secondary\": \"#ffffff\", \"secondary-fixed-dim\": \"#ffb690\", \"surface-container-low\": \"#faf2eb\", \"on-secondary-fixed-variant\": \"#783200\", \"on-tertiary-fixed\": \"#251a00\", \"on-error-container\": \"#93000a\", \"surface-tint\": \"#a73a00\", \"on-surface-variant\": \"#5a4138\", \"secondary-container\": \"#fd761a\", \"tertiary\": \"#755800\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"surface-container-lowest\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"gutter-sm\": \"0.75rem\", \"space-xs\": \"0.25rem\", \"space-md\": \"1rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"gutter\": \"1rem\", \"space-lg\": \"1.5rem\", \"margin\": \"1rem\", \"margin-lg\": \"1.5rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-md\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100%;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style></head><body class=\"bg-surface text-on-surface antialiased flex flex-col min-h-screen\"><div class=\"w-full pt-safe px-margin select-none\"><div class=\"flex justify-between items-center pt-space-xs text-on-surface\"><span class=\"font-label-md text-label-md font-semibold tracking-tight\">9:41</span><div class=\"flex items-center gap-1.5\"><span class=\"material-symbols-outlined text-[16px] leading-none\">signal_cellular_alt</span><span class=\"material-symbols-outlined text-[16px] leading-none\">wifi</span><span class=\"material-symbols-outlined text-[18px] leading-none\">battery_full</span></div></div></div><main class=\"flex-1 flex flex-col relative w-full pb-safe bg-surface px-margin\"><div class=\"flex flex-col w-full pb-6 space-y-5 animate-fade-in\">\n<!-- Top Navigation & Parish Badge Header -->\n<header class=\"flex items-center justify-between w-full pt-2\">\n<div class=\"flex items-center gap-2\">\n<img alt=\"Roam Plug Logo\" class=\"w-10 h-10 object-contain rounded-lg shadow-sm\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1XmALotlSP9jE2bot3DOkJ9Ouv5qiEOhn6k5boTQAQyORbZ89jqFUeeYqmFsjj5bdbR2x_KtjR475faejSGjZEtHwg05XZvaKrwL6wsAA6CeMMoznwZmIopNqbNDc-PwEYvLdAiyUOxupw9hdYwSZUeE7EsllxyZLZrF4-oCp3vPr0DJHQguvKyS-XcjunCplI096YEPFDRGv51pM7SAdx6BDkUroNb7w53Cg1TdbpLtCaz5QQdeAfvjwE\"/>\n<div class=\"flex flex-col\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface leading-none tracking-tight\">Roam Plug</span>\n<span class=\"font-label-sm text-label-sm text-secondary font-semibold uppercase tracking-wider mt-0.5\">Motoring Co-Pilot</span>\n</div>\n</div>\n<div class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high shadow-sm\">\n<span class=\"text-sm leading-none\">🇯🇲</span>\n<span class=\"font-label-md text-label-md text-on-surface font-bold tracking-normal\">Jamaica</span>\n</div>\n</header>\n<!-- Hero Visual Card with Warm Island Aesthetic -->\n<div class=\"relative w-full rounded-xl overflow-hidden bg-surface-container shadow-md group\">\n<div class=\"relative w-full aspect-[4/3] overflow-hidden\">\n<img alt=\"Roam Plug gas station experience across Jamaican hills\" class=\"w-full h-full object-cover transform transition-transform duration-700 ease-out group-hover:scale-105\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDM9P7iBQTX--eXioy1YCz6OgTT9w8lGqdfS1D_eVk3uwpyyVsfLKCEcnQ6VnodBbFoin8qhE6QGlcZW0aVweC5yzIWaNBAsB1EIr-Hq6vCBsXfkxQyAGzqUZlZlcmnWluKZZPWfTLiua2EKgpYJv8xfx_7rAab4GnX3aQdt3nTbnU02piOaRcj9kyXX60Bc4EW1bsQQLrw7hxGzbYrY3HcURujv6WkaQOY8Q6SBIsBSAvAV4A0gs2U\"/>\n<!-- Soft Sun-Warmed Vignette Overlay -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-on-surface/40 via-transparent to-transparent pointer-events-none\"></div>\n<!-- Live Island Status Pill -->\n<div class=\"absolute bottom-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur-md shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-emerald-600 animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface font-semibold tracking-wide\">14 Parishes Active</span>\n</div>\n<!-- Live Fuel Price Preview Spark -->\n<div class=\"absolute top-3 right-3 flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container shadow-md\">\n<span class=\"material-symbols-outlined text-[14px]\">local_gas_station</span>\n<span class=\"font-label-sm text-label-sm font-bold tracking-tight\">E-10 87 Best Rates</span>\n</div>\n</div>\n</div>\n<!-- Value Proposition & Typography Messaging -->\n<div class=\"flex flex-col space-y-2 text-left\">\n<div class=\"inline-flex items-center gap-1.5 text-secondary font-label-md text-label-md uppercase tracking-wider font-bold\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">explore</span>\n      Island-Wide Driver Network\n    </div>\n<h1 class=\"font-display-lg-mobile text-display-lg-mobile text-on-surface font-extrabold tracking-tight\">\n      Welcome to <span class=\"text-primary-container\">Roam Plug</span>\n</h1>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant leading-relaxed\">\n      Fuel prices, car care and every motoring spot in Jamaica — free.\n    </p>\n</div>\n<!-- Trust Highlights & Island Community Badges -->\n<div class=\"flex items-center justify-between w-full px-4 py-3 rounded-lg bg-surface-container-low shadow-sm\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\">block</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">No ads</span>\n</div>\n<span class=\"w-1 h-1 rounded-full bg-outline-variant\"></span>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[18px] text-tertiary-container\" style=\"font-variation-settings: 'FILL' 1;\">group</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">Community powered</span>\n</div>\n<span class=\"w-1 h-1 rounded-full bg-outline-variant\"></span>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[18px] text-primary-container\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">100% Free</span>\n</div>\n</div>\n<!-- Action Deck with Ergonomic One-Hand Hit Targets -->\n<div class=\"flex flex-col w-full space-y-3 pt-2\">\n<!-- Primary CTA: Get Started -->\n<button class=\"w-full min-h-[52px] px-6 py-3.5 rounded-xl bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 shadow-md active:scale-[0.98] transition-all duration-150\" id=\"get-started-btn\" type=\"button\">\n<span>Get Started</span>\n<span class=\"material-symbols-outlined text-[20px] transition-transform duration-200 group-active:translate-x-1\">arrow_forward</span>\n</button>\n<!-- Secondary CTA: Explore Without Account -->\n<button class=\"w-full min-h-[48px] px-6 py-3 rounded-xl bg-surface-container-highest text-on-surface font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 hover:bg-surface-container-high active:scale-[0.98] transition-colors\" id=\"explore-btn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px] text-secondary\">near_me</span>\n<span>Explore without an account</span>\n</button>\n<!-- Tertiary Action: Account Link -->\n<div class=\"flex items-center justify-center pt-1\">\n<button class=\"min-h-[48px] px-4 inline-flex items-center justify-center font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface active:text-primary transition-colors\" id=\"login-btn\" type=\"button\">\n        I already have an account • <span class=\"font-bold text-primary ml-1 underline decoration-primary-container decoration-2 underline-offset-4\">Log in</span>\n</button>\n</div>\n</div>\n</div>\n<script>\n  (function() {\n    const getStartedBtn = document.getElementById('get-started-btn');\n    const exploreBtn = document.getElementById('explore-btn');\n    const loginBtn = document.getElementById('login-btn');\n\n    if (getStartedBtn) {\n      getStartedBtn.addEventListener('click', () => {\n        getStartedBtn.classList.add('opacity-90');\n        setTimeout(() => getStartedBtn.classList.remove('opacity-90'), 150);\n      });\n    }\n\n    if (exploreBtn) {\n      exploreBtn.addEventListener('click', () => {\n        exploreBtn.classList.add('bg-surface-dim');\n        setTimeout(() => exploreBtn.classList.remove('bg-surface-dim'), 150);\n      });\n    }\n\n    if (loginBtn) {\n      loginBtn.addEventListener('click', () => {\n        loginBtn.classList.add('opacity-70');\n        setTimeout(() => loginBtn.classList.remove('opacity-70'), 150);\n      });\n    }\n  })();\n</script></main></body></html>"}