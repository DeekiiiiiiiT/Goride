{"filename":"28-saved-offline.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"error\": \"#ba1a1a\", \"error-container\": \"#ffdad6\", \"surface-bright\": \"#fff8f2\", \"primary-fixed-dim\": \"#ffb599\", \"surface-container-highest\": \"#e8e1db\", \"on-secondary-fixed\": \"#341100\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-container\": \"#936f00\", \"inverse-surface\": \"#33302c\", \"on-secondary-container\": \"#5c2400\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary\": \"#755800\", \"on-error-container\": \"#93000a\", \"on-tertiary\": \"#ffffff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface-container-lowest\": \"#ffffff\", \"background\": \"#fff8f2\", \"on-surface-variant\": \"#5a4138\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-low\": \"#faf2eb\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"outline\": \"#8e7166\", \"on-primary-container\": \"#fffbff\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container\": \"#f4ede6\", \"surface-variant\": \"#e8e1db\", \"on-primary-fixed\": \"#370e00\", \"on-secondary\": \"#ffffff\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary\": \"#9d4300\", \"surface-container-high\": \"#eee7e0\", \"primary-container\": \"#cc4900\", \"on-tertiary-container\": \"#fffbff\", \"primary\": \"#a33900\", \"on-background\": \"#1e1b17\", \"secondary-fixed\": \"#ffdbca\", \"outline-variant\": \"#e2bfb2\", \"surface\": \"#fff8f2\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"margin-lg\": \"1.5rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"margin\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"gutter\": \"1rem\" }, \"fontFamily\": { \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, \"fontSize\": { \"price-display\": [\"24px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</script><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen pt-safe pb-safe\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full px-margin pb-space-xl\">\n<!-- Top Visual Delight: Sunlit Offline Stash Illustration -->\n<div class=\"relative flex flex-col items-center justify-center pt-space-md pb-space-lg text-center overflow-hidden\">\n<!-- Ambient Warm Ray Effect -->\n<div class=\"absolute -top-10 w-56 h-56 rounded-full bg-secondary-fixed/50 blur-3xl pointer-events-none -z-10\"></div>\n<!-- Illustrated Offline Stamp / Cloud Badge -->\n<div class=\"relative w-24 h-24 mb-space-md flex items-center justify-center rounded-full bg-surface-container-high shadow-sm\">\n<div class=\"absolute inset-1.5 rounded-full bg-surface-container-low flex items-center justify-center\">\n<!-- Pulse ring for offline queue reassurance -->\n<span class=\"absolute w-full h-full rounded-full bg-tertiary-fixed/30 animate-ping opacity-60\"></span>\n<div class=\"relative flex items-center justify-center w-14 h-14 rounded-full bg-surface-container-highest text-tertiary\">\n<span class=\"material-symbols-outlined text-[36px]\" style=\"font-variation-settings: 'FILL' 1;\">cloud_off</span>\n</div>\n</div>\n<!-- Tiny playful Jamaican hummingbird/pine emblem sync badge -->\n<div class=\"absolute bottom-0 right-0 flex items-center justify-center w-8 h-8 rounded-full bg-tertiary-container text-on-tertiary-container shadow-md\">\n<span class=\"material-symbols-outlined text-[18px]\">lock</span>\n</div>\n</div>\n<!-- Title & Conversational Jamaican Driver Subtitle -->\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface mb-space-xs tracking-tight\">\n      Saved on your phone\n    </h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant max-w-xs leading-relaxed\">\n      No mobile data? No problem. Roam Plug stored your log safely. We'll automatically send it when you're back online.\n    </p>\n</div>\n<!-- Queued Logs Section -->\n<div class=\"flex flex-col w-full mb-space-lg\">\n<div class=\"flex items-center justify-between mb-space-sm px-space-xs\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-lg text-label-lg text-on-surface uppercase tracking-wider\">\n          Queued Logs\n        </span>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-bold\">\n          1 Pending\n        </span>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">St. Andrew</span>\n</div>\n<!-- Queued Log Card (Sunlight high contrast utility) -->\n<div class=\"relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-md shadow-md flex flex-col gap-space-sm\">\n<!-- Status pill & Station tag -->\n<div class=\"flex items-center justify-between gap-2\">\n<div class=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-tertiary-fixed/60 text-on-tertiary-fixed\">\n<span class=\"material-symbols-outlined text-[14px] animate-spin\" style=\"animation-duration: 3s;\">sync</span>\n<span class=\"font-label-sm text-label-sm tracking-wide uppercase\">Waiting to send</span>\n</div>\n<div class=\"flex items-center gap-1 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[14px]\">schedule</span>\n<span class=\"font-body-sm text-body-sm\">Today at 3:45 PM</span>\n</div>\n</div>\n<!-- Station & Fuel Type -->\n<div class=\"flex items-start justify-between gap-2 pt-1\">\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">\n              Texaco Barbican\n            </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Barbican Rd, Kingston 6</p>\n</div>\n<span class=\"inline-flex items-center justify-center px-2 py-1 rounded bg-[#16a34a] text-white font-label-sm text-label-sm font-bold shadow-sm whitespace-nowrap\">\n          E-10 87\n        </span>\n</div>\n<!-- Tabular Log Metrics Grid -->\n<div class=\"grid grid-cols-3 gap-2 p-space-sm rounded-lg bg-surface-container-low mt-1\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Amount</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">J$4,290</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Volume</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">20.0 L</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Odometer</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">84,612 km</span>\n</div>\n</div>\n<!-- Safe storage micro indicator -->\n<div class=\"flex items-center gap-1.5 pt-1 text-on-surface-variant/80\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n<span class=\"font-body-sm text-body-sm\">Saved locally to device sandbox database</span>\n</div>\n</div>\n</div>\n<!-- Offline Assurance Card -->\n<div class=\"relative overflow-hidden rounded-xl bg-surface-container p-space-md mb-space-lg shadow-sm\">\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[20px]\">speed</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg text-on-surface mb-0.5\">Zero Downtime Co-Pilot</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n          Your local vehicle stats, km/L calculation, and oil change reminders have already updated on this device.\n        </p>\n</div>\n</div>\n<!-- Mini visual meter indicator -->\n<div class=\"mt-space-md pt-space-sm flex items-center justify-between text-on-surface-variant\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">eco</span>\n<span class=\"font-body-sm text-body-sm font-semibold text-on-surface\">Calculated Rate:</span>\n</div>\n<span class=\"font-label-lg text-label-lg text-primary font-bold\">11.4 km/L</span>\n</div>\n</div>\n<!-- Real-time Jamaican Network Status Pill -->\n<div class=\"flex items-center justify-center mb-space-lg\">\n<div class=\"inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container-high text-on-surface-variant shadow-sm transition-all duration-300\" id=\"network-pill\">\n<span class=\"relative flex h-2.5 w-2.5\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary-container opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary-container\"></span>\n</span>\n<span class=\"font-label-sm text-label-sm tracking-wide\" id=\"network-text\">\n        Checking Jamaican network connection...\n      </span>\n</div>\n</div>\n<!-- Primary Done Action -->\n<div class=\"w-full flex flex-col gap-space-sm mt-auto\">\n<button class=\"w-full h-12 flex items-center justify-center rounded-xl bg-[#ea580c] active:bg-[#c2410c] text-white font-label-lg text-label-lg uppercase tracking-wider shadow-lg shadow-primary/20 transition-all duration-150 active:scale-[0.98]\" id=\"done-btn\" type=\"button\">\n      Done\n    </button>\n<button class=\"w-full h-10 flex items-center justify-center gap-1.5 rounded-lg bg-transparent text-secondary active:text-primary font-label-sm text-label-sm transition-colors\" onclick=\"manualSyncTry()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">refresh</span>\n<span>Force Sync Now</span>\n</button>\n</div>\n</div>\n<script>\n  // Simulated gentle ping to mirror live island transit network checks (Digicel / Flow JA)\n  const networkText = document.getElementById('network-text');\n  const networkPill = document.getElementById('network-pill');\n\n  function updateNetworkStatus() {\n    if (!navigator.onLine) {\n      if (networkText) networkText.textContent = \"Offline • Queued for Digicel / Flow connection\";\n      return;\n    }\n\n    setTimeout(() => {\n      if (networkText && networkPill) {\n        networkText.textContent = \"Auto-sync will trigger on route signal\";\n      }\n    }, 2400);\n  }\n\n  function manualSyncTry() {\n    if (!networkText) return;\n    networkText.textContent = \"Attempting sync with Jamaican cloud...\";\n    setTimeout(() => {\n      if (navigator.onLine) {\n        networkText.textContent = \"Data queued securely. Awaiting stable signal.\";\n      } else {\n        networkText.textContent = \"No data signal detected. Stored safe on phone.\";\n      }\n    }, 1200);\n  }\n\n  window.addEventListener('online', updateNetworkStatus);\n  window.addEventListener('offline', updateNetworkStatus);\n  updateNetworkStatus();\n\n  // Done button interactive feedback\n  const doneBtn = document.getElementById('done-btn');\n  if (doneBtn) {\n    doneBtn.addEventListener('click', () => {\n      doneBtn.textContent = \"Saved\";\n      setTimeout(() => {\n        doneBtn.textContent = \"Done\";\n      }, 800);\n    });\n  }\n</script></main></body></html>"}