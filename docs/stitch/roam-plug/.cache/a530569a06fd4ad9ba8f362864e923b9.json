{"filename":"50-notifications.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-primary-fixed\": \"#370e00\", \"primary-fixed-dim\": \"#ffb599\", \"surface-variant\": \"#e8e1db\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"tertiary-container\": \"#936f00\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-high\": \"#eee7e0\", \"on-secondary-container\": \"#5c2400\", \"on-secondary-fixed-variant\": \"#783200\", \"surface-container-highest\": \"#e8e1db\", \"on-error-container\": \"#93000a\", \"secondary-fixed\": \"#ffdbca\", \"primary-fixed\": \"#ffdbce\", \"background\": \"#fff8f2\", \"surface-bright\": \"#fff8f2\", \"surface-container-low\": \"#faf2eb\", \"on-primary\": \"#ffffff\", \"error\": \"#ba1a1a\", \"on-secondary\": \"#ffffff\", \"tertiary\": \"#755800\", \"outline-variant\": \"#e2bfb2\", \"on-surface-variant\": \"#5a4138\", \"primary\": \"#a33900\", \"inverse-primary\": \"#ffb599\", \"on-secondary-fixed\": \"#341100\", \"primary-container\": \"#cc4900\", \"outline\": \"#8e7166\", \"on-background\": \"#1e1b17\", \"error-container\": \"#ffdad6\", \"surface-container-lowest\": \"#ffffff\", \"surface-dim\": \"#e0d9d2\", \"inverse-surface\": \"#33302c\", \"on-tertiary-container\": \"#fffbff\", \"secondary\": \"#9d4300\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"surface\": \"#fff8f2\", \"on-tertiary-fixed\": \"#251a00\", \"surface-container\": \"#f4ede6\", \"on-primary-container\": \"#fffbff\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"on-tertiary\": \"#ffffff\", \"on-primary-fixed-variant\": \"#7f2b00\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed-dim\": \"#f7be1d\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xl\": \"2rem\", \"space-md\": \"1rem\", \"margin-lg\": \"1.5rem\", \"space-sm\": \"0.5rem\", \"gutter-sm\": \"0.75rem\", \"margin\": \"1rem\", \"space-xs\": \"0.25rem\", \"space-lg\": \"1.5rem\" }, \"fontFamily\": { \"body-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"body-md\": [\"Inter\"], \"display-lg\": [\"Inter\"] }, \"fontSize\": { \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }] } } } }</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl pt-safe shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Go back\" class=\"w-12 h-12 -ml-2 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors\" onclick=\"history.back()\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight select-none\">Notifications</h1></div><div class=\"flex items-center gap-space-sm\"><button class=\"min-h-[44px] px-space-sm py-space-xs rounded-lg text-primary hover:bg-primary-fixed/20 transition-colors font-label-md text-label-md flex items-center gap-1\" type=\"button\"><span>Mark all as read</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full px-margin pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Top Dynamic Status Banner & Stats Bar -->\n<div class=\"flex items-center justify-between py-space-sm mb-space-md\">\n<div class=\"flex items-center gap-2\">\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary text-on-primary font-label-md text-label-md shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-surface-container-lowest animate-pulse\"></span>\n        3 new alerts\n      </span>\n<span class=\"text-on-surface-variant font-body-sm text-body-sm hidden xs:inline\">Island co-pilot active</span>\n</div>\n<button class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-primary hover:bg-primary-fixed/30 active:scale-95 transition-all font-label-md text-label-md\" id=\"markAllReadBtn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">done_all</span>\n<span>Clear all</span>\n</button>\n</div>\n<!-- Filter Chips Ribbon (Parish & Category Flow) -->\n<div class=\"flex items-center gap-2 overflow-x-auto no-scrollbar -mx-margin px-margin pb-2 mb-space-md\">\n<button class=\"filter-chip active-filter shrink-0 h-9 px-4 rounded-full bg-on-surface text-surface-container-lowest font-label-md text-label-md shadow-sm transition-all flex items-center gap-1.5\" type=\"button\">\n<span>All</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-white/20 text-white font-label-sm text-label-sm\">5</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-high text-on-surface hover:bg-surface-variant active:scale-95 transition-all font-label-md text-label-md flex items-center gap-1.5\" type=\"button\">\n<span>Reminders</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm\">2</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-high text-on-surface hover:bg-surface-variant active:scale-95 transition-all font-label-md text-label-md flex items-center gap-1.5\" type=\"button\">\n<span>Scout Updates</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-label-sm\">1</span>\n</button>\n<button class=\"filter-chip shrink-0 h-9 px-4 rounded-full bg-surface-container-high text-on-surface hover:bg-surface-variant active:scale-95 transition-all font-label-md text-label-md flex items-center gap-1.5\" type=\"button\">\n<span>Fuel Radar</span>\n<span class=\"px-1.5 py-0.2 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm\">2</span>\n</button>\n</div>\n<!-- Notification Stream -->\n<div class=\"flex flex-col gap-space-lg\">\n<!-- SECTION: TODAY -->\n<div class=\"flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between px-1\">\n<h2 class=\"font-label-md text-label-md tracking-wider uppercase text-on-surface-variant\">Today</h2>\n<span class=\"font-label-sm text-label-sm text-outline\">Nov 14, 2024</span>\n</div>\n<!-- Card 1: Maintenance Alert (Amber / Warm) -->\n<div class=\"unread-card relative flex flex-col p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex gap-3 min-w-0\">\n<div class=\"w-10 h-10 rounded-xl bg-secondary-fixed flex items-center justify-center shrink-0 text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[22px]\">oil_barrel</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Oil change due in 200 km</span>\n</div>\n<div class=\"flex items-center gap-1.5 mt-0.5\">\n<span class=\"inline-flex items-center px-2 py-0.5 rounded-full bg-surface-container font-label-sm text-label-sm text-on-surface-variant font-semibold\">\n                  2019 Toyota Roomy\n                </span>\n<span class=\"font-body-sm text-body-sm text-outline\">84,210 km</span>\n</div>\n</div>\n</div>\n<div class=\"flex items-center gap-2 shrink-0\">\n<span class=\"font-body-sm text-body-sm text-outline\">2h ago</span>\n<span class=\"unread-dot w-2.5 h-2.5 rounded-full bg-primary-container\"></span>\n</div>\n</div>\n<p class=\"mt-3 font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          Your synthetic blend interval reaches its threshold at 84,400 km. Service early to protect against North-South Highway thermal wear.\n        </p>\n<!-- Dynamic Visual Cue: Service Gauge Mini-Bar -->\n<div class=\"mt-3 p-2.5 rounded-lg bg-surface-container-low flex flex-col gap-1.5\">\n<div class=\"flex justify-between items-center font-label-sm text-label-sm\">\n<span class=\"text-on-surface-variant font-medium\">Interval health</span>\n<span class=\"text-primary font-bold\">96% utilized</span>\n</div>\n<div class=\"w-full h-1.5 rounded-full bg-surface-variant overflow-hidden\">\n<div class=\"h-full bg-primary-container rounded-full\" style=\"width: 96%\"></div>\n</div>\n</div>\n<!-- Action Buttons -->\n<div class=\"flex items-center gap-2 mt-4 pt-1\">\n<button class=\"min-h-[44px] px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md shadow-sm active:scale-95 transition-all flex items-center gap-1.5 justify-center flex-1 sm:flex-initial\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">build_circle</span>\n<span>Log Service</span>\n</button>\n<button class=\"min-h-[44px] px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md active:scale-95 transition-all\" type=\"button\">\n            Snooze (100 km)\n          </button>\n</div>\n</div>\n<!-- Card 2: Scout Community (Emerald / Island Success) -->\n<div class=\"unread-card relative flex flex-col p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex gap-3 min-w-0\">\n<div class=\"w-10 h-10 rounded-xl bg-tertiary-fixed flex items-center justify-center shrink-0 text-on-tertiary-fixed\">\n<span class=\"material-symbols-outlined text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Your pin 'Precision Auto Works' was approved</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\">location_on</span>\n                Constant Spring Rd, St. Andrew\n              </p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 shrink-0\">\n<span class=\"font-body-sm text-body-sm text-outline\">5h ago</span>\n<span class=\"unread-dot w-2.5 h-2.5 rounded-full bg-primary-container\"></span>\n</div>\n</div>\n<!-- Island Community Impact Badge -->\n<div class=\"mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-container-low\">\n<span class=\"flex items-center gap-1 font-label-md text-label-md text-tertiary font-bold\">\n<span class=\"material-symbols-outlined text-[16px]\">stars</span>\n            +25 Scout XP\n          </span>\n<span class=\"w-1 h-1 rounded-full bg-outline-variant\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Live on Jamaica Route Map</span>\n</div>\n<p class=\"mt-2.5 font-body-md text-body-md text-on-surface-variant\">\n          A Kingston Road Scout verified your coordinates. <strong class=\"text-on-surface\">18 motorists</strong> navigated to this tire &amp; brake depot today!\n        </p>\n<!-- Location Visual Preview Card -->\n<div class=\"mt-3 rounded-lg overflow-hidden relative h-28 bg-surface-variant flex items-end p-2.5\">\n<img class=\"absolute inset-0 w-full h-full object-cover\" data-alt=\"Overhead aerial map shot of Constant Spring Road in Kingston Jamaica with warm tropical lighting, asphalt road intersections, automotive workshops, and Jamaican palm trees bathed in golden afternoon sunlight.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCtOPNW2qS9AreOY1VZqWhNsDGvs1uJvTt6ecVtf8nk6utuqSc1JvWleFakHGdM0nrQYcRjDY5pXex-eI1jSs4wZYdJTI0xxWcD4SQq2PF6wsLNr_548lge6z_dDbI1fc2U--jHfYL3ZRQ__wsoWnbqucB4CnhtQe0v3uMERqUgtA3aUEPHu_TLal4L4bD90nrVVXd4g5K2GZOEQv2KKROGzBrnXJpE1au4cFTrP24PIcGc-7Ke6HrN\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-inverse-surface/30 to-transparent\"></div>\n<div class=\"relative z-10 flex items-center justify-between w-full text-surface-container-lowest\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[18px] text-secondary-fixed\">pin_drop</span>\n<span class=\"font-label-md text-label-md drop-shadow\">Constant Spring Hub</span>\n</div>\n<span class=\"font-label-sm text-label-sm bg-surface-container-lowest/30 backdrop-blur-md px-2 py-0.5 rounded text-white\">4.8 ★ (12 Reviews)</span>\n</div>\n</div>\n<!-- Actions -->\n<div class=\"flex items-center gap-2 mt-4\">\n<button class=\"min-h-[44px] px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md active:scale-95 transition-all flex items-center gap-1.5 flex-1 sm:flex-initial justify-center\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">map</span>\n<span>View on Map</span>\n</button>\n<button class=\"min-h-[44px] px-4 py-2 rounded-lg text-primary hover:bg-primary-fixed/20 font-label-md text-label-md active:scale-95 transition-all\" type=\"button\">\n            Scout Profile\n          </button>\n</div>\n</div>\n</div>\n<!-- SECTION: THIS WEEK -->\n<div class=\"flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between px-1\">\n<h2 class=\"font-label-md text-label-md tracking-wider uppercase text-on-surface-variant\">This Week</h2>\n<span class=\"font-label-sm text-label-sm text-outline\">2 Updates</span>\n</div>\n<!-- Card 3: Fitness Certificate Warning -->\n<div class=\"unread-card relative flex flex-col p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex gap-3 min-w-0\">\n<div class=\"w-10 h-10 rounded-xl bg-secondary-fixed flex items-center justify-center shrink-0 text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[22px]\">assignment_late</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Fitness certificate expires in 14 days</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-2 mt-0.5\">\n<span>2019 Toyota Roomy</span>\n<span class=\"w-1 h-1 rounded-full bg-outline-variant\"></span>\n<span class=\"font-semibold text-on-surface\">Plate: 4821-JR</span>\n</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 shrink-0\">\n<span class=\"font-body-sm text-body-sm text-outline\">Yesterday</span>\n<span class=\"unread-dot w-2.5 h-2.5 rounded-full bg-primary-container\"></span>\n</div>\n</div>\n<!-- Deadline Notice Bar -->\n<div class=\"mt-3 flex items-center justify-between px-3 py-2 rounded-lg bg-surface-container-low\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">calendar_clock</span>\n<span class=\"font-label-md text-label-md text-on-surface\">Valid until: <strong>28 Nov 2024</strong></span>\n</div>\n<span class=\"font-label-sm text-label-sm px-2 py-0.5 rounded bg-secondary-fixed text-on-secondary-fixed font-bold\">14d left</span>\n</div>\n<p class=\"mt-2.5 font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          Avoid Island Traffic Authority spot checks and penalty tickets. Test bays currently reporting under 20-min wait times around Half-Way-Tree.\n        </p>\n<!-- Actions -->\n<div class=\"flex items-center gap-2 mt-4 pt-1\">\n<button class=\"min-h-[44px] px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md shadow-sm active:scale-95 transition-all flex items-center gap-1.5 flex-1 sm:flex-initial justify-center\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">event_available</span>\n<span>Book Inspection Depot</span>\n</button>\n<button class=\"min-h-[44px] px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md active:scale-95 transition-all\" type=\"button\">\n            Update Date\n          </button>\n</div>\n</div>\n<!-- Card 4: Fuel Radar Alert -->\n<div class=\"flex flex-col p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex gap-3 min-w-0\">\n<div class=\"w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center shrink-0 text-primary\">\n<span class=\"material-symbols-outlined text-[22px]\">local_gas_station</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-2\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">E-10 87 dropped J$3.20 this week</h3>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n                Kgn &amp; St. Andrew Avg: <strong class=\"text-on-surface font-semibold\">J$208.40 / L</strong>\n</p>\n</div>\n</div>\n<span class=\"font-body-sm text-body-sm text-outline shrink-0\">Wed</span>\n</div>\n<!-- Fuel Rate Comparison Box -->\n<div class=\"mt-3 grid grid-cols-2 gap-2\">\n<div class=\"p-2.5 rounded-lg bg-surface-container-low flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Rubis Waterloo Rd</span>\n<div class=\"flex items-baseline gap-1 mt-0.5\">\n<span class=\"font-price-display text-price-display text-primary\">J$204.85</span>\n<span class=\"font-label-sm text-label-sm text-tertiary\">Lowest</span>\n</div>\n</div>\n<div class=\"p-2.5 rounded-lg bg-surface-container-low flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">TotalEnergies HWT</span>\n<div class=\"flex items-baseline gap-1 mt-0.5\">\n<span class=\"font-price-display text-price-display text-on-surface\">J$205.10</span>\n<span class=\"font-label-sm text-label-sm text-outline\">Verified 4h</span>\n</div>\n</div>\n</div>\n<p class=\"mt-3 font-body-md text-body-md text-on-surface-variant\">\n          Petrojam ex-refinery price reduction has passed through to pumps along major commuter corridors.\n        </p>\n<!-- Action Button -->\n<div class=\"mt-4\">\n<button class=\"min-h-[44px] w-full px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-variant text-primary font-label-md text-label-md active:scale-95 transition-all flex items-center justify-center gap-1.5\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">trending_down</span>\n<span>View Best Pump Rates (Islandwide)</span>\n</button>\n</div>\n</div>\n</div>\n<!-- SECTION: EARLIER -->\n<div class=\"flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between px-1\">\n<h2 class=\"font-label-md text-label-md tracking-wider uppercase text-on-surface-variant\">Earlier</h2>\n<span class=\"font-label-sm text-label-sm text-outline\">Read</span>\n</div>\n<!-- Card 5: Toll Advisory (Highway 2000) -->\n<div class=\"flex flex-col p-4 rounded-xl bg-surface-container-low opacity-90 hover:opacity-100 transition-opacity\">\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex gap-3 min-w-0\">\n<div class=\"w-10 h-10 rounded-xl bg-surface-container-highest flex items-center justify-center shrink-0 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[22px]\">toll</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Highway 2000 May Pen interchange update</h3>\n<span class=\"font-body-sm text-body-sm text-outline mt-0.5\">Clarendon Expressway Section</span>\n</div>\n</div>\n<span class=\"font-body-sm text-body-sm text-outline shrink-0\">Oct 29</span>\n</div>\n<p class=\"mt-2.5 font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          Cashless T-Tag express lanes have expanded for speedier commuter clearance during Friday evening rush toward Manchester.\n        </p>\n<div class=\"mt-3 flex items-center gap-2\">\n<button class=\"px-3 py-1.5 rounded-lg text-primary hover:bg-surface-variant font-label-md text-label-md transition-colors flex items-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">info</span>\n<span>Review Toll Rates</span>\n</button>\n</div>\n</div>\n</div>\n<!-- BOTTOM ACTION CARD: Notification Preferences -->\n<div class=\"mt-space-md p-4 rounded-2xl bg-surface-container flex items-center justify-between gap-3\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-surface-container-lowest flex items-center justify-center text-on-surface shrink-0 shadow-sm\">\n<span class=\"material-symbols-outlined text-[20px]\">tune</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">Alert Preferences</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Manage SMS alerts, Fitness reminders &amp; Gas Radar</span>\n</div>\n</div>\n<button aria-label=\"Open alert preferences\" class=\"w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-colors shrink-0 shadow-sm active:scale-90\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">chevron_right</span>\n</button>\n</div>\n</div>\n</div>\n<script>\n  (function() {\n    const markAllBtn = document.getElementById('markAllReadBtn');\n    if (markAllBtn) {\n      markAllBtn.addEventListener('click', function() {\n        const dots = document.querySelectorAll('.unread-dot');\n        dots.forEach(dot => dot.remove());\n\n        const cards = document.querySelectorAll('.unread-card');\n        cards.forEach(card => {\n          card.classList.remove('unread-card');\n        });\n\n        const pill = document.querySelector('.bg-primary.text-on-primary');\n        if (pill) {\n          pill.innerHTML = '<span class=\"material-symbols-outlined text-[14px]\">check</span> All up to date';\n          pill.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md';\n        }\n      });\n    }\n\n    // Filter chip toggle\n    const chips = document.querySelectorAll('.filter-chip');\n    chips.forEach(chip => {\n      chip.addEventListener('click', function() {\n        chips.forEach(c => {\n          c.classList.remove('bg-on-surface', 'text-surface-container-lowest', 'shadow-sm');\n          c.classList.add('bg-surface-container-high', 'text-on-surface');\n        });\n        this.classList.remove('bg-surface-container-high', 'text-on-surface');\n        this.classList.add('bg-on-surface', 'text-surface-container-lowest', 'shadow-sm');\n      });\n    });\n  })();\n</script></main></body></html>"}