['32px', { lineHeight: '40px', letterSpacing: '-0.02em', fontWeight: '800' }], 'body-sm': ['12px', { lineHeight: '16px', fontWeight: '400' }], 'body-md': ['14px', { lineHeight: '20px', fontWeight: '400' }], 'label-lg': ['14px', { lineHeight: '20px', letterSpacing: '0.01em', fontWeight: '600' }], 'label-md': ['12px', { lineHeight: '16px', letterSpacing: '0.02em', fontWeight: '600' }], 'price-display': ['24px', { lineHeight: '28px', letterSpacing: '-0.01em', fontWeight: '700' }], 'display-lg': ['40px', { lineHeight: '48px', letterSpacing: '-0.02em', fontWeight: '800' }] } } } };</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen selection:bg-secondary-fixed selection:text-on-secondary-fixed\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl pt-safe shadow-[0_1px_8px_rgba(28,25,23,0.04)]\"><div class=\"h-16 px-margin flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><button aria-label=\"Go Back\" class=\"w-12 h-12 -ml-2 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container active:scale-95 transition-all\" onclick=\"history.back()\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight truncate max-w-[210px]\">Help &amp; Support</h1></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0 shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full\">\n<!-- Interactive Search Bar Section -->\n<section class=\"px-margin pt-space-md pb-space-sm\">\n<div class=\"relative w-full\">\n<div class=\"absolute inset-y-0 left-0 pl-space-md flex items-center pointer-events-none text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[22px]\">search</span>\n</div>\n<input class=\"w-full h-12 pl-12 pr-12 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant/70 shadow-sm focus:outline-none focus:bg-surface-container-low transition-all font-body-md text-body-md\" id=\"support-search\" placeholder=\"Search questions, guides, parish tips...\" type=\"search\"/>\n<button aria-label=\"Clear Search\" class=\"absolute inset-y-0 right-0 pr-space-md flex items-center text-on-surface-variant hover:text-on-surface active:scale-90 transition-all opacity-0 pointer-events-none\" id=\"clear-search\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">cancel</span>\n</button>\n</div>\n</section>\n<!-- Quick Support Banner: Direct Motorist Helpdesk -->\n<section class=\"px-margin py-space-sm\">\n<div class=\"relative overflow-hidden rounded-xl bg-gradient-to-br from-primary via-primary-container to-secondary-container p-space-md shadow-md text-on-primary\">\n<div class=\"absolute -right-4 -bottom-6 w-28 h-28 rounded-full bg-on-primary/10 blur-xl pointer-events-none\"></div>\n<div class=\"relative z-10 flex items-start gap-space-md\">\n<div class=\"w-12 h-12 rounded-xl bg-on-primary/20 backdrop-blur-md flex items-center justify-center shrink-0 shadow-inner\">\n<span class=\"material-symbols-outlined text-on-primary text-[28px]\" style=\"font-variation-settings: 'FILL' 1;\">support_agent</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center gap-space-xs mb-1\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-sm text-label-sm uppercase tracking-wider\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary animate-pulse\"></span>\n              Live On-Road\n            </span>\n</div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-primary leading-tight\">Direct Motorist Helpdesk</h2>\n<p class=\"font-body-sm text-body-sm text-on-primary/90 mt-1\">Stuck between towns or got route questions? Fast assistance for Jamaican drivers on the asphalt.</p>\n<div class=\"mt-space-md flex items-center gap-space-sm\">\n<a class=\"inline-flex items-center justify-center gap-2 h-10 px-space-md rounded-lg bg-surface-container-lowest text-primary font-label-lg text-label-lg shadow-sm hover:bg-surface-container-low active:scale-95 transition-all\" href=\"https://wa.me/18765557626\">\n<span class=\"material-symbols-outlined text-[18px]\">chat</span>\n              Quick Dispatch\n            </a>\n<span class=\"font-label-sm text-label-sm text-on-primary/80\">Avg reply ~10 min</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- FAQ Categories Section -->\n<section class=\"px-margin pt-space-lg pb-space-sm\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">grid_view</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Browse by Topic</h2>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider\">6 Categories</span>\n</div>\n<div class=\"grid grid-cols-1 gap-space-sm\" id=\"faq-category-list\">\n<!-- 1. Fuel prices -->\n<button class=\"faq-card w-full text-left bg-surface-container-lowest hover:bg-surface-container-low p-space-md rounded-xl shadow-sm transition-all flex items-start gap-space-md active:scale-[0.99] group\" data-keywords=\"gas fuel petrojam price petrol diesel e10 87 90 discrepancy parish\" type=\"button\">\n<div class=\"w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center shrink-0 text-on-primary-fixed group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[26px]\">local_gas_station</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold group-hover:text-primary transition-colors\">Fuel prices</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant/60 group-hover:translate-x-0.5 transition-transform text-[20px]\">chevron_right</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 line-clamp-2\">\n            Petrojam updates, parish averages, reporting discrepancies\n          </p>\n</div>\n</button>\n<!-- 2. Logging fuel & odometer -->\n<button class=\"faq-card w-full text-left bg-surface-container-lowest hover:bg-surface-container-low p-space-md rounded-xl shadow-sm transition-all flex items-start gap-space-md active:scale-[0.99] group\" data-keywords=\"odometer logs log camera scan receipt km/l offline mileage speed\" type=\"button\">\n<div class=\"w-12 h-12 rounded-xl bg-secondary-fixed flex items-center justify-center shrink-0 text-on-secondary-fixed group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[26px]\">speed</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold group-hover:text-primary transition-colors\">Logging fuel &amp; odometer</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant/60 group-hover:translate-x-0.5 transition-transform text-[20px]\">chevron_right</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 line-clamp-2\">\n            Camera scan tips, calculating km/L, offline logs\n          </p>\n</div>\n</button>\n<!-- 3. Maintenance schedules -->\n<button class=\"faq-card w-full text-left bg-surface-container-lowest hover:bg-surface-container-low p-space-md rounded-xl shadow-sm transition-all flex items-start gap-space-md active:scale-[0.99] group\" data-keywords=\"maintenance service oem severe potholes dust tropical interval oil filter brakes wrench\" type=\"button\">\n<div class=\"w-12 h-12 rounded-xl bg-tertiary-fixed flex items-center justify-center shrink-0 text-on-tertiary-fixed group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[26px]\">build</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold group-hover:text-primary transition-colors\">Maintenance schedules</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant/60 group-hover:translate-x-0.5 transition-transform text-[20px]\">chevron_right</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 line-clamp-2\">\n            OEM vs Jamaican severe conditions, custom service intervals\n          </p>\n</div>\n</button>\n<!-- 4. Mapping places -->\n<button class=\"faq-card w-full text-left bg-surface-container-lowest hover:bg-surface-container-low p-space-md rounded-xl shadow-sm transition-all flex items-start gap-space-md active:scale-[0.99] group\" data-keywords=\"mapping map tyre tire shop pin scout xp community points verified route\" type=\"button\">\n<div class=\"w-12 h-12 rounded-xl bg-primary-fixed-dim flex items-center justify-center shrink-0 text-on-primary-fixed group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[26px]\">pin_drop</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold group-hover:text-primary transition-colors\">Mapping places</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant/60 group-hover:translate-x-0.5 transition-transform text-[20px]\">chevron_right</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 line-clamp-2\">\n            Pinning tyre shops, verification process, earning Scout XP\n          </p>\n</div>\n</button>\n<!-- 5. Parts info -->\n<button class=\"faq-card w-full text-left bg-surface-container-lowest hover:bg-surface-container-low p-space-md rounded-xl shadow-sm transition-all flex items-start gap-space-md active:scale-[0.99] group\" data-keywords=\"parts spares fitment tiers genuine oem aftermarket local auto desk kingston montego\" type=\"button\">\n<div class=\"w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center shrink-0 text-on-surface group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[26px]\">settings_input_component</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold group-hover:text-primary transition-colors\">Parts info</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant/60 group-hover:translate-x-0.5 transition-transform text-[20px]\">chevron_right</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 line-clamp-2\">\n            Fitment guarantee, 5 quality tiers, local parts desk contacts\n          </p>\n</div>\n</button>\n<!-- 6. Account & privacy -->\n<button class=\"faq-card w-full text-left bg-surface-container-lowest hover:bg-surface-container-low p-space-md rounded-xl shadow-sm transition-all flex items-start gap-space-md active:scale-[0.99] group\" data-keywords=\"account privacy jdpa data compliance export logs backup security legal profile\" type=\"button\">\n<div class=\"w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center shrink-0 text-on-surface-variant group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[26px]\">verified_user</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-semibold group-hover:text-primary transition-colors\">Account &amp; privacy</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant/60 group-hover:translate-x-0.5 transition-transform text-[20px]\">chevron_right</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 line-clamp-2\">\n            Data charter, JDPA compliance, export motoring logs\n          </p>\n</div>\n</button>\n</div>\n</section>\n<!-- Popular Articles / Top Questions Section (Accordion) -->\n<section class=\"px-margin pt-space-lg pb-space-sm\">\n<div class=\"flex items-center gap-2 mb-space-sm\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">help_center</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Top Driver Questions</h2>\n</div>\n<div class=\"flex flex-col gap-space-sm\" id=\"popular-questions-list\">\n<!-- Question 1 -->\n<div class=\"faq-item rounded-xl bg-surface-container-lowest shadow-sm overflow-hidden transition-all\">\n<button aria-expanded=\"false\" class=\"faq-toggle w-full px-space-md py- space-md text-left flex items-center justify-between gap-space-sm min-h-[52px]\" type=\"button\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold flex-1\">\n            Why do gas prices vary across parishes in Jamaica?\n          </span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[22px] transition-transform duration-200 faq-icon shrink-0\">\n            expand_more\n          </span>\n</button>\n<div class=\"faq-content hidden px-space-md pb-space-md pt-1 text-on-surface-variant font-body-sm text-body-sm bg-surface-container-low/50\">\n<p class=\"leading-relaxed\">\n            While Petrojam publishes weekly ex-refinery billing benchmarks, pump prices differ by parish due to marketing company dealer margins, haulage transport costs from Kingston/Montego Bay terminals, and individual service station overheads (such as 24-hour backup generator fueling in hilly terrains).\n          </p>\n<div class=\"mt-space-sm flex items-center gap-2\">\n<span class=\"inline-flex items-center gap-1 font-label-sm text-label-sm text-primary font-bold\">\n<span class=\"material-symbols-outlined text-[14px]\">insights</span>\n              Live Parish Variance Tracker\n            </span>\n</div>\n</div>\n</div>\n<!-- Question 2 -->\n<div class=\"faq-item rounded-xl bg-surface-container-lowest shadow-sm overflow-hidden transition-all\">\n<button aria-expanded=\"false\" class=\"faq-toggle w-full px-space-md py-space-md text-left flex items-center justify-between gap-space-sm min-h-[52px]\" type=\"button\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold flex-1\">\n            How do I sync my logs if I'm driving through a dead zone?\n          </span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[22px] transition-transform duration-200 faq-icon shrink-0\">\n            expand_more\n          </span>\n</button>\n<div class=\"faq-content hidden px-space-md pb-space-md pt-1 text-on-surface-variant font-body-sm text-body-sm bg-surface-container-low/50\">\n<p class=\"leading-relaxed\">\n            Roam Plug uses an offline-first storage engine designed for rural routes like Spur Tree Hill or Cockpit country. You can snap receipts and record your odometer values without any cellular reception. Your logs are safely encrypted locally and will automatically sync as soon as you reconnect to Digicel or Flow networks.\n          </p>\n<div class=\"mt-space-sm inline-flex items-center gap-1 font-label-sm text-label-sm text-secondary font-bold\">\n<span class=\"material-symbols-outlined text-[14px]\">cloud_done</span>\n            Offline Queue: Active\n          </div>\n</div>\n</div>\n<!-- Question 3 -->\n<div class=\"faq-item rounded-xl bg-surface-container-lowest shadow-sm overflow-hidden transition-all\">\n<button aria-expanded=\"false\" class=\"faq-toggle w-full px-space-md py-space-md text-left flex items-center justify-between gap-space-sm min-h-[52px]\" type=\"button\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold flex-1\">\n            How long does it take for a newly pinned tyre shop to be approved?\n          </span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[22px] transition-transform duration-200 faq-icon shrink-0\">\n            expand_more\n          </span>\n</button>\n<div class=\"faq-content hidden px-space-md pb-space-md pt-1 text-on-surface-variant font-body-sm text-body-sm bg-surface-container-low/50\">\n<p class=\"leading-relaxed\">\n            Community scout submissions undergo a dual-verification process. Once two other verified drivers or a Parish Scout confirm the GPS pin and operating hours, the pin turns green on the public live map. This typically happens within 2 to 4 hours. You will receive 50 Scout XP immediately upon approval!\n          </p>\n</div>\n</div>\n</div>\n</section>\n<!-- Community Banner -->\n<section class=\"px-margin pt-space-lg pb-space-sm\">\n<div class=\"rounded-xl bg-surface-container p-space-md shadow-sm relative overflow-hidden\">\n<div class=\"flex items-center gap-space-md\">\n<div class=\"w-12 h-12 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[26px]\">groups</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<span class=\"inline-block px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm mb-1 uppercase tracking-wider\">\n            Islandwide Network\n          </span>\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-bold\">Roam Plug Driver Community</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">\n            Join over 14,000 drivers in our WhatsApp Community for road alerts &amp; taxi route updates.\n          </p>\n</div>\n</div>\n<div class=\"mt-space-md\">\n<a class=\"w-full h-11 flex items-center justify-center gap-2 rounded-lg bg-surface-container-lowest text-on-surface font-label-lg text-label-lg shadow-sm hover:bg-surface-container-low active:scale-95 transition-all\" href=\"https://chat.whatsapp.com/sample-roam-plug\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">hub</span>\n          Enter Island Driver Group\n        </a>\n</div>\n</div>\n</section>\n<!-- Direct Contact Support Section at Bottom -->\n<section class=\"px-margin pt-space-md pb-space-xl\">\n<div class=\"text-center mb-space-md\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Still Need Assistance?</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">Our Kingston support desk is staffed 7:00 AM – 9:00 PM daily</p>\n</div>\n<!-- Dual Contact Buttons -->\n<div class=\"flex flex-col gap-space-sm\">\n<!-- WhatsApp Support -->\n<a class=\"w-full min-h-[58px] p-space-md rounded-xl bg-[#128C7E] text-white flex items-center justify-between shadow-md hover:bg-[#075E54] active:scale-[0.98] transition-all group\" href=\"https://wa.me/18765557626\" rel=\"noopener noreferrer\" target=\"_blank\">\n<div class=\"flex items-center gap-space-md\">\n<div class=\"w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[22px] text-white\">chat</span>\n</div>\n<div class=\"text-left min-w-0\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-lg text-label-lg font-bold\">WhatsApp Support</span>\n<span class=\"px-1.5 py-0.5 rounded text-[10px] bg-white/25 font-bold tracking-wider uppercase\">Fastest</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-white/90 truncate\">+1 (876) 555-ROAM • Avg reply 10 mins</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-white/80 group-hover:translate-x-1 transition-transform text-[22px]\">arrow_forward</span>\n</a>\n<!-- Email Driver Desk -->\n<a class=\"w-full min-h-[58px] p-space-md rounded-xl bg-surface-container-lowest text-on-surface flex items-center justify-between shadow-sm hover:bg-surface-container-low active:scale-[0.98] transition-all group\" href=\"mailto:support@roamplug.jm\">\n<div class=\"flex items-center gap-space-md\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center shrink-0 text-primary\">\n<span class=\"material-symbols-outlined text-[22px]\">mail</span>\n</div>\n<div class=\"text-left min-w-0\">\n<h3 class=\"font-label-lg text-label-lg font-bold\">Email Driver Desk</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">support@roamplug.jm • Within 24 hrs</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:translate-x-1 transition-transform text-[22px]\">arrow_forward</span>\n</a>\n</div>\n<!-- Statutory / Trust Note -->\n<div class=\"mt-space-lg text-center\">\n<div class=\"inline-flex items-center gap-1.5 text-on-surface-variant/80 font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">security</span>\n<span>Registered with Jamaica Data Protection Act (JDPA)</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant/60 mt-1\">Roam Plug Jamaica • Version 2.4.1 (Build 88)</p>\n</div>\n</section>\n</div>\n<script>\n  // Accordion Logic for FAQ items\n  document.querySelectorAll('.faq-toggle').forEach(button => {\n    button.addEventListener('click', () => {\n      const isExpanded = button.getAttribute('aria-expanded') === 'true';\n      const content = button.nextElementSibling;\n      const icon = button.querySelector('.faq-icon');\n\n      // Close other accordions\n      document.querySelectorAll('.faq-toggle').forEach(otherBtn => {\n        if (otherBtn !== button) {\n          otherBtn.setAttribute('aria-expanded', 'false');\n          otherBtn.nextElementSibling.classList.add('hidden');\n          const otherIcon = otherBtn.querySelector('.faq-icon');\n          if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';\n        }\n      });\n\n      // Toggle current\n      button.setAttribute('aria-expanded', !isExpanded);\n      if (isExpanded) {\n        content.classList.add('hidden');\n        if (icon) icon.style.transform = 'rotate(0deg)';\n      } else {\n        content.classList.remove('hidden');\n        if (icon) icon.style.transform = 'rotate(180deg)';\n      }\n    });\n  });\n\n  // Client-side quick filter logic\n  const searchInput = document.getElementById('support-search');\n  const clearBtn = document.getElementById('clear-search');\n  const cards = document.querySelectorAll('.faq-card');\n\n  if (searchInput && clearBtn) {\n    searchInput.addEventListener('input', (e) => {\n      const term = e.target.value.toLowerCase().trim();\n      \n      if (term.length > 0) {\n        clearBtn.classList.remove('opacity-0', 'pointer-events-none');\n      } else {\n        clearBtn.classList.add('opacity-0', 'pointer-events-none');\n      }\n\n      cards.forEach(card => {\n        const text = card.textContent.toLowerCase();\n        const keywords = card.getAttribute('data-keywords') || '';\n        if (text.includes(term) || keywords.includes(term)) {\n          card.style.display = 'flex';\n        } else {\n          card.style.display = 'none';\n        }\n      });\n    });\n\n    clearBtn.addEventListener('click', () => {\n      searchInput.value = '';\n      clearBtn.classList.add('opacity-0', 'pointer-events-none');\n      cards.forEach(card => card.style.display = 'flex');\n      searchInput.focus();\n    });\n  }\n</script></main></body></html>"}