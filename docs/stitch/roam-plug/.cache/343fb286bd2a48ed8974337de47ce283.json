{"filename":"05-otp.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=block\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"surface-container-highest\": \"#e8e1db\", \"surface-container\": \"#f4ede6\", \"on-surface\": \"#1e1b17\", \"error\": \"#ba1a1a\", \"surface-bright\": \"#fff8f2\", \"on-background\": \"#1e1b17\", \"outline\": \"#8e7166\", \"secondary-fixed\": \"#ffdbca\", \"on-secondary-fixed\": \"#341100\", \"surface-dim\": \"#e0d9d2\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-fixed\": \"#ffdf9a\", \"primary-container\": \"#cc4900\", \"primary-fixed\": \"#ffdbce\", \"surface-variant\": \"#e8e1db\", \"on-error\": \"#ffffff\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary-container\": \"#936f00\", \"error-container\": \"#ffdad6\", \"on-tertiary\": \"#ffffff\", \"on-tertiary-container\": \"#fffbff\", \"secondary\": \"#9d4300\", \"primary\": \"#a33900\", \"inverse-surface\": \"#33302c\", \"primary-fixed-dim\": \"#ffb599\", \"on-primary-container\": \"#fffbff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface\": \"#fff8f2\", \"background\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"outline-variant\": \"#e2bfb2\", \"on-secondary\": \"#ffffff\", \"secondary-fixed-dim\": \"#ffb690\", \"surface-container-low\": \"#faf2eb\", \"on-secondary-fixed-variant\": \"#783200\", \"on-tertiary-fixed\": \"#251a00\", \"on-error-container\": \"#93000a\", \"surface-tint\": \"#a73a00\", \"on-surface-variant\": \"#5a4138\", \"secondary-container\": \"#fd761a\", \"tertiary\": \"#755800\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"surface-container-lowest\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"gutter-sm\": \"0.75rem\", \"space-xs\": \"0.25rem\", \"space-md\": \"1rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"gutter\": \"1rem\", \"space-lg\": \"1.5rem\", \"margin\": \"1rem\", \"margin-lg\": \"1.5rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-md\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100%;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface text-on-surface antialiased flex flex-col min-h-screen\"><div class=\"w-full pt-safe px-margin select-none\"><div class=\"flex justify-between items-center pt-space-xs text-on-surface\"><span class=\"font-label-md text-label-md font-semibold tracking-tight\">9:41</span><div class=\"flex items-center gap-1.5\"><span class=\"material-symbols-outlined text-[16px] leading-none\">signal_cellular_alt</span><span class=\"material-symbols-outlined text-[16px] leading-none\">wifi</span><span class=\"material-symbols-outlined text-[18px] leading-none\">battery_full</span></div></div></div><main class=\"flex-1 flex flex-col relative w-full pb-safe bg-surface px-margin\"><div class=\"flex flex-col w-full pb-6 space-y-5\">\n<!-- Nav Bar & Step indicator -->\n<div class=\"flex items-center justify-between pt-2\">\n<button aria-label=\"Go back\" class=\"w-12 h-12 flex items-center justify-center rounded-full bg-surface-container-low text-on-surface active:bg-surface-container transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">arrow_back</span>\n</button>\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold\">Step 2 of 3</span>\n<div class=\"flex items-center gap-1.5 mt-1\">\n<span class=\"w-6 h-1 rounded-full bg-primary-container\"></span>\n<span class=\"w-6 h-1 rounded-full bg-primary\"></span>\n<span class=\"w-6 h-1 rounded-full bg-surface-container-highest\"></span>\n</div>\n</div>\n<button class=\"h-10 px-3.5 flex items-center justify-center rounded-full bg-surface-container-low text-secondary font-label-md text-label-md hover:bg-surface-container transition-colors\" type=\"button\">\n      Help\n    </button>\n</div>\n<!-- Header & Number confirmation badge -->\n<div class=\"flex flex-col items-center text-center px-1\">\n<div class=\"w-16 h-16 rounded-full bg-secondary-fixed flex items-center justify-center text-primary mb-3 shadow-sm\">\n<span class=\"material-symbols-outlined text-[32px]\" style=\"font-variation-settings: 'FILL' 1;\">phonelink_lock</span>\n</div>\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight\">Verify your phone</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1.5\">\n      We sent a 6-digit verification code via SMS to\n    </p>\n<!-- Number Pill with Edit -->\n<div class=\"inline-flex items-center gap-2 mt-2 px-3.5 py-1.5 rounded-full bg-surface-container-high\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">verified</span>\n<span class=\"font-label-lg text-label-lg font-bold text-on-surface tracking-wide\">+1 (876) 842-9104</span>\n<button aria-label=\"Edit phone number\" class=\"flex items-center text-secondary hover:text-primary active:scale-95 transition-transform ml-0.5\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">edit</span>\n</button>\n</div>\n</div>\n<!-- 6-Digit OTP Entry -->\n<div class=\"w-full flex justify-between gap-2 pt-2\">\n<!-- Box 1 Filled -->\n<div class=\"flex-1 max-w-[52px] h-14 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center text-on-surface font-price-display text-price-display font-extrabold select-none\">\n      8\n    </div>\n<!-- Box 2 Filled -->\n<div class=\"flex-1 max-w-[52px] h-14 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center text-on-surface font-price-display text-price-display font-extrabold select-none\">\n      3\n    </div>\n<!-- Box 3 Filled -->\n<div class=\"flex-1 max-w-[52px] h-14 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center text-on-surface font-price-display text-price-display font-extrabold select-none\">\n      0\n    </div>\n<!-- Box 4 Filled -->\n<div class=\"flex-1 max-w-[52px] h-14 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center text-on-surface font-price-display text-price-display font-extrabold select-none\">\n      9\n    </div>\n<!-- Box 5 Active (Focused with cursor) -->\n<div class=\"flex-1 max-w-[52px] h-14 rounded-xl bg-surface-container-lowest shadow-md flex items-center justify-center relative overflow-hidden bg-gradient-to-b from-surface-container-lowest to-surface-container-low\" style=\"outline: 2px solid #a33900; outline-offset: -1px;\">\n<span class=\"w-0.5 h-6 bg-primary animate-pulse rounded-full\"></span>\n</div>\n<!-- Box 6 Empty -->\n<div class=\"flex-1 max-w-[52px] h-14 rounded-xl bg-surface-container-low flex items-center justify-center text-surface-container-highest\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-outline-variant/60\"></span>\n</div>\n</div>\n<!-- Resend & Timer Module -->\n<div class=\"rounded-xl bg-surface-container-low p-4 flex flex-col gap-3 shadow-sm\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">timer</span>\n<span class=\"font-body-md text-body-md text-on-surface-variant\">Didn't receive code?</span>\n</div>\n<div class=\"flex items-center gap-1.5 font-label-md text-label-md font-bold text-secondary bg-surface-container px-2.5 py-1 rounded-full\">\n<span class=\"inline-block w-2 h-2 rounded-full bg-secondary animate-ping\"></span>\n<span id=\"countdown-timer\">0:42</span>\n</div>\n</div>\n<!-- Secondary action channels -->\n<div class=\"flex items-center gap-2 pt-1\">\n<button class=\"flex-1 min-h-[44px] rounded-lg bg-surface-container-high text-on-surface-variant/50 font-label-md text-label-md flex items-center justify-center gap-1.5 cursor-not-allowed\" disabled=\"\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">sms</span>\n        Resend SMS\n      </button>\n<button class=\"flex-1 min-h-[44px] rounded-lg bg-surface-container text-secondary font-label-md text-label-md flex items-center justify-center gap-1.5 active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">phone_in_talk</span>\n        Call Me\n      </button>\n</div>\n</div>\n<!-- Primary CTA -->\n<div class=\"pt-1\">\n<button class=\"w-full min-h-[52px] rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 shadow-md active:bg-primary-container transition-colors group\" type=\"button\">\n<span>Verify &amp; Continue</span>\n<span class=\"material-symbols-outlined text-[20px] transition-transform group-active:translate-x-1\">arrow_forward</span>\n</button>\n</div>\n<!-- Island Transit / Gateway Trust Banner -->\n<div class=\"rounded-xl bg-surface-container-lowest p-3.5 flex items-center gap-3 shadow-sm mt-1\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">lock_clock</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-md text-label-md font-bold text-on-surface truncate\">Instant Island Verification</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Direct Jamaican Digicel &amp; Flow SMS gateways</span>\n</div>\n</div>\n<!-- Simulated Dialpad for Vehicle & Transit Convenience -->\n<div class=\"w-full bg-surface-container-low rounded-xl p-3 shadow-sm\">\n<div class=\"grid grid-cols-3 gap-2\">\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">1</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">JAM</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">2</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">ABC</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">3</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">DEF</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">4</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">GHI</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">5</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">JKL</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">6</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">MNO</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">7</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">PQRS</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">8</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">TUV</span>\n</button>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">9</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">WXYZ</span>\n</button>\n<div class=\"h-12 flex items-center justify-center text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[18px]\">verified_user</span>\n</div>\n<button class=\"h-12 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col items-center justify-center active:bg-surface-container-high transition-colors\" type=\"button\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface leading-none\">0</span>\n<span class=\"font-label-sm text-[8px] text-on-surface-variant tracking-widest leading-none mt-0.5\">+</span>\n</button>\n<button aria-label=\"Delete\" class=\"h-12 rounded-lg bg-surface-container-high shadow-sm flex items-center justify-center text-on-surface active:bg-surface-container-highest transition-colors\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">backspace</span>\n</button>\n</div>\n</div>\n</div>\n<script>\n  // Simple countdown micro-interaction\n  let seconds = 42;\n  const timerDisplay = document.getElementById('countdown-timer');\n  if (timerDisplay) {\n    const interval = setInterval(() => {\n      seconds--;\n      if (seconds <= 0) {\n        clearInterval(interval);\n        timerDisplay.textContent = '0:00';\n      } else {\n        timerDisplay.textContent = `0:${seconds < 10 ? '0' : ''}${seconds}`;\n      }\n    }, 1000);\n  }\n</script></main></body></html>"}