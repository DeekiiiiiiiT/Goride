{"filename":"41-parts-coming-soon.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back\" class=\"w-12 h-12 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Parts Coming Soon</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-safe\">\n<!-- Visual Hero Graphic / Delight Illustration -->\n<div class=\"relative w-full overflow-hidden rounded-xl bg-surface-container p-space-lg shadow-sm mt-space-sm mb-space-md text-center flex flex-col items-center justify-center\">\n<!-- Ambient Warm Decorative Glow -->\n<div class=\"absolute -top-10 -right-10 w-44 h-44 rounded-full bg-secondary-container/15 blur-2xl pointer-events-none\"></div>\n<div class=\"absolute -bottom-10 -left-10 w-44 h-44 rounded-full bg-primary/10 blur-2xl pointer-events-none\"></div>\n<!-- Centered Charming Automotive Graphic -->\n<div class=\"relative z-10 w-24 h-24 mb-space-md flex items-center justify-center\">\n<div class=\"absolute inset-0 rounded-full bg-surface-container-lowest shadow-md flex items-center justify-center transform transition-transform hover:scale-105 duration-300\">\n<!-- SVG Gear & Wrench & Island Flag Badge Assembly -->\n<svg class=\"w-14 h-14 text-primary\" fill=\"none\" viewbox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\">\n<!-- Outer Sunburst Cog -->\n<circle class=\"animate-[spin_20s_linear_infinite] origin-center opacity-40\" cx=\"32\" cy=\"32\" r=\"23\" stroke=\"currentColor\" stroke-dasharray=\"5 3\" stroke-width=\"3\"></circle>\n<!-- Secondary Interlocking Small Gear -->\n<circle class=\"animate-[spin_12s_linear_infinite_reverse] origin-[44px_20px] opacity-60\" cx=\"44\" cy=\"20\" r=\"9\" stroke=\"#9d4300\" stroke-dasharray=\"3 2\" stroke-width=\"2.5\"></circle>\n<!-- Stylized Wrench Crossing -->\n<path d=\"M22 42L36 28M35 24C35.5 22.5 37 21 39 21C40.5 21 42 22 42.5 23.5L40 26L41.5 27.5L44 25C44.5 26.5 44 28 43 29.5C42 30.5 40.5 31 39 30.5L25 44.5C24 45.5 22.5 45.5 21.5 44.5C20.5 43.5 20.5 42 21.5 41L35 24Z\" fill=\"currentColor\"></path>\n<!-- Modern Caliper / Gauge Accent -->\n<circle cx=\"25\" cy=\"26\" fill=\"#936f00\" r=\"4\"></circle>\n</svg>\n</div>\n<!-- Mini Jamaican Flag & Calendar Corner Chip -->\n<div class=\"absolute -bottom-1 -right-1 bg-surface-container-lowest px-1.5 py-0.5 rounded-full shadow-md flex items-center gap-1 border-0\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-tertiary-container flex items-center justify-center text-[7px] text-on-tertiary font-bold\">JA</span>\n<span class=\"material-symbols-outlined text-secondary text-[14px]\">calendar_today</span>\n</div>\n</div>\n<!-- Main Headline & Subheading -->\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface mb-space-xs font-bold leading-tight\">\n      Parts for your 2019 Toyota Roomy are coming soon\n    </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant max-w-xs mx-auto\">\n      We're building our verified parts database car by car. Yours is currently on the lift!\n    </p>\n<!-- Micro Badge Pill: Under Development -->\n<div class=\"mt-space-md inline-flex items-center gap-1.5 bg-surface-container-highest px-space-md py-1 rounded-full\">\n<span class=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface tracking-wider uppercase font-bold\">In Active Research</span>\n</div>\n</div>\n<!-- Narrative / Context Card -->\n<div class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm mb-space-md\">\n<div class=\"flex items-start gap-space-sm mb-space-sm\">\n<div class=\"w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">local_shipping</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface text-[16px] leading-5\">Curated for Jamaican Roads</h3>\n<span class=\"font-label-md text-label-md text-on-surface-variant\">OEM Numbers • Cross-Reference • Availability</span>\n</div>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-space-md leading-relaxed\">\n      Jamaica has over 400 distinct Japanese import models on the road. We are cataloging exact OEM numbers, cross-references with Daihatsu and Subaru sister models (Thor, Justy, Tank), and verifying stock availability parish by parish.\n    </p>\n<!-- Progress Meter -->\n<div class=\"bg-surface-container-low rounded-lg p-space-sm\">\n<div class=\"flex items-center justify-between mb-1.5\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-secondary text-[16px]\">pie_chart</span>\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">Toyota Roomy (M900 series)</span>\n</div>\n<span class=\"font-label-md text-label-md text-secondary font-bold\">72% Mapped</span>\n</div>\n<!-- Track bar -->\n<div class=\"w-full h-2 rounded-full bg-surface-container-highest overflow-hidden\">\n<div class=\"h-full bg-gradient-to-r from-secondary to-primary-container rounded-full w-[72%] transition-all duration-1000\"></div>\n</div>\n<div class=\"flex items-center justify-between mt-1 text-[11px] font-label-sm text-on-surface-variant\">\n<span>Suspension &amp; Filters done</span>\n<span>Electrical in progress</span>\n</div>\n</div>\n</div>\n<!-- Interactive Notification Toggle Card -->\n<div class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm mb-space-md flex items-center justify-between gap-space-md\">\n<div class=\"flex items-start gap-space-sm min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-container/20 flex items-center justify-center shrink-0 text-secondary\">\n<span class=\"material-symbols-outlined text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">notifications_active</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<h4 class=\"font-headline-sm text-headline-sm text-[16px] text-on-surface leading-tight\">Notify me when ready</h4>\n<span class=\"bg-primary-fixed text-on-primary-fixed px-1.5 py-0.5 rounded text-[10px] font-label-sm font-bold\">SMS / Push</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-snug\">\n          Instant alert when the 5-tier parts catalog and local store pricing unlock for your ride.\n        </p>\n</div>\n</div>\n<!-- Accessible Modern Toggle Switch (State Controlled via JS) -->\n<button aria-checked=\"true\" aria-label=\"Toggle notifications for parts catalog readiness\" class=\"relative inline-flex h-7 w-12 shrink-0 cursor-pointer rounded-full bg-primary-container p-0.5 transition-colors duration-200 ease-in-out focus:outline-none\" id=\"notify-toggle\" onclick=\"\n        const isChecked = this.getAttribute('aria-checked') === 'true';\n        this.setAttribute('aria-checked', !isChecked);\n        const knob = document.getElementById('toggle-knob');\n        if (isChecked) {\n          this.classList.remove('bg-primary-container');\n          this.classList.add('bg-surface-container-highest');\n          knob.classList.remove('translate-x-5');\n          knob.classList.add('translate-x-0');\n        } else {\n          this.classList.remove('bg-surface-container-highest');\n          this.classList.add('bg-primary-container');\n          knob.classList.remove('translate-x-0');\n          knob.classList.add('translate-x-5');\n        }\n      \" role=\"switch\">\n<span class=\"pointer-events-none inline-block h-6 w-6 transform rounded-full bg-surface-container-lowest shadow-md transition duration-200 ease-in-out translate-x-5 flex items-center justify-center\" id=\"toggle-knob\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\">check</span>\n</span>\n</button>\n</div>\n<!-- Vehicle Specs Confirmed Bento -->\n<div class=\"w-full bg-surface-container rounded-xl p-space-md shadow-sm mb-space-lg\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-on-surface-variant text-[18px]\">verified</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Active Profile Targets</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-primary font-bold uppercase tracking-wider\">Locked to Garage</span>\n</div>\n<!-- Spec Chips Grid -->\n<div class=\"grid grid-cols-2 gap-space-sm\">\n<div class=\"bg-surface-container-lowest rounded-lg p-space-sm shadow-sm flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Vehicle</span>\n<span class=\"font-label-md text-label-md text-on-surface truncate font-semibold\">2019 Toyota Roomy</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant text-[11px] truncate\">1.0L Turbo GS Custom</span>\n</div>\n<div class=\"bg-surface-container-lowest rounded-lg p-space-sm shadow-sm flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Chassis Code</span>\n<span class=\"font-price-display text-price-display text-[16px] text-primary truncate font-bold\">M900A</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant text-[11px] truncate\">JDM Micro-Van</span>\n</div>\n<div class=\"bg-surface-container-lowest rounded-lg p-space-sm shadow-sm flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Engine Variant</span>\n<span class=\"font-headline-sm text-headline-sm text-[15px] text-on-surface font-semibold truncate\">1KR-VET</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant text-[11px] truncate\">3-Cyl DOHC VVT</span>\n</div>\n<div class=\"bg-surface-container-lowest rounded-lg p-space-sm shadow-sm flex flex-col min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Primary Parish</span>\n<span class=\"font-headline-sm text-headline-sm text-[15px] text-on-surface font-semibold truncate\">St. Andrew</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant text-[11px] truncate\">Kingston Metro hub</span>\n</div>\n</div>\n</div>\n<!-- Alternative Action Buttons -->\n<div class=\"w-full flex flex-col gap-space-sm mb-space-lg\">\n<!-- Primary CTA: Parts Store Directory -->\n<button class=\"w-full min-h-[48px] rounded-lg bg-primary hover:bg-primary-container active:scale-[0.99] text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-space-sm shadow-md transition-all py-3 px-space-md\">\n<span class=\"material-symbols-outlined text-[20px]\">storefront</span>\n<span>Find Parts Stores Near Me</span>\n</button>\n<!-- Secondary CTA: Request Priority or Contribute -->\n<button class=\"w-full min-h-[48px] rounded-lg bg-surface-container-high hover:bg-surface-container-highest active:scale-[0.99] text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-space-sm transition-all py-3 px-space-md shadow-sm\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">add_task</span>\n<span>Contribute or Request Fast-Track</span>\n</button>\n</div>\n<!-- Helpful Island Driver Support Footer -->\n<div class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm mb-space-md flex items-start gap-space-sm\">\n<div class=\"w-8 h-8 rounded-full bg-tertiary-fixed flex items-center justify-center shrink-0 text-on-tertiary-fixed mt-0.5\">\n<span class=\"material-symbols-outlined text-[18px]\">support_agent</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<h4 class=\"font-label-md text-label-md text-on-surface font-bold\">Need a part urgently today?</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-relaxed\">\n        Don't wait on catalog release if your vehicle is off the road. Call our verified Jamaican parts directory or ask the <strong class=\"text-on-surface font-semibold\">Roam Plug WhatsApp motorist group</strong> for instant store inventory leads.\n      </p>\n<div class=\"flex items-center gap-space-md mt-space-sm\">\n<a class=\"inline-flex items-center gap-1 font-label-sm text-label-sm text-primary hover:underline font-bold\" href=\"#directory\">\n<span>View Local Phone List</span>\n<span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</a>\n<a class=\"inline-flex items-center gap-1 font-label-sm text-label-sm text-secondary hover:underline font-bold\" href=\"#whatsapp\">\n<span>Join WhatsApp Hub</span>\n<span class=\"material-symbols-outlined text-[14px]\">open_in_new</span>\n</a>\n</div>\n</div>\n</div>\n</div></main></body></html>"}