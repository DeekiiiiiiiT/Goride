">Pro-Tip for Fast Approvals</h5>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-snug\">Adding pump price photos or station contact tags cuts verification time down to under 45 minutes.</p>\n</div>\n</div>\n<!-- Sticky Bottom Floating Action Anchor -->\n<div class=\"sticky bottom-4 z-30 pt-space-xs\">\n<button class=\"w-full h-14 rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-space-sm shadow-xl active:bg-secondary transition-all transform active:scale-[0.98]\" onclick=\"showToast('Launching place pin submission camera...')\" type=\"button\">\n<span class=\"material-symbols-outlined text-[24px]\">add_location_alt</span>\n<span>+ Map Another Place</span>\n</button>\n</div>\n</div>\n</div>\n<script>\n  function filterContributions(status, triggerBtn) {\n    // 1. Update Tabs Visual State\n    const tabs = document.querySelectorAll('.tab-btn');\n    tabs.forEach(tab => {\n      tab.classList.remove('bg-inverse-surface', 'text-inverse-on-surface');\n      tab.classList.add('bg-surface-container-lowest', 'text-on-surface-variant');\n    });\n    \n    triggerBtn.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');\n    triggerBtn.classList.add('bg-inverse-surface', 'text-inverse-on-surface');\n\n    // 2. Filter Cards\n    const items = document.querySelectorAll('.contribution-item');\n    let visibleCount = 0;\n\n    items.forEach(item => {\n      const itemStatus = item.getAttribute('data-status');\n      if (status === 'all' || itemStatus === status) {\n        item.style.display = 'flex';\n        visibleCount++;\n      } else {\n        item.style.display = 'none';\n      }\n    });\n\n    // 3. Handle Empty State\n    const emptyState = document.getElementById('empty-state');\n    if (emptyState) {\n      if (visibleCount === 0) {\n        emptyState.classList.remove('hidden');\n        emptyState.classList.add('flex');\n      } else {\n        emptyState.classList.remove('flex');\n        emptyState.classList.add('hidden');\n      }\n    }\n  }\n\n  function showToast(message) {\n    const toast = document.getElementById('roam-toast');\n    const toastText = document.getElementById('toast-text');\n    if (!toast || !toastText) return;\n\n    toastText.innerText = message;\n    toast.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');\n    toast.classList.add('opacity-100', 'translate-y-0');\n\n    setTimeout(() => {\n      toast.classList.remove('opacity-100', 'translate-y-0');\n      toast.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');\n    }, 2400);\n  }\n</script></main></body></html>"}