{ lineHeight: \"20px\", fontWeight: \"400\" }], \"price-display\": [\"24px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"headline-md\": [\"22px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg\": [\"40px\", { lineHeight: \"48px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-sm\": [\"12px\", { lineHeight: \"16px\", fontWeight: \"400\" }], \"headline-sm\": [\"18px\", { lineHeight: \"24px\", fontWeight: \"600\" }], \"label-lg\": [\"14px\", { lineHeight: \"20px\", letterSpacing: \"0.01em\", fontWeight: \"600\" }] } } } }</script><style>@layer base { html, body { min-height: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface min-h-screen flex flex-col antialiased selection:bg-primary/20 selection:text-primary\"><header class=\"fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(28,25,23,0.04)] pt-safe\"><div class=\"h-16 px-space-md flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><h1 class=\"font-headline-md text-headline-md text-on-surface tracking-tight font-headline-md\">Garage   My Vehicles</h1></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Notifications\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><button aria-label=\"Settings\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[24px]\">settings</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-space-xs shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 w-full bg-surface pt-16 pb-28\"><div class=\"flex flex-col w-full px-space-md pb-10 space-y-space-lg\">\n<!-- Profile Showcase Card -->\n<section class=\"relative overflow-hidden rounded-xl bg-surface-container-lowest shadow-md p-space-md\">\n<!-- Ambient Island Sun Halo -->\n<div class=\"absolute -right-10 -top-10 w-44 h-44 rounded-full bg-gradient-to-br from-secondary-container/20 via-primary-fixed/30 to-transparent pointer-events-none blur-2xl\"></div>\n<div class=\"relative flex items-start gap-space-md\">\n<!-- Avatar with Verified Ring -->\n<div class=\"relative flex-shrink-0\">\n<div class=\"w-20 h-20 rounded-full overflow-hidden shadow-sm bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Portrait photo of Tariq, a smiling young Jamaican professional driver wearing a crisp casual shirt against a lush green tropical Blue Mountains backdrop with bright warm Caribbean sunshine.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAvk4GVw4hGeS0xpNDcVnf4hqMJIbBoh1uwS_oCkgAwU_0gU0pONixdkx8E0BMpq4O_lOyNin4R65FvFMbKoLuE_Ib4dnbm7HaEY6dw-fBv0y0OV6Tjh5uimkfxOOIINfxX6Aq-LqTnysWSTH-KSddqKgS0tAfK7zASoI2SzbxznzdncavKrfc7CC19kbemH8tA_I6aahmrGAA7SPK1iz2yUV_YfdZqLrzXT-ajAIT6rhU7O4nCMDbA\"/>\n</div>\n<div class=\"absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-surface-container-lowest flex items-center justify-center shadow\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n</div>\n</div>\n<!-- Identity Details -->\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center gap-1.5 flex-wrap\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight truncate\">Tariq Campbell</h2>\n<span class=\"inline-flex items-center px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm\">\n            🇯🇲 St. Andrew\n          </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">Kingston &amp; St. Andrew Metro Area</p>\n<!-- Rank Pill -->\n<div class=\"mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm shadow-sm\">\n<span class=\"material-symbols-outlined text-[15px] text-secondary-container\" style=\"font-variation-settings: 'FILL' 1;\">local_fire_department</span>\n<span class=\"font-semibold text-primary\">Road Scout Lvl 3</span>\n<span class=\"text-on-surface-variant font-normal\">• Island #18 (340 XP)</span>\n</div>\n</div>\n</div>\n<!-- Quick Milestone Progress bar -->\n<div class=\"mt-4 pt-3 bg-surface-container-low rounded-lg p-2.5\">\n<div class=\"flex items-center justify-between text-body-sm font-label-sm mb-1.5\">\n<span class=\"text-on-surface-variant font-medium\">Next Tier: Senior Scout (60 XP to go)</span>\n<span class=\"text-primary font-bold\">85%</span>\n</div>\n<div class=\"w-full h-2 rounded-full bg-surface-container-highest overflow-hidden\">\n<div class=\"h-full bg-gradient-to-r from-secondary-container to-primary rounded-full transition-all duration-500\" style=\"width: 85%\"></div>\n</div>\n<div class=\"flex items-center justify-between mt-1 text-on-surface-variant font-label-sm text-[11px]\">\n<span>Member since May 2023</span>\n<span class=\"text-secondary font-medium\">Island Contributor Pass</span>\n</div>\n</div>\n<!-- Glanceable Telemetry Grid -->\n<div class=\"grid grid-cols-2 gap-2 mt-3\">\n<div class=\"p-2.5 rounded-lg bg-surface-container-low flex items-center gap-2.5\">\n<div class=\"w-9 h-9 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary shadow-xs flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">directions_car</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Garage</p>\n<p class=\"font-label-md text-label-md text-on-surface truncate font-semibold\">1 Active Car</p>\n</div>\n</div>\n<div class=\"p-2.5 rounded-lg bg-surface-container-low flex items-center gap-2.5\">\n<div class=\"w-9 h-9 rounded-full bg-surface-container-lowest flex items-center justify-center text-secondary-container shadow-xs flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">add_location_alt</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Mapped</p>\n<p class=\"font-label-md text-label-md text-on-surface font-semibold\">14 Island Spots</p>\n</div>\n</div>\n<div class=\"p-2.5 rounded-lg bg-surface-container-low flex items-center gap-2.5\">\n<div class=\"w-9 h-9 rounded-full bg-surface-container-lowest flex items-center justify-center text-tertiary shadow-xs flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">local_gas_station</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Updates</p>\n<p class=\"font-label-md text-label-md text-on-surface font-semibold\">42 Fuel Rates</p>\n</div>\n</div>\n<div class=\"p-2.5 rounded-lg bg-surface-container-low flex items-center gap-2.5\">\n<div class=\"w-9 h-9 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary shadow-xs flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">payments</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Total Fuel</p>\n<p class=\"font-label-md text-label-md text-on-surface font-semibold truncate\">J$14,200</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Group 1: Motorist Core -->\n<section class=\"space-y-2\">\n<div class=\"px-1 flex items-center justify-between\">\n<h3 class=\"font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-bold\">Motorist Core</h3>\n<span class=\"font-label-sm text-label-sm text-primary font-semibold\">Vehicle Hub</span>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden\">\n<!-- Item: My Garage -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">garage</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">My Garage</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">1 vehicle active • 2019 Toyota Roomy</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-[11px] font-semibold\">Up to date</span>\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n<div class=\"h-px bg-surface-container-high mx-space-md\"></div>\n<!-- Item: My Contributions -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-tertiary-fixed flex items-center justify-center text-tertiary flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">stars</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">My Contributions</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Level 3 Scout • 11 approved pins</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-[11px] font-semibold\">+3 pending</span>\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n<div class=\"h-px bg-surface-container-high mx-space-md\"></div>\n<!-- Item: Documents & Renewals -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">assignment</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">Documents &amp; Renewals</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Fitness expires in 14 days</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-secondary-container animate-pulse\"></span>\n<span class=\"px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-[11px] font-semibold\">Action Due</span>\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n</div>\n</section>\n<!-- Group 2: Preferences & Alerts -->\n<section class=\"space-y-2\">\n<div class=\"px-1\">\n<h3 class=\"font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-bold\">Preferences &amp; Alerts</h3>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden\">\n<!-- Notification Settings -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">notifications_active</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">Notification Settings</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">SMS alerts, price drop radar &amp; reminders</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n<div class=\"h-px bg-surface-container-high mx-space-md\"></div>\n<!-- Privacy & Data -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">shield</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">Privacy &amp; Data</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Location permissions, telemetry &amp; offline sync</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n<div class=\"h-px bg-surface-container-high mx-space-md\"></div>\n<!-- Settings -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">tune</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">App Settings</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Measurement units (km / L / J$)</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n</div>\n</section>\n<!-- Group 3: Community & Support -->\n<section class=\"space-y-2\">\n<div class=\"px-1\">\n<h3 class=\"font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-bold\">Community &amp; Support</h3>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden\">\n<!-- Help & Support -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">support_agent</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">Help &amp; Support</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">FAQs, Road Scout guides, WhatsApp support</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n<div class=\"h-px bg-surface-container-high mx-space-md\"></div>\n<!-- About Roam Plug -->\n<a class=\"w-full flex items-center justify-between p-space-md hover:bg-surface-container-low transition-colors min-h-[56px] text-left active:bg-surface-container\" href=\"#\">\n<div class=\"flex items-center gap-space-md min-w-0\">\n<div class=\"w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">local_fire_department</span>\n</div>\n<div class=\"min-w-0\">\n<p class=\"font-label-lg text-label-lg text-on-surface font-semibold truncate\">About Roam Plug</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Version 2.4.1 • Made for Jamaican Drivers</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2 ml-2 flex-shrink-0\">\n<span class=\"px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-[11px] font-semibold\">Latest</span>\n<span class=\"material-symbols-outlined text-outline text-[20px]\">chevron_right</span>\n</div>\n</a>\n</div>\n</section>\n<!-- Group 4: Account Action -->\n<section class=\"space-y-2\">\n<div class=\"bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden p-space-sm\">\n<button class=\"w-full flex items-center justify-between p-space-md rounded-lg bg-surface-container-lowest hover:bg-error-container/20 text-error transition-all min-h-[48px] active:scale-[0.99]\" id=\"sign-out-btn\" type=\"button\">\n<div class=\"flex items-center gap-space-md\">\n<div class=\"w-10 h-10 rounded-full bg-error-container flex items-center justify-center text-error flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[22px]\">logout</span>\n</div>\n<div class=\"text-left\">\n<p class=\"font-label-lg text-label-lg font-bold\">Sign Out</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Signed in as +1 (876) 555-0192</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-error text-[20px]\">chevron_right</span>\n</button>\n</div>\n</section>\n<!-- Footer Meta -->\n<footer class=\"pt-2 text-center space-y-2\">\n<p class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant font-semibold\">\n      Roam Plug Jamaica • Built for Island Roads\n    </p>\n<div class=\"flex items-center justify-center gap-3 font-body-sm text-body-sm text-on-surface-variant\">\n<a class=\"hover:text-primary transition-colors underline-offset-4 hover:underline\" href=\"#\">Terms of Service</a>\n<span>•</span>\n<a class=\"hover:text-primary transition-colors underline-offset-4 hover:underline\" href=\"#\">Privacy Policy</a>\n<span>•</span>\n<a class=\"hover:text-primary transition-colors underline-offset-4 hover:underline\" href=\"#\">Gazetted Fuel Notice</a>\n</div>\n<p class=\"font-body-sm text-[11px] text-on-surface-variant/70 max-w-xs mx-auto\">\n      Fuel rates and toll tariffs are community-verified under the Jamaica Motoring Community Guidelines.\n    </p>\n</footer>\n</div>\n<script>\n  (function() {\n    const signOutBtn = document.getElementById('sign-out-btn');\n    if (signOutBtn) {\n      signOutBtn.addEventListener('click', function() {\n        if (confirm('Sign out of Roam Plug on this device? Your offline fuel logs and saved garage vehicles will remain safe in the cloud.')) {\n          // Graceful simulated sign out micro-interaction\n          signOutBtn.style.opacity = '0.5';\n          signOutBtn.innerText = 'Signing out...';\n          setTimeout(() => {\n            alert('Signed out successfully.');\n            signOutBtn.style.opacity = '1';\n          }, 600);\n        }\n      });\n    }\n  })();\n</script></main><nav class=\"fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_12px_rgba(28,25,23,0.06)]\" data-active