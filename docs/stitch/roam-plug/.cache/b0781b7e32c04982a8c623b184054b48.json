{"filename":"30-vehicle-overview.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"on-secondary-container\": \"#5c2400\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-primary-container\": \"#fffbff\", \"background\": \"#fff8f2\", \"on-secondary\": \"#ffffff\", \"primary-fixed-dim\": \"#ffb599\", \"tertiary-container\": \"#936f00\", \"inverse-primary\": \"#ffb599\", \"secondary-container\": \"#fd761a\", \"on-background\": \"#1e1b17\", \"surface-container\": \"#f4ede6\", \"primary\": \"#a33900\", \"on-surface-variant\": \"#5a4138\", \"inverse-on-surface\": \"#f7efe9\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"surface-container-high\": \"#eee7e0\", \"on-primary\": \"#ffffff\", \"error-container\": \"#ffdad6\", \"surface-variant\": \"#e8e1db\", \"outline\": \"#8e7166\", \"on-surface\": \"#1e1b17\", \"surface-bright\": \"#fff8f2\", \"tertiary\": \"#755800\", \"inverse-surface\": \"#33302c\", \"surface-container-low\": \"#faf2eb\", \"secondary\": \"#9d4300\", \"secondary-fixed-dim\": \"#ffb690\", \"surface-tint\": \"#a73a00\", \"on-error\": \"#ffffff\", \"primary-fixed\": \"#ffdbce\", \"primary-container\": \"#cc4900\", \"on-tertiary\": \"#ffffff\", \"surface\": \"#fff8f2\", \"error\": \"#ba1a1a\", \"tertiary-fixed\": \"#ffdf9a\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-error-container\": \"#93000a\", \"on-secondary-fixed\": \"#341100\", \"on-tertiary-container\": \"#fffbff\", \"on-secondary-fixed-variant\": \"#783200\", \"on-tertiary-fixed\": \"#251a00\", \"secondary-fixed\": \"#ffdbca\", \"surface-container-highest\": \"#e8e1db\", \"surface-container-lowest\": \"#ffffff\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-xl\": \"2rem\", \"space-md\": \"1rem\", \"margin\": \"1rem\", \"gutter\": \"1rem\", \"space-sm\": \"0.5rem\", \"margin-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\" }, fontFamily: { \"body-lg\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"body-md\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-lg\": [\"Inter\"] }, fontSize: { \"body-lg\": [\"16px\", { lineHeight: \"24px\", fontWeight: \"400\" }], \"label-sm\": [\"10px\", { lineHeight: \"12px\", letterSpacing: \"0.04em\", fontWeight: \"700\" }], \"label-md\": [\"12px\", { lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"600\" }], \"headline-lg\": [\"28px\", { lineHeight: \"36px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg-mobile\": [\"32px\", { lineHeight: \"40px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-md\": [\"14px\", { lineHeight: \"20px\", fontWeight: \"400\" }], \"price-display\": [\"24px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"headline-md\": [\"22px\", { lineHeight: \"28px\", letterSpacing: \"-0.01em\", fontWeight: \"700\" }], \"display-lg\": [\"40px\", { lineHeight: \"48px\", letterSpacing: \"-0.02em\", fontWeight: \"800\" }], \"body-sm\": [\"12px\", { lineHeight: \"16px\", fontWeight: \"400\" }], \"headline-sm\": [\"18px\", { lineHeight: \"24px\", fontWeight: \"600\" }], \"label-lg\": [\"14px\", { lineHeight: \"20px\", letterSpacing: \"0.01em\", fontWeight: \"600\" }] } } } }</script><style>@layer base { html, body { min-height: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface min-h-screen flex flex-col antialiased selection:bg-primary/20 selection:text-primary\"><header class=\"fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(28,25,23,0.04)] pt-safe\"><div class=\"h-16 px-space-sm flex items-center justify-between\"><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Go Back to My Garage\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface hover:text-primary hover:bg-surface-container active:scale-95 transition-all\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-md text-headline-md text-on-surface tracking-tight font-headline-md\">Vehicle Overview</h1></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Share Vehicle\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[22px]\">share</span></button><button aria-label=\"More Options\" class=\"w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-primary hover:bg-surface-container active:scale-95 transition-all\"><span class=\"material-symbols-outlined text-[22px]\">more_vert</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-space-xs shadow-sm\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 w-full bg-surface pt-16 pb-safe\"><div class=\"flex flex-col w-full px-margin pb-space-xl gap-space-lg\">\n<!-- Vehicle Hero Header Card -->\n<section class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden flex flex-col gap-space-md\">\n<!-- Ambient Subtlety Glow -->\n<div class=\"absolute -right-16 -top-16 w-44 h-44 rounded-full bg-secondary-container/10 pointer-events-none blur-2xl\"></div>\n<div class=\"flex items-start justify-between gap-space-sm relative z-10\">\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-space-xs mb-1\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[13px] text-tertiary\">lock</span>\n            8241-HY\n          </span>\n<span class=\"text-on-surface-variant font-label-sm text-label-sm tracking-tight opacity-75\">Private</span>\n</div>\n<h2 class=\"font-headline-md text-headline-md text-on-surface truncate\">2019 Toyota Roomy</h2>\n<p class=\"font-label-lg text-label-lg text-primary font-semibold\">“Daily Workhorse”</p>\n</div>\n<!-- Schedule Type Pill -->\n<div class=\"flex flex-col items-end shrink-0\">\n<button aria-controls=\"schedule-tooltip\" aria-expanded=\"false\" class=\"flex items-center gap-1 bg-surface-container-high px-2.5 py-1.5 rounded-full text-on-surface hover:bg-surface-variant transition-colors\" id=\"schedule-pill-btn\">\n<span class=\"material-symbols-outlined text-primary text-[15px]\">event_repeat</span>\n<span class=\"font-label-sm text-label-sm\">General Schedule</span>\n<span class=\"material-symbols-outlined text-[14px] text-on-surface-variant\">info</span>\n</button>\n</div>\n</div>\n<!-- Collapsible Schedule Micro-Explainer -->\n<div class=\"hidden bg-surface-container-high text-on-surface p-space-sm rounded-lg text-body-sm font-body-sm animate-fade-in\" id=\"schedule-tooltip\">\n<div class=\"flex items-start gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5\">verified</span>\n<p class=\"text-on-surface-variant leading-tight\">\n          General baseline schedule — model-specific Jamaican tropical driving schedule syncing (Montego Bay &amp; Kingston commuter adjusted).\n        </p>\n</div>\n</div>\n<!-- Vehicle Render & Specs Sub-Card -->\n<div class=\"relative w-full rounded-lg overflow-hidden bg-surface-container flex flex-col\">\n<div class=\"w-full h-44 relative bg-cover bg-center\" data-alt=\"Modern 2019 silver Toyota Roomy compact mini-wagon parked under tropical Jamaican morning sunlight, clean pavement, mountains in the warm atmospheric background, automotive photography, crisp sharp reflections, warm sunset motoring palette tone\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBOz1AgeKNR59w-PMg2jcOwdGYi7RvjhR6rPS1SP8oxUFPez3CcFg99uZ4bimV4PR7huz6qpHZ6OXPw0ELhesJ26IEMyoVZ2-LwEPcHe4XYtNpN8IfaqJk0FtpofziLDcIEEYtkk07ikWHWIWw5GOsXbOu7Lz0KEOKfDuUMWAOqqWCSv1qfmXQvBh97BsWOBfdDHPyOM0K6Sr8E6GHDZxeWkOBamdF5nxX-mKHLicYyGa5rgNhRIh-p')\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent\"></div>\n<div class=\"absolute bottom-3 left-3 right-3 flex items-center justify-between\">\n<span class=\"inline-flex items-center gap-1.5 bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-full text-white font-label-md text-label-md\">\n<span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n            1KR-FE Turbo\n          </span>\n<span class=\"bg-primary-container text-on-primary-container font-label-sm text-label-sm px-2.5 py-1 rounded-full uppercase tracking-wider font-bold\">\n            GS Grade\n          </span>\n</div>\n</div>\n<div class=\"px-space-md py-2.5 bg-surface-container-high flex items-center justify-between text-on-surface-variant font-label-md text-label-md\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[16px]\">tune</span>\n<span>1.0L Turbo GS (1KR-FE)</span>\n</div>\n<span class=\"text-outline\">•</span>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[16px]\">settings_input_component</span>\n<span>FWD CVT</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Horizontal Section Tabs -->\n<nav aria-label=\"Vehicle Sections\" class=\"w-full bg-surface-container-low p-1 rounded-xl flex items-center gap-1 shadow-sm\">\n<button class=\"flex-1 py-2 rounded-lg bg-surface-container-lowest text-primary font-label-lg text-label-lg font-bold shadow-sm flex items-center justify-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-[18px]\">dashboard</span>\n<span>Overview</span>\n</button>\n<button class=\"flex-1 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-[18px]\">build</span>\n<span>Service</span>\n</button>\n<button class=\"flex-1 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-[18px]\">local_gas_station</span>\n<span>Fuel</span>\n</button>\n<button class=\"flex-1 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-[18px]\">folder_shared</span>\n<span>Docs</span>\n</button>\n</nav>\n<!-- Key Stats Grid (4 compact statistic tiles) -->\n<section aria-label=\"Key Vehicle Statistics\" class=\"grid grid-cols-2 gap-space-sm w-full\">\n<!-- Tile 1: Odometer -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between gap-1\">\n<div class=\"flex items-center justify-between text-on-surface-variant\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider font-semibold\">Odometer</span>\n<span class=\"material-symbols-outlined text-primary text-[18px]\">speed</span>\n</div>\n<div class=\"mt-1\">\n<p class=\"font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight\">84,612 <span class=\"font-label-md text-label-md font-normal text-on-surface-variant\">km</span></p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\"></span> Updated today\n        </p>\n</div>\n</div>\n<!-- Tile 2: Avg km/day -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between gap-1\">\n<div class=\"flex items-center justify-between text-on-surface-variant\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider font-semibold\">Avg Usage</span>\n<span class=\"material-symbols-outlined text-secondary text-[18px]\">commute</span>\n</div>\n<div class=\"mt-1\">\n<p class=\"font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight\">48 <span class=\"font-label-md text-label-md font-normal text-on-surface-variant\">km / day</span></p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate mt-0.5\" title=\"Kingston – Spanish Town corridor\">\n          Kgn – Spanish Town\n        </p>\n</div>\n</div>\n<!-- Tile 3: Fuel Economy -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between gap-1\">\n<div class=\"flex items-center justify-between text-on-surface-variant\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider font-semibold\">Avg Economy</span>\n<span class=\"material-symbols-outlined text-tertiary text-[18px]\">eco</span>\n</div>\n<div class=\"mt-1\">\n<p class=\"font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight\">14.2 <span class=\"font-label-md text-label-md font-normal text-on-surface-variant\">km/L</span></p>\n<p class=\"font-body-sm text-body-sm text-emerald-700 font-semibold mt-0.5 flex items-center gap-0.5\">\n<span class=\"material-symbols-outlined text-[14px]\">trending_up</span> +6% vs Parish\n        </p>\n</div>\n</div>\n<!-- Tile 4: Month Fuel Spend -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between gap-1\">\n<div class=\"flex items-center justify-between text-on-surface-variant\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider font-semibold\">Spend (Oct)</span>\n<span class=\"material-symbols-outlined text-primary text-[18px]\">payments</span>\n</div>\n<div class=\"mt-1\">\n<p class=\"font-headline-sm text-headline-sm text-primary font-bold tracking-tight\">J$16,840</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">3 fill-ups recorded</p>\n</div>\n</div>\n</section>\n<!-- Quick Action Row -->\n<section aria-label=\"Vehicle Quick Actions\" class=\"grid grid-cols-3 gap-space-xs w-full\">\n<!-- Action 1: Log Fuel -->\n<button class=\"h-14 bg-primary text-on-primary rounded-xl font-label-md text-label-md font-bold flex flex-col items-center justify-center gap-0.5 shadow-sm active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">local_gas_station</span>\n<span>Log Fuel</span>\n</button>\n<!-- Action 2: Log Service -->\n<button class=\"h-14 bg-surface-container-high text-on-surface rounded-xl font-label-md text-label-md font-semibold flex flex-col items-center justify-center gap-0.5 hover:bg-surface-variant active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px] text-secondary\">build</span>\n<span>Log Service</span>\n</button>\n<!-- Action 3: Parts for Car -->\n<button class=\"h-14 bg-surface-container-high text-on-surface rounded-xl font-label-md text-label-md font-semibold flex flex-col items-center justify-center gap-0.5 hover:bg-surface-variant active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px] text-tertiary\">precision_manufacturing</span>\n<span class=\"truncate px-1\">Find Parts</span>\n</button>\n</section>\n<!-- Statutory Renewals & Jamaican Compliance Card -->\n<section class=\"w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-md\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-full bg-primary-fixed flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[18px]\">verified_user</span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Jamaica Compliance</h3>\n</div>\n<span class=\"font-label-sm text-label-sm bg-surface-container px-2 py-1 rounded text-on-surface-variant font-semibold\">Motor Vehicle Act</span>\n</div>\n<!-- Alert / Due Soon: Certificate of Fitness -->\n<div class=\"rounded-xl p-space-sm bg-surface-container-low flex flex-col gap-2 relative overflow-hidden\">\n<div class=\"absolute left-0 top-0 bottom-0 w-1.5 bg-amber-500\"></div>\n<div class=\"flex items-start justify-between pl-2\">\n<div>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-amber-600 text-[18px]\">warning</span>\n<p class=\"font-label-lg text-label-lg font-bold text-on-surface\">Certificate of Fitness</p>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5 pl-6\">\n         