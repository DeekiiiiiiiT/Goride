{"filename":"09-add-vehicle-make.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"secondary-container\": \"#fd761a\", \"on-tertiary-fixed\": \"#251a00\", \"tertiary\": \"#755800\", \"error-container\": \"#ffdad6\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container-high\": \"#eee7e0\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"surface-bright\": \"#fff8f2\", \"on-surface\": \"#1e1b17\", \"surface-variant\": \"#e8e1db\", \"secondary-fixed\": \"#ffdbca\", \"on-secondary-fixed-variant\": \"#783200\", \"primary-fixed-dim\": \"#ffb599\", \"secondary\": \"#9d4300\", \"surface-container-lowest\": \"#ffffff\", \"error\": \"#ba1a1a\", \"on-primary\": \"#ffffff\", \"on-tertiary-container\": \"#fffbff\", \"on-secondary\": \"#ffffff\", \"surface-container-low\": \"#faf2eb\", \"surface-container\": \"#f4ede6\", \"on-background\": \"#1e1b17\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"tertiary-container\": \"#936f00\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-primary-container\": \"#fffbff\", \"on-error-container\": \"#93000a\", \"inverse-surface\": \"#33302c\", \"primary-container\": \"#cc4900\", \"primary-fixed\": \"#ffdbce\", \"on-tertiary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"surface-dim\": \"#e0d9d2\", \"inverse-primary\": \"#ffb599\", \"background\": \"#fff8f2\", \"surface-container-highest\": \"#e8e1db\", \"on-surface-variant\": \"#5a4138\", \"secondary-fixed-dim\": \"#ffb690\", \"outline-variant\": \"#e2bfb2\", \"on-secondary-container\": \"#5c2400\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"on-secondary-fixed\": \"#341100\", \"primary\": \"#a33900\", \"surface\": \"#fff8f2\", \"surface-tint\": \"#a73a00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin\": \"1rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\" }, fontFamily: { \"label-lg\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"body-md\": [\"Inter\"], \"price-display\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, fontSize: { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base { html, body { width: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 16px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col\"><header class=\"fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl pt-safe\"><div class=\"h-12 px-margin flex items-center justify-between text-on-surface\"><span class=\"font-label-md text-label-md font-bold tracking-tight\">9:41</span><div class=\"flex items-center gap-space-xs text-on-surface\"><span class=\"material-symbols-outlined text-[18px]\">signal_cellular_4_bar</span><span class=\"material-symbols-outlined text-[18px]\">wifi</span><span class=\"material-symbols-outlined text-[20px]\">battery_full</span></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-12 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8\">\n<!-- Top Stepper Navigation Header -->\n<div class=\"px-margin pt-2 pb-space-sm flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between min-h-[48px]\">\n<button aria-label=\"Go back\" class=\"flex items-center justify-center w-12 h-12 -ml-2 rounded-full active:bg-surface-container transition-colors text-on-surface\" type=\"button\">\n<span class=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n</button>\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-sm text-label-sm tracking-wider uppercase text-on-surface-variant font-bold\">Step 1 of 3</span>\n</div>\n<button class=\"flex items-center justify-center min-h-[48px] px-space-xs font-label-md text-label-md text-secondary font-bold active:opacity-70\" type=\"button\">\n        Skip\n      </button>\n</div>\n<!-- Segmented 3-part progress bar -->\n<div class=\"flex items-center gap-1.5 w-full\">\n<div class=\"h-1.5 flex-1 rounded-full bg-primary-container\"></div>\n<div class=\"h-1.5 flex-1 rounded-full bg-surface-container-high\"></div>\n<div class=\"h-1.5 flex-1 rounded-full bg-surface-container-high\"></div>\n</div>\n</div>\n<!-- Heading & Intro section -->\n<div class=\"px-margin pt-space-md pb-space-sm flex flex-col\">\n<div class=\"flex items-center gap-space-xs mb-1\">\n<span class=\"px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant font-label-sm text-label-sm uppercase\">Garage Setup</span>\n</div>\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface\">Add your vehicle</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1.5 leading-relaxed\">\n      Track island gas rates, schedule routine parish road fitness, and match genuine replacement parts.\n    </p>\n</div>\n<!-- Search Input Container -->\n<div class=\"px-margin pt-space-sm pb-space-md\">\n<div class=\"relative flex items-center w-full min-h-[50px] bg-surface-container-lowest rounded-xl shadow-sm\">\n<div class=\"absolute left-3.5 flex items-center pointer-events-none text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[22px]\">search</span>\n</div>\n<input class=\"w-full h-[50px] pl-11 pr-11 bg-transparent text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/60 focus:outline-none\" id=\"make-search-input\" placeholder=\"Search make (e.g. Toyota, Nissan...)\" type=\"text\" value=\"\"/>\n<button aria-label=\"Clear search\" class=\"absolute right-1 w-10 h-10 flex items-center justify-center text-on-surface-variant rounded-full active:bg-surface-container transition-opacity\" id=\"clear-search-btn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">cancel</span>\n</button>\n</div>\n</div>\n<!-- Island Context Banner -->\n<div class=\"px-margin pb-space-md\">\n<div class=\"flex items-center gap-space-sm p-space-sm rounded-xl bg-surface-container-low shadow-sm\">\n<div class=\"w-10 h-10 rounded-lg bg-tertiary-fixed flex items-center justify-center shrink-0 text-on-tertiary-fixed\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">local_gas_station</span>\n</div>\n<div class=\"flex flex-col min-w-0 pr-1\">\n<span class=\"font-label-md text-label-md text-on-surface font-bold truncate\">Jamaica Route & Fleet Index</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Optimized for route taxis, pickups & commuter cars</span>\n</div>\n</div>\n</div>\n<!-- Popular Makes Section Header -->\n<div class=\"px-margin flex items-baseline justify-between pt-1 pb-space-sm\">\n<div>\n<h2 class=\"font-label-lg text-label-lg uppercase tracking-wider text-on-surface font-bold\">Popular in Jamaica</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Common island fleet & commuter vehicles</p>\n</div>\n<span class=\"font-label-sm text-label-sm text-primary font-bold\">10 Makes</span>\n</div>\n<!-- Brands Selection Grid (2-columns) -->\n<div class=\"px-margin pb-space-lg\">\n<div class=\"grid grid-cols-2 gap-space-sm\" id=\"makes-grid\">\n<!-- 1. Toyota (ACTIVE DEFAULT) -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-secondary-fixed text-on-secondary-fixed transition-all cursor-pointer shadow-md select-none\" data-make=\"Toyota\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm checkmark-badge\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center shadow-sm mb-3 text-primary\">\n<span class=\"material-symbols-outlined text-[28px]\">directions_car</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Toyota</span>\n<span class=\"font-label-sm text-label-sm text-primary font-bold mt-0.5\">#1 in Jamaica</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Axio, Probox, Voxy, Hiace</span>\n</div>\n<!-- 2. Honda -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Honda\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">commute</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Honda</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">High Resale</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Fit, Vezel, Civic, CR-V</span>\n</div>\n<!-- 3. Nissan -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Nissan\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">minor_crash</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Nissan</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Route Essential</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">AD Wagon, Note, Sylphy</span>\n</div>\n<!-- 4. Suzuki -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Suzuki\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">electric_car</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Suzuki</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Island Compact</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Swift, Jimny, Vitara</span>\n</div>\n<!-- 5. Mazda -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Mazda\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">speed</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Mazda</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Popular Hatch</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Demio, Axela, CX-5</span>\n</div>\n<!-- 6. Mitsubishi -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Mitsubishi\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">terrain</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Mitsubishi</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Rugged Hills</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Outlander, L200, Pajero</span>\n</div>\n<!-- 7. Hyundai -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Hyundai\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">car_repair</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Hyundai</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Growing Choice</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Tucson, Elantra, Santa Fe</span>\n</div>\n<!-- 8. Kia -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Kia\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">sensor_occupied</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Kia</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Modern Crossover</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Sportage, Cerato, Rio</span>\n</div>\n<!-- 9. Isuzu -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Isuzu\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">local_shipping</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Isuzu</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">Heavy Workhorse</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">D-Max, Elf Truck</span>\n</div>\n<!-- 10. Subaru -->\n<div class=\"make-card relative flex flex-col p-space-md rounded-2xl bg-surface-container-lowest text-on-surface transition-all cursor-pointer shadow-sm select-none active:scale-[0.98]\" data-make=\"Subaru\" role=\"button\" tabindex=\"0\">\n<div class=\"absolute top-3 right-3 w-6 h-6 rounded-full bg-primary items-center justify-center text-on-primary shadow-sm checkmark-badge hidden\">\n<span class=\"material-symbols-outlined text-[16px] font-bold\">check</span>\n</div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-3 text-on-surface\">\n<span class=\"material-symbols-outlined text-[28px]\">all_inclusive</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Subaru</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-medium mt-0.5\">AWD Mountain Run</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1 truncate\">Forester, XV, Impreza</span>\n</div>\n</div>\n</div>\n<!-- Manual Entry Action -->\n<div class=\"px-margin pb-space-lg flex flex-col items-center\">\n<button class=\"min-h-[48px] px-space-md py-2 flex items-center justify-center gap-space-xs text-secondary active:opacity-75 font-label-lg text-label-lg font-bold\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">edit_note</span>\n<span>Can't find your make? Enter manually</span>\n</button>\n</div>\n<!-- Sticky Bottom Confirmation Deck -->\n<div class=\"mt-auto px-margin pt-space-md pb-space-md flex flex-col gap-space-sm bg-surface/90 backdrop-blur-md\">\n<button class=\"w-full min-h-[52px] rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-lg active:bg-primary-container transition-all\" id=\"submit-make-btn\" type=\"button\">\n<span id=\"btn-text\">Continue with Toyota</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<button class=\"w-full min-h-[48px] rounded-xl text-on-surface-variant font-body-md text-body-md font-medium flex items-center justify-center active:bg-surface-container transition-colors\" type=\"button\">\n      Skip for now (can add later)\n    </button>\n</div>\n</div>\n<script>\n  (function initMakeSelection() {\n    let currentSelectedMake = 'Toyota';\n    const cards = document.querySelectorAll('.make-card');\n    const submitBtnText = document.getElementById('btn-text');\n    const searchInput = document.getElementById('make-search-input');\n    const clearBtn = document.getElementById('clear-search-btn');\n\n    cards.forEach(card => {\n      card.addEventListener('click', () => {\n        const make = card.getAttribute('data-make');\n        currentSelectedMake = make;\n\n        // Reset all cards\n        cards.forEach(c => {\n          c.classList.remove('bg-secondary-fixed', 'shadow-md');\n          c.classList.add('bg-surface-container-lowest', 'shadow-sm');\n          \n          const iconWrapper = c.querySelector('.w-12');\n          if (iconWrapper) {\n            iconWrapper.classList.remove('bg-surface-container-lowest', 'text-primary');\n            iconWrapper.classList.add('bg-surface-container', 'text-on-surface');\n          }\n\n          const badge = c.querySelector('.checkmark-badge');\n          if (badge) badge.classList.add('hidden');\n        });\n\n        // Set active card\n        card.classList.remove('bg-surface-container-lowest', 'shadow-sm');\n        card.classList.add('bg-secondary-fixed', 'shadow-md');\n\n        const activeIcon = card.querySelector('.w-12');\n        if (activeIcon) {\n          activeIcon.classList.remove('bg-surface-container', 'text-on-surface');\n          activeIcon.classList.add('bg-surface-container-lowest', 'text-primary');\n        }\n\n        const activeBadge = card.querySelector('.checkmark-badge');\n        if (activeBadge) {\n          activeBadge.classList.remove('hidden');\n          activeBadge.classList.add('flex');\n        }\n\n        if (submitBtnText) {\n          submitBtnText.textContent = `Continue with ${make}`;\n        }\n      });\n    });\n\n    if (searchInput) {\n      searchInput.addEventListener('input', (e) => {\n        const query = e.target.value.toLowerCase().trim();\n        cards.forEach(card => {\n          const make = (card.getAttribute('data-make') || '').toLowerCase();\n          const models = card.querySelector('.truncate')?.textContent?.toLowerCase() || '';\n          if (make.includes(query) || models.includes(query)) {\n            card.style.display = 'flex';\n          } else {\n            card.style.display = 'none';\n          }\n        });\n      });\n    }\n\n    if (clearBtn && searchInput) {\n      clearBtn.addEventListener('click', () => {\n        searchInput.value = '';\n        cards.forEach(card => { card.style.display = 'flex'; });\n        searchInput.focus();\n      });\n    }\n  })();\n</script></main></body></html>"}