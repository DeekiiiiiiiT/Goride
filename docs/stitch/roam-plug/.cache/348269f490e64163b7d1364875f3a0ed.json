{"filename":"08-permissions.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"secondary-container\": \"#fd761a\", \"on-tertiary-fixed\": \"#251a00\", \"tertiary\": \"#755800\", \"error-container\": \"#ffdad6\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container-high\": \"#eee7e0\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"surface-bright\": \"#fff8f2\", \"on-surface\": \"#1e1b17\", \"surface-variant\": \"#e8e1db\", \"secondary-fixed\": \"#ffdbca\", \"on-secondary-fixed-variant\": \"#783200\", \"primary-fixed-dim\": \"#ffb599\", \"secondary\": \"#9d4300\", \"surface-container-lowest\": \"#ffffff\", \"error\": \"#ba1a1a\", \"on-primary\": \"#ffffff\", \"on-tertiary-container\": \"#fffbff\", \"on-secondary\": \"#ffffff\", \"surface-container-low\": \"#faf2eb\", \"surface-container\": \"#f4ede6\", \"on-background\": \"#1e1b17\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"tertiary-container\": \"#936f00\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-primary-container\": \"#fffbff\", \"on-error-container\": \"#93000a\", \"inverse-surface\": \"#33302c\", \"primary-container\": \"#cc4900\", \"primary-fixed\": \"#ffdbce\", \"on-tertiary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"surface-dim\": \"#e0d9d2\", \"inverse-primary\": \"#ffb599\", \"background\": \"#fff8f2\", \"surface-container-highest\": \"#e8e1db\", \"on-surface-variant\": \"#5a4138\", \"secondary-fixed-dim\": \"#ffb690\", \"outline-variant\": \"#e2bfb2\", \"on-secondary-container\": \"#5c2400\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"on-secondary-fixed\": \"#341100\", \"primary\": \"#a33900\", \"surface\": \"#fff8f2\", \"surface-tint\": \"#a73a00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin\": \"1rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\" }, fontFamily: { \"label-lg\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"body-md\": [\"Inter\"], \"price-display\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, fontSize: { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base { html, body { width: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 16px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col\"><header class=\"fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl pt-safe\"><div class=\"h-12 px-margin flex items-center justify-between text-on-surface\"><span class=\"font-label-md text-label-md font-bold tracking-tight\">9:41</span><div class=\"flex items-center gap-space-xs text-on-surface\"><span class=\"material-symbols-outlined text-[18px]\">signal_cellular_4_bar</span><span class=\"material-symbols-outlined text-[18px]\">wifi</span><span class=\"material-symbols-outlined text-[20px]\">battery_full</span></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-12 pb-safe bg-surface\"><div class=\"flex flex-col w-full px-margin pb-space-xl\">\n<!-- Top Navigation Bar -->\n<div class=\"flex items-center justify-between w-full h-12 mb-space-sm\">\n<button aria-label=\"Go back\" class=\"flex items-center justify-center w-12 h-12 rounded-full bg-surface-container hover:bg-surface-container-high transition-colors text-on-surface\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">arrow_back</span>\n</button>\n<div class=\"flex items-center gap-space-xs px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed\">\n<span class=\"w-2 h-2 rounded-full bg-primary animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm tracking-wider uppercase font-bold\">App Permissions</span>\n</div>\n<button class=\"flex items-center gap-1 px-3 py-2 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-high transition-colors\" id=\"info-modal-trigger\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">info</span>\n<span>Why we ask</span>\n</button>\n</div>\n<!-- Header & Motivational Hook -->\n<div class=\"flex flex-col gap-space-xs mb-space-lg pt-space-xs\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold\">Step 2 of 3</span>\n<span class=\"w-1 h-1 rounded-full bg-outline-variant\"></span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Setup Companion</span>\n</div>\n<h1 class=\"font-display-lg-mobile text-display-lg-mobile text-on-surface\">Enable permissions</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n      To get live parish fuel alerts, snap your odometer at the pump, and navigate Jamaican roadways accurately.\n    </p>\n</div>\n<!-- Permissions Cards Stack -->\n<div class=\"flex flex-col gap-space-md mb-space-lg\" id=\"permissions-container\">\n<!-- Card 1: Location (Required) -->\n<div class=\"relative flex flex-col p-space-md rounded-xl bg-surface-container-lowest shadow-md transition-all duration-300\" id=\"card-location\">\n<div class=\"flex items-start justify-between gap-space-sm mb-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"flex items-center justify-center w-12 h-12 rounded-xl bg-primary text-on-primary shadow-sm flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[24px]\">near_me</span>\n</div>\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">Location Access</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-primary font-bold uppercase tracking-wide\">Set to: While using app</span>\n</div>\n</div>\n<span class=\"px-2.5 py-1 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm font-bold tracking-wider\">\n          REQUIRED\n        </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed\">\n        Pinpoint the cheapest gas station across your parish, track accurate JMD pump rates along your route, and log roadside tire/mechanic spots with precision.\n      </p>\n<div class=\"flex items-center justify-between pt-space-xs bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px] text-on-surface-variant\" id=\"location-status-icon\">fmd_good</span>\n<span class=\"font-label-md text-label-md text-on-surface\" id=\"location-status-text\">Accuracy: High Precision</span>\n</div>\n<button class=\"flex items-center justify-center h-12 px-space-md rounded-lg bg-primary text-on-primary font-label-lg text-label-lg active:scale-95 transition-all shadow-sm\" id=\"btn-perm-location\" type=\"button\">\n<span class=\"perm-btn-text\">Allow</span>\n</button>\n</div>\n</div>\n<!-- Card 2: Camera (Recommended) -->\n<div class=\"relative flex flex-col p-space-md rounded-xl bg-surface-container-lowest shadow-md transition-all duration-300\" id=\"card-camera\">\n<div class=\"flex items-start justify-between gap-space-sm mb-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"flex items-center justify-center w-12 h-12 rounded-xl bg-tertiary-fixed text-on-tertiary-fixed shadow-sm flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[24px]\">photo_camera</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">Camera</span>\n<span class=\"font-label-sm text-label-sm text-tertiary font-bold uppercase tracking-wide\">Pump & Spot Scanner</span>\n</div>\n</div>\n<span class=\"px-2.5 py-1 rounded-full bg-tertiary-fixed-dim text-on-tertiary-fixed font-label-sm text-label-sm font-bold tracking-wider\">\n          RECOMMENDED\n        </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed\">\n        Snap your vehicle's odometer at the fuel pump for instant MPG tracking, and contribute photos of verified auto shops, air compressors, and wash bays.\n      </p>\n<div class=\"flex items-center justify-between pt-space-xs bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px] text-on-surface-variant\" id=\"camera-status-icon\">document_scanner</span>\n<span class=\"font-label-md text-label-md text-on-surface\" id=\"camera-status-text\">Odometer & Gas Slips</span>\n</div>\n<button class=\"flex items-center justify-center h-12 px-space-md rounded-lg bg-secondary-fixed text-on-secondary-fixed font-label-lg text-label-lg active:scale-95 transition-all shadow-sm\" id=\"btn-perm-camera\" type=\"button\">\n<span class=\"perm-btn-text\">Allow</span>\n</button>\n</div>\n</div>\n<!-- Card 3: Push Notifications (Timely Alerts) -->\n<div class=\"relative flex flex-col p-space-md rounded-xl bg-surface-container-lowest shadow-md transition-all duration-300\" id=\"card-notifications\">\n<div class=\"flex items-start justify-between gap-space-sm mb-space-sm\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"flex items-center justify-center w-12 h-12 rounded-xl bg-surface-container-high text-on-surface shadow-sm flex-shrink-0\">\n<span class=\"material-symbols-outlined text-[24px]\">notifications_active</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">Push Notifications</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wide\">Timely Local Updates</span>\n</div>\n</div>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-variant text-on-surface-variant font-label-sm text-label-sm font-bold tracking-wider\">\n          TIMELY ALERTS\n        </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed\">\n        Stay notified when Petrojam weekly fuel price changes drop, receive reminders before your vehicle fitness & registration expire, and track parish traffic jams.\n      </p>\n<div class=\"flex items-center justify-between pt-space-xs bg-surface-container-low p-space-sm rounded-lg\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px] text-on-surface-variant\" id=\"notifications-status-icon\">price_change</span>\n<span class=\"font-label-md text-label-md text-on-surface\" id=\"notifications-status-text\">Price Drops & Deadlines</span>\n</div>\n<button class=\"flex items-center justify-center h-12 px-space-md rounded-lg bg-secondary-fixed text-on-secondary-fixed font-label-lg text-label-lg active:scale-95 transition-all shadow-sm\" id=\"btn-perm-notifications\" type=\"button\">\n<span class=\"perm-btn-text\">Allow</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Reassurance / Trust Badge -->\n<div class=\"flex items-center justify-center gap-space-xs mb-space-lg px-space-sm py-space-xs rounded-xl bg-surface-container-low text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[18px] text-secondary\">verified_user</span>\n<span class=\"font-body-sm text-body-sm text-center\">\n      Change these anytime in your Jamaican device settings.\n    </span>\n</div>\n<!-- Sticky-styled Bottom CTAs -->\n<div class=\"flex flex-col gap-space-sm w-full mt-auto\">\n<button class=\"flex items-center justify-center w-full h-12 gap-space-xs rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm shadow-md active:scale-[0.98] transition-all\" id=\"btn-continue\" type=\"button\">\n<span>Continue</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<button class=\"flex items-center justify-center w-full h-12 rounded-xl text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface transition-colors\" id=\"btn-skip\" type=\"button\">\n      I'll configure later\n    </button>\n</div>\n<!-- Modal: Why We Ask (Hidden by default) -->\n<div class=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-margin bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300\" id=\"info-modal\">\n<div class=\"flex flex-col w-full max-w-sm p-space-lg rounded-2xl bg-surface-container-lowest text-on-surface shadow-2xl transition-transform duration-300 translate-y-8\" id=\"modal-card\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[24px]\">privacy_tip</span>\n<span class=\"font-headline-sm text-headline-sm\">Privacy Commitment</span>\n</div>\n<button class=\"p-2 rounded-full hover:bg-surface-container text-on-surface-variant\" id=\"close-modal\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">close</span>\n</button>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mb-space-md\">\n        Roam Plug operates with strict data minimization under the Jamaican Data Protection Act (JDPA). We never sell your telemetry, driving speed, or parish routes to third-party insurers.\n      </p>\n<div class=\"flex flex-col gap-space-xs mb-space-md\">\n<div class=\"flex items-start gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary mt-0.5\">check_circle</span>\n<span class=\"font-body-sm text-body-sm text-on-surface\">GPS is solely active during live station sorting</span>\n</div>\n<div class=\"flex items-start gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary mt-0.5\">check_circle</span>\n<span class=\"font-body-sm text-body-sm text-on-surface\">Photos stay strictly linked to verified motoring pins</span>\n</div>\n</div>\n<button class=\"flex items-center justify-center w-full h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg shadow-sm\" id=\"modal-acknowledge\" type=\"button\">\n        Got it, blessed\n      </button>\n</div>\n</div>\n</div>\n<script>\n  (function() {\n    const permissions = {\n      location: false,\n      camera: false,\n      notifications: false\n    };\n\n    function updateCardState(key, btnId, statusTextId, statusIconId, cardId) {\n      const btn = document.getElementById(btnId);\n      const label = btn.querySelector('.perm-btn-text');\n      const statusText = document.getElementById(statusTextId);\n      const statusIcon = document.getElementById(statusIconId);\n      const card = document.getElementById(cardId);\n\n      if (permissions[key]) {\n        btn.classList.remove('bg-primary', 'bg-secondary-fixed', 'text-on-primary', 'text-on-secondary-fixed');\n        btn.classList.add('bg-surface-container-high', 'text-primary');\n        label.innerHTML = '<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[18px]\">check</span> Allowed</span>';\n        statusText.textContent = \"Status: Permission Granted\";\n        statusIcon.textContent = \"verified\";\n        statusIcon.classList.add(\"text-primary\");\n        card.classList.add(\"shadow-lg\");\n      } else {\n        if (key === 'location') {\n          btn.classList.add('bg-primary', 'text-on-primary');\n        } else {\n          btn.classList.add('bg-secondary-fixed', 'text-on-secondary-fixed');\n        }\n        btn.classList.remove('bg-surface-container-high', 'text-primary');\n        label.textContent = \"Allow\";\n      }\n    }\n\n    document.getElementById('btn-perm-location')?.addEventListener('click', function() {\n      permissions.location = !permissions.location;\n      updateCardState('location', 'btn-perm-location', 'location-status-text', 'location-status-icon', 'card-location');\n    });\n\n    document.getElementById('btn-perm-camera')?.addEventListener('click', function() {\n      permissions.camera = !permissions.camera;\n      updateCardState('camera', 'btn-perm-camera', 'camera-status-text', 'camera-status-icon', 'card-camera');\n    });\n\n    document.getElementById('btn-perm-notifications')?.addEventListener('click', function() {\n      permissions.notifications = !permissions.notifications;\n      updateCardState('notifications', 'btn-perm-notifications', 'notifications-status-text', 'notifications-status-icon', 'card-notifications');\n    });\n\n    // Modal Interaction\n    const modal = document.getElementById('info-modal');\n    const modalCard = document.getElementById('modal-card');\n    const trigger = document.getElementById('info-modal-trigger');\n    const closeBtn = document.getElementById('close-modal');\n    const ackBtn = document.getElementById('modal-acknowledge');\n\n    function openModal() {\n      modal.classList.remove('opacity-0', 'pointer-events-none');\n      modalCard.classList.remove('translate-y-8');\n    }\n\n    function closeModal() {\n      modal.classList.add('opacity-0', 'pointer-events-none');\n      modalCard.classList.add('translate-y-8');\n    }\n\n    trigger?.addEventListener('click', openModal);\n    closeBtn?.addEventListener('click', closeModal);\n    ackBtn?.addEventListener('click', closeModal);\n    modal?.addEventListener('click', function(e) {\n      if (e.target === modal) closeModal();\n    });\n\n    // Action feedback\n    document.getElementById('btn-continue')?.addEventListener('click', function() {\n      const btn = this;\n      btn.innerHTML = '<span class=\"material-symbols-outlined text-[20px] animate-spin\">progress_activity</span><span>Preparing Road Map...</span>';\n      setTimeout(() => {\n        btn.innerHTML = '<span>Ready to Roam</span><span class=\"material-symbols-outlined text-[20px]\">check</span>';\n      }, 700);\n    });\n  })();\n</script></main></body></html>"}