"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe\"><div class=\"h-16 px-space-md flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><div class=\"w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-[0_4px_12px_rgba(163,57,0,0.25)]\"><span class=\"material-symbols-outlined text-[22px]\">local_gas_station</span></div><div class=\"flex flex-col\"><span class=\"font-label-sm text-label-sm text-primary tracking-wider uppercase\">Roam Plug</span><h1 class=\"font-headline-sm text-headline-sm text-on-surface leading-tight\">Explore</h1></div></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Parish Selection &amp; Alerts\" class=\"w-11 h-11 min-h-[44px] min-w-[44px] rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full pt-16 pb-28 bg-surface min-h-screen\"><div class=\"flex flex-col w-full relative\">\n<!-- Dimmed Background: Explore Map View Preview -->\n<div class=\"relative w-full h-80 overflow-hidden select-none pointer-events-none opacity-40 filter blur-[1.5px] -mb-16\">\n<div class=\"w-full h-96 bg-cover bg-center\" data-location=\"Half-Way-Tree, Kingston, Jamaica\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCTimA3LSXWy5I1Ur500kFzftnwLNzZqIyFOXDcHpOyqTlV85AqXRoi_3oTGpuUPwmIGGbcvPPudcOZoSQiXLCE9A1_l4zlk5Z__ADzE36lMf15f5Z-CJIpo_SggDV9FSLQKm4nbCMnC9qY_TkkP5ENCzI_GKh8oLlK2QQaBBfqhWgaEv_OigbIhoePuUzJA3uzcjTCsZn9mZsUrjnaG7F79xh_g10vhfl8e0CYoW0xBJ_EL2NHD21R')\"></div>\n<div class=\"absolute inset-0 bg-surface-container-highest/60 mix-blend-multiply\"></div>\n</div>\n<!-- Bottom Sheet Container (Modal presentation) -->\n<div class=\"relative z-20 flex flex-col w-full bg-surface-container-lowest rounded-t-3xl shadow-[0_-8px_30px_rgba(28,25,23,0.18)] transition-all duration-300 ease-out\">\n<!-- Drag Handle & Sticky Header Container -->\n<div class=\"sticky top-0 z-30 pt-3 pb-4 px-space-md bg-surface-container-lowest/95 backdrop-blur-md rounded-t-3xl border-none\">\n<!-- Drag Handle Pill -->\n<div class=\"flex justify-center mb-3\">\n<div class=\"w-11 h-1.5 rounded-full bg-surface-container-highest\"></div>\n</div>\n<!-- Sheet Title Row -->\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<div class=\"w-8 h-8 rounded-full bg-primary-fixed flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[20px]\">tune</span>\n</div>\n<h2 class=\"font-headline-md text-headline-md text-on-surface\">Filter &amp; Sort</h2>\n</div>\n<button class=\"h-10 px-3 rounded-full flex items-center justify-center text-primary active:bg-primary-fixed/40 transition-colors font-label-lg text-label-lg font-bold\" id=\"reset-filters-btn\">\n          Reset All\n        </button>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">\n        Personalize fuel stations and roadside amenities across Jamaica\n      </p>\n</div>\n<!-- Scrollable Sheet Content -->\n<div class=\"flex flex-col px-space-md space-y-6 pt-1 pb-4\">\n<!-- SECTION 1: SORT BY -->\n<div class=\"flex flex-col space-y-2.5\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Sort Stations By</span>\n<span class=\"font-label-sm text-label-sm text-primary font-bold\">3 Options</span>\n</div>\n<div class=\"grid grid-cols-3 gap-2\">\n<!-- Cheapest Price (Active) -->\n<button class=\"filter-sort-pill min-h-[48px] px-2.5 py-2 rounded-xl bg-primary text-on-primary font-label-md text-label-md flex flex-col items-center justify-center text-center shadow-sm active:scale-95 transition-all\" data-sort=\"cheapest\">\n<span class=\"material-symbols-outlined text-[18px] mb-0.5\">payments</span>\n<span class=\"leading-tight\">Cheapest Price</span>\n</button>\n<!-- Nearest Distance -->\n<button class=\"filter-sort-pill min-h-[48px] px-2.5 py-2 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md flex flex-col items-center justify-center text-center active:scale-95 transition-all\" data-sort=\"distance\">\n<span class=\"material-symbols-outlined text-[18px] mb-0.5 text-on-surface-variant\">near_me</span>\n<span class=\"leading-tight\">Nearest</span>\n</button>\n<!-- Recently Verified -->\n<button class=\"filter-sort-pill min-h-[48px] px-2.5 py-2 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md flex flex-col items-center justify-center text-center active:scale-95 transition-all\" data-sort=\"verified\">\n<span class=\"material-symbols-outlined text-[18px] mb-0.5 text-on-surface-variant\">verified</span>\n<span class=\"leading-tight\">Verified First</span>\n</button>\n</div>\n</div>\n<!-- SECTION 2: FUEL GRADE -->\n<div class=\"flex flex-col space-y-2.5\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Required Fuel Grade</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Tap to swap rate</span>\n</div>\n<div class=\"flex flex-col space-y-2\">\n<!-- E-10 87 (Active) -->\n<div class=\"fuel-grade-opt flex items-center justify-between p-3 rounded-2xl bg-surface-container-low active:bg-surface-container cursor-pointer transition-all shadow-sm\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-[#16a34a] text-on-primary flex items-center justify-center font-label-lg text-label-lg font-bold shadow-sm\">\n                87\n              </div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold leading-snug\">E-10 87 Octane</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Most common regular blend across Jamaica</span>\n</div>\n</div>\n<div class=\"w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n</div>\n<!-- E-10 90 -->\n<div class=\"fuel-grade-opt flex items-center justify-between p-3 rounded-2xl bg-surface-container-lowest active:bg-surface-container-low cursor-pointer transition-all\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-[#dc2626] text-on-primary flex items-center justify-center font-label-lg text-label-lg font-bold shadow-sm\">\n                90\n              </div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold leading-snug\">E-10 90 Octane</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">High-octane premium sports/turbo spec</span>\n</div>\n</div>\n<div class=\"w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center text-transparent\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n</div>\n<!-- Ultra Diesel (ULSD) -->\n<div class=\"fuel-grade-opt flex items-center justify-between p-3 rounded-2xl bg-surface-container-lowest active:bg-surface-container-low cursor-pointer transition-all\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-[#1C1917] text-on-primary flex items-center justify-center font-label-md text-label-md font-bold tracking-tight shadow-sm\">\n                ULSD\n              </div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold leading-snug\">Ultra Low Sulphur Diesel</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Commercial, taxis, &amp; pickup fleets</span>\n</div>\n</div>\n<div class=\"w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center text-transparent\">\n<span class=\"material-symbols-outlined text-[16px]\">check</span>\n</div>\n</div>\n</div>\n</div>\n<!-- SECTION 3: FUEL BRANDS IN JAMAICA -->\n<div class=\"flex flex-col space-y-2.5\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Stations &amp; Brands</span>\n<div class=\"flex items-center gap-3\">\n<button class=\"font-label-sm text-label-sm text-primary font-bold\">Select All</button>\n<span class=\"text-surface-container-highest text-xs\">•</span>\n<button class=\"font-label-sm text-label-sm text-on-surface-variant\">Clear</button>\n</div>\n</div>\n<!-- Multi-select pill chips -->\n<div class=\"flex flex-wrap gap-2\">\n<!-- TotalEnergies -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md flex items-center gap-2 active:scale-95 shadow-sm\">\n<span class=\"w-3 h-3 rounded-full bg-[#e11d48]\"></span>\n<span>TotalEnergies</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary ml-0.5\">check_circle</span>\n</button>\n<!-- Rubis -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md flex items-center gap-2 active:scale-95 shadow-sm\">\n<span class=\"w-3 h-3 rounded-full bg-[#0284c7]\"></span>\n<span>Rubis</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary ml-0.5\">check_circle</span>\n</button>\n<!-- Texaco -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md flex items-center gap-2 active:scale-95 shadow-sm\">\n<span class=\"w-3 h-3 rounded-full bg-[#dc2626]\"></span>\n<span>Texaco</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary ml-0.5\">check_circle</span>\n</button>\n<!-- Fesco (Local favorite highlight) -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-md text-label-md flex items-center gap-2 active:scale-95 shadow-sm\">\n<span class=\"w-3 h-3 rounded-full bg-secondary-container\"></span>\n<span class=\"font-bold\">Fesco</span>\n<span class=\"text-[10px] px-1.5 py-0.5 rounded-full bg-primary text-on-primary font-bold\">Yard Fav</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary ml-0.5\">check_circle</span>\n</button>\n<!-- Cool Oasis -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md flex items-center gap-2 active:scale-95 shadow-sm\">\n<span class=\"w-3 h-3 rounded-full bg-[#059669]\"></span>\n<span>Cool Oasis</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary ml-0.5\">check_circle</span>\n</button>\n<!-- Petcom -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md flex items-center gap-2 active:scale-95 shadow-sm\">\n<span class=\"w-3 h-3 rounded-full bg-[#d97706]\"></span>\n<span>Petcom</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary ml-0.5\">check_circle</span>\n</button>\n<!-- Other / Independent -->\n<button class=\"min-h-[44px] px-3.5 py-2 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md flex items-center gap-2 active:scale-95\">\n<span class=\"w-3 h-3 rounded-full bg-surface-container-highest\"></span>\n<span>Independents</span>\n</button>\n</div>\n</div>\n<!-- SECTION 4: MAXIMUM DISTANCE -->\n<div class=\"flex flex-col space-y-3 p-4 rounded-2xl bg-surface-container-low\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">explore</span>\n<span class=\"font-label-md text-label-md text-on-surface uppercase tracking-wider font-bold\">Search Radius</span>\n</div>\n<span class=\"font-headline-sm text-headline-sm text-primary font-bold\">Within 5 km</span>\n</div>\n<!-- Radius Pills -->\n<div class=\"grid grid-cols-4 gap-1.5\">\n<button class=\"min-h-[44px] rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md flex items-center justify-center font-semibold active:scale-95\">2 km</button>\n<button class=\"min-h-[44px] rounded-lg bg-primary text-on-primary font-label-md text-label-md flex items-center justify-center font-bold shadow-sm active:scale-95\">5 km</button>\n<button class=\"min-h-[44px] rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md flex items-center justify-center font-semibold active:scale-95\">10 km</button>\n<button class=\"min-h-[44px] rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md flex items-center justify-center font-semibold active:scale-95\">25 km</button>\n</div>\n<!-- Distance Range Slider Graphic -->\n<div class=\"relative w-full pt-3 pb-1\">\n<div class=\"w-full h-2 rounded-full bg-surface-container-highest relative flex items-center\">\n<div class=\"h-2 w-1/3 rounded-full bg-gradient-to-r from-primary to-secondary-container\"></div>\n<!-- Thumb -->\n<div class=\"absolute left-1/3 -ml-3.5 w-7 h-7 rounded-full bg-surface-container-lowest shadow-[0_2px_8px_rgba(0,0,0,0.2)] flex items-center justify-center cursor-pointer\">\n<div class=\"w-3.5 h-3.5 rounded-full bg-primary\"></div>\n</div>\n</div>\n<div class=\"flex justify-between items-center mt-2.5\">\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Around Half-Way-Tree &amp; St. Andrew</span>\n<button class=\"font-label-sm text-label-sm text-primary font-bold hover:underline\">All 14 Parishes</button>\n</div>\n</div>\n</div>\n<!-- SECTION 5: STATION AMENITIES -->\n<div class=\"flex flex-col space-y-2.5\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Station Amenities</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">3 Selected</span>\n</div>\n<div class=\"grid grid-cols-2 gap-2\">\n<!-- Air pump (Checked) -->\n<button class=\"min-h-[48px] px-3 py-2.5 rounded-xl bg-surface-container-low text-on-surface font-label-md text-label-md flex items-center justify-between active:scale-95 transition-all shadow-sm\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[20px] text-primary\">tire_repai