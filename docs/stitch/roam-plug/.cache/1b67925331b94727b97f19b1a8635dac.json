{"filename":"48-tolls.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100%;margin:0;padding:0;background-color:#fff8f2;}body{overscroll-behavior-y:none;-webkit-tap-highlight-color:transparent;font-family:'Inter',sans-serif;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config={darkMode:\"class\",theme:{extend:{colors:{\"on-tertiary-fixed\":\"#251a00\",\"tertiary\":\"#755800\",\"primary-container\":\"#cc4900\",\"on-background\":\"#1e1b17\",\"surface-container-lowest\":\"#ffffff\",\"inverse-on-surface\":\"#f7efe9\",\"secondary\":\"#9d4300\",\"on-surface-variant\":\"#5a4138\",\"on-surface\":\"#1e1b17\",\"on-primary-fixed-variant\":\"#7f2b00\",\"error\":\"#ba1a1a\",\"primary-fixed\":\"#ffdbce\",\"background\":\"#fff8f2\",\"error-container\":\"#ffdad6\",\"on-primary\":\"#ffffff\",\"surface-container-highest\":\"#e8e1db\",\"surface-dim\":\"#e0d9d2\",\"primary-fixed-dim\":\"#ffb599\",\"surface-container-low\":\"#faf2eb\",\"on-secondary-fixed\":\"#341100\",\"primary\":\"#a33900\",\"on-secondary-container\":\"#5c2400\",\"on-tertiary-fixed-variant\":\"#5a4300\",\"on-tertiary\":\"#ffffff\",\"on-secondary-fixed-variant\":\"#783200\",\"on-error-container\":\"#93000a\",\"on-error\":\"#ffffff\",\"surface\":\"#fff8f2\",\"surface-container\":\"#f4ede6\",\"inverse-surface\":\"#33302c\",\"tertiary-container\":\"#936f00\",\"outline-variant\":\"#e2bfb2\",\"surface-tint\":\"#a73a00\",\"on-tertiary-container\":\"#fffbff\",\"tertiary-fixed-dim\":\"#f7be1d\",\"surface-container-high\":\"#eee7e0\",\"on-secondary\":\"#ffffff\",\"secondary-fixed\":\"#ffdbca\",\"tertiary-fixed\":\"#ffdf9a\",\"on-primary-fixed\":\"#370e00\",\"surface-bright\":\"#fff8f2\",\"inverse-primary\":\"#ffb599\",\"on-primary-container\":\"#fffbff\",\"secondary-fixed-dim\":\"#ffb690\",\"surface-variant\":\"#e8e1db\",\"secondary-container\":\"#fd761a\",\"outline\":\"#8e7166\"},borderRadius:{DEFAULT:\"0.25rem\",lg:\"0.5rem\",xl:\"0.75rem\",full:\"9999px\"},spacing:{\"gutter\":\"1rem\",\"margin\":\"1rem\",\"margin-lg\":\"1.5rem\",\"space-xl\":\"2rem\",\"space-md\":\"1rem\",\"space-lg\":\"1.5rem\",\"gutter-sm\":\"0.75rem\",\"space-xs\":\"0.25rem\",\"space-sm\":\"0.5rem\"},fontFamily:{\"display-lg-mobile\":[\"Inter\"],\"label-sm\":[\"Inter\"],\"body-md\":[\"Inter\"],\"label-lg\":[\"Inter\"],\"label-md\":[\"Inter\"],\"headline-md\":[\"Inter\"],\"display-lg\":[\"Inter\"],\"body-lg\":[\"Inter\"],\"body-sm\":[\"Inter\"],\"price-display\":[\"Inter\"],\"headline-lg\":[\"Inter\"],\"headline-sm\":[\"Inter\"]},fontSize:{\"display-lg-mobile\":[\"32px\",{lineHeight:\"40px\",letterSpacing:\"-0.02em\",fontWeight:\"800\"}],\"label-sm\":[\"10px\",{lineHeight:\"12px\",letterSpacing:\"0.04em\",fontWeight:\"700\"}],\"body-md\":[\"14px\",{lineHeight:\"20px\",fontWeight:\"400\"}],\"label-lg\":[\"14px\",{lineHeight:\"20px\",letterSpacing:\"0.01em\",fontWeight:\"600\"}],\"label-md\":[\"12px\",{lineHeight:\"16px\",letterSpacing:\"0.02em\",fontWeight:\"600\"}],\"headline-md\":[\"22px\",{lineHeight:\"28px\",letterSpacing:\"-0.01em\",fontWeight:\"700\"}],\"display-lg\":[\"40px\",{lineHeight:\"48px\",letterSpacing:\"-0.02em\",fontWeight:\"800\"}],\"body-lg\":[\"16px\",{lineHeight:\"24px\",fontWeight:\"400\"}],\"body-sm\":[\"12px\",{lineHeight:\"16px\",fontWeight:\"400\"}],\"price-display\":[\"24px\",{lineHeight:\"28px\",letterSpacing:\"-0.01em\",fontWeight:\"700\"}],\"headline-lg\":[\"28px\",{lineHeight:\"36px\",letterSpacing:\"-0.01em\",fontWeight:\"700\"}],\"headline-sm\":[\"18px\",{lineHeight:\"24px\",fontWeight:\"600\"}]}}}};</script><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between\"><div class=\"flex items-center gap-space-sm min-w-0 pr-space-sm\"><button aria-label=\"Go back\" class=\"w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-full text-on-surface hover:bg-surface-container active:bg-surface-container-high transition-colors\" onclick=\"history.back()\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><h1 class=\"font-headline-sm text-headline-sm text-on-surface tracking-tight truncate\">Highway Tolls</h1></div><div class=\"flex items-center gap-space-xs flex-shrink-0\"><button aria-label=\"Toll Rates &amp; Info\" class=\"w-12 h-12 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container active:bg-surface-container-high transition-colors\" type=\"button\"><span class=\"material-symbols-outlined text-[22px]\">info</span></button></div></div></header><main class=\"flex flex-col relative w-full pt-16 bg-surface min-h-screen pb-safe\"><div class=\"flex flex-col w-full pb-28\">\n<!-- Top Context / Status Strip -->\n<div class=\"px-gutter pt-space-md flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between flex-wrap gap-space-xs\">\n<span class=\"inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-md text-label-md font-semibold\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\">toll</span>\n        Official Rates • Highway 2000\n      </span>\n<div class=\"flex items-center gap-1 text-secondary font-label-sm text-label-sm font-semibold\">\n<span class=\"material-symbols-outlined text-[15px]\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n<span>Gazetted 1 Nov 2024</span>\n</div>\n</div>\n<!-- Banner Info -->\n<div class=\"bg-surface-container-low rounded-xl p-space-md flex items-start gap-space-sm shadow-sm\">\n<span class=\"material-symbols-outlined text-secondary text-[22px] mt-0.5 flex-shrink-0\">info</span>\n<div class=\"flex flex-col\">\n<p class=\"font-body-md text-body-md text-on-surface\">\n<strong class=\"font-semibold text-on-surface\">T-Tag, Card &amp; Cash lanes open 24/7.</strong> Exact Jamaican dollar change substantially reduces queue times at toll booths.\n        </p>\n</div>\n</div>\n<!-- Active Vehicle Link Chip -->\n<div class=\"flex items-center justify-between px-space-md py-space-sm rounded-xl bg-surface-container shadow-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">directions_car</span>\n<span class=\"font-label-md text-label-md text-on-surface truncate\">Linked Garage Vehicle: <strong>2019 Toyota Roomy (Class 1)</strong></span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase px-2 py-0.5 rounded bg-surface-container-lowest text-primary font-bold\">Auto-Set</span>\n</div>\n</div>\n<!-- Vehicle Class Selector -->\n<div class=\"px-gutter mt-space-lg flex flex-col gap-space-sm\">\n<div class=\"flex items-center justify-between\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Select Vehicle Class</h2>\n<button class=\"font-label-md text-label-md text-primary font-semibold flex items-center gap-1\" onclick=\"alert('Class 1: Height &lt; 1.7m or Length &lt; 5.5m\\nClass 2: Height &gt; 1.7m or Length 5.5m - 7m\\nClass 3: Length &gt; 7m, 3+ axles')\" type=\"button\">\n<span>Class Specs</span>\n<span class=\"material-symbols-outlined text-[16px]\">help</span>\n</button>\n</div>\n<!-- 3-Segmented Class Cards -->\n<div class=\"grid grid-cols-3 gap-space-xs\" id=\"vehicle-class-grid\">\n<!-- Class 1 (Active) -->\n<button class=\"flex flex-col items-start p-space-sm rounded-xl bg-primary text-on-primary shadow-md transition-all text-left\" id=\"class-btn-1\" onclick=\"selectClass(1)\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"material-symbols-outlined text-[20px]\">directions_car</span>\n<span class=\"w-2 h-2 rounded-full bg-white\"></span>\n</div>\n<span class=\"font-headline-sm text-headline-sm mt-1 leading-tight\">Class 1</span>\n<span class=\"font-label-sm text-label-sm opacity-90 line-clamp-2 mt-0.5\">Cars, Minivans, Small Pickups</span>\n</button>\n<!-- Class 2 -->\n<button class=\"flex flex-col items-start p-space-sm rounded-xl bg-surface-container-low text-on-surface hover:bg-surface-container transition-all text-left shadow-sm\" id=\"class-btn-2\" onclick=\"selectClass(2)\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"material-symbols-outlined text-[20px] text-on-surface-variant\">airport_shuttle</span>\n<span class=\"w-2 h-2 rounded-full bg-transparent\"></span>\n</div>\n<span class=\"font-headline-sm text-headline-sm mt-1 leading-tight\">Class 2</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant line-clamp-2 mt-0.5\">SUVs &gt; 1.7m, Light Trucks</span>\n</button>\n<!-- Class 3 -->\n<button class=\"flex flex-col items-start p-space-sm rounded-xl bg-surface-container-low text-on-surface hover:bg-surface-container transition-all text-left shadow-sm\" id=\"class-btn-3\" onclick=\"selectClass(3)\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"material-symbols-outlined text-[20px] text-on-surface-variant\">local_shipping</span>\n<span class=\"w-2 h-2 rounded-full bg-transparent\"></span>\n</div>\n<span class=\"font-headline-sm text-headline-sm mt-1 leading-tight\">Class 3</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant line-clamp-2 mt-0.5\">Heavy Trucks, Large Buses</span>\n</button>\n</div>\n</div>\n<!-- Route Cost Calculator Hero Card -->\n<div class=\"px-gutter mt-space-lg\">\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-md flex flex-col gap-space-md\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[24px]\" style=\"font-variation-settings: 'FILL' 1;\">calculate</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Route Toll Calculator</h2>\n</div>\n<span class=\"font-label-md text-label-md px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-semibold\">T1 • T2 Corridors</span>\n</div>\n<!-- From / To inputs -->\n<div class=\"flex flex-col gap-space-sm relative\">\n<!-- From field -->\n<div class=\"flex items-center gap-space-sm bg-surface-container-low px-space-md py-space-sm rounded-xl\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">trip_origin</span>\n<div class=\"flex flex-col flex-1 min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Starting Interchange</span>\n<select class=\"bg-transparent font-label-lg text-label-lg text-on-surface font-semibold focus:outline-none appearance-none pr-4 cursor-pointer\" id=\"origin-select\" onchange=\"recalculateRoute()\">\n<option value=\"may_pen\">May Pen (Clarendon Interchange)</option>\n<option value=\"freetown\">Freetown / Sandy Bay</option>\n<option value=\"old_harbour\">Old Harbour Ramp</option>\n<option value=\"spanish_town\">Spanish Town Plaza</option>\n<option value=\"portmore\">Portmore Causeway</option>\n<option value=\"caymanas\">Caymanas Interchange</option>\n<option value=\"mammee_bay\">Mammee Bay (Ocho Rios)</option>\n</select>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[20px] pointer-events-none\">expand_more</span>\n</div>\n<!-- Reverse Button Floating between -->\n<button aria-label=\"Swap Route Endpoints\" class=\"absolute right-4 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-lg hover:scale-105 active:scale-95 transition-transform z-10\" onclick=\"swapRoute()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">swap_vert</span>\n</button>\n<!-- To field -->\n<div class=\"flex items-center gap-space-sm bg-surface-container-low px-space-md py-space-sm rounded-xl\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">location_on</span>\n<div class=\"flex flex-col flex-1 min-w-0\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Destination Interchange</span>\n<select class=\"bg-transparent font-label-lg text-label-lg text-on-surface font-semibold focus:outline-none appearance-none pr-4 cursor-pointer\" id=\"dest-select\" onchange=\"recalculateRoute()\">\n<option selected=\"\" value=\"mandela\">Kingston / Mandela Highway</option>\n<option value=\"may_pen\">May Pen (Clarendon)</option>\n<option value=\"spanish_town\">Spanish Town</option>\n<option value=\"portmore\">Marcus Garvey / Portmore</option>\n<option value=\"mammee_bay\">Mammee Bay (Ocho Rios)</option>\n</select>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[20px] pointer-events-none\">expand_more</span>\n</div>\n</div>\n<!-- Corridor Transit Breadcrumb -->\n<div class=\"flex items-center gap-1.5 py-1 px-space-sm rounded-lg bg-surface-container text-on-surface-variant font-label-sm text-label-sm overflow-x-auto whitespace-nowrap\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">route</span>\n<span class=\"font-semibold text-on-surface\">Route Waypoints:</span>\n<span id=\"route-path-text\">May Pen → Freetown → Vineyards Plaza → Mandela</span>\n</div>\n<!-- Calculation Result Hero Box -->\n<div class=\"bg-primary text-on-primary rounded-xl p-space-md flex flex-col gap-space-sm shadow-md relative overflow-hidden\">\n<!-- Sunbeam decorative angle -->\n<div class=\"absolute -right-12 -top-12 w-32 h-32 rounded-full bg-white/10 blur-xl pointer-events-none\"></div>\n<div class=\"flex items-baseline justify-between\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-md text-label-md uppercase tracking-wider text-primary-fixed-dim font-bold\">Estimated One-Way Toll</span>\n<div class=\"flex items-baseline gap-1 mt-0.5\">\n<span class=\"font-display-lg-mobile text-display-lg-mobile font-extrabold\" id=\"calc-single-rate\">J$ 720</span>\n<span class=\"font-label-sm text-label-sm opacity-90\">JMD</span>\n</div>\n</div>\n<div class=\"text-right flex flex-col items-end\">\n<span class=\"font-label-sm text-label-sm text-primary-fixed-dim uppercase tracking-wider font-semibold\">Round Trip</span>\n<span class=\"font-headline-sm text-headline-sm font-bold\" id=\"calc-round-rate\">J$ 1,440</span>\n</div>\n</div>\n<div class=\"pt-space-xs flex items-center justify-between text-on-primary\">\n<div class=\"flex items-center gap-1 font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[18px]\">timer</span>\n<span id=\"calc-time-saved font-semibold\">Saves ~45 mins vs Old Road</span>\n</div>\n<div class=\"flex items-center gap-1 font-label-md text-label-md opacity-90\">\n<span class=\"material-symbols-outlined text-[18px]\">speed</span>\n<span>34.2 km Bypass</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Corridor 1: Highway 2000 East-West (T1) -->\n<div class=\"px-gutter mt-space-xl flex flex-col gap-space-md\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-2\">\n<span class=\"w-3 h-3 rounded-full bg-primary\"></span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Highway 2000 East-West</h2>\n</div>\n<p class=\"font-label-md text-label-md text-on-surface-variant\">T1 Corridor • Kingston to May Pen &amp; Mandeville</p>\n</div>\n<span class=\"font-label-sm text-label-sm font-bold px-2 py-1 rounded bg-surface-container-high text-on-surface\">4 Plazas</span>\n</div>\n<!-- Plaza List -->\n<div class=\"flex flex-col gap-space-sm\">\n<!-- Plaza 1 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Vineyards Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-primary font-bold\" data-toll=\"vineyards\">J$ 650</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[16px] text-secondary\">sync_alt</span> Eastbound &amp; Westbound</span>\n<span>•</span>\n<span class=\"text-primary font-semibold\">24/7 T-Tag Lanes</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Between Old Harbour &amp; Spanish Town trunk. Heavy morning commuter route.</p>\n</div>\n<!-- Plaza 2 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Spanish Town Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-primary font-bold\" data-toll=\"spanish_town\">J$ 260</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[16px] text-secondary\">call_merge</span> Off-ramp / On-ramp</span>\n<span>•</span>\n<span>Dual Lanes</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Mandela Highway connection. Smooth automated tags available.</p>\n</div>\n<!-- Plaza 3 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">May Pen Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-primary font-bold\" data-toll=\"may_pen\">J$ 340</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[16px] text-secondary\">swap_horiz</span> Eastbound / Westbound</span>\n<span>•</span>\n<span>Cash &amp; Card</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Rio Cobre &amp; Clarendon transit gate. Quick clearance during midday.</p>\n</div>\n<!-- Plaza 4 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Portmore Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-primary font-bold\" data-toll=\"portmore\">J$ 380</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span class=\"flex items-center gap-1\"><span class=\"material-symbols-outlined text-[16px] text-secondary\">video_file</span> Portmore Causeway</span>\n<span>•</span>\n<span class=\"text-error font-semibold\">Peak Delay ~15m</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Direct link to Marcus Garvey Drive &amp; Downtown Kingston waterfront.</p>\n</div>\n</div>\n</div>\n<!-- Corridor 2: Highway 2000 North-South (Edward Seaga Highway) -->\n<div class=\"px-gutter mt-space-xl flex flex-col gap-space-md\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-2\">\n<span class=\"w-3 h-3 rounded-full bg-secondary\"></span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\">Edward Seaga Highway</h2>\n</div>\n<p class=\"font-label-md text-label-md text-on-surface-variant\">Highway 2000 North-South • Caymanas to Mammee Bay</p>\n</div>\n<span class=\"font-label-sm text-label-sm font-bold px-2 py-1 rounded bg-surface-container-high text-on-surface\">4 Plazas</span>\n</div>\n<!-- Plaza List -->\n<div class=\"flex flex-col gap-space-sm\">\n<!-- North-South 1 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Caymanas Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-secondary font-bold\" data-toll=\"caymanas\">J$ 310</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span>Southbound Entry / Exit</span>\n<span>•</span>\n<span>Mandela Bypass</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Southern gateway joining St. Catherine to the North Coast corridor.</p>\n</div>\n<!-- North-South 2 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Unity Valley Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-secondary font-bold\" data-toll=\"unity_valley\">J$ 1,050</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span>Main Trunk through Moneague</span>\n<span>•</span>\n<span>High Elevation</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Bypasses Mount Rosser &amp; Faith’s Pen. Steep gradients; monitor engine temp.</p>\n</div>\n<!-- North-South 3 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Lydford Toll Plaza</h3>\n</div>\n<span class=\"font-price-display text-price-display text-secondary font-bold\" data-toll=\"lydford\">J$ 680</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span>Golden Grove Interchange</span>\n<span>•</span>\n<span>Northbound / Southbound</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Turn-off for Walkers Wood, Fern Gully &amp; St. Ann inland routes.</p>\n</div>\n<!-- North-South 4 -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">toll</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Mammee Bay (Ocho Rios)</h3>\n</div>\n<span class=\"font-price-display text-price-display text-secondary font-bold\" data-toll=\"mammee_bay\">J$ 1,450</span>\n</div>\n<div class=\"flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md\">\n<span>Northern Coastal Terminal</span>\n<span>•</span>\n<span class=\"text-secondary font-semibold\">Full Caymanas Run: J$ 2,850</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Direct express access to North Coast Highway A1 towards Ocho Rios &amp; Montego Bay.</p>\n</div>\n</div>\n</div>\n<!-- Motorist Perks & Emergency Tips Card -->\n<div class=\"px-gutter mt-space-xl flex flex-col gap-space-sm\">\n<!-- T-Tag transponder promo -->\n<div class=\"bg-surface-container-low rounded-xl p-space-md shadow-sm flex items-start gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center flex-shrink-0 text-primary\">\n<span class=\"material-symbols-outlined text-[22px]\">contactless</span>\n</div>\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-2\">\n<h3 class=\"font-label-lg text-label-lg font-bold text-on-surface\">T-Tag Transponder Discount</h3>\n<span class=\"px-1.5 py-0.5 rounded text-[10px] font-bold bg-secondary-fixed text-on-secondary-fixed\">SAVE 10%</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">\n          Save 10% on frequent commutes with registered TransJamaica T-Tag or South Coast Tag. Direct Roam Plug account balance sync coming in the next update.\n        </p>\n</div>\n</div>\n<!-- Highway Emergency Towing Banner -->\n<div class=\"bg-surface-container-highest rounded-xl p-space-md shadow-sm flex items-center justify-between gap-space-sm\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<span class=\"material-symbols-outlined text-error text-[26px] flex-shrink-0\">emergency</span>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-lg text-label-lg font-bold text-on-surface truncate\">Highway 2000 Free Assistance</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Free breakdown towing to the nearest safe exit</span>\n</div>\n</div>\n<a class=\"flex-shrink-0 flex items-center gap-1 px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md font-bold shadow-sm active:scale-95 transition-transform\" href=\"tel:8884292000\">\n<span class=\"material-symbols-outlined text-[18px] text-error\">call</span>\n<span>888-429-2000</span>\n</a>\n</div>\n</div>\n<!-- Sticky Bottom Action Bar -->\n<div class=\"fixed bottom-0 left-0 right-0 z-40 bg-surface/90 backdrop-blur-xl px-gutter py-space-sm shadow-xl flex items-center gap-space-sm\">\n<button class=\"flex-1 h-12 rounded-xl bg-surface-container text-on-surface font-label-lg text-label-lg font-semibold flex items-center justify-center gap-1.5 shadow-sm active:bg-surface-container-high transition-colors\" onclick=\"alert('Downloading official Toll Authority Gazette rate schedule (PDF)...')\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px] text-on-surface-variant\">download</span>\n<span class=\"truncate\">Rate Sheet (PDF)</span>\n</button>\n<button class=\"flex-1 h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-1.5 shadow-md active:bg-primary-container transition-colors\" onclick=\"alert('Added J$ 720 toll fee to your current trip fuel &amp; transit calculation!')\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">add_road</span>\n<span class=\"truncate\">Add Toll to Fuel Plan</span>\n</button>\n</div>\n</div>\n<script>\n  let activeClass = 1;\n\n  // Rate Matrix by Vehicle Class\n  const tollRates = {\n    1: {\n      vineyards: 650,\n      spanish_town: 260,\n      may_pen: 340,\n      portmore: 380,\n      caymanas: 310,\n      unity_valley: 1050,\n      lydford: 680,\n      mammee_bay: 1450,\n      calcOneWay: 720,\n      calcRound: 1440\n    },\n    2: {\n      vineyards: 1100,\n      spanish_town: 450,\n      may_pen: 580,\n      portmore: 650,\n      caymanas: 520,\n      unity_valley: 1800,\n      lydford: 1150,\n      mammee_bay: 2450,\n      calcOneWay: 1220,\n      calcRound: 2440\n    },\n    3: {\n      vineyards: 1950,\n      spanish_town: 780,\n      may_pen: 1020,\n      portmore: 1150,\n      caymanas: 940,\n      unity_valley: 3100,\n      lydford: 1980,\n      mammee_bay: 4200,\n      calcOneWay: 2150,\n      calcRound: 4300\n    }\n  };\n\n  function selectClass(classNumber) {\n    activeClass = classNumber;\n\n    // Reset button states\n    for (let i = 1; i <= 3; i++) {\n      const btn = document.getElementById('class-btn-' + i);\n      const dot = btn.querySelector('span:last-child');\n      const icon = btn.querySelector('.material-symbols-outlined');\n\n      if (i === classNumber) {\n        btn.className = \"flex flex-col items-start p-space-sm rounded-xl bg-primary text-on-primary shadow-md transition-all text-left\";\n        if (dot) dot.className = \"w-2 h-2 rounded-full bg-white\";\n        if (icon) icon.className = \"material-symbols-outlined text-[20px] text-on-primary\";\n      } else {\n        btn.className = \"flex flex-col items-start p-space-sm rounded-xl bg-surface-container-low text-on-surface hover:bg-surface-container transition-all text-left shadow-sm\";\n        if (dot) dot.className = \"w-2 h-2 rounded-full bg-transparent\";\n        if (icon) icon.className = \"material-symbols-outlined text-[20px] text-on-surface-variant\";\n      }\n    }\n\n    // Update individual toll cards on screen\n    const rates = tollRates[classNumber];\n    for (const [key, value] of Object.entries(rates)) {\n      const el = document.querySelector(`[data-toll=\"${key}\"]`);\n      if (el) {\n        el.textContent = `J$ ${value.toLocaleString()}`;\n      }\n    }\n\n    recalculateRoute();\n  }\n\n  function swapRoute() {\n    const origin = document.getElementById('origin-select');\n    const dest = document.getElementById('dest-select');\n    const temp = origin.value;\n    origin.value = dest.value;\n    dest.value = temp;\n    recalculateRoute();\n  }\n\n  function recalculateRoute() {\n    const rates = tollRates[activeClass];\n    const origin = document.getElementById('origin-select').value;\n    const dest = document.getElementById('dest-select').value;\n    const pathText = document.getElementById('route-path-text');\n\n    let multiplier = 1;\n    if (origin === 'mammee_bay' || dest === 'mammee_bay') {\n      multiplier = 2.8;\n      pathText.textContent = \"Caymanas \\u2192 Unity Valley \\u2192 Lydford \\u2192 Mammee Bay\";\n    } else if (origin === 'portmore' || dest === 'portmore') {\n      multiplier = 0.55;\n      pathText.textContent = \"Portmore Causeway \\u2192 Marcus Garvey Drive\";\n    } else {\n      multiplier = 1;\n      pathText.textContent = \"May Pen \\u2192 Freetown \\u2192 Vineyards Plaza \\u2192 Mandela\";\n    }\n\n    const calculatedSingle = Math.round(rates.calcOneWay * multiplier);\n    const calculatedRound = calculatedSingle * 2;\n\n    document.getElementById('calc-single-rate').textContent = `J$ ${calculatedSingle.toLocaleString()}`;\n    document.getElementById('calc-round-rate').textContent = `J$ ${calculatedRound.toLocaleString()}`;\n  }\n</script></main></body></html>"}