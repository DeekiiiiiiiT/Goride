{"filename":"56-gps-issue.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"error\": \"#ba1a1a\", \"error-container\": \"#ffdad6\", \"surface-bright\": \"#fff8f2\", \"primary-fixed-dim\": \"#ffb599\", \"surface-container-highest\": \"#e8e1db\", \"on-secondary-fixed\": \"#341100\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-container\": \"#936f00\", \"inverse-surface\": \"#33302c\", \"on-secondary-container\": \"#5c2400\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary\": \"#755800\", \"on-error-container\": \"#93000a\", \"on-tertiary\": \"#ffffff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface-container-lowest\": \"#ffffff\", \"background\": \"#fff8f2\", \"on-surface-variant\": \"#5a4138\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-low\": \"#faf2eb\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"outline\": \"#8e7166\", \"on-primary-container\": \"#fffbff\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container\": \"#f4ede6\", \"surface-variant\": \"#e8e1db\", \"on-primary-fixed\": \"#370e00\", \"on-secondary\": \"#ffffff\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary\": \"#9d4300\", \"surface-container-high\": \"#eee7e0\", \"primary-container\": \"#cc4900\", \"on-tertiary-container\": \"#fffbff\", \"primary\": \"#a33900\", \"on-background\": \"#1e1b17\", \"secondary-fixed\": \"#ffdbca\", \"outline-variant\": \"#e2bfb2\", \"surface\": \"#fff8f2\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"margin-lg\": \"1.5rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"margin\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"gutter\": \"1rem\" }, \"fontFamily\": { \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, \"fontSize\": { \"price-display\": [\"24px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</script><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen pt-safe pb-safe\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full relative overflow-hidden select-none\">\n<!-- Dimmed Map Canvas Backdrop -->\n<div class=\"relative w-full h-80 overflow-hidden\">\n<div class=\"w-full h-full bg-cover bg-center filter blur-[2px] brightness-[0.72] scale-105 transition-transform duration-700\" data-location=\"Kingston, Jamaica\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC7cgJkoiDjsDFoO6mvtjHK0Kiic3Jgzsbc09u5d0iBGjg3iqCp3mKxcaRGbEcpNEwLwePTVdflplbFYrC0q1QOzmBLQ77PALAewO5i3FxG1xj6stUGB83E9TuC8AaIO8hLjzHAz8aoM-xpf1WspsbAHAXSww3Sr_GM1RS0WCYit32_-ZYFBOlqxgYBgCd3Uq9CoStUpWysCFS1-unwNt3RoPtkQc7eOlgJTNx1Xguy5EKtggBfgN7b')\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-b from-inverse-surface/40 via-surface/70 to-surface\"></div>\n<!-- Top Bar Controls -->\n<div class=\"absolute top-0 left-0 right-0 p-margin flex items-center justify-between z-10\">\n<div class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-md shadow-sm\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-error animate-ping\"></span>\n<span class=\"w-2.5 h-2.5 rounded-full bg-error -ml-4\"></span>\n<span class=\"font-label-sm text-on-surface uppercase tracking-wider\">No GPS Fix</span>\n</div>\n<button aria-label=\"Dismiss issue sheet\" class=\"w-10 h-10 rounded-full bg-surface-container-lowest/90 text-on-surface flex items-center justify-center shadow-sm active:scale-95 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">close</span>\n</button>\n</div>\n<!-- Pulsing Radar / Warning Glyph Over Map -->\n<div class=\"absolute inset-0 flex items-center justify-center pointer-events-none pb-8\">\n<div class=\"relative flex items-center justify-center\">\n<div class=\"absolute w-28 h-28 rounded-full bg-secondary-container/20 animate-ping duration-1000\"></div>\n<div class=\"absolute w-20 h-20 rounded-full bg-primary/15 animate-pulse\"></div>\n<div class=\"relative w-16 h-16 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-lg shadow-primary/30\">\n<span class=\"material-symbols-outlined text-[32px]\">location_off</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Sheet Card Structure -->\n<div class=\"-mt-10 px-margin pb-margin-lg flex flex-col z-20\">\n<div class=\"w-full bg-surface-container-lowest rounded-xl shadow-xl shadow-inverse-surface/5 p-margin-lg flex flex-col gap-space-md\">\n<!-- Headline & Context -->\n<div class=\"flex flex-col gap-1 text-center items-center\">\n<div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-error-container text-on-error-container mb-1\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">warning</span>\n<span class=\"font-label-sm uppercase tracking-wide\">Telemetry Paused</span>\n</div>\n<h1 class=\"font-headline-md text-on-surface\">We can't find your location</h1>\n<p class=\"font-body-md text-on-surface-variant max-w-sm mt-1 leading-snug\">\n          Roam Plug needs your GPS location to verify nearby gas station prices and let you pin local motoring spots across Jamaica.\n        </p>\n</div>\n<!-- Real-Time Diagnostic Strip -->\n<div class=\"w-full bg-surface-container-low rounded-lg p-space-sm flex items-center justify-between px-3\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-secondary text-[18px]\">satellite_alt</span>\n<span class=\"font-label-md text-on-surface-variant\">Lock: 0/12</span>\n</div>\n<div class=\"w-1 h-1 rounded-full bg-outline-variant\"></div>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary-container\"></span>\n<span class=\"font-label-md text-on-surface-variant\">Mode: Standby</span>\n</div>\n<div class=\"w-1 h-1 rounded-full bg-outline-variant\"></div>\n<div class=\"flex items-center gap-1 text-error\">\n<span class=\"material-symbols-outlined text-[16px]\">signal_cellular_off</span>\n<span class=\"font-label-md font-semibold\">Unavailable</span>\n</div>\n</div>\n<!-- Actionable Checklist Cards -->\n<div class=\"flex flex-col gap-2.5\">\n<!-- Step 1 -->\n<div class=\"w-full bg-surface-container rounded-lg p-3.5 flex items-start gap-3 transition-colors active:bg-surface-container-high\">\n<div class=\"w-9 h-9 rounded-full bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center flex-shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[20px]\">my_location</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-sm bg-surface-container-highest text-on-surface-variant px-1.5 py-0.5 rounded-full\">Step 1</span>\n<h2 class=\"font-label-lg text-on-surface truncate\">Turn on location services</h2>\n</div>\n<p class=\"font-body-sm text-on-surface-variant mt-0.5\">\n              Ensure Location / GPS is toggled ON in your phone's quick settings.\n            </p>\n</div>\n</div>\n<!-- Step 2 -->\n<div class=\"w-full bg-surface-container rounded-lg p-3.5 flex items-start gap-3 transition-colors active:bg-surface-container-high\">\n<div class=\"w-9 h-9 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center flex-shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[20px]\">security</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-sm bg-surface-container-highest text-on-surface-variant px-1.5 py-0.5 rounded-full\">Step 2</span>\n<h2 class=\"font-label-lg text-on-surface truncate\">Allow Roam Plug permissions</h2>\n</div>\n<p class=\"font-body-sm text-on-surface-variant mt-0.5\">\n              Set location permission to “While Using App” or “Always” in settings.\n            </p>\n</div>\n</div>\n<!-- Step 3 -->\n<div class=\"w-full bg-surface-container rounded-lg p-3.5 flex items-start gap-3 transition-colors active:bg-surface-container-high\">\n<div class=\"w-9 h-9 rounded-full bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center flex-shrink-0 mt-0.5\">\n<span class=\"material-symbols-outlined text-[20px]\">explore</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-sm bg-surface-container-highest text-on-surface-variant px-1.5 py-0.5 rounded-full\">Step 3</span>\n<h2 class=\"font-label-lg text-on-surface truncate\">Clear concrete obstructions</h2>\n</div>\n<p class=\"font-body-sm text-on-surface-variant mt-0.5\">\n              Tall buildings, dense concrete car parks, or hills can block satellite reception.\n            </p>\n</div>\n</div>\n</div>\n<!-- Action Buttons -->\n<div class=\"flex flex-col gap-2.5 mt-2\">\n<button class=\"w-full min-h-[48px] bg-primary text-on-primary rounded-xl font-label-lg flex items-center justify-center gap-2 shadow-md shadow-primary/25 active:bg-on-primary-fixed-variant transition-all\" id=\"btn-settings\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">settings</span>\n<span>Open Settings</span>\n</button>\n<button class=\"w-full min-h-[48px] bg-surface-container-high text-on-surface rounded-xl font-label-lg flex items-center justify-center gap-2 active:bg-surface-dim transition-all\" id=\"btn-retry\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px] transition-transform\" id=\"retry-icon\">sync</span>\n<span id=\"retry-text\">Retry GPS Lock</span>\n</button>\n<button class=\"w-full py-2.5 text-center font-label-md text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center gap-1.5\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">cloud_off</span>\n<span>Continue in Offline Mode (Map &amp; Cached Data)</span>\n</button>\n</div>\n<!-- Local Support Footer -->\n<div class=\"w-full bg-surface-container-low rounded-lg p-3 flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary\">local_gas_station</span>\n</div>\n<span class=\"font-body-sm text-on-surface-variant\">Last known parish: <strong class=\"text-on-surface font-semibold\">St. Andrew</strong></span>\n</div>\n<span class=\"font-label-sm text-secondary bg-secondary-fixed/50 px-2 py-0.5 rounded-full\">14.2 km cached</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n  (function () {\n    const retryBtn = document.getElementById('btn-retry');\n    const retryIcon = document.getElementById('retry-icon');\n    const retryText = document.getElementById('retry-text');\n    let isRetrying = false;\n\n    if (retryBtn) {\n      retryBtn.addEventListener('click', function () {\n        if (isRetrying) return;\n        isRetrying = true;\n        \n        retryIcon.classList.add('animate-spin');\n        retryText.textContent = 'Searching satellites...';\n        retryBtn.classList.add('opacity-75');\n\n        setTimeout(function () {\n          retryIcon.classList.remove('animate-spin');\n          retryText.textContent = 'No signal found. Retry?';\n          retryBtn.classList.remove('opacity-75');\n          isRetrying = false;\n        }, 2200);\n      });\n    }\n\n    const settingsBtn = document.getElementById('btn-settings');\n    if (settingsBtn) {\n      settingsBtn.addEventListener('click', function () {\n        settingsBtn.classList.add('scale-95');\n        setTimeout(() => settingsBtn.classList.remove('scale-95'), 150);\n      });\n    }\n  })();\n</script></main></body></html>"}