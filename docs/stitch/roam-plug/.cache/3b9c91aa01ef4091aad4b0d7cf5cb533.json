{"filename":"07-privacy-consent.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"secondary-container\": \"#fd761a\", \"on-tertiary-fixed\": \"#251a00\", \"tertiary\": \"#755800\", \"error-container\": \"#ffdad6\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container-high\": \"#eee7e0\", \"outline\": \"#8e7166\", \"tertiary-fixed-dim\": \"#f7be1d\", \"surface-bright\": \"#fff8f2\", \"on-surface\": \"#1e1b17\", \"surface-variant\": \"#e8e1db\", \"secondary-fixed\": \"#ffdbca\", \"on-secondary-fixed-variant\": \"#783200\", \"primary-fixed-dim\": \"#ffb599\", \"secondary\": \"#9d4300\", \"surface-container-lowest\": \"#ffffff\", \"error\": \"#ba1a1a\", \"on-primary\": \"#ffffff\", \"on-tertiary-container\": \"#fffbff\", \"on-secondary\": \"#ffffff\", \"surface-container-low\": \"#faf2eb\", \"surface-container\": \"#f4ede6\", \"on-background\": \"#1e1b17\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"tertiary-container\": \"#936f00\", \"on-primary-fixed-variant\": \"#7f2b00\", \"on-primary-container\": \"#fffbff\", \"on-error-container\": \"#93000a\", \"inverse-surface\": \"#33302c\", \"primary-container\": \"#cc4900\", \"primary-fixed\": \"#ffdbce\", \"on-tertiary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"surface-dim\": \"#e0d9d2\", \"inverse-primary\": \"#ffb599\", \"background\": \"#fff8f2\", \"surface-container-highest\": \"#e8e1db\", \"on-surface-variant\": \"#5a4138\", \"secondary-fixed-dim\": \"#ffb690\", \"outline-variant\": \"#e2bfb2\", \"on-secondary-container\": \"#5c2400\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"on-secondary-fixed\": \"#341100\", \"primary\": \"#a33900\", \"surface\": \"#fff8f2\", \"surface-tint\": \"#a73a00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: { \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin\": \"1rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\" }, fontFamily: { \"label-lg\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"body-md\": [\"Inter\"], \"price-display\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, fontSize: { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base { html, body { width: 100%; margin: 0; padding: 0; background-color: #fff8f2; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 16px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col\"><header class=\"fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl pt-safe\"><div class=\"h-12 px-margin flex items-center justify-between text-on-surface\"><span class=\"font-label-md text-label-md font-bold tracking-tight\">9:41</span><div class=\"flex items-center gap-space-xs text-on-surface\"><span class=\"material-symbols-outlined text-[18px]\">signal_cellular_4_bar</span><span class=\"material-symbols-outlined text-[18px]\">wifi</span><span class=\"material-symbols-outlined text-[20px]\">battery_full</span></div></div></header><main class=\"flex-1 flex flex-col relative w-full pt-12 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-6\">\n<!-- Top Navigation Bar -->\n<div class=\"flex items-center justify-between px-margin py-space-sm\">\n<button aria-label=\"Go Back\" class=\"w-12 h-12 flex items-center justify-center rounded-full bg-surface-container-high text-on-surface active:scale-95 transition-transform duration-150\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">arrow_back</span>\n</button>\n<div class=\"inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[14px]\">shield</span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider\">DATA & PRIVACY</span>\n</div>\n<div class=\"w-12 h-12\"></div>\n</div>\n<!-- Heading Section -->\n<div class=\"px-margin pt-space-md pb-space-sm\">\n<div class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed mb-space-xs\">\n<span class=\"material-symbols-outlined text-[14px]\" style=\"font-variation-settings: 'FILL' 1;\">verified_user</span>\n<span class=\"font-label-sm text-label-sm\">Driver Pledge</span>\n</div>\n<h1 class=\"font-display-lg-mobile text-display-lg-mobile text-on-surface font-extrabold tracking-tight mt-1\">\n      Your data,<br/><span class=\"text-primary\">your choice</span>\n</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-2 leading-relaxed\">\n      Roam Plug is built for Jamaican drivers, not advertisers. Here is our simple privacy promise to you on the road.\n    </p>\n</div>\n<!-- Decorative Island Map Micro-Card / Contextual Visual -->\n<div class=\"mx-margin mt-space-xs mb-space-md p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex items-center gap-space-md\">\n<div class=\"relative w-14 h-14 shrink-0 rounded-lg bg-surface-container flex items-center justify-center overflow-hidden\">\n<!-- Mini abstract Parish Map Grid Vector -->\n<svg class=\"w-10 h-10 text-primary/70\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 48 48\">\n<path d=\"M4 24c3-6 9-9 14-8 5 1 9-3 14-3 7 0 12 5 12 11s-6 8-11 9c-8 2-15-2-21 1-4 2-7-3-8-10z\" fill=\"#ffdbce\" fill-opacity=\"0.35\"></path>\n<circle cx=\"16\" cy=\"22\" fill=\"#a33900\" r=\"2.5\"></circle>\n<circle cx=\"34\" cy=\"20\" fill=\"#a33900\" r=\"2.5\"></circle>\n<path d=\"M16 22 L24 28 L34 20\" stroke=\"#a33900\" stroke-dasharray=\"2 2\" stroke-width=\"1.5\"></path>\n</svg>\n<div class=\"absolute bottom-1 right-1 w-2.5 h-2.5 rounded-full bg-secondary-container animate-ping\"></div>\n<div class=\"absolute bottom-1 right-1 w-2.5 h-2.5 rounded-full bg-secondary-container\"></div>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-label-md text-label-md text-on-surface font-bold\">14 Parishes</span>\n<span class=\"font-label-sm text-label-sm text-secondary-container px-1.5 py-0.2 rounded-full bg-secondary-fixed font-bold\">Protected</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant truncate mt-0.5\">\n        Zero persistent background GPS trailing.\n      </p>\n</div>\n</div>\n<!-- 3 Plain-Language Cards -->\n<div class=\"px-margin flex flex-col gap-space-md\">\n<!-- Card 1: Local Station Discovery -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm transition-all duration-200 hover:shadow-md\">\n<div class=\"flex items-start gap-space-md\">\n<div class=\"w-12 h-12 shrink-0 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary\">\n<span class=\"material-symbols-outlined text-[26px]\">explore</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Local Station Discovery</h2>\n<span class=\"material-symbols-outlined text-[18px] text-tertiary\">check_circle</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1.5 leading-snug\">\n            We use your location to show nearby gas stations, current pump prices, and to map places you pin across all 14 parishes.\n          </p>\n<div class=\"flex items-center gap-2 mt-3 pt-2 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded\">\n<span class=\"material-symbols-outlined text-[13px] text-secondary\">my_location</span>\n              Foreground only\n            </span>\n<span class=\"inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded\">\n<span class=\"material-symbols-outlined text-[13px] text-secondary\">local_gas_station</span>\n              JMD Price Feeds\n            </span>\n</div>\n</div>\n</div>\n</div>\n<!-- Card 2: Strictly Private Logs -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm transition-all duration-200 hover:shadow-md\">\n<div class=\"flex items-start gap-space-md\">\n<div class=\"w-12 h-12 shrink-0 rounded-xl bg-primary-fixed flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings: 'FILL' 1;\">lock</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Strictly Private Logs</h2>\n<span class=\"material-symbols-outlined text-[18px] text-tertiary\">check_circle</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1.5 leading-snug\">\n            Your fuel logs, odometer entries, and car maintenance history are 100% private to you and never shared or sold.\n          </p>\n<div class=\"flex items-center gap-2 mt-3 pt-2 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded\">\n<span class=\"material-symbols-outlined text-[13px] text-primary\">key</span>\n              Device-Encrypted\n            </span>\n<span class=\"inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded\">\n<span class=\"material-symbols-outlined text-[13px] text-primary\">no_accounts</span>\n              No Ad Brokerage\n            </span>\n</div>\n</div>\n</div>\n</div>\n<!-- Card 3: Anonymous Map Intelligence -->\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm transition-all duration-200 hover:shadow-md\">\n<div class=\"flex items-start gap-space-md\">\n<div class=\"w-12 h-12 shrink-0 rounded-xl bg-tertiary-fixed flex items-center justify-center text-tertiary\">\n<span class=\"material-symbols-outlined text-[26px]\">hub</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center justify-between\">\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Anonymous Map Intelligence</h2>\n<span class=\"material-symbols-outlined text-[18px] text-tertiary\">check_circle</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1.5 leading-snug\">\n            Only aggregated totals help build our island road map — never who you are, your phone number, or where you travelled.\n          </p>\n<div class=\"flex items-center gap-2 mt-3 pt-2 text-on-surface-variant font-label-sm text-label-sm\">\n<span class=\"inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded\">\n<span class=\"material-symbols-outlined text-[13px] text-tertiary\">visibility_off</span>\n              De-identified\n            </span>\n<span class=\"inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded\">\n<span class=\"material-symbols-outlined text-[13px] text-tertiary\">alt_route</span>\n              Route Safety Only\n            </span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Guarantee & Settings Banner -->\n<div class=\"px-margin mt-space-md\">\n<div class=\"bg-surface-container-low rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-start gap-space-sm\">\n<div class=\"w-8 h-8 shrink-0 rounded-full bg-secondary-fixed-dim flex items-center justify-center text-on-secondary-fixed-variant mt-0.5\">\n<span class=\"material-symbols-outlined text-[18px]\">verified</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<p class=\"font-body-md text-body-md text-on-surface font-medium leading-snug\">\n            You can export or delete your data any time in Settings. Zero hidden trackers.\n          </p>\n<button class=\"mt-2.5 inline-flex items-center gap-1 text-primary font-label-md text-label-md font-bold group\" type=\"button\">\n<span>Read full privacy notice</span>\n<span class=\"material-symbols-outlined text-[16px] transition-transform duration-150 group-hover:translate-x-0.5\">chevron_right</span>\n</button>\n</div>\n</div>\n</div>\n</div>\n<!-- Quick Interactive Permission Toggle -->\n<div class=\"px-margin mt-space-md\">\n<div class=\"bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center justify-between\">\n<div class=\"flex items-center gap-space-sm pr-2\">\n<span class=\"material-symbols-outlined text-secondary-container text-[24px]\">location_on</span>\n<div>\n<span class=\"font-label-lg text-label-lg text-on-surface block\">Precise Location for Gas Runs</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant block\">Shows closest petrol pump & live rate</span>\n</div>\n</div>\n<button aria-checked=\"true\" class=\"w-12 h-7 bg-primary rounded-full relative p-0.5 transition-colors duration-200 shrink-0\" id=\"perm-toggle\" role=\"switch\" type=\"button\">\n<span class=\"block w-6 h-6 bg-surface-container-lowest rounded-full shadow-md transform translate-x-5 transition-transform duration-200\" id=\"perm-handle\"></span>\n</button>\n</div>\n</div>\n<!-- Bottom CTA Container -->\n<div class=\"px-margin pt-space-lg pb-space-sm flex flex-col gap-space-sm\">\n<button class=\"w-full min-h-[52px] h-14 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-space-sm shadow-md active:bg-primary-container active:scale-[0.99] transition-all duration-150\" id=\"agree-btn\" type=\"button\">\n<span>I Agree & Continue</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant text-center px-space-md leading-tight\">\n      By continuing, you agree to Roam Plug's community guidelines and transparent data pledge.\n    </p>\n</div>\n</div>\n<script>\n  (function() {\n    const toggle = document.getElementById('perm-toggle');\n    const handle = document.getElementById('perm-handle');\n    const agreeBtn = document.getElementById('agree-btn');\n    let isChecked = true;\n\n    if (toggle && handle) {\n      toggle.addEventListener('click', function() {\n        isChecked = !isChecked;\n        toggle.setAttribute('aria-checked', isChecked ? 'true' : 'false');\n        if (isChecked) {\n          toggle.classList.remove('bg-surface-container-highest');\n          toggle.classList.add('bg-primary');\n          handle.classList.remove('translate-x-0');\n          handle.classList.add('translate-x-5');\n        } else {\n          toggle.classList.remove('bg-primary');\n          toggle.classList.add('bg-surface-container-highest');\n          handle.classList.remove('translate-x-5');\n          handle.classList.add('translate-x-0');\n        }\n      });\n    }\n\n    if (agreeBtn) {\n      agreeBtn.addEventListener('click', function() {\n        const originalText = agreeBtn.innerHTML;\n        agreeBtn.innerHTML = `\n          <span class=\"material-symbols-outlined text-[20px] animate-spin\">progress_activity</span>\n          <span>Saving Preferences...</span>\n        `;\n        setTimeout(function() {\n          agreeBtn.innerHTML = `\n            <span class=\"material-symbols-outlined text-[20px]\">check</span>\n            <span>Welcome Aboard</span>\n          `;\n          agreeBtn.classList.remove('bg-primary');\n          agreeBtn.classList.add('bg-tertiary-container');\n        }, 600);\n      });\n    }\n  })();\n</script></main></body></html>"}