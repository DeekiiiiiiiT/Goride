{"filename":"32-service-item.html","html":"<!DOCTYPE html>\n\n<html class=\"h-full\" lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"on-surface\": \"#1e1b17\", \"on-secondary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#783200\", \"tertiary\": \"#755800\", \"primary\": \"#a33900\", \"outline\": \"#8e7166\", \"secondary\": \"#9d4300\", \"surface-container-highest\": \"#e8e1db\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1e1b17\", \"primary-container\": \"#cc4900\", \"on-primary\": \"#ffffff\", \"on-primary-fixed\": \"#370e00\", \"outline-variant\": \"#e2bfb2\", \"primary-fixed\": \"#ffdbce\", \"on-error\": \"#ffffff\", \"inverse-on-surface\": \"#f7efe9\", \"surface-container-low\": \"#faf2eb\", \"error-container\": \"#ffdad6\", \"surface-container\": \"#f4ede6\", \"on-secondary-fixed\": \"#341100\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-container\": \"#5c2400\", \"on-tertiary-fixed\": \"#251a00\", \"surface-dim\": \"#e0d9d2\", \"surface-container-lowest\": \"#ffffff\", \"secondary-fixed\": \"#ffdbca\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"on-primary-fixed-variant\": \"#7f2b00\", \"primary-fixed-dim\": \"#ffb599\", \"inverse-surface\": \"#33302c\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-container\": \"#fffbff\", \"surface-bright\": \"#fff8f2\", \"surface-container-high\": \"#eee7e0\", \"background\": \"#fff8f2\", \"surface-tint\": \"#a73a00\", \"surface\": \"#fff8f2\", \"tertiary-fixed\": \"#ffdf9a\", \"secondary-container\": \"#fd761a\", \"tertiary-container\": \"#936f00\", \"surface-variant\": \"#e8e1db\", \"on-tertiary-container\": \"#fffbff\", \"on-surface-variant\": \"#5a4138\", \"inverse-primary\": \"#ffb599\", \"on-error-container\": \"#93000a\", \"error\": \"#ba1a1a\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"gutter\": \"1rem\", \"space-xs\": \"0.25rem\", \"margin\": \"1rem\", \"space-sm\": \"0.5rem\", \"space-xl\": \"2rem\", \"space-lg\": \"1.5rem\", \"gutter-sm\": \"0.75rem\", \"margin-lg\": \"1.5rem\", \"space-md\": \"1rem\" }, \"fontFamily\": { \"label-lg\": [\"Inter\"], \"price-display\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-sm\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-lg\": [\"Inter\"] }, \"fontSize\": { \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }], \"price-display\": [\"24px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }], \"label-sm\": [\"10px\", { \"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\" }], \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }], \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }], \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }], \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\" }], \"headline-lg\": [\"28px\", { \"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }] } } } };</script><style>@layer base { html, body { width: 100vw; margin: 0; padding: 0; } body { overscroll-behavior: none; } .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); } .pt-safe { padding-top: env(safe-area-inset-top, 0px); } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-gutter flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0\"><button aria-label=\"Go back\" class=\"w-12 h-12 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors active:scale-95\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[24px]\">arrow_back</span></button><div class=\"flex flex-col min-w-0\"><h1 class=\"font-headline-sm text-headline-sm text-on-surface truncate\">Service Item Detail</h1><span class=\"font-label-md text-label-md text-on-surface-variant truncate\">2019 Toyota Roomy</span></div></div><div class=\"flex items-center gap-space-xs\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-gutter pt-16 pb-safe bg-surface\"><div class=\"flex flex-col w-full pb-8 space-y-space-md\">\n<!-- Status & Category Breadcrumb -->\n<div class=\"flex items-center justify-between pt-space-xs\">\n<div class=\"flex items-center gap-space-xs bg-surface-container px-3 py-1.5 rounded-full\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\" style=\"font-variation-settings: 'FILL' 1;\">security</span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant\">Braking &amp; Safety System</span>\n</div>\n<div class=\"flex items-center gap-1.5 bg-tertiary-fixed text-on-tertiary-fixed px-2.5 py-1 rounded-full shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm font-bold\">Due in 5,388 km</span>\n</div>\n</div>\n<!-- Hero Header Title & Quick Metric -->\n<div class=\"flex flex-col space-y-1\">\n<h2 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight\">Front Brake Pads &amp; Rotors</h2>\n<div class=\"flex items-center gap-2 text-on-surface-variant font-label-md text-label-md\">\n<span>2019 Toyota Roomy</span>\n<span>•</span>\n<span class=\"text-primary font-semibold\">Odo: 84,612 km</span>\n</div>\n</div>\n<!-- Visual Wear Gauge & Schedule Tracker Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-sm\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-lg bg-surface-container-high flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[20px]\">speed</span>\n</div>\n<div>\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider\">Interval Wear Life</p>\n<p class=\"font-headline-sm text-headline-sm text-on-surface\">78% Expended</p>\n</div>\n</div>\n<div class=\"text-right\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant block\">Target Replace</span>\n<span class=\"font-headline-sm text-headline-sm text-primary font-bold\">90,000 km</span>\n</div>\n</div>\n<!-- Visual Progress Bar / Wear Tracker -->\n<div class=\"space-y-1.5 pt-1\">\n<div class=\"h-3 w-full bg-surface-container-highest rounded-full overflow-hidden p-0.5 flex\">\n<div class=\"h-full bg-gradient-to-r from-secondary-container via-primary to-primary-container rounded-full transition-all duration-700 ease-out\" style=\"width: 78%;\"></div>\n</div>\n<div class=\"flex justify-between items-center text-on-surface-variant font-label-sm text-label-sm px-0.5\">\n<span>Last: 65k km</span>\n<span class=\"text-primary font-semibold\">Current: 84,612 km</span>\n<span>Goal: 90k km</span>\n</div>\n</div>\n<!-- Metrics Grid -->\n<div class=\"grid grid-cols-2 gap-space-sm pt-2\">\n<div class=\"bg-surface-container-low rounded-lg p-2.5\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant block\">Spec Interval</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">25,000 km / 18 mos</span>\n</div>\n<div class=\"bg-surface-container-low rounded-lg p-2.5\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant block\">Projected Service</span>\n<span class=\"font-label-lg text-label-lg text-on-surface font-semibold\">Est. Jan 2025</span>\n</div>\n</div>\n</div>\n<!-- Localized Route Insight / \"Why It Matters\" -->\n<div class=\"bg-surface-container rounded-xl p-space-md shadow-sm relative overflow-hidden\">\n<div class=\"flex items-start gap-3\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center shrink-0 text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[22px]\">terrain</span>\n</div>\n<div class=\"space-y-1\">\n<div class=\"flex items-center gap-1.5\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-bold\">Why It Matters on Island Roads</h3>\n<span class=\"bg-secondary-fixed-variant/10 text-secondary font-label-sm text-label-sm px-1.5 py-0.5 rounded\">Island Route Note</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          Crucial for downhill braking control through Mount Rosser and Junction road descents. Tropical wet heat causes faster pad glazing on stop-and-go Jamaican routes.\n        </p>\n</div>\n</div>\n</div>\n<!-- Last Performed Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-sm\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-label-lg text-label-lg text-on-surface font-bold flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">history_edu</span>\n        Last Service Record\n      </h3>\n<span class=\"font-label-sm text-label-sm bg-surface-container px-2 py-0.5 rounded-full text-on-surface-variant\">Verified Work</span>\n</div>\n<div class=\"bg-surface-container-low rounded-lg p-space-sm space-y-2\">\n<div class=\"flex justify-between items-baseline\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">65,000 km</span>\n<span class=\"font-label-md text-label-md text-on-surface-variant font-medium\">14 March 2024</span>\n</div>\n<div class=\"flex items-center gap-2 text-on-surface font-body-md text-body-md\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">store</span>\n<span class=\"font-semibold\">Precision Auto Works</span>\n<span class=\"text-on-surface-variant font-normal\">• Kingston</span>\n</div>\n<div class=\"pt-1 flex items-center justify-between\">\n<div class=\"flex items-center gap-1.5 bg-surface-container-lowest px-2 py-1 rounded\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\">check_circle</span>\n<span class=\"font-label-sm text-label-sm text-on-surface\">Akebono Ceramic OEM Spec</span>\n</div>\n<span class=\"font-label-lg text-label-lg text-primary font-bold\">J$9,800</span>\n</div>\n</div>\n</div>\n<!-- History For This Item (Timeline) -->\n<div class=\"space-y-space-xs\">\n<div class=\"flex items-center justify-between px-1\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface\">Component History</h3>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">2 Recorded Logs</span>\n</div>\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm divide-y divide-surface-container\">\n<!-- Item 1 -->\n<div class=\"pb-space-sm space-y-1.5\">\n<div class=\"flex justify-between items-center\">\n<span class=\"font-label-lg text-label-lg font-bold text-on-surface\">65,000 km • Pad &amp; Fluid Refresh</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Mar 2024</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Rotors skimmed and fitted with Akebono pads. System bled with DOT 4 fluid.</p>\n<div class=\"flex items-center justify-between pt-1\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Precision Auto Works</span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\">J$14,500 total</span>\n</div>\n</div>\n<!-- Item 2 -->\n<div class=\"pt-space-sm space-y-1.5\">\n<div class=\"flex justify-between items-center\">\n<span class=\"font-label-lg text-label-lg font-bold text-on-surface\">40,120 km • Inspection &amp; Cleaning</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Nov 2022</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Cleaned caliper slide pins, 55% pad thickness remaining. Calipers lubed.</p>\n<div class=\"flex items-center justify-between pt-1\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">Toyota Jamaica (Liguanea)</span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\">J$4,200</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Quick Jamaican Driver Connectors -->\n<div class=\"space-y-space-xs\">\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface px-1\">Island Fast Tracks</h3>\n<div class=\"grid grid-cols-1 gap-space-sm\">\n<!-- Parts Connector -->\n<button class=\"w-full text-left bg-surface-container-lowest rounded-xl p-space-md shadow-sm active:scale-[0.99] transition-transform\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-on-primary-fixed\">\n<span class=\"material-symbols-outlined text-[20px]\">shopping_bag</span>\n</div>\n<div>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Find Pads &amp; Rotors</span>\n<span class=\"bg-surface-container text-on-surface-variant font-label-sm text-label-sm px-1.5 rounded\">In Stock</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">Mario's Auto Parts (Constant Spring) • OEM Ready</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px]\">chevron_right</span>\n</div>\n</button>\n<!-- Mechanic Connector -->\n<button class=\"w-full text-left bg-surface-container-lowest rounded-xl p-space-md shadow-sm active:scale-[0.99] transition-transform\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed\">\n<span class=\"material-symbols-outlined text-[20px]\">build_circle</span>\n</div>\n<div>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Find a Mechanic</span>\n<span class=\"bg-secondary-fixed-variant/10 text-secondary font-label-sm text-label-sm px-1.5 rounded\">4 Nearby</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-0.5\">Precision Auto Works • 1.4 km away in Kingston</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">chevron_right</span>\n</div>\n</button>\n</div>\n</div>\n<!-- Action CTAs -->\n<div class=\"pt-space-sm space-y-3\">\n<button class=\"w-full h-12 bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg font-bold rounded-xl shadow-md flex items-center justify-center gap-2 active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">check_circle</span>\n<span>Mark as Done / Log Service</span>\n</button>\n<button class=\"w-full h-12 bg-surface-container hover:bg-surface-container-high text-on-surface-variant font-label-lg text-label-lg font-semibold rounded-xl flex items-center justify-center gap-2 active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">alarm</span>\n<span>Add to To-Do / Remind me in 3,000 km</span>\n</button>\n</div>\n</div></main></body></html>"}