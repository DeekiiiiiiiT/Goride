ing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe\"><div class=\"h-16 px-space-md flex items-center justify-between\"><div class=\"flex items-center gap-space-sm\"><div class=\"w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-[0_4px_12px_rgba(163,57,0,0.25)]\"><span class=\"material-symbols-outlined text-[22px]\">local_gas_station</span></div><div class=\"flex flex-col\"><span class=\"font-label-sm text-label-sm text-primary tracking-wider uppercase\">Roam Plug</span><h1 class=\"font-headline-sm text-headline-sm text-on-surface leading-tight\">Explore</h1></div></div><div class=\"flex items-center gap-space-xs\"><button aria-label=\"Parish Selection &amp; Alerts\" class=\"w-11 h-11 min-h-[44px] min-w-[44px] rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors\"><span class=\"material-symbols-outlined text-[24px]\">notifications</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full pt-16 pb-28 bg-surface min-h-screen\"><div class=\"flex flex-col w-full relative select-none\">\n<!-- Top Floating Controls Area -->\n<div class=\"sticky top-0 z-30 flex flex-col w-full px-space-md pt-space-sm pb-space-xs gap-space-sm bg-gradient-to-b from-surface via-surface/90 to-transparent pointer-events-auto\">\n<!-- Current Area Selector & Live Community Ticker -->\n<div class=\"flex items-center justify-between w-full\">\n<button class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-lowest shadow-md active:scale-95 transition-transform min-h-[44px]\" id=\"parishSelectorBtn\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">location_on</span>\n<span class=\"font-headline-sm text-label-md text-on-surface font-bold tracking-tight\">Half-Way-Tree, St Andrew</span>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[16px]\">expand_more</span>\n</button>\n<div class=\"flex items-center gap-space-xs\">\n<div class=\"flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant\">\n<span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n<span class=\"font-label-sm text-[10px] uppercase font-bold text-on-surface-variant\">Live Plugs</span>\n</div>\n<div class=\"relative w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center shadow-sm\">\n<span class=\"font-label-lg text-label-sm text-primary font-bold\">AB</span>\n<span class=\"absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-secondary-container ring-2 ring-surface\"></span>\n</div>\n</div>\n</div>\n<!-- Search Input Bar -->\n<div class=\"relative flex items-center w-full shadow-md rounded-2xl bg-surface-container-lowest\">\n<div class=\"pl-3.5 pr-2 flex items-center justify-center text-primary pointer-events-none\">\n<span class=\"material-symbols-outlined text-[22px]\">search</span>\n</div>\n<input class=\"w-full h-12 bg-transparent text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant focus:outline-none pr-12 min-h-[48px]\" placeholder=\"Search stations, parts stores, mechanics...\" type=\"text\"/>\n<div class=\"absolute right-1 flex items-center gap-1\">\n<button aria-label=\"Voice Search\" class=\"w-10 h-10 min-w-[40px] min-h-[40px] flex items-center justify-center text-on-surface-variant hover:text-primary active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">mic</span>\n</button>\n<button aria-label=\"Filters\" class=\"w-10 h-10 min-w-[40px] min-h-[40px] flex items-center justify-center text-on-surface-variant hover:text-primary active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">tune</span>\n</button>\n</div>\n</div>\n<!-- Category Chips Carousel -->\n<div class=\"flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5 -mx-space-md px-space-md\">\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-secondary-container text-on-primary shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px]\">local_gas_station</span>\n<span class=\"font-label-lg text-label-sm font-bold tracking-tight\">Fuel</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-tertiary\">build</span>\n<span class=\"font-label-md text-label-sm font-semibold\">Mechanics</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-primary\">settings</span>\n<span class=\"font-label-md text-label-sm font-semibold\">Parts Stores</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-secondary\">tire_repair</span>\n<span class=\"font-label-md text-label-sm font-semibold\">Air Pump</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-on-surface-variant\">wc</span>\n<span class=\"font-label-md text-label-sm font-semibold\">Restrooms</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-primary\">local_car_wash</span>\n<span class=\"font-label-md text-label-sm font-semibold\">Car Wash</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-emerald-600\">ev_station</span>\n<span class=\"font-label-md text-label-sm font-semibold\">EV Charging</span>\n</button>\n<button class=\"flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-lowest text-on-surface shadow-sm min-h-[38px] active:scale-95 transition-all shrink-0\">\n<span class=\"material-symbols-outlined text-[17px] text-tertiary\">toll</span>\n<span class=\"font-label-md text-label-sm font-semibold\">Tolls</span>\n</button>\n</div>\n</div>\n<!-- Map Display Stage & Geospatial Grid -->\n<div class=\"relative w-full h-[512px] bg-surface-container-low overflow-hidden cursor-grab active:cursor-grabbing\">\n<!-- Stylized Kingston / Half-Way-Tree Vector Map Graphic -->\n<svg class=\"absolute inset-0 w-full h-full object-cover select-none pointer-events-none opacity-90\" fill=\"none\" viewbox=\"0 0 420 560\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect fill=\"#F4EDE6\" height=\"560\" width=\"420\"></rect>\n<!-- Urban green areas (Emancipation Park / Kings House grounds) -->\n<path d=\"M260 40C295 40 330 65 330 110C330 145 285 160 250 150C225 142 220 95 240 60C248 45 254 40 260 40Z\" fill=\"#DCECD7\" opacity=\"0.6\"></path>\n<path d=\"M40 380C65 375 110 385 115 425C120 460 85 490 50 480C25 470 20 420 30 395C33 385 36 380 40 380Z\" fill=\"#DCECD7\" opacity=\"0.5\"></path>\n<!-- Major Arterial Road Lines (Kingston Grid: Hope Rd, Constant Spring Rd, Hagley Park Rd) -->\n<path d=\"M-20 180 Q 140 210 210 260 T 440 330\" stroke=\"#FFFFFF\" stroke-linecap=\"round\" stroke-width=\"26\"></path>\n<path d=\"M-20 180 Q 140 210 210 260 T 440 330\" stroke=\"#E2BFB2\" stroke-linecap=\"round\" stroke-width=\"12\"></path>\n<text fill=\"#8E7166\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" transform=\"rotate(8 70 195)\" x=\"70\" y=\"195\">HOPE ROAD</text>\n<path d=\"M210 -20 L 210 580\" stroke=\"#FFFFFF\" stroke-width=\"24\"></path>\n<path d=\"M210 -20 L 210 580\" stroke=\"#FFDBCA\" stroke-width=\"10\"></path>\n<text fill=\"#8E7166\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" transform=\"rotate(90 218 90)\" x=\"218\" y=\"90\">CONSTANT SPRING RD</text>\n<path d=\"M210 260 L 30 520\" stroke=\"#FFFFFF\" stroke-width=\"22\"></path>\n<path d=\"M210 260 L 30 520\" stroke=\"#E2BFB2\" stroke-width=\"8\"></path>\n<text fill=\"#8E7166\" font-family=\"Inter\" font-size=\"8\" font-weight=\"700\" transform=\"rotate(-55 120 380)\" x=\"120\" y=\"380\">HAGLEY PARK RD</text>\n<path d=\"M210 260 L 410 470\" stroke=\"#FFFFFF\" stroke-width=\"20\"></path>\n<path d=\"M210 260 L 410 470\" stroke=\"#FFDBCA\" stroke-width=\"8\"></path>\n<text fill=\"#8E7166\" font-family=\"Inter\" font-size=\"8\" font-weight=\"700\" transform=\"rotate(45 290 355)\" x=\"290\" y=\"355\">HALF-WAY-TREE RD</text>\n<!-- Half-Way-Tree Clock Roundabout Junction -->\n<circle cx=\"210\" cy=\"260\" fill=\"#F4EDE6\" r=\"28\" stroke=\"#FFFFFF\" stroke-width=\"10\"></circle>\n<circle cx=\"210\" cy=\"260\" fill=\"#E8E1DB\" r=\"20\"></circle>\n<circle cx=\"210\" cy=\"260\" fill=\"#CC4900\" opacity=\"0.3\" r=\"8\"></circle>\n<!-- Secondary Streets -->\n<path d=\"M70 40 L 70 330\" stroke=\"#FFFFFF\" stroke-width=\"7\"></path>\n<path d=\"M340 180 L 340 500\" stroke=\"#FFFFFF\" stroke-width=\"8\"></path>\n<path d=\"M40 100 L 390 100\" stroke=\"#FFFFFF\" stroke-width=\"8\"></path>\n<path d=\"M60 410 L 380 410\" stroke=\"#FFFFFF\" stroke-width=\"7\"></path>\n<path d=\"M120 200 L 120 480\" stroke=\"#FFFFFF\" stroke-width=\"6\"></path>\n<path d=\"M30 460 L 390 460\" stroke=\"#FFFFFF\" stroke-width=\"6\"></path>\n<!-- Subtle pulse grid circles for radar feel -->\n<circle cx=\"160\" cy=\"210\" opacity=\"0.2\" r=\"70\" stroke=\"#CC4900\" stroke-dasharray=\"4 4\" stroke-width=\"1\"></circle>\n</svg>\n<!-- Map Elements / Interactive Floating Hotspots -->\n<!-- 1. Pulsing Current User Location (On Hope Road) -->\n<div class=\"absolute top-[200px] left-[145px] -translate-x-1/2 -translate-y-1/2 z-20 flex flex-col items-center pointer-events-none\">\n<div class=\"relative flex items-center justify-center\">\n<span class=\"absolute w-12 h-12 rounded-full bg-primary/20 animate-ping\"></span>\n<span class=\"absolute w-7 h-7 rounded-full bg-primary/30\"></span>\n<span class=\"relative w-4 h-4 rounded-full bg-primary ring-2 ring-surface shadow-md\"></span>\n</div>\n<div class=\"mt-1 px-2 py-0.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-sm shadow-sm flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary\"></span>\n<span class=\"font-label-sm text-[9px] text-on-surface font-bold whitespace-nowrap\">You on Hope Rd</span>\n</div>\n</div>\n<!-- 2. CHEAPEST PIN: Fesco Beechwood (Golden Highlight) -->\n<div class=\"absolute top-[320px] left-[130px] z-20 -translate-x-1/2 -translate-y-full cursor-pointer group\">\n<div class=\"flex flex-col items-center\">\n<div class=\"px-2.5 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed shadow-md flex items-center gap-1 -mb-1 z-10 scale-95 ring-2 ring-tertiary-container animate-bounce\">\n<span class=\"material-symbols-outlined text-[13px] text-tertiary-container\" style=\"font-variation-settings: 'FILL' 1;\">star</span>\n<span class=\"font-label-sm text-[10px] font-bold uppercase tracking-tight text-tertiary-container\">Best J$208.20</span>\n</div>\n<div class=\"px-3 py-1.5 rounded-xl bg-surface-container-lowest shadow-lg flex items-center gap-1.5 active:scale-95 transition-transform\">\n<span class=\"w-5 h-5 rounded-md bg-secondary-container flex items-center justify-center text-on-primary font-bold text-[10px]\">F</span>\n<div class=\"flex flex-col leading-none\">\n<span class=\"font-label-sm text-[10px] font-bold text-on-surface\">Fesco Beechwood</span>\n<span class=\"font-price-display text-label-sm text-primary font-bold\">J$208.20</span>\n</div>\n</div>\n<div class=\"w-2.5 h-2.5 bg-surface-container-lowest rotate-45 -mt-1 shadow-sm\"></div>\n</div>\n</div>\n<!-- 3. Texaco Half-Way-Tree Pin -->\n<div class=\"absolute top-[230px] left-[260px] z-10 -translate-x-1/2 -translate-y-full cursor-pointer\">\n<div class=\"flex flex-col items-center active:scale-95 transition-transform\">\n<div class=\"px-2.5 py-1 rounded-xl bg-surface-container-lowest shadow-md flex items-center gap-1.5\">\n<span class=\"w-4 h-4 rounded-full bg-error flex items-center justify-center text-on-primary text-[9px] font-bold\">★</span>\n<span class=\"font-label-