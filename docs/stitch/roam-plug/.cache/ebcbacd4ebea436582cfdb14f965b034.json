{"filename":"27-saved.html","html":"<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_blank\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { \"colors\": { \"error\": \"#ba1a1a\", \"error-container\": \"#ffdad6\", \"surface-bright\": \"#fff8f2\", \"primary-fixed-dim\": \"#ffb599\", \"surface-container-highest\": \"#e8e1db\", \"on-secondary-fixed\": \"#341100\", \"primary-fixed\": \"#ffdbce\", \"inverse-on-surface\": \"#f7efe9\", \"tertiary-container\": \"#936f00\", \"inverse-surface\": \"#33302c\", \"on-secondary-container\": \"#5c2400\", \"secondary-container\": \"#fd761a\", \"secondary-fixed-dim\": \"#ffb690\", \"on-primary-fixed-variant\": \"#7f2b00\", \"tertiary\": \"#755800\", \"on-error-container\": \"#93000a\", \"on-tertiary\": \"#ffffff\", \"inverse-primary\": \"#ffb599\", \"on-primary\": \"#ffffff\", \"surface-container-lowest\": \"#ffffff\", \"background\": \"#fff8f2\", \"on-surface-variant\": \"#5a4138\", \"surface-dim\": \"#e0d9d2\", \"on-tertiary-fixed-variant\": \"#5a4300\", \"surface-container-low\": \"#faf2eb\", \"on-tertiary-fixed\": \"#251a00\", \"on-surface\": \"#1e1b17\", \"on-error\": \"#ffffff\", \"outline\": \"#8e7166\", \"on-primary-container\": \"#fffbff\", \"surface-tint\": \"#a73a00\", \"tertiary-fixed\": \"#ffdf9a\", \"surface-container\": \"#f4ede6\", \"surface-variant\": \"#e8e1db\", \"on-primary-fixed\": \"#370e00\", \"on-secondary\": \"#ffffff\", \"tertiary-fixed-dim\": \"#f7be1d\", \"on-secondary-fixed-variant\": \"#783200\", \"secondary\": \"#9d4300\", \"surface-container-high\": \"#eee7e0\", \"primary-container\": \"#cc4900\", \"on-tertiary-container\": \"#fffbff\", \"primary\": \"#a33900\", \"on-background\": \"#1e1b17\", \"secondary-fixed\": \"#ffdbca\", \"outline-variant\": \"#e2bfb2\", \"surface\": \"#fff8f2\" }, \"borderRadius\": { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, \"spacing\": { \"margin-lg\": \"1.5rem\", \"space-xl\": \"2rem\", \"space-sm\": \"0.5rem\", \"margin\": \"1rem\", \"gutter-sm\": \"0.75rem\", \"space-md\": \"1rem\", \"space-lg\": \"1.5rem\", \"space-xs\": \"0.25rem\", \"gutter\": \"1rem\" }, \"fontFamily\": { \"price-display\": [\"Inter\"], \"label-lg\": [\"Inter\"], \"display-lg-mobile\": [\"Inter\"], \"headline-sm\": [\"Inter\"], \"headline-lg\": [\"Inter\"], \"display-lg\": [\"Inter\"], \"body-lg\": [\"Inter\"], \"label-md\": [\"Inter\"], \"body-md\": [\"Inter\"], \"headline-md\": [\"Inter\"], \"label-sm\": [\"Inter\"], \"body-sm\": [\"Inter\"] }, \"fontSize\": { \"price-display\": [\"24px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\"}], \"display-lg-mobile\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"headline-sm\": [\"18px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"600\"}], \"headline-lg\": [\"28px\", {\"lineHeight\": \"36px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"display-lg\": [\"40px\", {\"lineHeight\": \"48px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}], \"body-lg\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}], \"label-md\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\"}], \"body-md\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"400\"}], \"headline-md\": [\"22px\", {\"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\"}], \"label-sm\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"700\"}], \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}] } } } }</script><style>body { min-height: max(884px, 100dvh); }</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-on-surface flex flex-col min-h-screen pt-safe pb-safe\"><main class=\"flex-1 flex flex-col relative w-full bg-surface\"><div class=\"flex flex-col w-full px-margin pb-space-xl\">\n<!-- Celebration Header & Burst -->\n<div class=\"relative flex flex-col items-center justify-center pt-space-md text-center\">\n<!-- Ambient Warm Glow Background -->\n<div class=\"absolute w-48 h-48 rounded-full bg-secondary-fixed/50 blur-3xl -top-6 pointer-events-none\"></div>\n<!-- Animated Checkmark Container -->\n<div class=\"relative flex items-center justify-center mb-space-sm\">\n<!-- Outer pulsing ring -->\n<div class=\"w-24 h-24 rounded-full bg-secondary-fixed flex items-center justify-center animate-pulse\">\n<!-- Inner celebratory badge ring -->\n<div class=\"w-20 h-20 rounded-full bg-primary flex items-center justify-center shadow-lg transform transition-transform duration-300 hover:scale-105\">\n<span class=\"material-symbols-outlined text-on-primary text-[44px]\" style=\"font-variation-settings: 'FILL' 1, 'wght' 700;\">\n            check_circle\n          </span>\n</div>\n</div>\n<!-- Island Sparkle Micro Badges -->\n<div class=\"absolute -top-1 -right-1 w-8 h-8 rounded-full bg-tertiary-fixed-dim text-on-tertiary-fixed flex items-center justify-center shadow-md animate-bounce\">\n<span class=\"material-symbols-outlined text-[18px]\" style=\"font-variation-settings: 'FILL' 1;\">arrow_back_ios_new</span>\n</div>\n<div class=\"absolute -bottom-1 -left-2 w-7 h-7 rounded-full bg-surface-container-lowest text-primary flex items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">\n          local_gas_station\n        </span>\n</div>\n</div>\n<!-- Celebration Titles -->\n<h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight\">\n      Fuel Logged!\n    </h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-space-xs max-w-xs\">\n      2019 Toyota Roomy updated • Odometer at <span class=\"font-label-lg text-on-surface\">84,612 km</span>\n</p>\n</div>\n<!-- Key Metrics Bento Grid -->\n<div class=\"flex flex-col gap-space-md mt-space-lg\">\n<!-- Metric 1: Fuel Economy Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\" style=\"font-variation-settings: 'FILL' 1;\">speed</span>\n          Fuel Economy\n        </span>\n<span class=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-surface-container text-on-surface text-[11px] font-label-md\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\" style=\"font-variation-settings: 'wght' 700;\">arrow_upward</span>\n          +0.8 km/L\n        </span>\n</div>\n<div class=\"flex items-baseline gap-space-xs mt-space-xs\">\n<span class=\"font-display-lg-mobile text-display-lg-mobile text-on-surface font-extrabold tracking-tight\">\n          14.2\n        </span>\n<span class=\"font-headline-sm text-headline-sm text-on-surface-variant font-semibold\">\n          km/L\n        </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-space-xs flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span>\n        Better than St. Andrew average for Roomy 1.0L (13.4 km/L)\n      </p>\n<!-- Mini Graphic Fuel Efficiency Sparkline Bar -->\n<div class=\"w-full bg-surface-container h-2 rounded-full mt-space-sm overflow-hidden flex\">\n<div class=\"bg-tertiary-container h-full rounded-full\" style=\"width: 78%\"></div>\n</div>\n</div>\n<!-- Metric 2: This Fill Detail Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm\">\n<div class=\"flex items-center justify-between pb-space-xs\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant\">\n          This Refuel\n        </span>\n<!-- Fuel Grade Chip -->\n<span class=\"px-2.5 py-1 rounded bg-surface-container-highest text-on-surface font-label-md text-label-md flex items-center gap-1\">\n<span class=\"w-2 h-2 rounded-full bg-primary\"></span>\n          E-10 87 @ J$214.50/L\n        </span>\n</div>\n<div class=\"flex items-baseline justify-between mt-space-xs\">\n<div>\n<span class=\"font-price-display text-price-display text-on-surface font-bold\">\n            J$4,290\n          </span>\n<span class=\"font-body-md text-body-md text-on-surface-variant ml-1\">\n            • 20.00 L\n          </span>\n</div>\n<div class=\"flex items-center text-primary font-label-md text-label-md gap-0.5\">\n<span class=\"material-symbols-outlined text-[16px]\">pin_drop</span>\n          Texaco Barbican\n        </div>\n</div>\n</div>\n<!-- Metric 3: Next Service Reminder Card -->\n<div class=\"bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden\">\n<!-- Amber Status Left Highlight Indicator -->\n<div class=\"absolute left-0 top-0 bottom-0 w-1.5 bg-secondary-container\"></div>\n<div class=\"flex items-start justify-between pl-space-xs\">\n<div class=\"flex flex-col\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-secondary-container text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">\n              build\n            </span>\n<span class=\"font-headline-sm text-headline-sm text-on-surface\">\n              Oil change due in 380 km\n            </span>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">\n            Target threshold: <strong class=\"text-on-surface\">85,000 km</strong> • Approx. 6 days left at your pace\n          </span>\n</div>\n<span class=\"px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm uppercase tracking-wide\">\n          Due Soon\n        </span>\n</div>\n</div>\n<!-- Community Impact Card (Jamaican Sunset Gradient) -->\n<div class=\"relative overflow-hidden rounded-xl bg-gradient-to-r from-secondary-container via-primary-container to-tertiary p-space-md text-on-primary-container shadow-md\">\n<!-- Subtle Decorative Background Island Sun Motif -->\n<div class=\"absolute -right-4 -bottom-6 w-28 h-28 rounded-full bg-surface-container-lowest/15 pointer-events-none\"></div>\n<div class=\"relative z-10 flex flex-col gap-space-xs\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-tertiary-fixed text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">\n            volunteer_activism\n          </span>\n<span class=\"font-label-lg text-label-lg tracking-wide uppercase text-tertiary-fixed\">\n            Driver Network Impact\n          </span>\n</div>\n<p class=\"font-headline-sm text-headline-sm font-semibold leading-snug mt-1 text-on-primary\">\n          You updated the E-10 87 price at Texaco Barbican for every driver 🎉\n        </p>\n<div class=\"flex items-center justify-between pt-space-xs mt-space-xs\">\n<div class=\"inline-flex items-center gap-1.5 bg-on-secondary-container/30 px-space-sm py-1 rounded-full text-on-primary font-label-md text-label-md backdrop-blur-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary-fixed-dim\" style=\"font-variation-settings: 'FILL' 1;\">\n              military_tech\n            </span>\n            +15 Community Points earned\n          </div>\n<span class=\"font-label-sm text-label-sm text-tertiary-fixed font-bold tracking-wider uppercase\">\n            Level 3 Parish Spotter\n          </span>\n</div>\n</div>\n</div>\n</div>\n<!-- Action CTA Area -->\n<div class=\"flex flex-col gap-space-sm mt-space-xl\">\n<!-- Primary CTA -->\n<button class=\"w-full h-12 rounded-xl bg-primary hover:bg-primary-container active:scale-[0.99] text-on-primary font-label-lg text-label-lg shadow-md flex items-center justify-center gap-space-xs transition duration-150\" type=\"button\">\n<span>Done</span>\n<span class=\"material-symbols-outlined text-[18px]\">check</span>\n</button>\n<!-- Secondary CTA -->\n<button class=\"w-full h-12 rounded-xl bg-surface-container-low hover:bg-surface-container active:scale-[0.99] text-primary font-label-lg text-label-lg flex items-center justify-center gap-space-xs transition duration-150\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">receipt_long</span>\n<span>View in Fuel History</span>\n</button>\n</div>\n</div></main></body></html>"}