{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // No rootDir: settlementShared intentionally imports finance-core periodKey twin.
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    // Deno twin imports use .ts suffixes; allow them under noEmit (TS5097).
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules"]
}
