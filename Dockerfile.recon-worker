# Week calculator. One driver-week is 2–4 seconds of CPU, past the edge budget.
# The container works only while a wake request is open, then Cloud Run can stop it.
FROM denoland/deno:2.1.4
WORKDIR /app
COPY deno.json ./
COPY scripts/recon-worker.ts scripts/recon-worker.ts
COPY supabase/functions supabase/functions
COPY packages packages
# CACHEBUST forces a fresh Deno graph when settlement math changes.
ARG CACHEBUST=1
RUN echo "cachebust=$CACHEBUST" && deno cache --reload scripts/recon-worker.ts
CMD ["run", "--allow-env", "--allow-net", "--allow-read", "scripts/recon-worker.ts"]
