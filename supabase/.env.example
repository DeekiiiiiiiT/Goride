# Local Edge Function secrets. Copy to supabase/.env.local (already gitignored).
# Production values are set via `supabase secrets set` / the Supabase dashboard.
#
# Auto-provided by Supabase at runtime — do not set manually in production:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL

# AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_ADMIN_API_KEY=

# Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_MERCHANT=
GOOGLE_MAPS_SERVER_KEY_RIDES=

# Payments
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENV=sandbox
WIPAY_CALLBACK_SECRET=

# SMS — dashOrderSms reads *_API_URL + *_API_KEY (not FLOW_SMS_TOKEN alone)
DIGICEL_SMS_API_URL=
DIGICEL_SMS_API_KEY=
DIGICEL_SMS_USER=
DIGICEL_SMS_PASS=
FLOW_SMS_API_URL=
FLOW_SMS_API_KEY=
FLOW_SMS_TOKEN=
SEND_SMS_HOOK_SECRET=
# Soft-fail logging only (never in production)
# SMS_HOOK_STUB_LOG_OK=1
# DASH_SMS_STUB_LOG_OK=1

# Email
SMTP_USER=
SMTP_PASS=

# Push (required for merchant-push + courier notifications in production)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@roam.app
# Fail loud when VAPID missing (set in production)
REQUIRE_VAPID=1
MERCHANT_PUSH_SECRET=

# Courier dispatch tuning
COURIER_DISPATCH_RADIUS_KM=12
COURIER_DISPATCH_MAX_OFFERS=15
COURIER_DISPATCH_OFFER_TTL_MS=90000

# Internal service-to-service secrets (never VITE_/NEXT_PUBLIC_-prefix these)
TOLL_BRAIN_INTERNAL_SECRET=
FUEL_BRAIN_INTERNAL_SECRET=
MATCHING_INTERNAL_SECRET=
AUDIT_HMAC_SECRET=
ROAM_RIDES_QUOTE_SECRET=
STATION_DEVICE_SECRET=
STATION_SHIFT_SECRET=
FLEET_CRON_SECRET=
RIDES_CRON_SECRET=
MATCHING_CRON_SECRET=

# CORS (comma-separated browser origins)
CORS_ALLOWED_ORIGINS=

# Supabase Management API (org-level — extremely sensitive)
SUPABASE_PAT=
SUPABASE_PROJECT_REF=
