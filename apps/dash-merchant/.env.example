# Roam Dash Partner (dash-merchant)
# Copy to .env.local for local overrides.

# Google OAuth redirect must include http://localhost:<port>/ in Supabase Auth settings.
# VITE_PARTNER_UNIFIED_ONBOARDING was removed — unified 6-step wizard is always used.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# true = simulated Stripe Terminal readers (dev/QA). Production builds should leave unset/false.
VITE_STRIPE_TERMINAL_SIMULATED=false
