# Roam Dash Partner (dash-merchant)
# Copy to .env.local for local overrides.

# Supabase Auth ? Redirect URLs must include:
#   - http://localhost:<port>/  (web / Vite)
#   - https://partner.roamrush.app/  (production web)
#   - co.roamenterprise.partner://login  (Capacitor Android/iOS deep link — required for native Google OAuth)
# VITE_PARTNER_UNIFIED_ONBOARDING was removed — unified 6-step wizard is always used.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# true = simulated Stripe Terminal readers (dev/QA). Production builds should leave unset/false.
VITE_STRIPE_TERMINAL_SIMULATED=false

# Sentry (client DSN — public by design)
VITE_SENTRY_DSN=

# --- Native push (Capacitor + Firebase) — ops files, not VITE secrets ---
# Place Firebase Android config at:
#   apps/dash-merchant/android/app/google-services.json
# Place Firebase iOS config at (when iOS project exists):
#   apps/dash-merchant/ios/App/App/GoogleService-Info.plist
# Both are gitignored / local-only — download from Firebase Console for project "Roam Partner".
# Server-side FCM sends use edge secret FCM_SERVER_KEY (Supabase function env), not this file.
