# Dash courier — copy to .env.local for local dev.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (VAPID public key) — required for background new-offer alerts.
VITE_VAPID_PUBLIC_KEY=

# Soft-launch: leave unset/false for real dispatch. true = demo mock offers.
VITE_COURIER_USE_MOCK_DISPATCH=false

# Sentry (client DSN — public by design)
VITE_SENTRY_DSN=
