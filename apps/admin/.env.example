# Admin (Roam Dominion) — copy to .env.local for local dev.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Rotated browser key (sb_publishable_…). Takes precedence over the anon key above.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sentry (client DSN � public by design)
VITE_SENTRY_DSN=

# CARTO raster basemaps (dark Spatial Integrity map). Free key from carto.com/basemaps/apikey
# Client-visible in the browser tile URL � do not put a different secret here.
VITE_CARTO_API_KEY=

