{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "react": ["../../node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../node_modules/@types/react/jsx-runtime.d.ts"],
      "@/*": ["./src/*"],
      "@roam/types": ["../../packages/types/src"],
      "@roam/types/*": ["../../packages/types/src/*"],
      "@roam/ui": ["../../packages/ui/src"],
      "@roam/ui/*": ["../../packages/ui/src/*"],
      "@roam/api-client": ["../../packages/api-client/src"],
      "@roam/api-client/*": ["../../packages/api-client/src/*"],
      "@roam/auth-client": ["../../packages/auth-client/src"],
      "@roam/auth-client/*": ["../../packages/auth-client/src/*"],
      "@roam/business-config": ["../../packages/business-config/src"],
      "@roam/business-config/*": ["../../packages/business-config/src/*"],
      "@roam/finance-core": ["../../packages/finance-core/src"],
      "@roam/finance-core/*": ["../../packages/finance-core/src/*"],
      "@roam/dash-admin-client": ["../../packages/dash-admin-client/src"],
      "@roam/dash-admin-client/*": ["../../packages/dash-admin-client/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
