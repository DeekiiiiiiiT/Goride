{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@roam/types": ["../../packages/types/src"],
      "@roam/types/*": ["../../packages/types/src/*"],
      "@roam/ui": ["../../packages/ui/src"],
      "@roam/ui/*": ["../../packages/ui/src/*"],
      "@roam/api-client": ["../../packages/api-client/src"],
      "@roam/api-client/*": ["../../packages/api-client/src/*"],
      "@roam/auth-client": ["../../packages/auth-client/src"],
      "@roam/auth-client/*": ["../../packages/auth-client/src/*"],
      "@roam/admin-core": ["../../packages/admin-core/src"],
      "@roam/admin-core/*": ["../../packages/admin-core/src/*"],
      "@roam/business-config": ["../../packages/business-config/src"],
      "@roam/business-config/*": ["../../packages/business-config/src/*"],
      "@roam/finance-core": ["../../packages/finance-core/src"],
      "@roam/finance-core/*": ["../../packages/finance-core/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", "src/supabase", "**/*.test.ts", "**/*.test.tsx"]
}
