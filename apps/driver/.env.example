# Driver app — copy to .env.local for local dev / Android builds.
# Public Supabase keys (same project as fleet). Required or the app throws on boot.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# VITE_CASH_SETTLEMENT=1
# VITE_CASH_SETTLEMENT_V2=1

# Sentry (client DSN - public by design). Required for Play Store crash visibility.
VITE_SENTRY_DSN=
# Override only if not using Android version.properties via vite define.
# VITE_APP_VERSION=1.0.26
