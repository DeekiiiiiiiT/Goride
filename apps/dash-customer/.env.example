# Dash customer — copy to .env.local for local dev.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Set true only for local demos — never in production builds
VITE_ALLOW_MOCKS=false

# Google Places / Maps: server secret GOOGLE_MAPS_API_KEY (or GOOGLE_MAPS_API_KEY_MERCHANT)
# is read by the delivery edge function maps-config endpoint. Do not put a browser key here.
# VITE_GOOGLE_MAPS_API_KEY is unused by current source — left blank intentionally.

# Native OAuth: add co.roamenterprise.rush://login to Supabase Auth redirect allowlist
# (plus https://roamrush.app/ for production web).

# Optional web push (customer audience) — same VAPID key as other Dash apps when enabled
VITE_VAPID_PUBLIC_KEY=

# Sentry (client DSN — public by design)
VITE_SENTRY_DSN=

# Android push: place google-services.json at android/app/google-services.json (gitignored).
# iOS push: place GoogleService-Info.plist in ios/App/App/ (gitignored).
